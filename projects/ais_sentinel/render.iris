bring std.json
bring std.fs
bring std.string
bring std.ui
bring domain

def j_quote(s: str) -> str effect alloc {
    val esc = json_escape(s)
    return f"\"{esc}\""
}

def j_kv_str(k: str, v: str) -> str effect alloc {
    return concat(concat(j_quote(k), ":"), j_quote(v))
}

def j_kv_num(k: str, v: f64) -> str effect alloc {
    return concat(concat(j_quote(k), ":"), to_str(v))
}

def j_kv_int(k: str, v: i64) -> str effect alloc {
    return concat(concat(j_quote(k), ":"), to_str(v))
}

def j_kv_bool(k: str, v: bool) -> str effect alloc {
    val b = if v { "true" } else { "false" }
    return concat(concat(j_quote(k), ":"), b)
}

def join_json_fields(fields: list<str>) -> str effect alloc {
    var out = "{"
    val n = list_len(fields)
    for i in 0..n {
        if i > 0 {
            out = concat(out, ",")
        }
        out = concat(out, list_get(fields, i))
    }
    return concat(out, "}")
}

def render_contact_json(c: VesselContact) -> str effect alloc {
    val f: list<str> = list()
    list_push(f, j_kv_str("label", c.label))
    list_push(f, j_kv_int("mmsi", c.mmsi.raw))
    list_push(f, j_kv_str("flag_country", c.mmsi.flag_country))
    list_push(f, j_kv_num("lat", c.lat.deg))
    list_push(f, j_kv_num("lon", c.lon.deg))
    list_push(f, j_kv_num("sog_kn", c.sog.value))
    list_push(f, j_kv_num("cog_deg", c.cog_deg))
    list_push(f, j_kv_str("nav_status", nav_status_label(c.nav_status)))
    return join_json_fields(f)
}

def render_weather_json(w: MarineWeather) -> str effect alloc {
    val f: list<str> = list()
    list_push(f, j_kv_num("wave_height_m", w.wave_height_m))
    list_push(f, j_kv_num("wave_dir_deg", w.wave_dir_deg))
    list_push(f, j_kv_num("wave_period_s", w.wave_period_s))
    list_push(f, j_kv_num("wind_knots", w.wind_knots))
    list_push(f, j_kv_num("gust_knots", w.gust_knots))
    list_push(f, j_kv_num("pressure_hpa", w.pressure_hpa))
    list_push(f, j_kv_num("current_knots", w.current_knots))
    list_push(f, j_kv_num("sea_temp_c", w.sea_temp_c))
    list_push(f, j_kv_bool("live_ok", w.live_ok))
    list_push(f, j_kv_str("source", w.note))
    return join_json_fields(f)
}

def render_verdict_json(v: AisPilotVerdict) -> str effect alloc {
    val f: list<str> = list()
    list_push(f, j_kv_str("regime", sea_regime_label(v.regime)))
    list_push(f, j_kv_str("proposed_action", helm_action_label(v.proposed_action)))
    list_push(f, j_kv_str("approved_action", helm_action_label(v.approved_action)))
    list_push(f, j_kv_bool("overridden", v.overridden))
    list_push(f, j_kv_str("safety_rule", v.safety_rule))
    list_push(f, j_kv_num("active_inf_conf", v.active_inf_conf))
    list_push(f, j_kv_num("wm_predicted_wave_m", v.wm_predicted_wave_m))
    list_push(f, j_kv_num("wm_predicted_cpa_nm", v.wm_predicted_cpa_nm))
    list_push(f, j_kv_num("homeostat_health", v.homeostat_health))
    list_push(f, j_kv_str("governor_action", v.governor_action))
    list_push(f, j_kv_num("ewc_penalty", v.ewc_penalty_val))
    list_push(f, j_kv_str("audit_notes", v.audit_notes))
    return join_json_fields(f)
}

/// Render a single `SentinelDecision` as an RFC-8259 JSON object string.
pub def render_decision_json(d: SentinelDecision) -> str effect alloc {
    val f: list<str> = list()
    list_push(f, concat("\"vessel\":", render_contact_json(d.contact)))
    list_push(f, j_kv_num("range_nm", d.encounter.range_nm))
    list_push(f, j_kv_num("bearing_deg", d.encounter.bearing_deg))
    list_push(f, j_kv_num("cpa_nm", d.encounter.cpa_nm))
    list_push(f, j_kv_num("tcpa_min", d.encounter.tcpa_min))
    list_push(f, j_kv_int("risk_score", d.risk_score))
    list_push(f, concat("\"weather\":", render_weather_json(d.weather)))
    list_push(f, concat("\"ais_verdict\":", render_verdict_json(d.verdict)))
    return join_json_fields(f)
}

def render_summary_json(s: FleetSummary) -> str effect alloc {
    val f: list<str> = list()
    list_push(f, j_kv_str("corridor", s.corridor))
    list_push(f, j_kv_int("waypoint_count", s.waypoint_count))
    list_push(f, j_kv_int("override_count", s.override_count))
    list_push(f, j_kv_num("min_cpa_nm", s.min_cpa_nm))
    list_push(f, j_kv_num("max_wave_m", s.max_wave_m))
    list_push(f, j_kv_num("max_gust_kn", s.max_gust_kn))
    list_push(f, j_kv_num("avg_health", s.avg_health))
    list_push(f, j_kv_str("pomdp_state", s.pomdp_saved_path))
    list_push(f, j_kv_str("observed_at_iso", s.observed_at_iso))
    list_push(f, j_kv_str("feed_source", s.feed_source))
    list_push(f, j_kv_bool("feed_ok", s.feed_ok))
    return join_json_fields(f)
}

/// Render a full sentinel report (`summary` + `decisions` array) as JSON.
pub def render_sentinel_json(
    summary: FleetSummary,
    decisions: list<SentinelDecision>,
) -> str effect alloc {
    var arr = "["
    val n = list_len(decisions)
    for i in 0..n {
        if i > 0 {
            arr = concat(arr, ",")
        }
        arr = concat(arr, render_decision_json(list_get(decisions, i)))
    }
    arr = concat(arr, "]")
    val sum_json = render_summary_json(summary)
    val f: list<str> = list()
    list_push(f, concat("\"summary\":", sum_json))
    list_push(f, concat("\"decisions\":", arr))
    return join_json_fields(f)
}

/// Write formatted JSON report atomically via `std.fs` to `out_path`.
pub def write_sentinel_json(
    summary: FleetSummary,
    decisions: list<SentinelDecision>,
    out_path: str,
) -> result<str, AisError> effect fs, io, alloc {
    val payload = render_sentinel_json(summary, decisions)
    return when file_write_all(out_path, payload) {
        ok(_n) => ok(out_path),
        err(msg) => err(AisError.IoFailed(f"failed writing JSON to {out_path}: {msg}")),
    }
}

/// Format high-level fleet summary header for stdout reporting.
pub def format_fleet_banner(s: FleetSummary) -> str effect alloc {
    val head = f"=== AIS SENTINEL REPORT [{s.corridor}] obs={s.observed_at_iso} ==="
    val stats = f"contacts={s.waypoint_count} overrides={s.override_count} min_cpa={to_str(s.min_cpa_nm)}nm max_wave={to_str(s.max_wave_m)}m max_gust={to_str(s.max_gust_kn)}kn avg_health={to_str(s.avg_health)}"
    val state_line = f"pomdp_model={s.pomdp_saved_path}"
    return f"{head}\n{stats}\n{state_line}"
}

/// Format compact single-line telemetry and `std.ais` verdict row for stdout.
pub def format_decision_row(d: SentinelDecision) -> str effect alloc {
    val act = helm_action_label(d.verdict.approved_action)
    val reg = sea_regime_label(d.verdict.regime)
    val ov_tag = if d.verdict.overridden { "OVERRIDE" } else { "DIRECT" }
    val cpa_s = to_str(d.encounter.cpa_nm)
    val wave_s = to_str(d.weather.wave_height_m)
    val gst_s = to_str(d.weather.gust_knots)
    return f"[{ov_tag}] {d.contact.label} (MMSI {d.contact.mmsi.raw} {d.contact.mmsi.flag_country}) | cpa={cpa_s}nm wave={wave_s}m gust={gst_s}kn | regime={reg} -> {act} (risk={d.risk_score})"
}

/// Format detailed `std.ais` safety shield, world-model, and governor diagnostics.
pub def format_decision_detail(d: SentinelDecision) -> str effect alloc {
    val row = format_decision_row(d)
    val sub = f"  ais: conf={to_str(d.verdict.active_inf_conf)} wm_wave={to_str(d.verdict.wm_predicted_wave_m)}m wm_cpa={to_str(d.verdict.wm_predicted_cpa_nm)}nm health={to_str(d.verdict.homeostat_health)} gov={d.verdict.governor_action} ewc={to_str(d.verdict.ewc_penalty_val)} rule='{d.verdict.safety_rule}'"
    return f"{row}\n{sub}"
}

