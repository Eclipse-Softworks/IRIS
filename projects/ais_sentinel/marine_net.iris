bring std.http
bring std.json
bring domain

/// Live Open-Meteo Marine wave surface reading at a coordinate.
pub record MarineReading {
    wave_height_m: f64,
    wave_dir_deg: f64,
    wave_period_s: f64,
    current_knots: f64 = 0.0,
    sea_temp_c: f64 = 0.0,
    observed_iso: str = "",
    sheltered: bool,
}

/// Live Open-Meteo atmospheric wind and barometric reading at a coordinate.
pub record WindReading {
    wind_knots: f64,
    gust_knots: f64,
    wind_dir_deg: f64,
    pressure_hpa: f64,
    observed_iso: str,
}

/// Validated AIS encounter scenario with own-ship state and target contacts.
pub record CorridorScenario {
    corridor_name: str,
    own_ship: VesselContact,
    targets: list<VesselContact>,
}

/// Specification record for constructing a validated `VesselContact`.
pub record ContactSpec {
    label: str,
    mmsi_raw: i64,
    lat_deg: f64,
    lon_deg: f64,
    sog_kn: f64,
    cog_deg: f64,
    heading_deg: i64,
    nav_status: NavStatus,
}

def extract_json_metric(body: str, path: str) -> option<f64> effect alloc {
    val raw = trim(json_query(body, path))
    if len(raw) == 0 || raw == "null" {
        return none()
    }
    return safe_parse_float(raw)
}

def check_api_error(body: str) -> result<bool, AisError> effect alloc {
    val err_flag = trim(json_query(body, "error"))
    if err_flag == "true" {
        val reason = trim(json_query(body, "reason"))
        return err(AisError.NetworkFailed(f"Open-Meteo API error: {reason}"))
    }
    return ok(true)
}

/// Parse an Open-Meteo Marine `/v1/marine` JSON response into `MarineReading`.
pub def parse_open_meteo_marine(body: str) -> result<MarineReading, AisError> effect alloc {
    val _ok = check_api_error(body)?
    val wh = extract_json_metric(body, "current.wave_height")
    val wd = extract_json_metric(body, "current.wave_direction")
    val wp = extract_json_metric(body, "current.wave_period")
    val cur_kmh = extract_json_metric(body, "current.ocean_current_velocity")
    val sst = extract_json_metric(body, "current.sea_surface_temperature")
    val raw_iso = trim(json_query(body, "current.time"))
    val obs_iso = if len(raw_iso) > 0 && raw_iso != "null" { raw_iso } else { "" }
    val cur_kn = if is_some(cur_kmh) { unwrap(cur_kmh) / 1.852 } else { 0.0 }
    val sea_c = if is_some(sst) { unwrap(sst) } else { 0.0 }
    if is_none(wh) {
        return ok(
            MarineReading {
                wave_height_m: 0.0,
                wave_dir_deg: 0.0,
                wave_period_s: 0.0,
                current_knots: cur_kn,
                sea_temp_c: sea_c,
                observed_iso: obs_iso,
                sheltered: true,
            },
        )
    }
    return ok(
        MarineReading {
            wave_height_m: unwrap(wh),
            wave_dir_deg: if is_some(wd) { unwrap(wd) } else { 0.0 },
            wave_period_s: if is_some(wp) { unwrap(wp) } else { 0.0 },
            current_knots: cur_kn,
            sea_temp_c: sea_c,
            observed_iso: obs_iso,
            sheltered: false,
        },
    )
}

/// Parse an Open-Meteo Forecast `/v1/forecast` JSON response into `WindReading`.
pub def parse_open_meteo_wind(body: str) -> result<WindReading, AisError> effect alloc {
    val _ok = check_api_error(body)?
    val spd = extract_json_metric(body, "current.wind_speed_10m")
    if is_none(spd) {
        return err(AisError.ParseFailed("missing current.wind_speed_10m in forecast payload"))
    }
    val gst = extract_json_metric(body, "current.wind_gusts_10m")
    val dir = extract_json_metric(body, "current.wind_direction_10m")
    val pres = extract_json_metric(body, "current.surface_pressure")
    val raw_iso = trim(json_query(body, "current.time"))
    val obs_iso = if len(raw_iso) > 0 && raw_iso != "null" { raw_iso } else { "live-utc" }
    return ok(
        WindReading {
            wind_knots: unwrap(spd),
            gust_knots: if is_some(gst) { unwrap(gst) } else { unwrap(spd) },
            wind_dir_deg: if is_some(dir) { unwrap(dir) } else { 0.0 },
            pressure_hpa: if is_some(pres) { unwrap(pres) } else { 1013.25 },
            observed_iso: obs_iso,
        },
    )
}

/// Build the Open-Meteo Marine live surface wave, current, and SST URL for `(lat, lon)`.
pub def build_marine_url(lat: f64, lon: f64) -> str effect alloc {
    val slat = to_str(lat)
    val slon = to_str(lon)
    return f"https://marine-api.open-meteo.com/v1/marine?latitude={slat}&longitude={slon}&current=wave_height,wave_direction,wave_period,ocean_current_velocity,ocean_current_direction,sea_surface_temperature"
}

/// Build the Open-Meteo Forecast live wind/pressure URL (in knots) for `(lat, lon)`.
pub def build_wind_url(lat: f64, lon: f64) -> str effect alloc {
    val slat = to_str(lat)
    val slon = to_str(lon)
    return f"https://api.open-meteo.com/v1/forecast?latitude={slat}&longitude={slon}&current=wind_speed_10m,wind_direction_10m,wind_gusts_10m,surface_pressure&wind_speed_unit=kn"
}

def fetch_http_body(url: str) -> result<str, AisError> effect net, alloc {
    val req = HttpRequest {
        method: "GET",
        url: url,
        headers: "Accept: application/json",
        body: "",
        timeout_ms: 8000,
    }
    return when http_send(req) {
        ok(resp) => if resp.status < 200 || resp.status >= 300 {
            err(AisError.NetworkFailed(f"HTTP {resp.status} from {url}"))
        } else {
            ok(resp.body)
        },
        err(msg) => err(AisError.NetworkFailed(f"HTTP transport error for {url}: {msg}")),
    }
}

def combine_marine_and_wind(
    lat: f64,
    lon: f64,
    marine_body: str,
    wind_body: str,
) -> result<(MarineWeather, str), AisError> effect alloc {
    val m = parse_open_meteo_marine(marine_body)?
    val w = parse_open_meteo_wind(wind_body)?
    val note_text = if m.sheltered { "open-meteo-live (sheltered wave)" } else { "open-meteo-live" }
    val obs_iso = if len(w.observed_iso) > 0 && w.observed_iso != "live-utc" {
        w.observed_iso
    } else if len(m.observed_iso) > 0 {
        m.observed_iso
    } else {
        "live-utc"
    }
    val combined = MarineWeather {
        lat: lat,
        lon: lon,
        wave_height_m: m.wave_height_m,
        wave_dir_deg: m.wave_dir_deg,
        wave_period_s: m.wave_period_s,
        wind_knots: w.wind_knots,
        gust_knots: w.gust_knots,
        wind_dir_deg: w.wind_dir_deg,
        pressure_hpa: w.pressure_hpa,
        current_knots: m.current_knots,
        sea_temp_c: m.sea_temp_c,
        observed_iso: obs_iso,
        live_ok: true,
        note: note_text,
    }
    return ok((combined, obs_iso))
}

/// Fetch live wave, current, SST, wind, gust, and pressure conditions concurrently from Open-Meteo.
pub def fetch_live_weather_pair(
    lat: f64,
    lon: f64,
) -> result<(MarineWeather, str), AisError> effect net, alloc, thread {
    val wind_url = build_wind_url(lat, lon)
    val marine_ch: chan<result<str, AisError>> = channel(1)
    spawn {
        send(marine_ch, fetch_http_body(build_marine_url(lat, lon)))
    }
    val wind_res = fetch_http_body(wind_url)
    val marine_res = recv(marine_ch)
    val marine_body = marine_res?
    val wind_body = wind_res?
    return combine_marine_and_wind(lat, lon, marine_body, wind_body)
}

/// Fetch live `MarineWeather` without separate timestamp tuple.
pub def fetch_live_marine_weather(
    lat: f64,
    lon: f64,
) -> result<MarineWeather, AisError> effect net, alloc, thread {
    val pair = fetch_live_weather_pair(lat, lon)?
    return ok(pair.0)
}

/// Explicit offline fallback climatology used only when `--offline` is selected.
pub def offline_baseline_weather(lat: f64, lon: f64) -> MarineWeather effect alloc {
    return MarineWeather {
        lat: lat,
        lon: lon,
        wave_height_m: 1.4,
        wave_dir_deg: 245.0,
        wave_period_s: 5.2,
        wind_knots: 16.5,
        gust_knots: 24.0,
        wind_dir_deg: 240.0,
        pressure_hpa: 1008.0,
        current_knots: 0.6,
        sea_temp_c: 9.4,
        observed_iso: "offline-sim",
        live_ok: false,
        note: "offline-baseline",
    }
}

/// Construct and validate a `VesselContact` from raw specification fields.
pub def materialize_contact(spec: ContactSpec) -> result<VesselContact, AisError> effect alloc {
    val mmsi = parse_mmsi(spec.mmsi_raw)?
    val lat = parse_geo_lat(spec.lat_deg)?
    val lon = parse_geo_lon(spec.lon_deg)?
    val sog = parse_knots(spec.sog_kn)?
    return ok(
        VesselContact {
            label: spec.label,
            mmsi: mmsi,
            msg_type: 1,
            lat: lat,
            lon: lon,
            sog: sog,
            cog_deg: spec.cog_deg,
            heading_deg: spec.heading_deg,
            nav_status: spec.nav_status,
        },
    )
}

def push_wp(
    out: list<VesselContact>,
    label: str,
    mmsi_raw: i64,
    pos: (f64, f64),
    kin: (f64, f64, NavStatus),
) -> result<bool, AisError> effect alloc {
    val c = materialize_contact(
        ContactSpec {
            label: label,
            mmsi_raw: mmsi_raw,
            lat_deg: pos.0,
            lon_deg: pos.1,
            sog_kn: kin.0,
            cog_deg: kin.1,
            heading_deg: kin.1 to i64,
            nav_status: kin.2,
        },
    )?
    list_push(out, c)
    return ok(true)
}

def make_own(
    label: str,
    mmsi: i64,
    pos: (f64, f64),
    kin: (f64, f64, NavStatus),
) -> result<VesselContact, AisError> effect alloc {
    return materialize_contact(
        ContactSpec {
            label: label,
            mmsi_raw: mmsi,
            lat_deg: pos.0,
            lon_deg: pos.1,
            sog_kn: kin.0,
            cog_deg: kin.1,
            heading_deg: kin.1 to i64,
            nav_status: kin.2,
        },
    )
}

def gulf_of_finland_scenario() -> result<CorridorScenario, AisError> effect alloc {
    val own = make_own(
        "PV-Turva (Own)",
        230001000,
        (60.05, 24.95),
        (14.0, 245.0, NavStatus.UnderWayEngine),
    )?
    val targets: list<VesselContact> = list()
    val _1 = push_wp(
        targets,
        "M/V Finnmaid",
        230992750,
        (60.012, 24.835),
        (16.5, 62.0, NavStatus.UnderWayEngine),
    )?
    val _2 = push_wp(
        targets,
        "M/T Nordic Sky",
        230645000,
        (59.935, 24.48),
        (12.8, 258.0, NavStatus.ConstrainedDraught),
    )?
    val _3 = push_wp(
        targets,
        "M/V Kotka Star",
        265541000,
        (60.195, 26.82),
        (11.2, 210.0, NavStatus.UnderWayEngine),
    )?
    val _4 = push_wp(
        targets,
        "R/V Aranda",
        230120000,
        (59.972, 25.61),
        (9.4, 85.0, NavStatus.RestrictedManeuver),
    )?
    return ok(
        CorridorScenario { corridor_name: "gulf_of_finland", own_ship: own, targets: targets },
    )
}

