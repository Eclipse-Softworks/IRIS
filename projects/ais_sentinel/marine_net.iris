/// Build validated maritime TSS corridor waypoints for the selected `CorridorKind`.
pub def corridor_scenario(kind: CorridorKind) -> result<CorridorScenario, AisError> effect alloc {
    return when kind {
        CorridorKind.GulfOfFinland => gulf_of_finland_scenario(),
        CorridorKind.AlandSea => aland_sea_scenario(),
        CorridorKind.DoverStrait => dover_strait_scenario(),
        CorridorKind.Skagerrak => skagerrak_scenario(),
        CorridorKind.CustomCoord => gulf_of_finland_scenario(),
    }
}

/// Synthesize a nearby patrol own-ship contact relative to a custom target `(lat, lon)`.
pub def custom_own_ship(
    target_lat: GeoLat,
    target_lon: GeoLon,
) -> result<VesselContact, AisError> effect alloc {
    val own_lat = if target_lat.deg + 0.04 <= 90.0 {
        target_lat.deg + 0.04
    } else {
        target_lat.deg - 0.04
    }
    val own_lon = if target_lon.deg + 0.04 <= 180.0 {
        target_lon.deg + 0.04
    } else {
        target_lon.deg - 0.04
    }
    return materialize_contact(
        ContactSpec {
            label: "AIS-Sentinel Patrol",
            mmsi_raw: 230009999,
            lat_deg: own_lat,
            lon_deg: own_lon,
            sog_kn: 12.0,
            cog_deg: 225.0,
            heading_deg: 225,
            nav_status: NavStatus.UnderWayEngine,
        },
    )
}

def test_parse_open_meteo_marine_and_wind() -> i64 effect alloc, throw {
    val m_json = "{\"latitude\":60.15,\"current\":{\"time\":\"2026-11-15T00:00\",\"wave_height\":0.85,\"wave_direction\":242,\"wave_period\":4.1,\"ocean_current_velocity\":1.852,\"sea_surface_temperature\":8.6}}"
    val w_json = "{\"latitude\":60.15,\"current\":{\"time\":\"2026-11-15T00:00\",\"wind_speed_10m\":14.2,\"wind_direction_10m\":238,\"wind_gusts_10m\":21.5,\"surface_pressure\":1004.8}}"
    val mr = parse_open_meteo_marine(m_json)
    val wr = parse_open_meteo_wind(w_json)
    assert(is_ok(mr))
    assert(is_ok(wr))
    val m = unwrap(mr)
    val w = unwrap(wr)
    assert(!m.sheltered && m.wave_height_m > 0.8 && m.wave_period_s > 4.0)
    assert(m.current_knots > 0.99 && m.current_knots < 1.01 && m.sea_temp_c > 8.5)
    assert(m.observed_iso == "2026-11-15T00:00")
    assert(w.wind_knots > 14.0 && w.gust_knots > 21.0 && w.pressure_hpa > 1004.0)
    val sheltered_json = "{\"current\":{\"wave_height\":null,\"wave_direction\":null}}"
    val sr = parse_open_meteo_marine(sheltered_json)
    assert(is_ok(sr) && unwrap(sr).sheltered)
    val aland = corridor_scenario(CorridorKind.AlandSea)
    assert(is_ok(aland) && len(unwrap(aland).targets) == 3)
    return 0
}
