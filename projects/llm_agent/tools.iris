// Typed tools for the warehouse agent. Every tool has a record for its
// arguments and a record for its result. The model's JSON arguments are
// decoded into the argument record and checked (required fields, ranges,
// known values) before the tool runs, and the result is encoded from the
// result record. A failure is a typed ToolError, sent back to the model as
// {"error":{"code":..,"message":..}}; nothing runs on unchecked input.

bring std.json

pub record StockQuery { sku: str }
pub record StockLevel { sku: str, on_hand: i64, reserved: i64, warehouse: str }
pub record ReorderRequest { sku: str, quantity: i64 }
pub record ReorderReceipt { order_id: str, sku: str, quantity: i64, eta_days: i64 }
pub record ShippingQuery { weight_grams: i64, zone: str }
pub record ShippingQuote { zone: str, weight_grams: i64, cost_cents: i64, days: i64 }
pub record ToolError { code: str, message: str }

pub const MAX_REORDER: i64 = 1000
pub const MAX_WEIGHT_GRAMS: i64 = 30000

// Orders placed this run; program state, so it persists between tool calls.
var orders_placed: i64 = 0

// ── The warehouse ───────────────────────────────────────────────────────────

def stock_of(sku: str) -> option<StockLevel> {
    if sku == "A-100" {
        some(StockLevel { sku: sku, on_hand: 12, reserved: 4, warehouse: "JNB-1" })
    } else if sku == "B-200" {
        some(StockLevel { sku: sku, on_hand: 340, reserved: 20, warehouse: "CPT-2" })
    } else if sku == "C-300" {
        some(StockLevel { sku: sku, on_hand: 0, reserved: 0, warehouse: "JNB-1" })
    } else {
        none()
    }
}

def fail(code: str, message: str) -> ToolError {
    ToolError { code: code, message: message }
}

pub def stock_level(q: StockQuery) -> result<StockLevel, ToolError> {
    val found = stock_of(q.sku);
    if is_some(found) { ok(unwrap(found)) } else { err(fail("not_found", "no SKU " + q.sku)) }
}

pub def reorder_stock(r: ReorderRequest) -> result<ReorderReceipt, ToolError> {
    val found = stock_of(r.sku);
    if is_some(found) == false {
        return err(fail("not_found", "no SKU " + r.sku))
    };
    orders_placed = orders_placed + 1;
    val eta = if unwrap(found).warehouse == "JNB-1" { 3 } else { 5 };
    ok(ReorderReceipt { order_id: "R-" + to_str(orders_placed), sku: r.sku, quantity: r.quantity, eta_days: eta })
}

pub def shipping_quote(q: ShippingQuery) -> result<ShippingQuote, ToolError> {
    val kilos = (q.weight_grams + 999) / 1000;
    val base = if q.zone == "local" { 300 } else if q.zone == "national" { 650 } else if q.zone == "EU" { 1800 } else { 2400 };
    val per_kilo = if q.zone == "local" { 50 } else if q.zone == "national" { 120 } else { 450 };
    val days = if q.zone == "local" { 1 } else if q.zone == "national" { 2 } else if q.zone == "EU" { 6 } else { 8 };
    ok(ShippingQuote { zone: q.zone, weight_grams: q.weight_grams, cost_cents: base + per_kilo * kilos, days: days })
}

// ── Decoding: JSON arguments into argument records ────────────────────────

// A required string field; json_query yields "" when it is missing.
def need_str(args: str, name: str) -> result<str, ToolError> {
    val value = json_query(args, name);
    if len(value) == 0 { err(fail("invalid_arguments", "missing string field '" + name + "'")) } else { ok(value) }
}

// A required integer field within [low, high].
def need_int(args: str, name: str, low: i64, high: i64) -> result<i64, ToolError> {
    val text = json_query(args, name);
    val parsed = parse_i64(text);
    if len(text) == 0 || is_some(parsed) == false {
        return err(fail("invalid_arguments", "missing integer field '" + name + "'"))
    };
    val value = unwrap(parsed);
    if value < low || value > high {
        return err(fail("out_of_range", name + " must be between " + to_str(low) + " and " + to_str(high) + ", got " + to_str(value)))
    };
    ok(value)
}

pub def decode_stock_query(args: str) -> result<StockQuery, ToolError> {
    val sku = need_str(args, "sku");
    if is_ok(sku) { ok(StockQuery { sku: unwrap(sku) }) } else { err(unwrap_err(sku)) }
}

pub def decode_reorder(args: str) -> result<ReorderRequest, ToolError> {
    val sku = need_str(args, "sku");
    if is_ok(sku) == false {
        return err(unwrap_err(sku))
    };
    val quantity = need_int(args, "quantity", 1, MAX_REORDER);
    if is_ok(quantity) == false {
        return err(unwrap_err(quantity))
    };
    ok(ReorderRequest { sku: unwrap(sku), quantity: unwrap(quantity) })
}

pub def decode_shipping(args: str) -> result<ShippingQuery, ToolError> {
    val weight = need_int(args, "weight_grams", 1, MAX_WEIGHT_GRAMS);
    if is_ok(weight) == false {
        return err(unwrap_err(weight))
    };
    val zone = need_str(args, "zone");
    if is_ok(zone) == false {
        return err(unwrap_err(zone))
    };
    val z = unwrap(zone);
    if z != "local" && z != "national" && z != "EU" && z != "US" {
        return err(fail("invalid_arguments", "zone must be local, national, EU or US, got " + z))
    };
    ok(ShippingQuery { weight_grams: unwrap(weight), zone: z })
}

// ── Encoding: result records into JSON ──────────────────────────────────────

pub def stock_json(s: StockLevel) -> str {
    "{\"sku\":" + json_stringify(s.sku) + ",\"on_hand\":" + to_str(s.on_hand) + ",\"reserved\":" + to_str(s.reserved) + ",\"warehouse\":" + json_stringify(s.warehouse) + "}"
}

pub def receipt_json(r: ReorderReceipt) -> str {
    "{\"order_id\":" + json_stringify(r.order_id) + ",\"sku\":" + json_stringify(r.sku) + ",\"quantity\":" + to_str(r.quantity) + ",\"eta_days\":" + to_str(r.eta_days) + "}"
}

pub def quote_json(q: ShippingQuote) -> str {
    "{\"zone\":" + json_stringify(q.zone) + ",\"weight_grams\":" + to_str(q.weight_grams) + ",\"cost_cents\":" + to_str(q.cost_cents) + ",\"days\":" + to_str(q.days) + "}"
}

pub def error_json(e: ToolError) -> str {
    "{\"error\":{\"code\":" + json_stringify(e.code) + ",\"message\":" + json_stringify(e.message) + "}}"
}

// ── The tool table ──────────────────────────────────────────────────────────

pub def tools_json() -> str {
    val sku = "\"sku\":{\"type\":\"string\",\"description\":\"Stock keeping unit, for example A-100\"}";
    val stock = "{\"type\":\"function\",\"function\":{\"name\":\"stock_level\",\"description\":\"Units on hand and reserved for one SKU\",\"parameters\":{\"type\":\"object\",\"properties\":{" + sku + "},\"required\":[\"sku\"],\"additionalProperties\":false}}}";
    val quantity = "\"quantity\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":" + to_str(MAX_REORDER) + "}";
    val reorder = "{\"type\":\"function\",\"function\":{\"name\":\"reorder_stock\",\"description\":\"Place a supplier order for a SKU\",\"parameters\":{\"type\":\"object\",\"properties\":{" + sku + "," + quantity + "},\"required\":[\"sku\",\"quantity\"],\"additionalProperties\":false}}}";
    val weight = "\"weight_grams\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":" + to_str(MAX_WEIGHT_GRAMS) + "}";
    val zone = "\"zone\":{\"type\":\"string\",\"enum\":[\"local\",\"national\",\"EU\",\"US\"]}";
    val ship = "{\"type\":\"function\",\"function\":{\"name\":\"shipping_quote\",\"description\":\"Cost in cents and days to ship a parcel\",\"parameters\":{\"type\":\"object\",\"properties\":{" + weight + "," + zone + "},\"required\":[\"weight_grams\",\"zone\"],\"additionalProperties\":false}}}";
    "[" + stock + "," + reorder + "," + ship + "]"
}

/// Run tool `name` on the model's arguments; the JSON to send back.
pub def run_tool(name: str, args_json: str) -> str {
    if name == "stock_level" {
        val q = decode_stock_query(args_json);
        if is_ok(q) == false {
            return error_json(unwrap_err(q))
        };
        val r = stock_level(unwrap(q));
        if is_ok(r) { stock_json(unwrap(r)) } else { error_json(unwrap_err(r)) }
    } else if name == "reorder_stock" {
        val q = decode_reorder(args_json);
        if is_ok(q) == false {
            return error_json(unwrap_err(q))
        };
        val r = reorder_stock(unwrap(q));
        if is_ok(r) { receipt_json(unwrap(r)) } else { error_json(unwrap_err(r)) }
    } else if name == "shipping_quote" {
        val q = decode_shipping(args_json);
        if is_ok(q) == false {
            return error_json(unwrap_err(q))
        };
        val r = shipping_quote(unwrap(q));
        if is_ok(r) { quote_json(unwrap(r)) } else { error_json(unwrap_err(r)) }
    } else {
        error_json(fail("unknown_tool", "no tool named " + name))
    }
}

pub def orders_placed_count() -> i64 {
    orders_placed
}
