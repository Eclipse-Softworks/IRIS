// The environment: a 5 x 5 grid the agent knows nothing about. A move into a
// wall or off the grid leaves it where it is; in the mud (~) a move fails,
// and the agent stays put, half the time. Cells are numbered y * 5 + x from
// the top left; the agent starts at 0 and the goal is 24.
//
//   S . . # .
//   . ~ ~ # .
//   . ~ ~ . .
//   . . # . .
//   # . . . G
//
// The best route goes down the left column (8 moves); the route through the
// mud is as short on paper but slower in expectation. close_cell(15) puts a
// wall on that column mid-run, so every route then crosses the mud.

pub const GRID: i64 = 5
pub const CELLS: i64 = 25
pub const START: i64 = 0
pub const GOAL: i64 = 24
pub const ACTIONS: i64 = 4
// Outcomes of a move: 0 stay, 1 up, 2 right, 3 down, 4 left.
pub const SLOTS: i64 = 5
pub const SLIP_PERMILLE: i64 = 500

// A cell walled off while the agent runs; -1 for none.
var closed_cell: i64 = -1

pub def close_cell(s: i64) -> i64 {
    closed_cell = s;
    0
}

pub def is_wall(s: i64) -> bool {
    s == 3 || s == 8 || s == 17 || s == 20 || s == closed_cell
}

pub def is_mud(s: i64) -> bool {
    s == 6 || s == 7 || s == 11 || s == 12
}

// The cell outcome `slot` leads to from s, or -1 off the grid.
pub def slot_target(s: i64, slot: i64) -> i64 {
    val x = s % GRID;
    val y = s / GRID;
    if slot == 0 {
        s
    } else if slot == 1 {
        if y == 0 { -1 } else { s - GRID }
    } else if slot == 2 {
        if x == GRID - 1 { -1 } else { s + 1 }
    } else if slot == 3 {
        if y == GRID - 1 { -1 } else { s + GRID }
    } else {
        if x == 0 { -1 } else { s - 1 }
    }
}

// Action a (0 up, 1 right, 2 down, 3 left) aims at outcome a + 1.
pub def passable(s: i64, a: i64) -> bool {
    val target = slot_target(s, a + 1);
    target >= 0 && is_wall(target) == false
}

// The true probability that action a from s ends in outcome `slot`.
pub def true_slot_prob(s: i64, a: i64, slot: i64) -> f64 {
    val moves = if passable(s, a) == false { 0.0 } else if is_mud(s) { 1.0 - (SLIP_PERMILLE to f64) / 1000.0 } else { 1.0 };
    if slot == a + 1 { moves } else if slot == 0 { 1.0 - moves } else { 0.0 }
}

// Park-Miller minimal standard generator: the next state of the stream.
pub def rng_next(state: i64) -> i64 {
    (state * 48271) % 2147483647
}

// One move in the world: the next cell and the generator's next state.
pub def world_step(s: i64, a: i64, rng: i64) -> (i64, i64) {
    val next_rng = rng_next(rng);
    if passable(s, a) == false {
        return (s, next_rng)
    };
    if is_mud(s) && next_rng % 1000 < SLIP_PERMILLE {
        return (s, next_rng)
    };
    (slot_target(s, a + 1), next_rng)
}
