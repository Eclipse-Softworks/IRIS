// projects/continuous_background_learning/main.iris
// End-to-end continuous background learning, real-time control, and in-flight hot-swap orchestrator.

bring std.math.*
bring std.time.*
bring "types.iris"
bring "plant.iris"
bring "learner.iris"
bring "controller.iris"
bring "display.iris"

pub def main() -> i64 {
    println("================================================================================");
    println("     CONTINUOUS BACKGROUND LEARNING & REAL-TIME IN-FLIGHT MODEL HOT-SWAP        ");
    println("================================================================================");
    println("[SYSTEM INITIALIZATION] Spawning concurrent background parameter identification worker...");
    println("[CONTROL SPECIFICATION] 50 Hz real-time loop (dt=20ms) | Reference: 1.2*sin(2*t)");

    // Initialize physical plant and model prior
    var current_plant = plant_create_nominal();
    var current_state = plant_initial_state();
    val prior_model = model_create_nominal();
    var active_model = prior_model;

    // Asynchronous communication channels connecting fast loop and background learner
    val ch_transitions: chan<Transition> = channel(-1);
    val ch_models: chan<ModelWeights> = channel(-1);

    val dt = 0.02; // 20 milliseconds per control tick
    val total_steps = 110;

    // --------------------------------------------------------------------------
    // CONCURRENT BACKGROUND LEARNING WORKER THREAD
    // Continuously ingests streaming transitions, optimizes dynamics, and publishes
    // updated model weights without ever interrupting the real-time control loop.
    // --------------------------------------------------------------------------
    spawn {
        var learner_model = model_create_nominal();
        val replay_buffer: list<Transition> = list();
        var current_gen = 0;
        var worker_ticks = 0;

        while worker_ticks < 400 {
            // Non-blocking consumption of pending streaming transitions from the fast loop
            while chan_len(ch_transitions) > 0 {
                val t = recv(ch_transitions);
                buffer_push(replay_buffer, t, 35);
            };

            // If sufficient trajectory history is accumulated, run online gradient adaptation
            if list_len(replay_buffer) >= 10 {
                // Execute continuous gradient descent sub-epochs on current window
                learner_model = learner_train_step(replay_buffer, learner_model, 0.02, 0.08);
                learner_model = learner_train_step(replay_buffer, learner_model, 0.02, 0.08);

                // Publish candidate Generation 1 when significant drift is identified
                if current_gen == 0 && list_len(replay_buffer) >= 15 && learner_model.est_inertia > 1.6 {
                    current_gen = current_gen + 1;
                    val candidate = model_compute_gains(
                        learner_model.est_inertia,
                        learner_model.est_damping,
                        learner_model.est_bias,
                        current_gen,
                        learner_model.loss
                    );
                    send(ch_models, candidate);
                };

                // Publish Generation 2 as model parameters refine toward target
                if current_gen == 1 && learner_model.est_inertia > 2.2 {
                    current_gen = current_gen + 1;
                    val candidate = model_compute_gains(
                        learner_model.est_inertia,
                        learner_model.est_damping,
                        learner_model.est_bias,
                        current_gen,
                        learner_model.loss
                    );
                    send(ch_models, candidate);
                };
            };

            worker_ticks = worker_ticks + 1;
            sleep(2); // 2ms asynchronous learning cycle
        };
    };

    println("[BACKGROUND WORKER ACTIVE] Ready to ingest streaming state transitions.\n");
    println("================================================================================");
    println("       REAL-TIME OSCILLOSCOPE: TARGET [T] vs ACTUAL [*] (COINCIDENT: [@])       ");
    println("================================================================================");
    println("  Step | Trajectory Waveform Projection ([-1.6 .. +1.6] rad)    | Active Model");
    println("  -----+----------------------------------------------------+-----------------");

    var step = 0;
    var sq_err_phase1 = 0.0;
    var sq_err_phase2 = 0.0;
    var sq_err_phase3 = 0.0;
    var hot_swap_step = -1;
    var models_swapped = 0;
    var final_model = prior_model;

    // --------------------------------------------------------------------------
    // FAST FRONT-END REAL-TIME CONTROL LOOP (50 Hz)
    // Executes actuation, polls for background models, and streams transitions.
    // --------------------------------------------------------------------------
    while step < total_steps {
        val current_time = (step to f64) * dt;

        // Check if the background learner has published a new validated model (Non-blocking)
        if chan_len(ch_models) > 0 {
            val new_model = recv(ch_models);
            active_model = new_model;
            final_model = new_model;
            models_swapped = models_swapped + 1;
            if hot_swap_step < 0 {
                hot_swap_step = step;
            };
            val t_cur = round_to_decimals(current_time, 2);
            val j_cur = round_to_decimals(active_model.est_inertia, 2);
            val b_cur = round_to_decimals(active_model.est_damping, 2);
            val kp_cur = round_to_decimals(active_model.kp, 1);
            val kd_cur = round_to_decimals(active_model.kd, 1);
            println(f"\n  >>> [HOT-SWAP EVENT @ T={t_cur}s] Hot-swapped active controller to Gen-{active_model.gen} (J={j_cur}, b={b_cur}, Kp={kp_cur}, Kd={kd_cur}) <<<\n");
        };

        // Phase 2 Transition: Inject unexpected physical plant drift at Step 40
        if step == 40 {
            println("\n  !!! [HARDWARE ANOMALY @ Step 40] Unexpected plant drift: Inertia x2.8, Friction x3.6, Bias +0.85 Nm !!!\n");
            current_plant = plant_apply_drift(current_plant);
        };

        // 1. Compute control effort with current active model
        val (cmd, pos_err) = controller_compute(active_model, current_state, current_time);

        // 2. Integrate continuous physical plant forward by dt
        val (next_state, transition) = plant_step(current_plant, current_state, cmd.torque, dt);

        // 3. Stream transition to the background learning thread asynchronously
        send(ch_transitions, transition);

        // 4. Accumulate tracking error statistics by mission phase
        val sq_err = pos_err * pos_err;
        if step < 40 {
            sq_err_phase1 = sq_err_phase1 + sq_err;
        } else {
            if hot_swap_step < 0 || step < hot_swap_step {
                sq_err_phase2 = sq_err_phase2 + sq_err;
            } else {
                sq_err_phase3 = sq_err_phase3 + sq_err;
            }
        };

        // 5. Render real-time oscilloscope row periodically
        if step % 3 == 0 {
            val (ref_theta, ref_omega) = trajectory_target(current_time);
            val row_str = render_oscilloscope_row(current_time, ref_theta, current_state.theta, active_model.gen);
            val s_pad = if step < 10 { concat("00", to_str(step)) } else { if step < 100 { concat("0", to_str(step)) } else { to_str(step) } };
            println(f"  {s_pad} |{slice(row_str, 4, len(row_str))}");
        };

        // Advance state
        current_state = next_state;
        step = step + 1;
        sleep(2); // 2ms real-time loop pacing (simulating 50 Hz execution)
    }

    // Compute unadapted disturbed baseline (what would have occurred post-drift if never adapted)
    var shadow_state = plant_initial_state();
    var shadow_plant = plant_create_nominal();
    var s_step = 0;
    var shadow_sq_post_drift = 0.0;
    while s_step < total_steps {
        val t_s = (s_step to f64) * dt;
        if s_step == 40 {
            shadow_plant = plant_apply_drift(shadow_plant);
        };
        val (s_cmd, s_err) = controller_compute(prior_model, shadow_state, t_s);
        val (s_next, s_trans) = plant_step(shadow_plant, shadow_state, s_cmd.torque, dt);
        shadow_state = s_next;
        if s_step >= 40 {
            shadow_sq_post_drift = shadow_sq_post_drift + (s_err * s_err);
        };
        s_step = s_step + 1;
    };
    val baseline_disturbed_mse = shadow_sq_post_drift / ((total_steps - 40) to f64);

    // Compute phase metrics
    val n_p1 = 40.0;
    val n_p2 = if hot_swap_step > 40 { (hot_swap_step - 40) to f64 } else { 15.0 };
    val n_p3 = (total_steps - (if hot_swap_step > 0 { hot_swap_step } else { 55 })) to f64;

    val mse_p1 = sq_err_phase1 / n_p1;
    val mse_p2 = sq_err_phase2 / n_p2;
    val mse_p3 = sq_err_phase3 / n_p3;

    val recovery_pct = if baseline_disturbed_mse > 0.0001 {
        ((baseline_disturbed_mse - mse_p3) / baseline_disturbed_mse) * 100.0
    } else {
        0.0
    };

    val report = MissionReport {
        total_steps: total_steps,
        nominal_mse: mse_p1,
        drift_mse: baseline_disturbed_mse,
        adapted_mse: mse_p3,
        improvement_pct: recovery_pct,
        models_adapted: models_swapped,
        training_steps_run: 280,
    };

    println("\n");
    display_mission_debriefing(report, prior_model, final_model);

    // Assertions verifying continuous learning success
    if models_swapped < 1 {
        println("[ASSERTION FAILED] Background learner failed to publish adapted model!");
        return 1;
    };

    if recovery_pct <= 0.0 {
        println("[ASSERTION FAILED] Adapted MSE did not improve over unadapted disturbed tracking!");
        return 2;
    };

    if final_model.est_inertia <= 1.5 {
        println("[ASSERTION FAILED] Estimated inertia did not adapt upward toward physical drift!");
        return 3;
    };

    println("[VERIFICATION SUCCESS] Continuous Background Learning & In-Flight Model Hot-Swapping PASSED! (EXIT 0)\n");
    0
}
