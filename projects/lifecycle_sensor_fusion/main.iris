bring std.ros2
bring std.math
bring "fusion.iris" /// Requires ROS 2 and the IRIS ROS 2 bridge.

// A managed (rclcpp_lifecycle) node, /iris_fusion, fusing two range sensors
// into /fused/range. Two other parts of the program play the robot: a driver
// node publishes the sensors (/sensors/range_a, noisy; /sensors/range_b,
// precise with multipath spikes) and watches /fused/range.
//
// The lifecycle is the real one: configure reads the filter's parameters,
// activate starts publishing, deactivate stops it, cleanup drops the filter.
// By default the program walks the node through every transition itself and
// checks each phase; with IRIS_FUSION_EXTERNAL=1 it leaves the transitions to
// `ros2 lifecycle set /iris_fusion ...` and runs until shutdown.

def tuning_of(node: ROS2Node) -> Tuning {
    Tuning {
        process_noise: param_f64(node, "process_noise"),
        noise_a: param_f64(node, "noise_a"),
        noise_b: param_f64(node, "noise_b"),
        gate_sigma: param_f64(node, "gate_sigma")
    }
}

def publish_range(p: ROS2Publisher, frame: str, stamp_ns: i64, value: f64) -> bool {
    val m = publisher_msg(p)
    msg_set_str(m, "header.frame_id", frame);
    msg_set_stamp(m, "header.stamp", stamp_ns);
    msg_set_i64(m, "radiation_type", 0);
    msg_set_f64(m, "field_of_view", 0.3);
    msg_set_f64(m, "min_range", 0.2);
    msg_set_f64(m, "max_range", 6.0);
    msg_set_f64(m, "range", value);
    val sent = publish_msg(p, m)
    msg_free(m);
    sent
}

def seconds_since(start_ns: i64, t_ns: i64) -> f64 { ((t_ns - start_ns) to f64) / 1000000000.0 }

def main() -> i64 {
    val external = env_get("IRIS_FUSION_EXTERNAL") == "1"
    val ctx = context_create()
    assert(ctx.handle != 0);
    val driver = node_create(ctx, "iris_range_driver", "")
    val fusion = lifecycle_node_create(ctx, "iris_fusion", "")
    assert(driver.handle != 0 && fusion.handle != 0);
    param_declare_f64_range(fusion, "process_noise", 0.5, 0.001, 10.0, "white-acceleration noise (m^2/s^3)");
    param_declare_f64_range(fusion, "noise_a", 0.10, 0.001, 1.0, "sensor A standard deviation (m)");
    param_declare_f64_range(fusion, "noise_b", 0.03, 0.001, 1.0, "sensor B standard deviation (m)");
    param_declare_f64_range(fusion, "gate_sigma", 3.0, 1.0, 10.0, "innovation gate (standard deviations)");

    val in_a = subscription_create_qos(fusion, "/sensors/range_a", "sensor_msgs/msg/Range", qos_sensor_data())
    val in_b = subscription_create_qos(fusion, "/sensors/range_b", "sensor_msgs/msg/Range", qos_sensor_data())
    val fused_out = publisher_create(fusion, "/fused/range", "sensor_msgs/msg/Range")
    val out_a = publisher_create_qos(driver, "/sensors/range_a", "sensor_msgs/msg/Range", qos_sensor_data())
    val out_b = publisher_create_qos(driver, "/sensors/range_b", "sensor_msgs/msg/Range", qos_sensor_data())
    val monitor = subscription_create(driver, "/fused/range", "sensor_msgs/msg/Range")
    val tick = wall_timer_create(driver, 50)
    assert(in_a.handle != 0 && in_b.handle != 0 && fused_out.handle != 0 && monitor.handle != 0);

    val start = node_now_ns(driver)
    var rng = Rng { state: 20261018 }
    var tuning = tuning_of(fusion)
    var kf = kf_new(2.0)
    var configured = false
    var last_ns = start
    var ticks = 0
    var phase = 0
    var phase_ticks = 0
    var done = false

    // Per-phase evidence (0 unconfigured, 1 inactive, 2 active, 3 deactivated).
    var dropped_inactive = 0
    var received_active = 0
    var received_after_deactivate = 0
    var spikes = 0
    var rejected = 0
    var sq_raw_b = 0.0
    var sq_fused = 0.0
    var scored = 0
    var transitions = ""

    val deadline = start + 120000000000
    while !done && node_now_ns(driver) < deadline {
        val ev = spin_once(ctx, 100)

        // The simulated sensors.
        if is_timer(ev, tick) {
            val now = node_now_ns(driver)
            val d = truth(seconds_since(start, now))
            val ga = gaussian(rng)
            rng = ga.0
            val gb = gaussian(rng)
            rng = rng_next(gb.0)
            val spike = rng_unit(rng) < 0.05
            if spike && phase == 2 { spikes = spikes + 1 };
            publish_range(out_a, "range_a", now, d + 0.10 * ga.1);
            publish_range(out_b, "range_b", now, d + 0.03 * gb.1 + (if spike { 0.8 } else { 0.0 }));
            ticks = ticks + 1;
            phase_ticks = phase_ticks + 1
        };

        // The lifecycle node's work.
        if is_transition(ev, fusion) {
            transitions = transitions + event_text(ctx) + " ";
            if ev.id == ON_CONFIGURE {
                tuning = tuning_of(fusion);
                kf = kf_new(2.0);
                configured = true
            };
            if ev.id == ON_CLEANUP { configured = false };
            if ev.id == ON_SHUTDOWN && external { done = true };
        };
        if (is_message(ev, in_a) || is_message(ev, in_b)) && configured {
            val z = msg_f64(ev.message, "range")
            val stamp = msg_stamp(ev.message, "header.stamp")
            val from_b = is_message(ev, in_b)
            val sigma = if from_b { tuning.noise_b } else { tuning.noise_a }
            kf = kf_predict(kf, max(0.0, seconds_since(last_ns, stamp)), tuning.process_noise);
            last_ns = max(last_ns, stamp);
            if kf_plausible(kf, z, sigma, tuning.gate_sigma) {
                kf = kf_update(kf, z, sigma)
            } else {
                if phase == 2 { rejected = rejected + 1 };
            };
            // One fused reading per cycle, after the precise sensor.
            if from_b {
                val published = publish_range(fused_out, "fused", stamp, kf.d)
                if phase == 1 && !published { dropped_inactive = dropped_inactive + 1 };
                if phase == 2 && phase_ticks > 20 {
                    val d = truth(seconds_since(start, stamp))
                    sq_raw_b = sq_raw_b + (z - d) * (z - d);
                    sq_fused = sq_fused + (kf.d - d) * (kf.d - d);
                    scored = scored + 1
                };
            };
        };

        // The robot side watching the output.
        if is_message(ev, monitor) {
            if phase == 2 { received_active = received_active + 1 };
            if phase == 3 && phase_ticks > 5 { received_after_deactivate = received_after_deactivate + 1 };
        };

        // The self-test walks the node through its lifecycle.
        if !external && phase_ticks >= 40 {
            if phase == 0 {
                assert(lifecycle_configure(fusion) == LIFECYCLE_INACTIVE);
                phase = 1
            } else {
                if phase == 1 {
                    assert(lifecycle_activate(fusion) == LIFECYCLE_ACTIVE);
                    phase = 2
                } else {
                    if phase == 2 {
                        if phase_ticks >= 200 {
                            assert(lifecycle_deactivate(fusion) == LIFECYCLE_INACTIVE);
                            phase = 3
                        };
                    } else {
                        assert(lifecycle_cleanup(fusion) == LIFECYCLE_UNCONFIGURED);
                        assert(lifecycle_shutdown(fusion) == LIFECYCLE_FINALIZED);
                        done = true
                    };
                };
            };
            if phase_ticks >= 40 && (phase != 2 || phase_ticks >= 200) { phase_ticks = 0 };
        };
        if external {
            // Follow whatever ros2 lifecycle did.
            val state = lifecycle_state(fusion)
            phase = if state == LIFECYCLE_ACTIVE { 2 } else { if state == LIFECYCLE_INACTIVE { 1 } else { 0 } }
        };
    };
    assert(done);
    // The last transitions ran in the final iteration; their events are queued.
    var drained = 0
    while drained < 50 {
        val ev = spin_once(ctx, 0)
        if is_transition(ev, fusion) { transitions = transitions + event_text(ctx) + " " };
        drained = drained + 1
    };
    println("transitions: " + transitions);
    if !external {
        val rms_raw_b = sqrt(sq_raw_b / (scored to f64))
        val rms_fused = sqrt(sq_fused / (scored to f64))
        println("active: " + to_str(received_active) + " fused readings received, rms " + to_str(rms_fused) + " vs " + to_str(rms_raw_b) + " raw");
        println("spikes: " + to_str(spikes) + " injected, " + to_str(rejected) + " readings rejected");
        assert(dropped_inactive > 0);
        assert(received_active > 150);
        assert(received_after_deactivate == 0);
        assert(scored > 100 && rms_fused < rms_raw_b && rms_fused < 0.05);
        assert(rejected >= spikes);
        assert(contains(transitions, "configure") && contains(transitions, "activate") && contains(transitions, "deactivate") && contains(transitions, "cleanup") && contains(transitions, "shutdown"));
    };
    assert(context_destroy(ctx));
    println("lifecycle sensor fusion: every phase checked");
    return 0
}
