bring std.math
bring "fusion.iris" /// The fusion filter on simulated sensors, offline.

// The same sensors and filter as main.iris, without ROS 2: sensor A is noisy
// (0.10 m), sensor B is precise (0.03 m) but 5% of its readings are 0.8 m
// multipath spikes. The fused estimate must beat both, and the gate must catch
// the spikes.
def main() -> i64 {
    val tuning = Tuning { process_noise: 0.5, noise_a: 0.10, noise_b: 0.03, gate_sigma: 3.0 }
    val dt = 0.05
    var rng = Rng { state: 20261018 }
    var kf = kf_new(2.0)
    var sq_a = 0.0
    var sq_b = 0.0
    var sq_fused = 0.0
    var counted = 0
    var spikes = 0
    var spikes_caught = 0
    var good_rejected = 0
    for step in 1..601 {
        val t = (step to f64) * dt
        val d = truth(t)
        val ga = gaussian(rng)
        rng = ga.0
        val gb = gaussian(rng)
        rng = gb.0
        rng = rng_next(rng)
        val spike = rng_unit(rng) < 0.05
        val za = d + tuning.noise_a * ga.1
        val zb = d + tuning.noise_b * gb.1 + (if spike { 0.8 } else { 0.0 })

        kf = kf_predict(kf, dt, tuning.process_noise)
        if kf_plausible(kf, za, tuning.noise_a, tuning.gate_sigma) {
            kf = kf_update(kf, za, tuning.noise_a)
        };
        val b_ok = kf_plausible(kf, zb, tuning.noise_b, tuning.gate_sigma)
        if b_ok { kf = kf_update(kf, zb, tuning.noise_b) };
        if spike {
            spikes = spikes + 1;
            if !b_ok { spikes_caught = spikes_caught + 1 };
        } else {
            if !b_ok { good_rejected = good_rejected + 1 };
        };

        // Score after a one-second warm-up.
        if step > 20 {
            sq_a = sq_a + (za - d) * (za - d);
            sq_b = sq_b + (zb - d) * (zb - d);
            sq_fused = sq_fused + (kf.d - d) * (kf.d - d);
            counted = counted + 1
        };
    };
    val n = counted to f64
    val rms_a = sqrt(sq_a / n)
    val rms_b = sqrt(sq_b / n)
    val rms_fused = sqrt(sq_fused / n)
    println("rms error: sensor a " + to_str(rms_a) + ", sensor b " + to_str(rms_b) + ", fused " + to_str(rms_fused));
    println("spikes: " + to_str(spikes) + " injected, " + to_str(spikes_caught) + " rejected; good readings rejected: " + to_str(good_rejected));
    assert(spikes > 10);
    assert(spikes_caught == spikes);
    assert(good_rejected < 15);
    assert(rms_fused < rms_a && rms_fused < rms_b);
    assert(rms_fused < 0.03);
    println("lifecycle sensor fusion: simulated sensors fused");
    return 0
}
