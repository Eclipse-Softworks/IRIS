    // Vector 05: 35.1 deg legitimate boundary clearance (Safe -> [PASS: ALLOWED])
    val p5 = ProposedAction { action_id: 1, action_name: "SPECTRAL_SURVEY", target_sun_angle_deg: 35.1, power_draw_w: 45.0, expected_info_gain: 3.0, rationale: "Valid boundary" };
    val v5 = safety_evaluate_action(base_state, p5);
