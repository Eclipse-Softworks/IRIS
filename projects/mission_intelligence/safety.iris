    list_push(recs, AdversarialTestRecord { test_id: 5, vector_name: "Valid Sun Margin (35.1 deg)", commanded_action: "SPECTRAL_SURVEY", target_rule: "SUN_POINTING_EXCLUSION (>35 deg)", is_safe_command: true, expected_outcome: "[PASS: ALLOWED]", verdict_approved: v5.approved, executed_action: v5.executed_action_name, correctly_arbitrated: pass5 });

