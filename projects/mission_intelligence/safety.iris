// projects/mission_intelligence/safety.iris
// Independent, separately verified hard safety governor with 25-vector adversarial verification suite.

bring "types.iris"

/// Independent safety governor: evaluates proposed actions against hard physical constraints
pub def safety_evaluate_action(
    state: SpacecraftState,
    proposed: ProposedAction
) -> SafetyVerdict {
    // FAIL-CLOSED INTEGRITY CHECK: Corrupted, negative, or unphysical telemetry
    if state.battery_pct < 0.0 || state.battery_pct > 105.0 || state.temp_celsius < -50.0 || state.temp_celsius > 100.0 || state.altitude_km < 0.0 {
        return SafetyVerdict {
            approved: false,
            violated_rule: "TELEMETRY_CORRUPTION_FAIL_CLOSED",
            executed_action_name: "IDLE_MONITOR",
            mitigation_reason: "Fail-Closed Protection: Telemetry out-of-physical-range. Clamped to safe idle hold.",
        };
    };

    // GATE 1: Solar Pointing Exclusion (Optical Sensor Burnout Protection)
    // Delicate multi-spectral focal plane arrays must never point within 35 degrees of the Sun vector.
    if proposed.action_name == "SPECTRAL_SURVEY" && proposed.target_sun_angle_deg <= 35.0 {
        return SafetyVerdict {
            approved: false,
            violated_rule: "SUN_POINTING_EXCLUSION",
            executed_action_name: "SUN_SAFE_SLEW",
            mitigation_reason: "Hard Gate 1 Violation: Proposal commanded sun angle <= 35.0 deg boundary. Forced safe slew to protect focal plane arrays.",
        };
    };

    // GATE 2: Battery Reserve Protection & Bus Overcurrent Limit
    // Spacecraft bus peak power draw must not exceed 75W to prevent electrical bus brownout
    if proposed.power_draw_w > 75.0 {
        return SafetyVerdict {
            approved: false,
            violated_rule: "BUS_OVERCURRENT_VIOLATION",
            executed_action_name: "IDLE_MONITOR",
            mitigation_reason: "Hard Gate 2 Violation: Commanded power draw exceeds 75W peak electrical bus ceiling. Clamped to safe idle hold.",
        };
    };

    // Payload operations must not deplete energy storage below 30% survival floor (gated at 32.0% for high loads)
    if state.battery_pct < 32.0 && proposed.power_draw_w > 20.0 {
        return SafetyVerdict {
            approved: false,
            violated_rule: "BATTERY_RESERVE_VIOLATION",
            executed_action_name: "IDLE_MONITOR",
            mitigation_reason: "Hard Gate 2 Violation: Battery SoC near 30% reserve threshold. Clamped high-draw payload to prevent bus undervoltage.",
        };
    };

    // GATE 3: Thermal Excursion Protection (Component Overheating)
    // Spacecraft bus temperature must not exceed +52 C. High-power instruments must be shed.
    if state.temp_celsius >= 52.0 && proposed.power_draw_w > 20.0 {
        return SafetyVerdict {
            approved: false,
            violated_rule: "THERMAL_EXCURSION",
            executed_action_name: "THERMAL_RADIATOR_PURGE",
            mitigation_reason: "Hard Gate 3 Violation: Bus temperature reached or exceeded +52.0 C. Payload shed and radiator cold face oriented to deep space.",
        };
    };

    // GATE 4: Reaction Wheel Momentum Saturation
    // Angular momentum must not exceed 11.0 N*m*s to prevent loss of attitude control authority.
    if state.wheel_momentum_nms >= 11.0 && proposed.action_name != "MOMENTUM_DESATURATION" {
        return SafetyVerdict {
            approved: false,
            violated_rule: "MOMENTUM_SATURATION",
            executed_action_name: "MOMENTUM_DESATURATION",
            mitigation_reason: "Hard Gate 4 Violation: Reaction wheel momentum reached saturation threshold. Mandatory cold-gas desaturation fire.",
        };
    };

    // All gates cleared: autonomous exploratory action approved
    SafetyVerdict {
        approved: true,
        violated_rule: "NONE",
        executed_action_name: proposed.action_name,
        mitigation_reason: "Cleared all independent hard safety gates: Sun-exclusion, Battery SoC, Bus power, Thermal, Momentum.",
    }
}

/// Adversarial verification test suite: 25 comprehensive boundary, corrupted, and multi-fault vectors
pub def safety_run_adversarial_suite() -> AdversarialSafetyResult {
    val base_state = SpacecraftState {
        time_s: 1000.0,
        altitude_km: 250.0,
        radius_km: 1810.0,
        true_anomaly_rad: 1.0,
        velocity_kms: 1.4,
        specific_energy: -0.86,
        specific_momentum: 2417.0,
        battery_pct: 90.0,
        temp_celsius: 22.0,
        wheel_momentum_nms: 3.0,
        solar_flux_wm2: 1361.0,
        is_eclipse: false,
        sensor_sun_angle_deg: 75.0,
        accumulated_radiation_krad: 0.0416,
        vault_radiation_krad: 0.00116,
    };

    var attacks_tested = 0;
    var unsafe_rejected = 0;
    var safe_approved = 0;
    var unsafe_approved = 0;
    var safe_rejected = 0;
    val recs: list<AdversarialTestRecord> = list();

    // CATEGORY A: SOLAR BORESIGHT BOUNDARY & EXCLUSION VECTORS
    // Vector 01: Direct 0.0 deg Sun stare (Unsafe -> [PASS: BLOCKED])
    val p1 = ProposedAction { action_id: 1, action_name: "SPECTRAL_SURVEY", target_sun_angle_deg: 0.0, power_draw_w: 45.0, expected_info_gain: 5.0, rationale: "Attacking boresight" };
    val v1 = safety_evaluate_action(base_state, p1);
    attacks_tested = attacks_tested + 1;
    val pass1 = !v1.approved && v1.executed_action_name == "SUN_SAFE_SLEW";
    if pass1 { unsafe_rejected = unsafe_rejected + 1; } else { unsafe_approved = unsafe_approved + 1; };
    list_push(recs, AdversarialTestRecord { test_id: 1, vector_name: "Direct Solar Stare (0.0 deg)", commanded_action: "SPECTRAL_SURVEY", target_rule: "SUN_POINTING_EXCLUSION (>35 deg)", is_safe_command: false, expected_outcome: "[PASS: BLOCKED]", verdict_approved: v1.approved, executed_action: v1.executed_action_name, correctly_arbitrated: pass1 });

    // Vector 02: Narrow 24.0 deg Sun vector (Unsafe -> [PASS: BLOCKED])
    val p2 = ProposedAction { action_id: 1, action_name: "SPECTRAL_SURVEY", target_sun_angle_deg: 24.0, power_draw_w: 45.0, expected_info_gain: 4.0, rationale: "Attacking boresight" };
    val v2 = safety_evaluate_action(base_state, p2);
    attacks_tested = attacks_tested + 1;
    val pass2 = !v2.approved && v2.executed_action_name == "SUN_SAFE_SLEW";
    if pass2 { unsafe_rejected = unsafe_rejected + 1; } else { unsafe_approved = unsafe_approved + 1; };
    list_push(recs, AdversarialTestRecord { test_id: 2, vector_name: "Narrow Solar Angle (24.0 deg)", commanded_action: "SPECTRAL_SURVEY", target_rule: "SUN_POINTING_EXCLUSION (>35 deg)", is_safe_command: false, expected_outcome: "[PASS: BLOCKED]", verdict_approved: v2.approved, executed_action: v2.executed_action_name, correctly_arbitrated: pass2 });

    // Vector 03: 34.9 deg boundary attack (Unsafe -> [PASS: BLOCKED])
    val p3 = ProposedAction { action_id: 1, action_name: "SPECTRAL_SURVEY", target_sun_angle_deg: 34.9, power_draw_w: 45.0, expected_info_gain: 3.0, rationale: "Boundary attack" };
    val v3 = safety_evaluate_action(base_state, p3);
    attacks_tested = attacks_tested + 1;
    val pass3 = !v3.approved && v3.executed_action_name == "SUN_SAFE_SLEW";
    if pass3 { unsafe_rejected = unsafe_rejected + 1; } else { unsafe_approved = unsafe_approved + 1; };
    list_push(recs, AdversarialTestRecord { test_id: 3, vector_name: "Sub-Threshold Margin (34.9 deg)", commanded_action: "SPECTRAL_SURVEY", target_rule: "SUN_POINTING_EXCLUSION (>35 deg)", is_safe_command: false, expected_outcome: "[PASS: BLOCKED]", verdict_approved: v3.approved, executed_action: v3.executed_action_name, correctly_arbitrated: pass3 });

    // Vector 04: Exact 35.0 deg boundary point (Unsafe -> [PASS: BLOCKED])
    val p4 = ProposedAction { action_id: 1, action_name: "SPECTRAL_SURVEY", target_sun_angle_deg: 35.0, power_draw_w: 45.0, expected_info_gain: 3.0, rationale: "Exact boundary" };
    val v4 = safety_evaluate_action(base_state, p4);
    attacks_tested = attacks_tested + 1;
    val pass4 = !v4.approved && v4.executed_action_name == "SUN_SAFE_SLEW";
    if pass4 { unsafe_rejected = unsafe_rejected + 1; } else { unsafe_approved = unsafe_approved + 1; };
