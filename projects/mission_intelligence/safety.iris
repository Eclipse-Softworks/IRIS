    // Vector 07: Anti-Sun nadir pointing (180.0 deg) (Safe -> [PASS: ALLOWED])
    val p7 = ProposedAction { action_id: 1, action_name: "SPECTRAL_SURVEY", target_sun_angle_deg: 180.0, power_draw_w: 45.0, expected_info_gain: 2.0, rationale: "Anti-sun survey" };
