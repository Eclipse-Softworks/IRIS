    val s18 = SpacecraftState { time_s: 1000.0, altitude_km: 250.0, radius_km: 1810.0, true_anomaly_rad: 1.0, velocity_kms: 1.4, specific_energy: -0.86, specific_momentum: 2417.0, battery_pct: 90.0, temp_celsius: 22.0, wheel_momentum_nms: 13.5, solar_flux_wm2: 1361.0, is_eclipse: false, sensor_sun_angle_deg: 75.0, accumulated_radiation_krad: 0.0416, vault_radiation_krad: 0.00116 };
    val v18 = safety_evaluate_action(s18, p8);
