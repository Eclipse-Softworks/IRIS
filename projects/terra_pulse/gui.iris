/// Kind discriminator for asynchronous worker messages sent to the desktop UI loop.
pub choice WorkerReplyKind {
    LiveSnapshot,
    ProbedWeather,
    BundleExported,
    WorkerError,
}

/// Typed asynchronous response envelope sent from background worker to the UI thread.
pub record WorkerReply {
    kind: WorkerReplyKind = WorkerReplyKind.WorkerError,
    snap: ObservatorySnapshot,
    delta: HistoryDelta,
    runs: list<StoredRunSummary>,
    weather: SurfaceWeather,
    stage1_ms: i64 = 0,
    stage2_ms: i64 = 0,
    note: str = "",
}

def make_worker_reply_base(kind: WorkerReplyKind, note: str) -> WorkerReply effect alloc {
    val empty_runs: list<StoredRunSummary> = list()
    return WorkerReply {
        kind: kind,
        snap: empty_observatory_snapshot(),
        delta: HistoryDelta {
            prior_runs: 0,
            stored_events_total: 0,
            new_events_count: 0,
            has_previous: false,
            prev_kp: 0.0,
            prev_gr_b: 1.0,
            prev_max_mag: 0.0,
        },
        runs: empty_runs,
        weather: SurfaceWeather {
            label: "",
            lat: 0.0,
            lon: 0.0,
            temp_c: 0.0,
            pressure_hpa: 0.0,
            wind_kmh: 0.0,
        },
        note: note,
    }
}

record WorkerRuntimeCfg {
    feed_slug: str,
    db_path: str,
    svg_path: str,
    json_path: str,
    enable_db: bool,
    auto_sync: bool,
}

record GuiEventPick {
    ui_st: UiState,
    pick_id: str,
    hover_id: str,
    hover_lon: f64,
    hover_lat: f64,
    in_map: bool,
    wheel_steps: f64,
}

record DesktopGuiEnv {
    lib: NativeUiLib,
    tick_ch: chan<WorkerReply>,
    cmd_ch: chan<GuiWorkerCmd>,
    stop_ch: chan<i64>,
}

record DesktopGuiCtx {
    app: TelemetryGuiState,
    ui_st: UiState,
    buf: DrawBuffer,
    last_w: f64 = -1.0,
    last_h: f64 = -1.0,
    rendered: bool = false,
    running: bool = true,
}

def build_header_bar(tree: UiTree, st: TelemetryGuiState) -> i64 effect alloc {
    val a = st.snap.analytics
    val sync_txt = if st.loading {
        "SYNCING..."
    } else if st.tick > 0 {
        f"POLL #{st.tick}"
    } else {
        "INIT"
    }
    val run_txt = f"STORED {st.delta.stored_events_total} (+{st.delta.new_events_count})"
    val kids = list(
        tp_section_title(tree, "hdr_brand", "TERRA PULSE  |  Planetary Telemetry Console"),
        ui_badge(
            tree,
            "hdr_alert",
            alert_severity_label(a.overall_alert),
            tp_alert_tone(a.overall_alert),
        ),
        ui_badge(tree, "hdr_feed", st.feed_slug, UiTone.Neutral),
        ui_badge(tree, "hdr_sync", sync_txt, UiTone.Neutral),
        ui_badge(tree, "hdr_db", run_txt, UiTone.Neutral),
        ui_spacer(tree, 1.0, 10.0, 4.0),
        ui_toggle(tree, "tog_auto_sync", "Auto Sync", st.auto_sync, UiTone.Secondary),
        tp_button(tree, "btn_export", "Export SVG/JSON", "act_export_bundle", false),
        tp_cta_button(
            tree,
            "btn_refresh",
            if st.loading { "Syncing..." } else { "Refresh Live" },
            "act_refresh_now",
        ),
    )
    val row = ui_row(tree, "hdr_row", UiStyle { gap: 8.0, align: UiAlign.Center }, kids)
    return ui_card(
        tree,
        "hdr_card",
        UiStyle {
            bg: tree.theme.panel,
            border: tree.theme.border,
            border_width: 1.0,
            padding: 9.0,
            min_h: 52.0,
        },
        list(row),
    )
}

def build_kpi_ribbon(tree: UiTree, st: TelemetryGuiState) -> i64 effect alloc {
    val a = st.snap.analytics
    val iss = st.snap.iss
    val top_place = if list_len(st.snap.events) > 0 && a.strongest_idx < list_len(st.snap.events) {
        tp_fit_width(list_get(st.snap.events, a.strongest_idx).place, 24)
    } else {
        "Awaiting USGS feed"
    }
    val k1 = tp_kpi_card(
        tree,
        "kpi_mag",
        "PEAK SEISMIC",
        if a.total_quakes > 0 { f"M {format_fixed_2(a.max_magnitude)}" } else { "--" },
        f"{a.total_quakes} events ({a.shallow_count}S/{a.intermediate_count}M/{a.deep_count}D)",
    )
    val k2 = tp_kpi_card(
        tree,
        "kpi_energy",
        "RADIATED ENERGY",
        if a.total_quakes > 0 { f"{format_fixed_2(a.total_energy_log10_j)} log10 J" } else { "--" },
        top_place,
    )
    val k3 = tp_kpi_card(
        tree,
        "kpi_kp",
        "GEOMAGNETIC KP / AD",
        f"Kp {format_fixed_2(a.kp_latest)}  (Max {format_fixed_1(a.kp_peak)})",
        f"GR b={format_fixed_2(a.gr_fit.b_value)}  R^2={format_fixed_2(a.gr_fit.r2_score)}",
    )
    val k4 = tp_kpi_card(
        tree,
        "kpi_iss",
        "ISS EPHEMERIS",
        if iss.timestamp_s > 0 { f"{format_fixed_1(iss.altitude_km)} km" } else { "--" },
        if iss.timestamp_s > 0 {
            f"{iss.visibility} | Near {format_fixed_0(a.closest_iss_km)} km"
        } else {
            "Awaiting orbital vector"
        },
    )
    return ui_row(tree, "kpi_row", UiStyle { gap: 8.0, min_h: 72.0 }, list(k1, k2, k3, k4))
}

def build_viewport_toolbar(tree: UiTree, st: TelemetryGuiState) -> i64 effect alloc {
    val views = list(
        tp_button(
            tree,
            "tab_map",
            "Global Map",
            "act_view_map",
            workspace_view_eq(st.active_view, WorkspaceView.GlobalMap),
        ),
        tp_button(
            tree,
            "tab_ad",
            "AD Regression",
            "act_view_ad",
            workspace_view_eq(st.active_view, WorkspaceView.AdFitView),
        ),
        tp_button(
            tree,
            "tab_kp",
            "Kp & Archive",
            "act_view_kp",
            workspace_view_eq(st.active_view, WorkspaceView.GeomagneticView),
        ),
        tp_button(
            tree,
            "tab_wx",
            "Atmosphere",
            "act_view_wx",
            workspace_view_eq(st.active_view, WorkspaceView.AtmosphericView),
        ),
        ui_spacer(tree, 1.0, 8.0, 4.0),
        tp_button(tree, "btn_zout", "-", "act_zoom_out", false),
        tp_button(tree, "btn_zrst", "Reset", "act_map_reset", false),
        tp_button(tree, "btn_zin", "+", "act_zoom_in", false),
        tp_button(tree, "btn_f_iss", "ISS", "act_focus_iss", false),
        tp_button(tree, "btn_f_eq", "Focus EQ", "act_focus_eq", false),
    )
    return ui_row(tree, "vp_toolbar", UiStyle { gap: 6.0, align: UiAlign.Center }, views)
}

def build_layer_toggles_row(tree: UiTree, st: TelemetryGuiState) -> i64 effect alloc {
    val m = st.map
    val cursor_txt = if st.hover_in_map {
        f"Cursor ({format_fixed_2(st.hover_lat)}, {format_fixed_2(st.hover_lon)})"
    } else {
        f"View Center ({format_fixed_1(m.center_lat)}, {format_fixed_1(m.center_lon)})"
    }
    val kids = list(
        ui_toggle(tree, "tog_arcs", "Arcs", m.show_arcs, UiTone.Secondary),
        ui_toggle(tree, "tog_footprint", "ISS Ring", m.show_footprint, UiTone.Secondary),
        ui_toggle(tree, "tog_wx", "Weather", m.show_weather, UiTone.Secondary),
        ui_toggle(tree, "tog_labels", "Labels", m.show_labels, UiTone.Secondary),
        ui_spacer(tree, 1.0, 6.0, 4.0),
        tp_muted_text(tree, "vp_cursor_lbl", cursor_txt),
    )
    return ui_row(tree, "vp_layers_row", UiStyle { gap: 10.0, align: UiAlign.Center }, kids)
}

def build_viewport_card(tree: UiTree, st: TelemetryGuiState) -> i64 effect alloc {
    val bar = build_viewport_toolbar(tree, st)
    val layers = build_layer_toggles_row(tree, st)
    val empty_kids: list<i64> = list()
    val canvas_slot = ui_card(
        tree,
        "map_viewport",
        UiStyle {
            bg: rgb(14, 18, 25),
            border: tree.theme.border,
            border_width: 1.0,
            padding: 2.0,
            flex: 1.0,
            min_h: 320.0,
        },
        empty_kids,
    )
    val latency_txt = if st.tick > 0 {
        f"S1 {st.last_stage1_ms}ms  S2 {st.last_stage2_ms}ms  |  {st.status_note}"
    } else {
        st.status_note
    }
    val footer = tp_muted_text(tree, "vp_status_footer", tp_fit_width(latency_txt, 92))
    return ui_card(
        tree,
        "vp_outer_card",
        UiStyle {
            bg: tree.theme.panel,
            border: tree.theme.border,
            border_width: 1.0,
            padding: 10.0,
            gap: 8.0,
            flex: 1.0,
        },
        list(bar, layers, canvas_slot, footer),
    )
}

