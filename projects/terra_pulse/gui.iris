    val depths = build_depth_buttons_row(tree, st.depth_filter)
    val slider = ui_slider_range(
        tree,
        "sldr_min_mag",
        f"Minimum Magnitude Filter (M >= {format_fixed_1(st.min_mag)})",
        st.min_mag,
        UiSize { w: 0.0, h: 7.0 },
