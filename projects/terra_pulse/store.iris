bring std.sql
bring std.time
bring "domain.iris"

/// Longitudinal comparison metrics between the current live ingestion run
/// and prior observations persisted in SQLite.
pub record HistoryDelta {
    prior_runs: i64,
    stored_events_total: i64,
    new_events_count: i64,
    has_previous: bool,
    prev_kp: f64,
    prev_gr_b: f64,
    prev_max_mag: f64,
}

/// Summary row retrieved from the SQLite `runs` table.
pub record StoredRunSummary {
    run_id: i64,
    fetched_at_ms: i64,
    quake_count: i64,
    max_mag: f64,
    kp_latest: f64,
    gr_b: f64,
    alert_tier: str,
}

/// Create idempotent SQLite schema tables and indexes.
pub def ensure_schema(db: i64) -> result<i64, TelemetryError> effect ffi, alloc {
    val ddl_runs = "CREATE TABLE IF NOT EXISTS runs (id INTEGER PRIMARY KEY AUTOINCREMENT, fetched_at_ms INTEGER, quake_count INTEGER, max_mag REAL, kp_latest REAL, iss_lat REAL, iss_lon REAL, gr_a REAL, gr_b REAL, gr_r2 REAL, alert_tier TEXT);"
    val ddl_eq = "CREATE TABLE IF NOT EXISTS seismic_events (event_id TEXT PRIMARY KEY, first_seen_ms INTEGER, last_seen_ms INTEGER, time_utc TEXT, lat REAL, lon REAL, depth_km REAL, mag REAL, place TEXT);"
    val ddl_kp = "CREATE TABLE IF NOT EXISTS kp_history (time_tag TEXT PRIMARY KEY, kp_index REAL, a_running REAL, station_count INTEGER);"
    val ddl_wx = "CREATE TABLE IF NOT EXISTS weather_samples (id INTEGER PRIMARY KEY AUTOINCREMENT, run_ms INTEGER, label TEXT, lat REAL, lon REAL, temp_c REAL, pressure_hpa REAL, wind_kmh REAL);"

    if db_exec(db, ddl_runs) < 0 {
        return err(TelemetryError.Storage("failed creating runs table"))
    }
    if db_exec(db, ddl_eq) < 0 {
        return err(TelemetryError.Storage("failed creating seismic_events table"))
    }
    if db_exec(db, ddl_kp) < 0 {
        return err(TelemetryError.Storage("failed creating kp_history table"))
    }
    if db_exec(db, ddl_wx) < 0 {
        return err(TelemetryError.Storage("failed creating weather_samples table"))
    }
    return ok(0)
}

record BaselineMetrics {
    prior_runs: i64,
    has_previous: bool,
    prev_kp: f64,
    prev_gr_b: f64,
    prev_max_mag: f64,
}

def read_previous_baseline(
    db: i64,
    analytics: RunAnalytics,
) -> BaselineMetrics effect ffi, io, alloc {
    val prev_rows = db_query(
        db,
        "SELECT kp_latest, gr_b, max_mag FROM runs ORDER BY id DESC LIMIT 1;",
    )
    val cnt_rows = db_query(db, "SELECT COUNT(*) FROM runs;")
    val prior_runs = if list_len(cnt_rows) > 0 && list_len(list_get(cnt_rows, 0)) > 0 {
        parse_i64(list_get(list_get(cnt_rows, 0), 0)) ?? 0
    } else {
        0
    }
    var has_prev = false
    var prev_kp = analytics.kp_latest
    var prev_gr_b = analytics.gr_fit.b_value
    var prev_max_mag = analytics.max_magnitude
    if list_len(prev_rows) > 0 {
        val r0 = list_get(prev_rows, 0)
        if list_len(r0) >= 3 {
            has_prev = true
            prev_kp = parse_f64(list_get(r0, 0)) ?? analytics.kp_latest
            prev_gr_b = parse_f64(list_get(r0, 1)) ?? analytics.gr_fit.b_value
            prev_max_mag = parse_f64(list_get(r0, 2)) ?? analytics.max_magnitude
        }
    }
    return BaselineMetrics {
        prior_runs: prior_runs,
        has_previous: has_prev,
        prev_kp: prev_kp,
        prev_gr_b: prev_gr_b,
        prev_max_mag: prev_max_mag,
    }
}

def upsert_seismic_events(
    db: i64,
    now_s: str,
    events: list<SeismicEvent>,
) -> i64 effect ffi, io, alloc {
    var new_events = 0
    for i in 0..list_len(events) {
        val ev = list_get(events, i)
        val check_p: list<str> = list(ev.event_id)
        val existing = db_query_params(
            db,
            "SELECT first_seen_ms FROM seismic_events WHERE event_id = ? LIMIT 1;",
            check_p,
        )
        var first_seen = now_s
        if list_len(existing) == 0 {
            new_events = new_events + 1
        } else if list_len(list_get(existing, 0)) > 0 {
            first_seen = list_get(list_get(existing, 0), 0)
        }
        val up_eq: list<
            str
        > = list(
            ev.event_id,
            first_seen,
            now_s,
            ev.time_utc,
            to_str(ev.coord.lat_deg),
            to_str(ev.coord.lon_deg),
            to_str(ev.coord.depth_km),
            to_str(ev.magnitude),
            ev.place,
        )
        val _ = db_exec_params(
            db,
            "INSERT OR REPLACE INTO seismic_events(event_id, first_seen_ms, last_seen_ms, time_utc, lat, lon, depth_km, mag, place) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);",
            up_eq,
        )
    }
    return new_events
}

def upsert_kp_samples(db: i64, kps: list<GeomagneticSample>) -> i64 effect ffi, io, alloc {
    for i in 0..list_len(kps) {
        val sample = list_get(kps, i)
        val up_kp: list<
            str
        > = list(
            sample.time_tag,
            to_str(sample.kp_index),
            to_str(sample.a_running),
            to_str(sample.station_count),
        )
        val _ = db_exec_params(
            db,
            "INSERT OR REPLACE INTO kp_history(time_tag, kp_index, a_running, station_count) VALUES (?, ?, ?, ?);",
            up_kp,
        )
    }
    return 0
}

def insert_weather_samples(
    db: i64,
    now_s: str,
    weather: list<SurfaceWeather>,
) -> i64 effect ffi, io, alloc {
    for i in 0..list_len(weather) {
        val wx = list_get(weather, i)
        val ins_wx: list<
            str
        > = list(
            now_s,
            wx.label,
            to_str(wx.lat),
            to_str(wx.lon),
            to_str(wx.temp_c),
            to_str(wx.pressure_hpa),
            to_str(wx.wind_kmh),
        )
        val _ = db_exec_params(
            db,
            "INSERT INTO weather_samples(run_ms, label, lat, lon, temp_c, pressure_hpa, wind_kmh) VALUES (?, ?, ?, ?, ?, ?, ?);",
            ins_wx,
        )
    }
    return 0
}

def insert_run_summary_row(
    db: i64,
    now_s: str,
    iss: OrbitalState,
    analytics: RunAnalytics,
) -> i64 effect ffi, io, alloc {
    val ins_run: list<
        str
    > = list(
        now_s,
        to_str(analytics.total_quakes),
        to_str(analytics.max_magnitude),
        to_str(analytics.kp_latest),
        to_str(iss.latitude),
        to_str(iss.longitude),
        to_str(analytics.gr_fit.a_value),
        to_str(analytics.gr_fit.b_value),
        to_str(analytics.gr_fit.r2_score),
        alert_severity_label(analytics.overall_alert),
    )
    val _ = db_exec_params(
        db,
        "INSERT INTO runs(fetched_at_ms, quake_count, max_mag, kp_latest, iss_lat, iss_lon, gr_a, gr_b, gr_r2, alert_tier) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);",
        ins_run,
    )
    return 0
}

/// Persist live ingestion data into an already-open SQLite handle and compute deltas
/// against previously recorded state.
pub def persist_on_handle(
    db: i64,
    now_ms_val: i64,
    snap: ObservatorySnapshot,
) -> result<HistoryDelta, TelemetryError> effect ffi, io, alloc {
    ensure_schema(db)?
    val baseline = read_previous_baseline(db, snap.analytics)
    val now_s = to_str(now_ms_val)

    val _ = db_exec(db, "BEGIN TRANSACTION;")
    val new_events = upsert_seismic_events(db, now_s, snap.events)
    val _ = upsert_kp_samples(db, snap.kps)
    val _ = insert_weather_samples(db, now_s, snap.weather)
    val _ = insert_run_summary_row(db, now_s, snap.iss, snap.analytics)
    val _ = db_exec(db, "COMMIT;")

    val total_rows = db_query(db, "SELECT COUNT(*) FROM seismic_events;")
    val stored_total = if list_len(total_rows) > 0 && list_len(list_get(total_rows, 0)) > 0 {
        parse_i64(list_get(list_get(total_rows, 0), 0)) ?? new_events
    } else {
        new_events
    }
    return ok(
        HistoryDelta {
            prior_runs: baseline.prior_runs,
            stored_events_total: stored_total,
            new_events_count: new_events,
            has_previous: baseline.has_previous,
            prev_kp: baseline.prev_kp,
            prev_gr_b: baseline.prev_gr_b,
            prev_max_mag: baseline.prev_max_mag,
        },
    )
}

/// Open SQLite database at `db_path`, persist live telemetry safely (`defer db_close`),
/// and return longitudinal deltas.
pub def persist_observatory_run(
    db_path: str,
    snap: ObservatorySnapshot,
) -> result<HistoryDelta, TelemetryError> effect ffi, io, alloc, time {
    val db = db_open(db_path)
    if db == 0 {
        return err(TelemetryError.Storage(concat("failed to open SQLite database at ", db_path)))
    }
    defer {
        val _ = db_close(db)
    }
    return persist_on_handle(db, now_ms(), snap)
}

/// Fetch recent persisted run summaries from `db_path` ordered newest first.
pub def fetch_recent_runs(
    db_path: str,
    limit: i64,
) -> result<list<StoredRunSummary>, TelemetryError> effect ffi, io, alloc {
    val db = db_open(db_path)
    if db == 0 {
        return err(TelemetryError.Storage(concat("failed to open SQLite db: ", db_path)))
    }
    defer {
        val _ = db_close(db)
    }
    ensure_schema(db)?
    val params: list<str> = list(to_str(limit))
    val rows = db_query_params(
        db,
        "SELECT id, fetched_at_ms, quake_count, max_mag, kp_latest, gr_b, alert_tier FROM runs ORDER BY id DESC LIMIT ?;",
        params,
    )
    val out: list<StoredRunSummary> = list()
    for i in 0..list_len(rows) {
        val r = list_get(rows, i)
        if list_len(r) >= 7 {
            val _ = list_push(
                out,
                StoredRunSummary {
                    run_id: parse_i64(list_get(r, 0)) ?? 0,
                    fetched_at_ms: parse_i64(list_get(r, 1)) ?? 0,
                    quake_count: parse_i64(list_get(r, 2)) ?? 0,
                    max_mag: parse_f64(list_get(r, 3)) ?? 0.0,
                    kp_latest: parse_f64(list_get(r, 4)) ?? 0.0,
                    gr_b: parse_f64(list_get(r, 5)) ?? 0.0,
                    alert_tier: list_get(r, 6),
                },
            )
        }
    }
    return ok(out)
}

def sample_store_event(id: str, coord: GeoCoord, mag: f64, place: str) -> SeismicEvent {
    return SeismicEvent {
        event_id: id,
        time_utc: "2026-11-14T19:00:00Z",
        coord: coord,
        magnitude: mag,
        mag_type: "mww",
        place: place,
        station_count: 25,
        gap_deg: 30.0,
        rms_sec: 0.2,
    }
}

def sample_store_analytics() -> RunAnalytics {
    return RunAnalytics {
        total_quakes: 1,
        shallow_count: 1,
        intermediate_count: 0,
        deep_count: 0,
        max_magnitude: 4.5,
        strongest_idx: 0,
        secondary_idx: 0,
        total_energy_log10_j: 11.55,
        closest_iss_km: 12000.0,
        closest_iss_idx: 0,
        watch_plus_count: 1,
        mag_mean: 4.5,
        mag_ci_low: 4.0,
        mag_ci_high: 5.0,
        kp_latest: 3.33,
        kp_peak: 3.33,
        kp_ci_low: 2.8,
        kp_ci_high: 3.8,
        gr_fit: GutenbergRichterFit {
            a_value: 4.5,
            b_value: 1.0,
            r2_score: 0.95,
            bin_count: 3,
            expected_daily_m5: 0.3,
            expected_daily_m6: 0.03,
        },
        overall_alert: AlertSeverity.Elevated,
    }
}

def sample_store_iss() -> OrbitalState {
    return OrbitalState {
        name: "iss",
        latitude: 10.0,
        longitude: 20.0,
        altitude_km: 415.0,
        velocity_kmh: 27590.0,
        footprint_km: 4480.0,
        visibility: "daylight",
        timestamp_s: 1794690639,
        solar_lat: -18.0,
        solar_lon: 200.0,
    }
}

def sample_store_snap(events: list<SeismicEvent>) -> ObservatorySnapshot effect io, alloc {
    val kp1 = GeomagneticSample {
        time_tag: "2026-11-14T18:00:00",
        kp_index: 3.33,
        a_running: 18.0,
        station_count: 8,
    }
    return ObservatorySnapshot {
        events: events,
        kps: list(kp1),
        iss: sample_store_iss(),
        weather: list(),
        analytics: sample_store_analytics(),
    }
}

def test_store_persistence_and_deltas() -> i64 effect ffi, io, alloc, throw {
    val db = db_open(":memory:")
    assert(db != 0)
    defer {
        val _ = db_close(db)
    }

    val eq1 = sample_store_event(
        "eq-alpha",
        GeoCoord { lat_deg: 35.0, lon_deg: 139.0, depth_km: 20.0 },
        4.5,
        "Tokyo Bay",
    )
    val d1 = unwrap(persist_on_handle(db, 1000, sample_store_snap(list(eq1))))
    assert(d1.prior_runs == 0)
    assert(d1.new_events_count == 1)
    assert(d1.stored_events_total == 1)
    assert(!d1.has_previous)

    val eq2 = sample_store_event(
        "eq-beta",
        GeoCoord { lat_deg: -15.0, lon_deg: -175.0, depth_km: 120.0 },
        5.2,
        "Tonga Region",
    )
    val d2 = unwrap(persist_on_handle(db, 2000, sample_store_snap(list(eq1, eq2))))
    assert(d2.prior_runs == 1)
    assert(d2.new_events_count == 1)
    assert(d2.stored_events_total == 2)
    assert(d2.has_previous)
    assert(abs_f64(d2.prev_gr_b - 1.0) < 0.001)
    return 0
}
