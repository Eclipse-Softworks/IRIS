def start_fetch_for_feed(
    st: TelemetryGuiState,
    slug: str,
    note: str,
) -> (TelemetryGuiState, GuiWorkerCmd) {
    val next = TelemetryGuiState {
        feed_slug: slug,
        active_view: st.active_view,
        depth_filter: st.depth_filter,
        min_mag: st.min_mag,
        search_text: st.search_text,
        selected_event_id: st.selected_event_id,
        table_page: 0,
        auto_sync: st.auto_sync,
        loading: true,
        weather_probing: st.weather_probing,
        tick: st.tick,
        last_stage1_ms: st.last_stage1_ms,
        last_stage2_ms: st.last_stage2_ms,
        hover_lat: st.hover_lat,
        hover_lon: st.hover_lon,
        hover_in_map: st.hover_in_map,
        hovered_event_id: st.hovered_event_id,
        status_note: note,
        db_path: st.db_path,
        svg_path: st.svg_path,
        json_path: st.json_path,
        enable_db: st.enable_db,
        map: st.map,
        snap: st.snap,
        delta: st.delta,
        recent_runs: st.recent_runs,
        probed_weather: st.probed_weather,
    }
    return (next, GuiWorkerCmd.FetchFeed(slug))
}

def apply_live_control_deltas(
    st: TelemetryGuiState,
    ui_st: UiState,
) -> (TelemetryGuiState, UiState) {
    var cur = st
    var out_ui = ui_st
    if ui_st.has_toggle_change {
        cur = reduce_toggle_action(cur, ui_st.last_toggle_key, ui_st.last_toggle_val)
    }
    if ui_st.has_slider_change && ui_st.last_slider_key == "sldr_min_mag" {
        cur = with_search_and_min_mag(cur, cur.search_text, ui_st.last_slider_val, 0)
    }
    if ui_st.last_text_key == "inp_search" && ui_st.last_text_val != cur.search_text {
        cur = with_search_and_min_mag(cur, ui_st.last_text_val, cur.min_mag, 0)
    }
    if ui_st.dispatched_action == "act_clear_search" {
        cur = with_search_and_min_mag(cur, "", cur.min_mag, 0)
        out_ui = ui_state_set_text(out_ui, "inp_search", "")
    }
    return (cur, out_ui)
}

def reduce_probe_or_export(
    cur: TelemetryGuiState,
    act: str,
) -> (TelemetryGuiState, GuiWorkerCmd) effect alloc {
    if act == "act_probe_wx" {
        return when resolve_selected_event_idx(cur) {
            some(idx) => {
                val ev = list_get(cur.snap.events, idx)
                val probing_st = TelemetryGuiState {
                    feed_slug: cur.feed_slug,
                    active_view: cur.active_view,
                    depth_filter: cur.depth_filter,
                    min_mag: cur.min_mag,
                    search_text: cur.search_text,
                    selected_event_id: cur.selected_event_id,
                    table_page: cur.table_page,
                    auto_sync: cur.auto_sync,
                    loading: cur.loading,
                    weather_probing: true,
                    tick: cur.tick,
                    last_stage1_ms: cur.last_stage1_ms,
                    last_stage2_ms: cur.last_stage2_ms,
                    hover_lat: cur.hover_lat,
                    hover_lon: cur.hover_lon,
                    hover_in_map: cur.hover_in_map,
                    hovered_event_id: cur.hovered_event_id,
                    status_note: concat("Probing Open-Meteo at ", ev.place),
                    db_path: cur.db_path,
                    svg_path: cur.svg_path,
                    json_path: cur.json_path,
                    enable_db: cur.enable_db,
                    map: cur.map,
                    snap: cur.snap,
                    delta: cur.delta,
                    recent_runs: cur.recent_runs,
                    probed_weather: cur.probed_weather,
                }
                (
                    probing_st,
                    GuiWorkerCmd.ProbeWeather(ev.place, ev.coord.lat_deg, ev.coord.lon_deg),
                )
            },
            none => (cur, GuiWorkerCmd.NoOp),
        }
    }
    return (cur, GuiWorkerCmd.ExportBundle)
}

def reduce_action_dispatch(
    cur0: TelemetryGuiState,
    out_ui: UiState,
    act: str,
) -> (TelemetryGuiState, GuiWorkerCmd, UiState) effect alloc {
    when resolve_feed_slug_action(act) {
        some(slug) => {
            val pair = start_fetch_for_feed(cur0, slug, concat("Switching USGS feed to ", slug))
            return (pair.0, pair.1, out_ui)
        },
        none => {},
    }
    if act == "act_refresh_now" {
        val pair = start_fetch_for_feed(cur0, cur0.feed_slug, "Refreshing live telemetry feeds...")
        return (pair.0, pair.1, out_ui)
    }
    if act == "act_probe_wx" || act == "act_export_bundle" {
        val pair = reduce_probe_or_export(cur0, act)
        return (pair.0, pair.1, out_ui)
    }
    if starts_with(act, "sel_eq_") {
        val ev_id = slice(act, 7, len(act))
        val next = with_selection_and_status(cur0, ev_id, cur0.table_page, cur0.status_note)
        return (next, GuiWorkerCmd.NoOp, out_ui)
    }
    if act == "act_page_prev" {
        val prev_p = if cur0.table_page > 0 { cur0.table_page - 1 } else { 0 }
        val next = with_selection_and_status(cur0, cur0.selected_event_id, prev_p, cur0.status_note)
        return (next, GuiWorkerCmd.NoOp, out_ui)
    }
    if act == "act_page_next" {
        val p = cur0.table_page + 1
        val next = with_selection_and_status(cur0, cur0.selected_event_id, p, cur0.status_note)
        return (next, GuiWorkerCmd.NoOp, out_ui)
    }
    val cur1 = reduce_view_or_depth(cur0, act)
    return (reduce_map_action(cur1, act), GuiWorkerCmd.NoOp, out_ui)
}

/// Apply polled `UiState` widget edges and optional map pick ID to application state.
pub def reduce_gui_interaction(
    st: TelemetryGuiState,
    ui_st: UiState,
    map_pick_id: str,
) -> (TelemetryGuiState, GuiWorkerCmd, UiState) effect alloc {
    val delta_res = apply_live_control_deltas(st, ui_st)
    var cur = delta_res.0
    val out_ui = delta_res.1
    val sync_toggled = ui_st.has_toggle_change && ui_st.last_toggle_key == "tog_auto_sync"
    if len(map_pick_id) > 0 {
        cur = with_selection_and_status(cur, map_pick_id, cur.table_page, cur.status_note)
    }
    val act = out_ui.dispatched_action
    if len(act) == 0 {
        val cmd = if sync_toggled {
            GuiWorkerCmd.SetAutoSync(cur.auto_sync)
        } else {
            GuiWorkerCmd.NoOp
        }
        return (cur, cmd, out_ui)
    }
    return reduce_action_dispatch(cur, out_ui, act)
}

def sample_state_test_snap() -> ObservatorySnapshot effect alloc, thread {
    val events: list<SeismicEvent> = list(
        SeismicEvent {
            event_id: "eq_a",
            time_utc: "2026-11-15T10:00:00Z",
            coord: GeoCoord { lat_deg: 36.2, lon_deg: 141.0, depth_km: 24.0 },
            magnitude: 5.4,
            mag_type: "mww",
            place: "Off East Coast of Honshu, Japan",
            station_count: 40,
            gap_deg: 30.0,
            rms_sec: 0.4,
        },
        SeismicEvent {
            event_id: "eq_b",
            time_utc: "2026-11-15T09:12:00Z",
            coord: GeoCoord { lat_deg: -21.5, lon_deg: -176.2, depth_km: 410.0 },
            magnitude: 4.1,
            mag_type: "mb",
            place: "Fiji Region",
            station_count: 18,
            gap_deg: 75.0,
            rms_sec: 0.3,
        },
    )
    val kps = list(
        GeomagneticSample { time_tag: "t0", kp_index: 3.33, a_running: 18.0, station_count: 8 },
    )
    val iss = OrbitalState {
        name: "iss",
        latitude: 12.0,
        longitude: 45.0,
        altitude_km: 416.0,
        velocity_kmh: 27590.0,
        footprint_km: 4480.0,
        visibility: "daylight",
        timestamp_s: 1794690639,
        solar_lat: -18.0,
        solar_lon: 110.0,
    }
    val an = analyze_observatory_feeds(events, kps, iss)
    val empty_wx: list<SurfaceWeather> = list()
    return ObservatorySnapshot {
        events: events,
        kps: kps,
        iss: iss,
        weather: empty_wx,
        analytics: an,
    }
}

def test_gui_state_filtering_and_reduction() -> i64 effect alloc, thread, throw {
    val base0 = gui_state_init(GuiLaunchOpts {})
    val snap = sample_state_test_snap()
    val runs: list<StoredRunSummary> = list()
    var st = apply_live_snapshot(base0, snap, base0.delta, runs, (120, 80, "Live ok"))
    assert(!st.loading && st.selected_event_id == "eq_a")
    assert(list_len(filtered_event_indices(st)) == 2)

    val ui_search = ui_state_set_text(UiState {}, "inp_search", "fiji")
    val r1 = reduce_gui_interaction(st, ui_search, "")
    st = r1.0
    assert(list_len(filtered_event_indices(st)) == 1)
    assert(list_get(st.snap.events, list_get(filtered_event_indices(st), 0)).event_id == "eq_b")

    val ui_clear = UiState {
        last_text_key: "inp_search",
        last_text_val: "fiji",
        dispatched_action: "act_clear_search",
    }
    val r2 = reduce_gui_interaction(st, ui_clear, "")
    st = r2.0
    assert(st.search_text == "" && r2.2.last_text_val == "")

    val ui_feed = UiState { dispatched_action: "act_feed_4.5_week" }
    val r3 = reduce_gui_interaction(st, ui_feed, "")
    assert(r3.0.feed_slug == "4.5_week" && r3.0.loading)
    return 0
}
