bring std.fs
bring std.json
bring std.math
bring std.net
bring std.svg
bring "domain.iris"
bring "store.iris"

/// Escape XML reserved characters for safe embedding inside SVG `<text>` elements.
pub def xml_escape(s: str) -> str effect io, alloc {
    val n = len(s)
    val parts: list<str> = list()
    for i in 0..n {
        val b = str_index(s, i)
        if b == 38 {
            val _ = list_push(parts, "&amp;")
        } else if b == 60 {
            val _ = list_push(parts, "&lt;")
        } else if b == 62 {
            val _ = list_push(parts, "&gt;")
        } else if b == 34 {
            val _ = list_push(parts, "&quot;")
        } else if b == 39 {
            val _ = list_push(parts, "&apos;")
        } else {
            val _ = list_push(parts, slice(s, i, i + 1))
        }
    }
    return join(parts, "")
}

/// Project WGS-84 longitude `[-180..180]` onto equirectangular SVG map X coordinate.
pub def map_proj_x(lon_deg: f64) -> f64 {
    val clamped = clamp_f64(lon_deg, -180.0, 180.0)
    return 40.0 + ((clamped + 180.0) / 360.0) * 1200.0
}

/// Project WGS-84 latitude `[-90..90]` onto equirectangular SVG map Y coordinate.
pub def map_proj_y(lat_deg: f64) -> f64 {
    val clamped = clamp_f64(lat_deg, -90.0, 90.0)
    return 70.0 + ((90.0 - clamped) / 180.0) * 490.0
}

/// Draw a sequence of connected `(lon, lat)` vertices as geographic coastline line segments.
def draw_geo_polyline(
    ctx: SVGContext,
    coords: list<f64>,
    color: str,
    width: f64,
) -> SVGContext effect io, alloc {
    var cur = ctx
    val n = list_len(coords)
    var i = 0
    while (i + 3) < n {
        val lon0 = list_get(coords, i)
        val lat0 = list_get(coords, i + 1)
        val lon1 = list_get(coords, i + 2)
        val lat1 = list_get(coords, i + 3)
        cur = svg_line(
            cur,
            map_proj_x(lon0),
            map_proj_y(lat0),
            map_proj_x(lon1),
            map_proj_y(lat1),
            color,
            width,
        )
        i = i + 2
    }
    return cur
}

