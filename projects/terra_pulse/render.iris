def sample_render_snapshot() -> ObservatorySnapshot effect io, alloc {
    val ev = SeismicEvent {
        event_id: "eq-svg-1",
        time_utc: "2026-11-14T20:00:00Z",
        coord: GeoCoord { lat_deg: 24.0, lon_deg: 121.6, depth_km: 15.0 },
        magnitude: 5.1,
        mag_type: "mww",
        place: "Hualien & East",
        station_count: 30,
        gap_deg: 35.0,
        rms_sec: 0.3,
    }
    val kp = GeomagneticSample {
        time_tag: "2026-11-14T18:00:00",
        kp_index: 4.33,
        a_running: 28.0,
        station_count: 8,
    }
    val iss = OrbitalState {
        name: "iss",
        latitude: 12.0,
        longitude: 45.0,
        altitude_km: 416.0,
        velocity_kmh: 27590.0,
        footprint_km: 4480.0,
        visibility: "daylight",
        timestamp_s: 1794690639,
        solar_lat: -18.0,
        solar_lon: 110.0,
    }
    return ObservatorySnapshot {
        events: list(ev),
        kps: list(kp),
        iss: iss,
        weather: list(),
        analytics: sample_render_analytics(),
    }
}

def test_render_svg_projection_and_escape() -> i64 effect io, alloc, throw {
    assert(xml_escape("Hualien & <Taiwan> '1'") == "Hualien &amp; &lt;Taiwan&gt; &apos;1&apos;")
    assert(abs_f64(map_proj_x(0.0) - 640.0) < 0.01)
    assert(abs_f64(map_proj_y(0.0) - 315.0) < 0.01)

    val svg = build_observatory_svg(sample_render_snapshot())
    assert(contains(svg, "<svg width=\"1280\" height=\"760\""))
    assert(contains(svg, "Hualien &amp; East"))
    assert(contains(svg, "Gutenberg-Richter &amp; Bayesian"))
    assert(contains(svg, "log10(N&gt;=M)"))
    assert(!contains(svg, " & "))
    assert(contains(svg, "</svg>"))
    assert(extract_http_path("GET /api/summary?v=1 HTTP/1.1\r\n") == "/api/summary")
    return 0
}
