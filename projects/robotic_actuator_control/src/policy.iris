pub
record State {
    position : f64, target : f64
}
/// Saturated proportional control in a deterministic simulation.
pub def command(state : State) -> f64 {
    val requested = (state.target - state.position) * 0.5;
    return if requested>1.0 {
        1.0
    } else {
        if requested< - 1.0 {
            - 1.0
        } else {
            requested
        }

    }

}
pub def advance(state : State, action : f64) -> State {
    return State {
        position : state.position + action, target : state.target
    }

}
