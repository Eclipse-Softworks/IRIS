bring "policy.iris" bring std.ros2 /// A simulated controller: no GPIO writes or ROS transport are started.
def main() -> i64 {
    var state = State {
        position : 0.0, target : 4.0
    }
    ;
    for tick in 0 .. 12 {
        val action = command(state);
        assert(action >= - 1.0 && action <= 1.0);
        state = advance(state, action);

    }
    ;
    assert(state.position>3.99);
    assert(state.position <= 4.0);
    assert(qos_control().depth == 1);
    println("robot controller: simulated target reached within actuator bounds");
    return 0
}
