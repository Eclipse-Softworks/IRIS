<?xml version="1.0" encoding="UTF-8"?>
<!-- Cyclone DDS on this machine only: loopback, unicast discovery between
     local processes. Docker, WSL and VPN adapters cannot split the turtle and
     the controller onto different interfaces. Used by run.ps1 / run.sh via
     CYCLONEDDS_URI. -->
<CycloneDDS>
  <Domain>
    <General>
      <Interfaces>
        <NetworkInterface address="127.0.0.1"/>
      </Interfaces>
      <AllowMulticast>false</AllowMulticast>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>32</MaxAutoParticipantIndex>
      <Peers>
        <Peer address="127.0.0.1"/>
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
