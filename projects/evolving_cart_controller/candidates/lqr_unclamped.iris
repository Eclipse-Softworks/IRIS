// The LQR-optimal law from reference.iris, unsaturated. It matches the canary
// exactly -- near the operating point it never needs more than ~5 N -- but a
// large setpoint change asks for far more than the +/-10 N rating, and the
// field check rolls it back.
def policy(error: f64, velocity: f64) -> f64 effect pure {
    4.340176623413436 * error - 3.4653432951749576 * velocity
}

def test_policy() -> i64 effect throw { assert(policy(1.0, 0.0) == 4.340176623413436); 0 }

def test_transaction_rollback() -> i64 effect alloc, transaction {
    val state: list<i64> = list()
    push(state, 10);
    transaction_begin();
    push(state, 99);
    transaction_rollback();
    if list_len(state) == 1 && list_get(state, 0) == 10 { 0 } else { 1 }
}
