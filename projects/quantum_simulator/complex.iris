// projects/quantum_simulator/complex.iris
// Complex Number Arithmetic & Polar Representation for Quantum Mechanics

pub record Complex {
    re: f64,
    im: f64,
}

pub def c_new(re: f64, im: f64) -> Complex {
    Complex { re: re, im: im }
}

pub def c_zero() -> Complex {
    Complex { re: 0.0, im: 0.0 }
}

pub def c_one() -> Complex {
    Complex { re: 1.0, im: 0.0 }
}

pub def c_add(a: Complex, b: Complex) -> Complex {
    Complex { re: a.re + b.re, im: a.im + b.im }
}

pub def c_sub(a: Complex, b: Complex) -> Complex {
    Complex { re: a.re - b.re, im: a.im - b.im }
}

pub def c_mul(a: Complex, b: Complex) -> Complex {
    Complex {
        re: a.re * b.re - a.im * b.im,
        im: a.re * b.im + a.im * b.re,
    }
}

pub def c_scale(a: Complex, s: f64) -> Complex {
    Complex { re: a.re * s, im: a.im * s }
}

pub def c_conj(a: Complex) -> Complex {
    Complex { re: a.re, im: -a.im }
}

pub def c_mag_sq(a: Complex) -> f64 {
    a.re * a.re + a.im * a.im
}

pub def c_mag(a: Complex) -> f64 {
    sqrt(c_mag_sq(a))
}

pub def c_div(a: Complex, b: Complex) -> Complex {
    val denom = c_mag_sq(b);
    Complex {
        re: (a.re * b.re + a.im * b.im) / denom,
        im: (a.im * b.re - a.re * b.im) / denom,
    }
}

/// Euler's formula: e^(i * theta) = cos(theta) + i * sin(theta)
pub def c_exp_i(theta: f64) -> Complex {
    Complex { re: cos(theta), im: sin(theta) }
}
