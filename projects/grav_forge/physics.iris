// Core N-body astrophysics engine, ADTs, trait metrics, algebraic effect telemetry,
// curated multi-body orbital scenarios, and RFC 8259 JSON snapshot codec.

bring std.json
bring std.math
bring std.string

extern def grav_audit_hook(code: i64, energy_milli: i64) -> i64

/// Classification of simulated orbital entities and gravity-well attractors.
pub choice BodyKind {
    Star,
    Planet,
    Comet,
    BlackHole,
    Probe,
}

/// Interactive canvas tool selected from the Mission Control bar.
pub choice ToolMode {
    SlingshotPlanet,
    SlingshotStar,
    MoveBeacon,
    GravityBrush,
}

/// Curated orbital presets selectable from tabs or CLI flags.
pub choice ScenarioId {
    BinarySlingshot,
    FigureEight,
    SolarNursery,
    BlackHoleCollider,
}

/// Domain events emitted by each physics step and scored via algebraic effect handlers.
pub choice SimEvent {
    Merger(f64, f64, f64),
    BeaconDocked(i64, f64),
    ProbeLaunched(f64),
}

/// 2D simulation vector in normalized workspace coordinates (`[0..1]`).
pub record Vec2 {
    x: f64 = 0.0,
    y: f64 = 0.0,
}

impl Vec2 {
    def len_sq(self) -> f64 {
        return self.x * self.x + self.y * self.y
    }

    def norm(self) -> f64 {
        return sqrt(self.len_sq())
    }

    def dist_to(self, other: Vec2) -> f64 {
        val dx = self.x - other.x
        val dy = self.y - other.y
        return sqrt(dx * dx + dy * dy)
    }

    def add(self, other: Vec2) -> Vec2 {
        return Vec2 { x: self.x + other.x, y: self.y + other.y }
    }

    def sub(self, other: Vec2) -> Vec2 {
        return Vec2 { x: self.x - other.x, y: self.y - other.y }
    }

    def scale(self, k: f64) -> Vec2 {
        return Vec2 { x: self.x * k, y: self.y * k }
    }
}

/// Dynamic celestial body with integrated position, velocity, mass, and orbital trail.
pub record Body {
    id: i64 = 1,
    kind: BodyKind = BodyKind.Planet,
    x: f64 = 0.5,
    y: f64 = 0.5,
    vx: f64 = 0.0,
    vy: f64 = 0.0,
    mass: f64 = 0.25,
    radius: f64 = 0.015,
    color_idx: i64 = 0,
    trail_x: list<f64> = list(),
    trail_y: list<f64> = list(),
    age: f64 = 0.0,
}

/// Shared contract for computing physical energy and display radius of bodies.
pub trait CelestialMetric {
    def kinetic_energy(self) -> f64
    def visual_radius(self) -> f64
}

impl CelestialMetric for Body {
    def kinetic_energy(self) -> f64 {
        val v2 = self.vx * self.vx + self.vy * self.vy
        return 0.5 * self.mass * v2
    }

    def visual_radius(self) -> f64 {
        return when self.kind {
            BodyKind.BlackHole => clamp_f(0.022 + sqrt(self.mass) * 0.005, 0.018, 0.042),
            BodyKind.Star => clamp_f(0.017 + sqrt(self.mass) * 0.006, 0.016, 0.038),
            BodyKind.Planet => clamp_f(0.009 + sqrt(self.mass) * 0.006, 0.008, 0.022),
            BodyKind.Comet => 0.007,
            BodyKind.Probe => 0.0085,
        }
    }
}

/// Compute kinetic energy using the `CelestialMetric` trait implementation.
pub def body_kinetic_energy(b: Body) -> f64 {
    return b.kinetic_energy()
}

/// Expanding ring shockwave produced by probe dockings, launches, and body mergers.
pub record Shockwave {
    x: f64 = 0.5,
    y: f64 = 0.5,
    radius: f64 = 0.01,
    max_radius: f64 = 0.14,
    life: f64 = 1.0,
    tone_idx: i64 = 0,
}

/// Live simulation parameters tuned from the UI control panel.
pub record SimConfig {
    gravity_g: f64 = 0.021,
    time_scale: f64 = 1.0,
    softening: f64 = 0.032,
    merge_collisions: bool = true,
    paused: bool = false,
}

/// Interactive tractor-beam gravity brush state driven by pointer drag.
pub record BrushInput {
    active: bool = false,
    x: f64 = 0.5,
    y: f64 = 0.5,
    strength: f64 = 0.36,
}

/// Real-time energy balance and algebraic-effect mission score counters.
pub record SimTelemetry {
    kinetic: f64 = 0.0,
    potential: f64 = 0.0,
    total_energy: f64 = 0.0,
    mergers: i64 = 0,
    dockings: i64 = 0,
    audit_score: i64 = 0,
}

/// Complete physical simulation state for one orbital sandbox session.
pub record WorldState {
    bodies: list<Body> = list(),
    waves: list<Shockwave> = list(),
    launch_x: f64 = 0.13,
    launch_y: f64 = 0.80,
    beacon_x: f64 = 0.86,
    beacon_y: f64 = 0.22,
    next_id: i64 = 1,
    sim_time: f64 = 0.0,
    telemetry: SimTelemetry = SimTelemetry {},
    scenario: ScenarioId = ScenarioId.BinarySlingshot,
}

/// Clamp `v` into `[lo, hi]`.
pub def clamp_f(v: f64, lo: f64, hi: f64) -> f64 {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    return v
}

/// Readable short name of `ScenarioId`.
pub def scenario_label(sc: ScenarioId) -> str {
    return when sc {
        ScenarioId.BinarySlingshot => "Binary Slingshot",
        ScenarioId.FigureEight => "Chenciner Fig-8",
        ScenarioId.SolarNursery => "Solar Nursery",
        ScenarioId.BlackHoleCollider => "Black Hole Collider",
    }
}

/// Integer encoding (`0..=3`) for `ScenarioId`.
pub def scenario_index(sc: ScenarioId) -> i64 {
    return when sc {
        ScenarioId.BinarySlingshot => 0,
        ScenarioId.FigureEight => 1,
        ScenarioId.SolarNursery => 2,
        ScenarioId.BlackHoleCollider => 3,
    }
}

/// Reconstruct `ScenarioId` from tab index `0..=3`.
pub def scenario_from_index(idx: i64) -> ScenarioId {
    if idx == 1 {
        return ScenarioId.FigureEight
    }
    if idx == 2 {
        return ScenarioId.SolarNursery
    }
    if idx == 3 {
        return ScenarioId.BlackHoleCollider
    }
    return ScenarioId.BinarySlingshot
}

/// Score simulation events through an intercepted algebraic effect handler (`handle ... with`).
pub def score_sim_events(events: list<SimEvent>) -> i64 {
    var total = 0
    for i in 0..list_len(events) {
        val ev = list_get(events, i)
        val delta = when ev {
            SimEvent.Merger(_x, _y, mass) => handle {
                grav_audit_hook(1, (mass * 100.0) to i64)
            } with {
                grav_audit_hook(_c, m) => 100 + m
            },
            SimEvent.BeaconDocked(_id, speed) => handle {
                grav_audit_hook(2, (speed * 200.0) to i64)
            } with {
                grav_audit_hook(_c, m) => 350 + m
            },
            SimEvent.ProbeLaunched(speed) => handle {
                grav_audit_hook(3, (speed * 40.0) to i64)
            } with {
                grav_audit_hook(_c, m) => 25 + m
            },
        }
        total = total + delta
    }
    return total
}

def make_body_with_seed(id: i64, spec: Body) -> Body effect alloc {
    val tx: list<f64> = list(spec.x)
    val ty: list<f64> = list(spec.y)
    return Body {
        id: id,
        kind: spec.kind,
        x: spec.x,
        y: spec.y,
        vx: spec.vx,
        vy: spec.vy,
        mass: spec.mass,
        radius: spec.visual_radius(),
        color_idx: spec.color_idx,
        trail_x: tx,
        trail_y: ty,
        age: 0.0,
    }
}

def build_binary_bodies() -> list<Body> effect alloc {
    return list(
        make_body_with_seed(
            1,
            Body {
                kind: BodyKind.Star,
                x: 0.40,
                y: 0.48,
                vx: 0.063,
                vy: -0.316,
                mass: 2.6,
                color_idx: 1,
            },
        ),
        make_body_with_seed(
            2,
            Body {
                kind: BodyKind.Star,
                x: 0.60,
                y: 0.52,
                vx: -0.075,
                vy: 0.373,
                mass: 2.2,
                color_idx: 2,
            },
        ),
        make_body_with_seed(
            3,
            Body {
                kind: BodyKind.Planet,
                x: 0.50,
                y: 0.18,
                vx: 0.56,
                vy: 0.0,
                mass: 0.35,
                color_idx: 3,
            },
        ),
        make_body_with_seed(
            4,
            Body {
                kind: BodyKind.Comet,
                x: 0.74,
                y: 0.74,
                vx: -0.38,
                vy: 0.34,
                mass: 0.08,
                color_idx: 4,
            },
        ),
    )
}

def build_figure_eight_bodies() -> list<Body> effect alloc {
    val scale_l = 0.19
    val gm = 0.021 * 1.6
    val vel_k = sqrt(gm / scale_l)
    val vx1 = 0.466203685 * vel_k
    val vy1 = 0.432365730 * vel_k
    return list(
        make_body_with_seed(
            1,
            Body {
                kind: BodyKind.Star,
                x: 0.50 - 0.97000436 * scale_l,
                y: 0.50 + 0.24308753 * scale_l,
                vx: vx1,
                vy: vy1,
                mass: 1.6,
                color_idx: 2,
            },
        ),
        make_body_with_seed(
            2,
            Body {
                kind: BodyKind.Star,
                x: 0.50 + 0.97000436 * scale_l,
                y: 0.50 - 0.24308753 * scale_l,
                vx: vx1,
                vy: vy1,
                mass: 1.6,
                color_idx: 1,
            },
        ),
        make_body_with_seed(
            3,
            Body {
                kind: BodyKind.Star,
                x: 0.50,
                y: 0.50,
                vx: -2.0 * vx1,
                vy: -2.0 * vy1,
                mass: 1.6,
                color_idx: 5,
            },
        ),
    )
}

