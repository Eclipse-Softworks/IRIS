// IRIS GravForge: 60 FPS interactive Differentiable Orbital & Field-Dynamics Sandbox.
// Showcases reverse-mode autodiff (`tape`/`backward`/`grad`), ADTs & traits,
// algebraic effects (`handle`/`with`), JSON clipboard snapshots, and native `std.ui`.

bring std.math
bring std.ui
bring "physics.iris"
bring "autodiff.iris"
bring "canvas.iris"

record CliOpts {
    headless: bool = false,
    snap_path: str = "",
    initial_scenario: ScenarioId = ScenarioId.BinarySlingshot,
}

record AppState {
    world: WorldState = WorldState {},
    sim_cfg: SimConfig = SimConfig {},
    solver: AdSolverState = AdSolverState {},
    drag: DragState = DragState {},
    tool: ToolMode = ToolMode.SlingshotPlanet,
    theme_idx: i64 = 0,
    grav_slider: f64 = 42.0,
    speed_slider: f64 = 100.0,
    launch_mass: f64 = 4.0,
    show_grid: bool = true,
    show_trails: bool = true,
    show_vectors: bool = false,
    drawer_open: bool = false,
    frame_idx: i64 = 0,
    last_clock: f64 = 0.0,
    fps_smooth: f64 = 60.0,
    ke_xs: list<f64> = list(),
    ke_ys: list<f64> = list(),
    vp_x: f64 = 0.0,
    vp_y: f64 = 0.0,
    vp_w: f64 = 0.0,
    vp_h: f64 = 0.0,
}

def scenario_from_cli(raw: str) -> ScenarioId {
    if raw == "fig8" {
        return ScenarioId.FigureEight
    }
    if raw == "solar" {
        return ScenarioId.SolarNursery
    }
    if raw == "holes" {
        return ScenarioId.BlackHoleCollider
    }
    return ScenarioId.BinarySlingshot
}

def parse_cli(argv: list<str>) -> CliOpts {
    var headless = false
    var snap = ""
    var sc = ScenarioId.BinarySlingshot
    var i = 1
    while i < list_len(argv) {
        val a = list_get(argv, i)
        if a == "--headless-snapshot" {
            headless = true
            snap = if i + 1 < list_len(argv) {
                list_get(argv, i + 1)
            } else {
                "grav_forge_snapshot.png"
            }
            if i + 1 < list_len(argv) {
                i = i + 1
            }
        } else if a == "--scenario" && i + 1 < list_len(argv) {
            sc = scenario_from_cli(list_get(argv, i + 1))
            i = i + 1
        }
        i = i + 1
    }
    return CliOpts { headless: headless, snap_path: snap, initial_scenario: sc }
}

def pick_theme(idx: i64) -> UiTheme {
    val m = idx % 6
    if m == 1 {
        return midnight_theme()
    }
    if m == 2 {
        return nord_theme()
    }
    if m == 3 {
        return emerald_studio_theme()
    }
    if m == 4 {
        return daylight_theme()
    }
    if m == 5 {
        return high_contrast_theme()
    }
    return obsidian_theme()
}

def theme_label(idx: i64) -> str {
    val m = idx % 6
    if m == 1 {
        return "Midnight"
    }
    if m == 2 {
        return "Nord"
    }
    if m == 3 {
        return "Emerald"
    }
    if m == 4 {
        return "Daylight"
    }
    if m == 5 {
        return "HiContrast"
    }
    return "Obsidian"
}

def tool_index(t: ToolMode) -> i64 {
    return when t {
        ToolMode.SlingshotPlanet => 0,
        ToolMode.SlingshotStar => 1,
        ToolMode.MoveBeacon => 2,
        ToolMode.GravityBrush => 3,
    }
}

def tool_from_index(idx: i64) -> ToolMode {
    if idx == 1 {
        return ToolMode.SlingshotStar
    }
    if idx == 2 {
        return ToolMode.MoveBeacon
    }
    if idx == 3 {
        return ToolMode.GravityBrush
    }
    return ToolMode.SlingshotPlanet
}

def init_app_state(sc: ScenarioId) -> AppState effect alloc {
    val cfg = SimConfig {}
    val w = make_scenario(sc)
    val solver = ad_start_solver(w, cfg)
    return AppState {
        world: w,
        sim_cfg: cfg,
        solver: solver,
        ke_xs: list(0.0),
        ke_ys: list(w.telemetry.kinetic * 100.0),
    }
}

def build_header(tree: UiTree, app: AppState) -> i64 effect alloc {
    val play_ic = if app.sim_cfg.paused { UiIcon.Play } else { UiIcon.Pause }
    val play_lbl = if app.sim_cfg.paused { "Play" } else { "Pause" }
    return ui_row(
        tree,
        "hdr_row",
        UiStyle { gap: 8.0, padding: 2.0 },
        list(
            ui_icon(tree, "hdr_ic", UiIcon.Globe, 22.0, UiTone.Accent),
            ui_heading(tree, "hdr_ttl", "IRIS GravForge", UiTone.Primary),
            ui_badge(tree, "sc_badge", scenario_label(app.world.scenario), UiTone.Primary),
            ui_badge(tree, "ad_badge", "AUTODIFF", UiTone.Accent),
            ui_spacer(tree, 1.0, 8.0, 0.0),
            ui_icon_button(tree, "play_btn", play_ic, play_lbl, UiTone.Primary, "toggle_pause"),
            ui_icon_button(tree, "ad_btn", UiIcon.Spark, "Solve AD [G]", UiTone.Accent, "solve_ad"),
            ui_icon_button(
                tree,
                "fire_btn",
                UiIcon.Rocket,
                "Fire Probe [F]",
                UiTone.Secondary,
                "fire_probe",
            ),
            ui_icon_button(
                tree,
                "guide_btn",
                UiIcon.HelpCircle,
                "Guide [H]",
                UiTone.Neutral,
                "toggle_drawer",
            ),
            ui_icon_button(
                tree,
                "theme_btn",
                UiIcon.Palette,
                theme_label(app.theme_idx),
                UiTone.Neutral,
                "cycle_theme",
            ),
        ),
    )
}

def fmt_milli(v: f64) -> str effect alloc {
    val m = ((v * 1000.0) + 0.5) to i64
    return to_str(m) + "m"
}

def fmt_signed_energy(v: f64) -> str effect alloc {
    val c = (v * 100.0) to i64
    return to_str(c) + "cJ"
}

def build_stats_strip(tree: UiTree, app: AppState, vw: f64) -> i64 effect alloc {
    val cols = ui_responsive_cols(vw * 0.68, 2, 4, 4)
    val tel = app.world.telemetry
    val fps_txt = to_str((app.fps_smooth + 0.5) to i64) + " FPS"
    val miss_txt = fmt_milli(app.solver.best_miss)
    val iter_txt = "Iter " + to_str(app.solver.iter) + "/" + to_str(app.solver.max_iters)
    return ui_grid(
        tree,
        "stat_grid",
        cols,
        10.0,
        list(
            ui_stat_card(
                tree,
                "st_bodies",
                StatSpec {
                    title: "Bodies",
                    value: to_str(list_len(app.world.bodies)),
                    delta: "Mergers: " + to_str(tel.mergers),
                    positive: true,
                    icon: UiIcon.Activity,
                    tone: UiTone.Primary,
                },
            ),
            ui_stat_card(
                tree,
                "st_miss",
                StatSpec {
                    title: "AD Miss Dist",
                    value: miss_txt,
                    delta: iter_txt,
                    positive: app.solver.best_miss < 0.08,
                    icon: UiIcon.Compass,
                    tone: UiTone.Accent,
                },
            ),
            ui_stat_card(
                tree,
                "st_dock",
                StatSpec {
                    title: "Probe Docks",
                    value: to_str(tel.dockings),
                    delta: "Audit: " + to_str(tel.audit_score),
                    positive: true,
                    icon: UiIcon.CheckCircle,
                    tone: UiTone.Secondary,
                },
            ),
            ui_stat_card(
                tree,
                "st_fps",
                StatSpec {
                    title: "Engine Rate",
                    value: fps_txt,
                    delta: "E: " + fmt_signed_energy(tel.total_energy),
                    positive: true,
                    icon: UiIcon.Bolt,
                    tone: UiTone.Accent,
                },
            ),
        ),
    )
}

def build_left_pane(tree: UiTree, app: AppState, vw: f64) -> i64 effect alloc {
    val canvas_card = ui_card(
        tree,
        "grav_canvas",
        UiStyle { min_w: 520.0, min_h: 380.0, flex: 1.0, radius: 12.0, border_width: 1.5 },
        list(),
    )
    val strip = build_stats_strip(tree, app, vw)
    return ui_col(tree, "left_pane", UiStyle { gap: 10.0, flex: 1.0 }, list(canvas_card, strip))
}

