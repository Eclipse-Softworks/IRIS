def build_control_pane(tree: UiTree, app: AppState) -> i64 effect alloc {
    val sc_tabs = ui_tabs(
        tree,
        "sc_tabs",
        list("Binary", "Fig-8", "Solar", "Holes"),
        scenario_index(app.world.scenario),
        UiTone.Primary,
        "sc_change",
    )
    val tool_seg = ui_segmented(
        tree,
        "tool_seg",
        list("Planet", "Star", "Beacon", "Brush"),
        tool_index(app.tool),
        UiTone.Accent,
        "tool_change",
    )
    val loss_chart = ui_line_chart(
        tree,
        "ad_loss_chart",
        ChartSeries {
            label: "AD Miss (x100)",
            xs: app.solver.loss_xs,
            ys: app.solver.loss_ys,
            tone: UiTone.Accent,
            fill: true,
        },
        UiStyle { min_h: 90.0 },
    )
    val ke_chart = ui_sparkline(
        tree,
        "energy_spark",
        ChartSeries {
            label: "Kinetic Energy",
            xs: app.ke_xs,
            ys: app.ke_ys,
            tone: UiTone.Primary,
            fill: true,
        },
        UiStyle { min_h: 52.0 },
    )
    return ui_card(
        tree,
        "ctrl_card",
        UiStyle { padding: 12.0, gap: 6.0 },
        list(
            ui_heading(tree, "ctl_h", "Mission Control & AD Lab", UiTone.Accent),
            sc_tabs,
            tool_seg,
            build_sidebar_actions(tree),
            ui_divider(tree, "Field & Physics"),
            ui_toggle(tree, "grid_tog", "Spacetime Curvature Grid", app.show_grid, UiTone.Primary),
            ui_toggle(tree, "trail_tog", "Orbital Trails", app.show_trails, UiTone.Accent),
            ui_toggle(tree, "vec_tog", "Velocity Vectors", app.show_vectors, UiTone.Secondary),
            ui_toggle(
                tree,
                "mrg_tog",
                "Collision Mergers",
                app.sim_cfg.merge_collisions,
                UiTone.Primary,
            ),
            ui_slider_range(
                tree,
                "grav_sl",
                "Gravity Constant G",
                app.grav_slider,
                UiSize { w: 10.0, h: 100.0 },
            ),
            ui_slider_range(
                tree,
                "spd_sl",
                "Time Scale %",
                app.speed_slider,
                UiSize { w: 20.0, h: 250.0 },
            ),
            ui_slider_range(
                tree,
                "mass_sl",
                "Slingshot Mass",
                app.launch_mass,
                UiSize { w: 1.0, h: 18.0 },
            ),
            ui_divider(tree, "AD Loss & Kinetic Telemetry"),
            loss_chart,
