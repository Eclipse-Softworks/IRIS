// logstat: summarize a web server access log (combined log format).
//
//   iris run projects/cli_tools/logstat.iris -- access.log [--scan-threshold 20]
//
// Prints request and status counts, bytes, the busiest path, clients with at
// least the threshold of 404 responses (probing for files), and the minute
// with the most 5xx responses.

bring "logs.iris"

def main() -> i64 {
    val argv = args();
    var file = "";
    var threshold = 20;
    var bad = false;
    var i = 1;
    while i < list_len(argv) {
        val a = list_get(argv, i);
        if a == "--scan-threshold" && i + 1 < list_len(argv) {
            val n = parse_i64(list_get(argv, i + 1));
            if is_some(n) { threshold = unwrap(n) } else { bad = true };
            i = i + 1
        } else if starts_with(a, "--") || len(file) > 0 {
            bad = true
        } else {
            file = a
        };
        i = i + 1
    };
    if bad || len(file) == 0 {
        println("usage: logstat FILE [--scan-threshold N]");
        return 2
    };
    val text = file_read_all(file);
    if is_ok(text) == false {
        println("logstat: cannot read " + file);
        return 1
    };
    val stats = analyze(unwrap(text), threshold);
    assert(stats.parsed + stats.unparsed == stats.lines);
    // Each report line ends in a newline, and print adds one more.
    val text = report(stats);
    print(slice(text, 0, len(text) - 1));
    return 0
}
