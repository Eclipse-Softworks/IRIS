bring "features.iris" bring std.ais bring std.async /// Deterministic simulated modalities; real model backends are separate adapters.
def main() -> i64 {
    val vision : chan<f64> = channel();
    val audio : chan<f64> = channel();
    val sensor : chan<f64> = channel();
    val group = new_task_group();
    spawn(group) {
        send(vision, 0.6);

    }
    ;
    spawn(group) {
        send(audio, 0.3);

    }
    ;
    spawn(group) {
        send(sensor, 0.9);

    }
    ;
    task_group_join(group);
    val combined = fuse(recv(vision), recv(audio), recv(sensor));
    assert(combined>0.599 && combined<0.601);
    val action = argmax(list(0.1, combined, 0.2));
    assert(action == 1);
    var runtime = agent_runtime_new(3);
    runtime = agent_record_outcome(runtime, combined, 0.1, true);
    assert(runtime.consecutive_failures == 0);
    println("multimodal orchestrator: 3 producers, tensor fusion, AIS action=1");
    return 0
}
