def apply(value : i64, operation : |i64 | -> i64) -> i64 {
    return operation(value)
}
def main() -> i64 {
    val offset = 7;
    val add_offset = |value : i64 |value + offset;
    val square = |value : i64 |value * value;
    assert(apply(35, add_offset) == 42);
    assert(apply(9, square) == 81);
    println("closures: ok");
    return 0
}
