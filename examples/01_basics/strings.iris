def main() -> i64 {
    val name = "IRIS";
    val message = f"Welcome to {name}";
    val words = split("learn,build,verify", ",");
    assert(message == "Welcome to IRIS");
    assert(len(name) == 4);
    assert(contains(message, name));
    assert(list_get(words, 2) == "verify");
    assert(join(words, " / ") == "learn / build / verify");
    println("strings: ok");
    return 0
}
