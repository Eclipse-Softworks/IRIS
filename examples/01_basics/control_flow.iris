/// return exits this function immediately; ranges exclude their upper bound.
def first_even(start : i64) -> i64 {
    for n in start .. start + 3 {
        if n % 2 == 0 {
            return n
        };

    };
    return - 1
}
def main() -> i64 {
    var sum = 0;
    for n in 1 .. 11 {
        if n % 2 == 0 {
            continue
        };
        sum = sum + n;
    };

    var remaining = 3;
    while remaining>0 {
        remaining = remaining - 1;
    };

    var steps = 0;
    loop {
        steps = steps + 1;
        if steps == 2 {
            break
        };
    };

    assert(sum == 25);
    assert(remaining == 0);
    assert(steps == 2);
    assert(first_even(7) == 8);
    println("control flow: ok");
    return 0
}
