// src/stdlib/bitset.iris -- IRIS standard bit set library
//
// Provides a compact bit array implementation using the `list<i64>` backend.
// Bitsets are represented as lists of 64-bit integers where each bit is a flag.

/// Create a new empty bitset.
pub def bitset_create() -> list<i64> {
    bitset_new()
}

/// Set a bit at position `pos` (0-indexed).
/// Returns the modified bitset for chaining.
pub def set_bit(bs: list<i64>, pos: i64) -> list<i64> {
    bitset_set(bs, pos)
}

/// Get a bit at position `pos` (0-indexed).
/// Returns `true` if the bit is set, `false` otherwise.
pub def get_bit(bs: list<i64>, pos: i64) -> bool {
    bitset_get(bs, pos)
}

/// Clear a bit at position `pos` (0-indexed).
/// Returns the modified bitset for chaining.
pub def clear_bit(bs: list<i64>, pos: i64) -> list<i64> {
    bitset_clear(bs, pos)
}

/// Count the number of set bits in the bitset (population count).
pub def popcount(bs: list<i64>) -> i64 {
    bitset_count(bs)
}

/// Toggle a bit at position `pos` (0-indexed).
pub def toggle_bit(bs: list<i64>, pos: i64) -> list<i64> {
    if get_bit(bs, pos) {
        clear_bit(bs, pos)
    } else {
        set_bit(bs, pos)
    }
}

/// Clone an existing bitset.
pub def bitset_clone(bs: list<i64>) -> list<i64> {
    val out: list<i64> = list()
    var i = 0
    val n = list_len(bs)
    while i < n {
        push(out, list_get(bs, i));
        i = i + 1
    }
    out
}

/// Return true if no bits are set in the bitset.
pub def bitset_is_empty(bs: list<i64>) -> bool {
    popcount(bs) == 0
}

/// Return the bitwise union (A | B) of two bitsets as a new bitset.
pub def bitset_union(a: list<i64>, b: list<i64>) -> list<i64> {
    val out: list<i64> = list()
    val len_a = list_len(a)
    val len_b = list_len(b)
    val max_len = if len_a > len_b { len_a } else { len_b }
    var i = 0
    while i < max_len {
        val wa = if i < len_a { list_get(a, i) } else { 0 }
        val wb = if i < len_b { list_get(b, i) } else { 0 }
        push(out, bor(wa, wb));
        i = i + 1
    }
    out
}

/// Return the bitwise intersection (A & B) of two bitsets as a new bitset.
pub def bitset_intersection(a: list<i64>, b: list<i64>) -> list<i64> {
    val out: list<i64> = list()
    val len_a = list_len(a)
    val len_b = list_len(b)
    val min_len = if len_a < len_b { len_a } else { len_b }
    var i = 0
    while i < min_len {
        val wa = list_get(a, i)
        val wb = list_get(b, i)
        push(out, band(wa, wb));
        i = i + 1
    }
    out
}

/// Return the bitwise difference (A \ B) of two bitsets as a new bitset.
pub def bitset_difference(a: list<i64>, b: list<i64>) -> list<i64> {
    val out: list<i64> = list()
    val len_a = list_len(a)
    val len_b = list_len(b)
    var i = 0
    while i < len_a {
        val wa = list_get(a, i)
        val wb = if i < len_b { list_get(b, i) } else { 0 }
        push(out, band(wa, bitnot(wb)));
        i = i + 1
    }
    out
}

/// Return the bitwise symmetric difference / XOR (A ^ B) of two bitsets as a new bitset.
pub def bitset_xor(a: list<i64>, b: list<i64>) -> list<i64> {
    val out: list<i64> = list()
    val len_a = list_len(a)
    val len_b = list_len(b)
    val max_len = if len_a > len_b { len_a } else { len_b }
    var i = 0
    while i < max_len {
        val wa = if i < len_a { list_get(a, i) } else { 0 }
        val wb = if i < len_b { list_get(b, i) } else { 0 }
        push(out, bxor(wa, wb));
        i = i + 1
    }
    out
}

/// Return true if the two bitsets share at least one common set bit.
pub def bitset_intersects(a: list<i64>, b: list<i64>) -> bool {
    val len_a = list_len(a)
    val len_b = list_len(b)
    val min_len = if len_a < len_b { len_a } else { len_b }
    var i = 0
    while i < min_len {
        val wa = list_get(a, i)
        val wb = list_get(b, i)
        if band(wa, wb) != 0 {
            return true
        }
        i = i + 1
    }
    false
}

/// Return true if `sub` is a subset of `sup` (all bits in sub are in sup).
pub def bitset_is_subset(sub: list<i64>, sup: list<i64>) -> bool {
    val len_sub = list_len(sub)
    val len_sup = list_len(sup)
    var i = 0
    while i < len_sub {
        val w_sub = list_get(sub, i)
        val w_sup = if i < len_sup { list_get(sup, i) } else { 0 }
        if band(w_sub, bitnot(w_sup)) != 0 {
            return false
        }
        i = i + 1
    }
    true
}

/// Construct a bitset from a list of integer bit positions.
pub def bitset_from_indices(indices: list<i64>) -> list<i64> {
    var bs = bitset_create()
    var i = 0
    val n = list_len(indices)
    while i < n {
        val pos = list_get(indices, i)
        if pos >= 0 {
            bs = set_bit(bs, pos);
        }
        i = i + 1
    }
    bs
}

/// Extract all set bit positions into an ordered list<i64>.
pub def bitset_to_indices(bs: list<i64>) -> list<i64> {
    val out: list<i64> = list()
    val n = list_len(bs)
    var word_idx = 0
    while word_idx < n {
        val w = list_get(bs, word_idx)
        if w != 0 {
            var bit_idx = 0
            while bit_idx < 64 {
                val pos = word_idx * 64 + bit_idx
                if get_bit(bs, pos) {
                    push(out, pos);
                }
                bit_idx = bit_idx + 1
            }
        }
        word_idx = word_idx + 1
    }
    out
}

/// Return the maximum set bit position, or -1 if the bitset is empty.
pub def bitset_max_bit(bs: list<i64>) -> i64 {
    val n = list_len(bs)
    var word_idx = n - 1
    while word_idx >= 0 {
        val w = list_get(bs, word_idx)
        if w != 0 {
            var bit_idx = 63
            while bit_idx >= 0 {
                val pos = word_idx * 64 + bit_idx
                if get_bit(bs, pos) {
                    return pos
                }
                bit_idx = bit_idx - 1
            }
        }
        word_idx = word_idx - 1
    }
    -1
}