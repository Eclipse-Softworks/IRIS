/// Draw one icon into `r` using `color` and crisp antialiased SVG vector strokes.
pub def draw_icon(
    buf: DrawBuffer,
    icon: UiIcon,
    r: UiRect,
    color: UiColor,
) -> DrawBuffer effect ffi, alloc {
    val clear = UiColor { r: 0, g: 0, b: 0, a: 0 }
    return draw_cmd_svg_path(
        buf,
        r,
        UiSize { w: 24.0, h: 24.0 },
        UiTransform {},
        icon_svg_path(icon),
        clear,
        color,
        1.75,
    )
}

/// Draw one icon with configurable stroke color, fill color, and stroke width.
pub def draw_icon_styled(
    buf: DrawBuffer,
    icon: UiIcon,
    r: UiRect,
    stroke: UiColor,
    fill: UiColor,
    stroke_w: f64,
) -> DrawBuffer effect ffi, alloc {
    return draw_cmd_svg_path(
        buf,
        r,
        UiSize { w: 24.0, h: 24.0 },
        UiTransform {},
        icon_svg_path(icon),
        fill,
        stroke,
        stroke_w,
    )
}

/// Draw an arbitrary custom 24x24 SVG path `d` string into `r`.
pub def draw_svg_icon(
    buf: DrawBuffer,
    path_data: str,
    r: UiRect,
    stroke: UiColor,
    fill: UiColor,
    stroke_w: f64,
) -> DrawBuffer effect ffi, alloc {
    return draw_cmd_svg_path(
        buf,
        r,
        UiSize { w: 24.0, h: 24.0 },
        UiTransform {},
        path_data,
        fill,
        stroke,
        stroke_w,
    )
}

/// Resolve a lowercase icon name (`"search"`, `"rocket"`, `"sun"`, etc.) to `UiIcon`.
pub def ui_icon_from_name(name: str) -> UiIcon {
    if name == "search" {
        return UiIcon.Search
    }
    if name == "plus" || name == "add" {
        return UiIcon.Plus
    }
    if name == "minus" {
        return UiIcon.Minus
    }
    if name == "close" || name == "x" {
        return UiIcon.Close
    }
    if name == "check" {
        return UiIcon.Check
    }
    if name == "chevron-left" {
        return UiIcon.ChevronLeft
    }
    if name == "chevron-right" {
        return UiIcon.ChevronRight
    }
    if name == "chevron-up" {
        return UiIcon.ChevronUp
    }
    if name == "chevron-down" {
        return UiIcon.ChevronDown
    }
    if name == "arrow-left" {
        return UiIcon.ArrowLeft
    }
    if name == "arrow-right" {
        return UiIcon.ArrowRight
    }
    if name == "arrow-up" {
        return UiIcon.ArrowUp
    }
    if name == "arrow-down" {
        return UiIcon.ArrowDown
    }
    if name == "play" {
        return UiIcon.Play
    }
    if name == "pause" {
        return UiIcon.Pause
    }
    if name == "stop" {
        return UiIcon.Stop
    }
    if name == "refresh" {
        return UiIcon.Refresh
