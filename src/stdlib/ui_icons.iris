// std.ui_icons -- resolution-independent 24x24 SVG vector icons for IRIS native UI.
//
// Icons are defined on a canonical 24x24 viewBox using SVG path syntax and
// rasterized directly by `iris_ui_host` via `draw_cmd_svg_path`, giving crisp
// antialiased curves, arcs, and strokes at any DPI or size.

pub bring std.ui_protocol
pub bring std.ui_theme

/// Built-in vector icon catalog (24x24 design grid).
pub choice UiIcon {
    Search,
    Plus,
    Minus,
    Close,
    Check,
    ChevronLeft,
    ChevronRight,
    ChevronUp,
    ChevronDown,
    ArrowLeft,
    ArrowRight,
    ArrowUp,
    ArrowDown,
    Play,
    Pause,
    Stop,
    Refresh,
    RotateCcw,
    Settings,
    Sliders,
    Brain,
    Network,
    Chart,
    Folder,
    File,
    Bolt,
    Shield,
    Eye,
    EyeOff,
    Home,
    Link,
    ExternalLink,
    Download,
    Upload,
    Copy,
    Clipboard,
    Save,
    Undo,
    Redo,
    Share,
    Spark,
    Radio,
    Layers,
    Terminal,
    Code,
    GitBranch,
    Package,
    Rocket,
    Clock,
    Calendar,
    Bell,
    Mail,
    MapPin,
    User,
    Lock,
    Unlock,
    Key,
    Filter,
    Grid,
    List,
    Trash,
    Edit,
    Star,
    Heart,
    Bookmark,
    Tag,
    Cpu,
    Database,
    Globe,
    Cloud,
    Wifi,
    Activity,
    SearchSmall,
    Info,
    Warning,
    AlertCircle,
    CheckCircle,
    HelpCircle,
    Sun,
    Moon,
    Palette,
    Menu,
    Sidebar,
    PanelLeft,
    PanelRight,
    Maximize,
    Minimize,
    Volume,
    VolumeMute,
    Camera,
    Image,
    Compass,
    LogIn,
    LogOut,
    ZoomIn,
    ZoomOut,
    Grip,
    MoreHorizontal,
    MoreVertical,
}

/// Canonical 24x24 SVG path `d` data for `icon`.
pub def icon_svg_path(icon: UiIcon) -> str {
    return when icon {
        UiIcon.Search => "M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14z M21 21l-4.35-4.35",
        UiIcon.SearchSmall => "M10 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10z M19 19l-3.8-3.8",
        UiIcon.Plus => "M12 5v14 M5 12h14",
        UiIcon.Minus => "M5 12h14",
        UiIcon.Close => "M18 6L6 18 M6 6l12 12",
        UiIcon.Check => "M20 6L9 17l-5-5",
        UiIcon.ChevronLeft => "M15 18l-6-6 6-6",
        UiIcon.ChevronRight => "M9 18l6-6-6-6",
        UiIcon.ChevronUp => "M18 15l-6-6-6 6",
        UiIcon.ChevronDown => "M6 9l6 6 6-6",
        UiIcon.ArrowLeft => "M19 12H5 M12 19l-7-7 7-7",
        UiIcon.ArrowRight => "M5 12h14 M12 5l7 7-7 7",
        UiIcon.ArrowUp => "M12 19V5 M5 12l7-7 7 7",
        UiIcon.ArrowDown => "M12 5v14 M19 12l-7 7-7-7",
