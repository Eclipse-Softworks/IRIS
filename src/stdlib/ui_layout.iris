/// Find the arena index of the first node whose `key` equals `key`.
pub def ui_find_node_key(tree: UiTree, key: str) -> option<i64> effect alloc {
    val n = list_len(tree.nodes)
    for i in 0..n {
        if list_get(tree.nodes, i).key == key {
            return some(i)
        }
    }
    return none
}

def apply_style_bounds(raw: UiSize, style: UiStyle) -> UiSize {
    var w = fmax(raw.w, style.min_w)
    var h = fmax(raw.h, style.min_h)
    // An explicit maximum wins over both the estimate and the minimum: a
    // conflicting min/max must not make a node overflow its neighbours.
    if style.max_w > 0.0 {
        w = fmin(w, style.max_w)
    }
    if style.max_h > 0.0 {
        h = fmin(h, style.max_h)
    }
    return UiSize { w: w, h: h }
}

def estimate_text_size(text: str, style: UiStyle) -> UiSize {
    val font_sz = if style.font_size > 0.0 { style.font_size } else { 14.0 }
    val lh = if style.line_height > 0.0 { style.line_height } else { font_sz * 1.4 }
    // Slightly conservative ratios: the native host shapes real glyphs, which
    // can be wider than a flat average. Under-estimating used to let labels
    // run into their neighbours before the renderer wrapped them.
    val char_ratio = if style.monospace { 0.68 } else { 0.62 }
    val raw_w = to_f64(len(text)) * font_sz * char_ratio
    if style.max_w > 0.0 && raw_w > style.max_w {
        val line_count = to_f64(((raw_w / style.max_w) to i64) + 1)
        return UiSize { w: style.max_w, h: lh * line_count }
    }
    return UiSize { w: fmax(raw_w, 8.0), h: lh }
}

def style_pad_x(st: UiStyle) -> f64 {
    return if st.pad_x >= 0.0 { st.pad_x } else { st.padding }
}

def style_pad_y(st: UiStyle) -> f64 {
    return if st.pad_y >= 0.0 { st.pad_y } else { st.padding }
}

def tree_scroll_for(tree: UiTree, key: str) -> f64 effect alloc {
    if len(key) > 0 {
        for i in 0..list_len(tree.scroll_keys) {
            if list_get(tree.scroll_keys, i) == key {
                return list_get(tree.scroll_offsets, i)
            }
        }
    }
    return tree.scroll_y
}

def tree_split_ratio(tree: UiTree, node: UiNode) -> f64 effect alloc {
    if len(node.key) > 0 {
        for i in 0..list_len(tree.split_keys) {
            if list_get(tree.split_keys, i) == node.key {
                return fmin(0.85, fmax(0.15, list_get(tree.split_ratios, i)))
            }
        }
    }
    val raw = if node.ratio > 0.0 { node.ratio } else { 0.3 }
    return fmin(0.85, fmax(0.15, raw))
}

/// Bounding rectangle of a `SplitPane` draggable divider handle.
pub def split_divider_rect(layout: UiRect, ratio: f64) -> UiRect {
    val div_w = 8.0
    val usable = fmax(0.0, layout.w - div_w)
    val left_w = fmax(40.0, usable * fmin(0.85, fmax(0.15, ratio)))
    return UiRect {
        x: layout.x + fmin(usable, left_w),
        y: layout.y,
        w: div_w,
        h: layout.h,
    }
}

/// Compute the centered card rect of an open `Modal` inside viewport `(vw, vh)`.
pub def modal_card_rect(vw: f64, vh: f64, node: UiNode) -> UiRect {
    val cw = fmin(540.0, fmax(260.0, vw - 48.0))
    val ch = fmin(vh - 64.0, fmax(220.0, node.measured.h + 64.0))
    return UiRect {
        x: fmax(16.0, (vw - cw) * 0.5),
        y: fmax(16.0, (vh - ch) * 0.5),
        w: cw,
        h: ch,
    }
}

/// Compute the docked panel rect of an open `Drawer` inside viewport `(vw, vh)`.
pub def drawer_panel_rect(vw: f64, vh: f64, node: UiNode) -> UiRect {
    val max_pw = if node.style.max_w > 0.0 { node.style.max_w } else { 360.0 }
    val pw = fmin(max_pw, fmax(240.0, vw * 0.85))
    return UiRect {
        x: fmax(0.0, vw - pw),
        y: 0.0,
        w: pw,
        h: vh,
    }
}

def tabs_total_width(tree: UiTree, node: UiNode, is_segmented: bool) -> f64 effect alloc {
    if node.data_idx < 0 || node.data_idx >= list_len(tree.tabs_specs) {
        return 200.0
    }
    val spec = list_get(tree.tabs_specs, node.data_idx)
    val n = list_len(spec.labels)
    if n == 0 {
        return 140.0
    }
    var sum_w = 0.0
    for i in 0..n {
        val lbl = list_get(spec.labels, i)
        sum_w = sum_w + to_f64(len(lbl)) * 8.2 + if is_segmented { 24.0 } else { 28.0 }
    }
    return fmax(160.0, sum_w)
}

def select_measured_size(tree: UiTree, node: UiNode) -> UiSize effect alloc {
    var best_w = to_f64(len(node.placeholder)) * 8.0
    if node.data_idx >= 0 && node.data_idx < list_len(tree.selects) {
        val spec = list_get(tree.selects, node.data_idx)
        for i in 0..list_len(spec.options) {
            val ow = to_f64(len(list_get(spec.options, i))) * 8.4
            best_w = fmax(best_w, ow)
        }
    }
    return UiSize { w: fmax(160.0, best_w + 44.0), h: 36.0 }
}

def estimate_leaf_size_in(tree: UiTree, node: UiNode) -> UiSize effect alloc {
    val txt_sz = estimate_text_size(node.text, node.style)
    val ph_sz = estimate_text_size(node.placeholder, node.style)
    val pad_x2 = style_pad_x(node.style) * 2.0
    val pad_y2 = style_pad_y(node.style) * 2.0
    return when node.kind {
        WidgetKind.Spacer => UiSize {
            w: fmax(8.0, node.style.min_w),
            h: fmax(8.0, node.style.min_h),
        },
        WidgetKind.Label => UiSize { w: txt_sz.w + pad_x2, h: txt_sz.h + pad_y2 },
        WidgetKind.Badge => UiSize { w: txt_sz.w + 18.0, h: fmax(22.0, txt_sz.h + 4.0) },
        WidgetKind.Button => UiSize { w: txt_sz.w + 28.0, h: fmax(34.0, txt_sz.h + 14.0) },
        WidgetKind.TextInput => UiSize {
            w: fmax(180.0, fmax(txt_sz.w, ph_sz.w) + 24.0),
            h: fmax(36.0, txt_sz.h + 14.0),
        },
        WidgetKind.Checkbox => UiSize { w: txt_sz.w + 30.0, h: fmax(26.0, txt_sz.h + 6.0) },
        WidgetKind.Toggle => UiSize { w: txt_sz.w + 54.0, h: fmax(28.0, txt_sz.h + 6.0) },
        WidgetKind.Slider => UiSize {
            w: fmax(170.0, txt_sz.w + 40.0),
            h: if len(node.text) > 0 { 42.0 } else { 28.0 },
        },
        WidgetKind.Sparkline => UiSize { w: 160.0, h: 42.0 },
        WidgetKind.LineChart => UiSize { w: 260.0, h: 150.0 },
        WidgetKind.RadarScope => UiSize { w: 260.0, h: 260.0 },
        WidgetKind.TensorView => UiSize { w: 220.0, h: 160.0 },
        WidgetKind.TableHeader => UiSize { w: fmax(220.0, txt_sz.w + 20.0), h: 28.0 },
        WidgetKind.TableRow => UiSize { w: fmax(220.0, txt_sz.w + 20.0), h: 26.0 },
        WidgetKind.Divider => UiSize {
            w: fmax(24.0, node.style.min_w),
            h: if node.style.min_h > 0.0 { node.style.min_h } else { 12.0 },
        },
        WidgetKind.Icon => UiSize {
            w: fmax(22.0, node.style.min_w),
            h: fmax(22.0, node.style.min_h),
        },
        WidgetKind.IconButton => UiSize {
            w: fmax(34.0, if len(node.text) > 0 { txt_sz.w + 42.0 } else { 34.0 }),
            h: 34.0,
        },
        WidgetKind.Radio => UiSize { w: txt_sz.w + 30.0, h: fmax(26.0, txt_sz.h + 6.0) },
        WidgetKind.Select => select_measured_size(tree, node),
        WidgetKind.Tabs => UiSize { w: tabs_total_width(tree, node, false), h: 36.0 },
        WidgetKind.Segmented => UiSize { w: tabs_total_width(tree, node, true), h: 34.0 },
        WidgetKind.Stepper => UiSize {
            w: fmax(148.0, txt_sz.w + 112.0),
            h: 34.0,
        },
        WidgetKind.NavItem => UiSize {
            w: fmax(160.0, txt_sz.w + 56.0),
            h: 36.0,
        },
        WidgetKind.Chip => UiSize {
            w: fmax(56.0, txt_sz.w + 28.0),
            h: 28.0,
        },
        WidgetKind.TextArea => UiSize {
            w: fmax(220.0, node.style.min_w),
            h: fmax(92.0, node.style.min_h),
        },
        WidgetKind.ProgressBar => UiSize {
            w: fmax(160.0, node.style.min_w),
            h: if len(node.text) > 0 { 30.0 } else { 14.0 },
        },
        WidgetKind.ProgressRing => UiSize { w: 76.0, h: 76.0 },
        WidgetKind.Spinner => UiSize { w: 32.0, h: 32.0 },
        WidgetKind.Avatar => UiSize { w: 40.0, h: 40.0 },
        WidgetKind.StatCard => UiSize { w: 185.0, h: 92.0 },
        WidgetKind.BarChart => UiSize { w: 260.0, h: 165.0 },
        WidgetKind.Breadcrumb => UiSize { w: tabs_total_width(tree, node, false), h: 28.0 },
        WidgetKind.Image => UiSize { w: 200.0, h: 140.0 },
        WidgetKind.Menu => UiSize { w: fmax(110.0, txt_sz.w + 36.0), h: 34.0 },
        WidgetKind.Col => UiSize { w: 0.0, h: 0.0 },
        WidgetKind.Row => UiSize { w: 0.0, h: 0.0 },
        WidgetKind.Stack => UiSize { w: 0.0, h: 0.0 },
        WidgetKind.Card => UiSize { w: 0.0, h: 0.0 },
        WidgetKind.Wrap => UiSize { w: 0.0, h: 0.0 },
        WidgetKind.Grid => UiSize { w: 0.0, h: 0.0 },
        WidgetKind.SplitPane => UiSize { w: 0.0, h: 0.0 },
        WidgetKind.Accordion => UiSize { w: 0.0, h: 0.0 },
        WidgetKind.Modal => UiSize { w: 0.0, h: 0.0 },
        WidgetKind.Drawer => UiSize { w: 0.0, h: 0.0 },
    }
}

def is_overlay_container(kind: WidgetKind) -> bool {
    return when kind {
        WidgetKind.Modal => true,
        WidgetKind.Drawer => true,
        _ => false,
    }
}

def measure_col_like(tree: UiTree, node: UiNode) -> UiSize effect alloc {
    val cc = list_len(node.children)
    val px2 = style_pad_x(node.style) * 2.0
    val py2 = style_pad_y(node.style) * 2.0
    var max_w = 0.0
    var sum_h = 0.0
    var flow_count = 0
    for j in 0..cc {
        val c = list_get(tree.nodes, list_get(node.children, j))
        if !is_overlay_container(c.kind) {
            max_w = fmax(max_w, c.measured.w)
            sum_h = sum_h + c.measured.h
            flow_count = flow_count + 1
        }
    }
    val gaps = if flow_count > 1 { node.style.gap * to_f64(flow_count - 1) } else { 0.0 }
    return UiSize { w: max_w + px2, h: sum_h + gaps + py2 }
}

def measure_row_like(tree: UiTree, node: UiNode) -> UiSize effect alloc {
    val cc = list_len(node.children)
    val px2 = style_pad_x(node.style) * 2.0
    val py2 = style_pad_y(node.style) * 2.0
    var sum_w = 0.0
    var max_h = 0.0
    var flow_count = 0
    for j in 0..cc {
        val c = list_get(tree.nodes, list_get(node.children, j))
        if !is_overlay_container(c.kind) {
            sum_w = sum_w + c.measured.w
            max_h = fmax(max_h, c.measured.h)
            flow_count = flow_count + 1
        }
    }
    val gaps = if flow_count > 1 { node.style.gap * to_f64(flow_count - 1) } else { 0.0 }
    return UiSize { w: sum_w + gaps + px2, h: max_h + py2 }
}

def measure_stack_like(tree: UiTree, node: UiNode) -> UiSize effect alloc {
    val cc = list_len(node.children)
    val px2 = style_pad_x(node.style) * 2.0
    val py2 = style_pad_y(node.style) * 2.0
    var max_w = 0.0
    var max_h = 0.0
    for j in 0..cc {
        val c = list_get(tree.nodes, list_get(node.children, j))
        if !is_overlay_container(c.kind) {
            max_w = fmax(max_w, c.measured.w)
            max_h = fmax(max_h, c.measured.h)
        }
    }
    return UiSize { w: max_w + px2, h: max_h + py2 }
}

def measure_wrap_like(tree: UiTree, node: UiNode) -> UiSize effect alloc {
    val cc = list_len(node.children)
    val px2 = style_pad_x(node.style) * 2.0
    val py2 = style_pad_y(node.style) * 2.0
    val limit = if node.style.max_w > 0.0 { fmax(80.0, node.style.max_w - px2) } else { 480.0 }
    var line_w = 0.0
    var line_h = 0.0
    var max_w = 0.0
    var total_h = 0.0
    for j in 0..cc {
        val cm = list_get(tree.nodes, list_get(node.children, j)).measured
        if line_w > 0.0 && line_w + node.style.gap + cm.w > limit {
            max_w = fmax(max_w, line_w)
            total_h = total_h + line_h + node.style.gap
            line_w = cm.w
            line_h = cm.h
        } else {
            line_w = if line_w > 0.0 { line_w + node.style.gap + cm.w } else { cm.w }
            line_h = fmax(line_h, cm.h)
        }
    }
    max_w = fmax(max_w, line_w)
    total_h = total_h + line_h
    return UiSize { w: max_w + px2, h: total_h + py2 }
}

def measure_grid_like(tree: UiTree, node: UiNode) -> UiSize effect alloc {
    val cc = list_len(node.children)
    val cols = if node.style.columns > 0 { node.style.columns } else { 2 }
    val px2 = style_pad_x(node.style) * 2.0
    val py2 = style_pad_y(node.style) * 2.0
    var max_cell_w = 0.0
    var sum_row_h = 0.0
    var row_h = 0.0
    var col_idx = 0
    for j in 0..cc {
        val cm = list_get(tree.nodes, list_get(node.children, j)).measured
        max_cell_w = fmax(max_cell_w, cm.w)
        row_h = fmax(row_h, cm.h)
        col_idx = col_idx + 1
        if col_idx >= cols || j == cc - 1 {
            sum_row_h = sum_row_h + row_h
            row_h = 0.0
            col_idx = 0
        }
    }
    val rows = if cc == 0 { 0 } else { (cc + cols - 1) / cols }
    val h_gaps = if cols > 1 { node.style.gap * to_f64(cols - 1) } else { 0.0 }
    val v_gaps = if rows > 1 { node.style.gap * to_f64(rows - 1) } else { 0.0 }
    return UiSize {
        w: max_cell_w * to_f64(cols) + h_gaps + px2,
        h: sum_row_h + v_gaps + py2,
    }
}

def measure_split_like(tree: UiTree, node: UiNode) -> UiSize effect alloc {
    val cc = list_len(node.children)
    val px2 = style_pad_x(node.style) * 2.0
    val py2 = style_pad_y(node.style) * 2.0
    var sum_w = 8.0
    var max_h = 120.0
    for j in 0..cc {
        val cm = list_get(tree.nodes, list_get(node.children, j)).measured
        sum_w = sum_w + cm.w
        max_h = fmax(max_h, cm.h)
    }
    return UiSize { w: sum_w + px2, h: max_h + py2 }
}

def measure_accordion_like(tree: UiTree, node: UiNode) -> UiSize effect alloc {
    val body = measure_col_like(tree, node)
    val txt_sz = estimate_text_size(node.text, node.style)
    val w = fmax(fmax(220.0, txt_sz.w + 48.0), body.w + 16.0)
    if !node.open {
        return UiSize { w: w, h: 40.0 }
    }
    return UiSize { w: w, h: 44.0 + body.h }
}

def measure_overlay_content(tree: UiTree, node: UiNode) -> UiSize effect alloc {
    val inner = measure_col_like(tree, node)
    return UiSize { w: fmax(300.0, inner.w), h: fmax(160.0, inner.h) }
}

def update_node_measured(tree: UiTree, idx: i64, sz: UiSize) -> i64 effect alloc {
    val n = list_get(tree.nodes, idx)
    list_set(tree.nodes, idx, clone_node_with(n, n.id, n.layout, sz))
    return 0
}

def update_node_layout(tree: UiTree, idx: i64, r: UiRect) -> i64 effect alloc {
    val n = list_get(tree.nodes, idx)
    list_set(tree.nodes, idx, clone_node_with(n, n.id, r, n.measured))
    return 0
}

def measure_pass(tree: UiTree) -> i64 effect alloc {
    val n = list_len(tree.nodes)
    for i in 0..n {
        val node = list_get(tree.nodes, i)
        val raw = when node.kind {
            WidgetKind.Col => measure_col_like(tree, node),
            WidgetKind.Card => measure_col_like(tree, node),
            WidgetKind.Row => measure_row_like(tree, node),
            WidgetKind.Stack => measure_stack_like(tree, node),
            WidgetKind.Wrap => measure_wrap_like(tree, node),
            WidgetKind.Grid => measure_grid_like(tree, node),
            WidgetKind.SplitPane => measure_split_like(tree, node),
            WidgetKind.Accordion => measure_accordion_like(tree, node),
            WidgetKind.Modal => measure_overlay_content(tree, node),
            WidgetKind.Drawer => measure_overlay_content(tree, node),
            _ => estimate_leaf_size_in(tree, node),
        }
        val _u = update_node_measured(tree, i, apply_style_bounds(raw, node.style))
    }
    return 0
}

def align_pos(start: f64, avail: f64, size: f64, align: UiAlign) -> f64 {
    return when align {
        UiAlign.Center => start + fmax(0.0, (avail - size) * 0.5),
        UiAlign.End => start + fmax(0.0, avail - size),
        UiAlign.Start => start,
        UiAlign.Stretch => start,
    }
}

def justify_start_offset(justify: UiJustify, extra: f64, count: i64) -> f64 {
    if extra <= 0.0 || count <= 0 {
        return 0.0
    }
    return when justify {
        UiJustify.Start => 0.0,
        UiJustify.Center => extra * 0.5,
        UiJustify.End => extra,
        UiJustify.SpaceBetween => 0.0,
        UiJustify.SpaceAround => extra / to_f64(count) * 0.5,
        UiJustify.SpaceEvenly => extra / to_f64(count + 1),
    }
}

def justify_gap(justify: UiJustify, base_gap: f64, extra: f64, count: i64) -> f64 {
    if extra <= 0.0 || count <= 0 {
        return base_gap
    }
    return when justify {
        UiJustify.SpaceBetween => if count > 1 {
            base_gap + extra / to_f64(count - 1)
        } else {
            base_gap
        },
        UiJustify.SpaceAround => base_gap + extra / to_f64(count),
        UiJustify.SpaceEvenly => base_gap + extra / to_f64(count + 1),
        _ => base_gap,
    }
}

def child_span_on_cross(avail: f64, measured: f64, style: UiStyle) -> f64 {
    return when style.align {
        UiAlign.Stretch => avail,
        _ => fmin(avail, measured),
    }
}

def is_col_stretch_widget(kind: WidgetKind) -> bool {
    return when kind {
        WidgetKind.Col => true,
        WidgetKind.Row => true,
        WidgetKind.Stack => true,
        WidgetKind.Card => true,
        WidgetKind.Wrap => true,
        WidgetKind.Grid => true,
        WidgetKind.SplitPane => true,
        WidgetKind.Accordion => true,
        WidgetKind.Divider => true,
        WidgetKind.TextInput => true,
        WidgetKind.TextArea => true,
        WidgetKind.Slider => true,
        WidgetKind.ProgressBar => true,
        WidgetKind.Select => true,
        WidgetKind.Tabs => true,
        WidgetKind.Segmented => true,
        WidgetKind.NavItem => true,
        WidgetKind.StatCard => true,
        WidgetKind.BarChart => true,
        WidgetKind.Sparkline => true,
        WidgetKind.LineChart => true,
        WidgetKind.RadarScope => true,
        WidgetKind.TensorView => true,
        WidgetKind.Image => true,
        WidgetKind.TableHeader => true,
        WidgetKind.TableRow => true,
        _ => false,
    }
}

def col_child_width(iw: f64, c: UiNode) -> f64 {
    val want_stretch = when c.style.align {
        UiAlign.Stretch => true,
        UiAlign.Start => is_col_stretch_widget(c.kind) && c.style.max_w == 0.0,
        _ => false,
    }
    return if want_stretch { iw } else { fmin(iw, c.measured.w) }
}

def arrange_col_rect(
    tree: UiTree,
    node: UiNode,
    bounds: UiRect,
    pad_x: f64,
    pad_y: f64,
    scroll_y: f64,
    work: list<i64>,
) -> i64 effect alloc {
    val cc = list_len(node.children)
    if cc == 0 {
        return 0
    }
    val ix = bounds.x + pad_x
    val iy = bounds.y + pad_y
    val iw = fmax(0.0, bounds.w - pad_x * 2.0)
    val ih = fmax(0.0, bounds.h - pad_y * 2.0)
    var fixed_h = 0.0
    var flex_sum = 0.0
    var flow_count = 0
    for j in 0..cc {
        val c = list_get(tree.nodes, list_get(node.children, j))
        if is_overlay_container(c.kind) {
            list_push(work, list_get(node.children, j))
        } else {
            flow_count = flow_count + 1
            if c.style.flex > 0.0 {
                flex_sum = flex_sum + c.style.flex
            } else {
                fixed_h = fixed_h + c.measured.h
            }
        }
    }
    if flow_count == 0 {
        return 0
    }
    val gaps = node.style.gap * to_f64(flow_count - 1)
    val flex_avail = fmax(0.0, ih - fixed_h - gaps)
    var overflow_scale = 1.0
    val total_fixed = fixed_h + gaps
    if !node.style.scrollable && ih > 0.0 && total_fixed > ih {
        overflow_scale = ih / total_fixed
    }
    val used_h = if flex_sum > 0.0 {
        ih
    } else {
        fixed_h * overflow_scale + gaps
    }
    val extra = if node.style.scrollable { 0.0 } else { fmax(0.0, ih - used_h) }
    val clamped_scroll = if node.style.scrollable {
        fmin(scroll_y, fmax(0.0, total_fixed - ih))
    } else {
        0.0
    }
    var cy = iy + justify_start_offset(node.style.justify, extra, flow_count) - clamped_scroll
    val step_gap = justify_gap(node.style.justify, node.style.gap, extra, flow_count)
    for j in 0..cc {
        val cid = list_get(node.children, j)
        val c = list_get(tree.nodes, cid)
        if !is_overlay_container(c.kind) {
            val ch = if c.style.flex > 0.0 && flex_sum > 0.0 {
                flex_avail * (c.style.flex / flex_sum)
            } else {
                c.measured.h * overflow_scale
            }
            val bounded_h = if c.style.max_h > 0.0 { fmin(ch, c.style.max_h) } else { ch }
            val final_h = fmax(bounded_h, c.style.min_h)
            val cw = col_child_width(iw, c)
            val cx = align_pos(ix, iw, cw, c.style.align)
            val _u = update_node_layout(tree, cid, UiRect { x: cx, y: cy, w: cw, h: final_h })
            list_push(work, cid)
            cy = cy + final_h + step_gap
        }
    }
    return 0
}

def arrange_col_children(tree: UiTree, node: UiNode, work: list<i64>) -> i64 effect alloc {
    val px = style_pad_x(node.style)
    val py = style_pad_y(node.style)
    val scroll_y = if node.style.scrollable { tree_scroll_for(tree, node.key) } else { 0.0 }
    return arrange_col_rect(tree, node, node.layout, px, py, scroll_y, work)
}

def arrange_row_children(tree: UiTree, node: UiNode, work: list<i64>) -> i64 effect alloc {
    val cc = list_len(node.children)
    if cc == 0 {
        return 0
    }
    val px = style_pad_x(node.style)
    val py = style_pad_y(node.style)
    val ix = node.layout.x + px
    val iy = node.layout.y + py
    val iw = fmax(0.0, node.layout.w - px * 2.0)
    val ih = fmax(0.0, node.layout.h - py * 2.0)
    var fixed_w = 0.0
    var flex_sum = 0.0
    var flow_count = 0
    for j in 0..cc {
        val cid = list_get(node.children, j)
        val c = list_get(tree.nodes, cid)
        if is_overlay_container(c.kind) {
            list_push(work, cid)
        } else {
            flow_count = flow_count + 1
            if c.style.flex > 0.0 {
                flex_sum = flex_sum + c.style.flex
            } else {
                fixed_w = fixed_w + c.measured.w
            }
        }
    }
    if flow_count == 0 {
        return 0
    }
    val gaps = node.style.gap * to_f64(flow_count - 1)
    val flex_avail = fmax(0.0, iw - fixed_w - gaps)
    var overflow_scale = 1.0
    val total_fixed = fixed_w + gaps
    if iw > 0.0 && total_fixed > iw {
        overflow_scale = iw / total_fixed
    }
    val used_w = if flex_sum > 0.0 { iw } else { fixed_w * overflow_scale + gaps }
    val extra = fmax(0.0, iw - used_w)
    var cx = ix + justify_start_offset(node.style.justify, extra, flow_count)
    val step_gap = justify_gap(node.style.justify, node.style.gap, extra, flow_count)
    for j in 0..cc {
        val cid = list_get(node.children, j)
        val c = list_get(tree.nodes, cid)
        if !is_overlay_container(c.kind) {
            val cw = if c.style.flex > 0.0 && flex_sum > 0.0 {
                flex_avail * (c.style.flex / flex_sum)
            } else {
                c.measured.w * overflow_scale
            }
            val bounded_w = if c.style.max_w > 0.0 { fmin(cw, c.style.max_w) } else { cw }
            val final_w = fmax(bounded_w, c.style.min_w)
            val ch = child_span_on_cross(ih, c.measured.h, c.style)
            val cy = align_pos(iy, ih, ch, c.style.align)
            val _u = update_node_layout(tree, cid, UiRect { x: cx, y: cy, w: final_w, h: ch })
            list_push(work, cid)
            cx = cx + final_w + step_gap
        }
    }
    return 0
}

def arrange_stack_children(tree: UiTree, node: UiNode, work: list<i64>) -> i64 effect alloc {
    val cc = list_len(node.children)
    val px = style_pad_x(node.style)
    val py = style_pad_y(node.style)
    val ix = node.layout.x + px
    val iy = node.layout.y + py
    val iw = fmax(0.0, node.layout.w - px * 2.0)
    val ih = fmax(0.0, node.layout.h - py * 2.0)
    for j in 0..cc {
        val cid = list_get(node.children, j)
        val c = list_get(tree.nodes, cid)
        if is_overlay_container(c.kind) {
            list_push(work, cid)
        } else {
            val cw = child_span_on_cross(iw, c.measured.w, c.style)
            val ch = child_span_on_cross(ih, c.measured.h, c.style)
            val cx = align_pos(ix, iw, cw, c.style.align)
            val cy = align_pos(iy, ih, ch, c.style.align)
            val _u = update_node_layout(tree, cid, UiRect { x: cx, y: cy, w: cw, h: ch })
            list_push(work, cid)
        }
    }
    return 0
}

def arrange_wrap_children(tree: UiTree, node: UiNode, work: list<i64>) -> i64 effect alloc {
    val cc = list_len(node.children)
    if cc == 0 {
        return 0
    }
    val px = style_pad_x(node.style)
    val py = style_pad_y(node.style)
    val ix = node.layout.x + px
    val iy = node.layout.y + py
    val iw = fmax(0.0, node.layout.w - px * 2.0)
    var cx = ix
    var cy = iy
    var row_h = 0.0
    for j in 0..cc {
        val cid = list_get(node.children, j)
        val c = list_get(tree.nodes, cid)
        val cw = fmin(iw, fmax(c.style.min_w, c.measured.w))
        val ch = fmax(c.style.min_h, c.measured.h)
        if cx > ix && cx + cw > ix + iw {
            cx = ix
            cy = cy + row_h + node.style.gap
            row_h = 0.0
        }
        val _u = update_node_layout(tree, cid, UiRect { x: cx, y: cy, w: cw, h: ch })
        list_push(work, cid)
        cx = cx + cw + node.style.gap
        row_h = fmax(row_h, ch)
    }
    return 0
}

def arrange_grid_children(tree: UiTree, node: UiNode, work: list<i64>) -> i64 effect alloc {
    val cc = list_len(node.children)
    if cc == 0 {
        return 0
    }
    val cols = if node.style.columns > 0 { node.style.columns } else { 2 }
    val px = style_pad_x(node.style)
    val py = style_pad_y(node.style)
    val ix = node.layout.x + px
    val iy = node.layout.y + py
    val iw = fmax(0.0, node.layout.w - px * 2.0)
    val h_gaps = if cols > 1 { node.style.gap * to_f64(cols - 1) } else { 0.0 }
    val cell_w = fmax(24.0, (iw - h_gaps) / to_f64(cols))
    var cur_y = iy
    var row_start = 0
    while row_start < cc {
        val row_end = if row_start + cols < cc { row_start + cols } else { cc }
        var row_h = 0.0
        for j in row_start..row_end {
            val c = list_get(tree.nodes, list_get(node.children, j))
            row_h = fmax(row_h, fmax(c.style.min_h, c.measured.h))
        }
        for j in row_start..row_end {
            val col = j - row_start
            val cid = list_get(node.children, j)
            val cx = ix + to_f64(col) * (cell_w + node.style.gap)
            val _u = update_node_layout(tree, cid, UiRect { x: cx, y: cur_y, w: cell_w, h: row_h })
            list_push(work, cid)
        }
        cur_y = cur_y + row_h + node.style.gap
        row_start = row_end
    }
    return 0
}

def arrange_split_pane_children(tree: UiTree, node: UiNode, work: list<i64>) -> i64 effect alloc {
    val cc = list_len(node.children)
    if cc == 0 {
        return 0
    }
    val px = style_pad_x(node.style)
    val py = style_pad_y(node.style)
    val ix = node.layout.x + px
    val iy = node.layout.y + py
    val iw = fmax(0.0, node.layout.w - px * 2.0)
    val ih = fmax(0.0, node.layout.h - py * 2.0)
    val ratio = tree_split_ratio(tree, node)
    val div = split_divider_rect(UiRect { x: ix, y: iy, w: iw, h: ih }, ratio)
    val c0 = list_get(node.children, 0)
    val lw = fmax(0.0, div.x - ix)
    val _u0 = update_node_layout(tree, c0, UiRect { x: ix, y: iy, w: lw, h: ih })
    list_push(work, c0)
    if cc >= 2 {
        val c1 = list_get(node.children, 1)
        val rx = div.x + div.w
        val rw = fmax(0.0, ix + iw - rx)
        val _u1 = update_node_layout(tree, c1, UiRect { x: rx, y: iy, w: rw, h: ih })
        list_push(work, c1)
    }
    return 0
}

def arrange_accordion_children(tree: UiTree, node: UiNode, work: list<i64>) -> i64 effect alloc {
    val cc = list_len(node.children)
    if cc == 0 {
        return 0
    }
    if !node.open {
        for j in 0..cc {
            val _z = update_node_layout(tree, list_get(node.children, j), UiRect {})
        }
        return 0
    }
    val body_rect = UiRect {
        x: node.layout.x,
        y: node.layout.y + 38.0,
        w: node.layout.w,
        h: fmax(0.0, node.layout.h - 38.0),
    }
    return arrange_col_rect(tree, node, body_rect, 10.0, 8.0, 0.0, work)
}

def arrange_overlay_children(
    tree: UiTree,
    node: UiNode,
    vw: f64,
    vh: f64,
    is_modal: bool,
    work: list<i64>,
) -> i64 effect alloc {
    val cc = list_len(node.children)
    if !node.open {
        val _z0 = update_node_layout(tree, node.id, UiRect {})
        for j in 0..cc {
            val _zc = update_node_layout(tree, list_get(node.children, j), UiRect {})
        }
        return 0
    }
    val _vp = update_node_layout(tree, node.id, UiRect { x: 0.0, y: 0.0, w: vw, h: vh })
    val card = if is_modal {
        modal_card_rect(vw, vh, node)
    } else {
        drawer_panel_rect(vw, vh, node)
    }
    return arrange_col_rect(tree, node, card, 20.0, 18.0, 0.0, work)
}

/// Run two-pass iterative $O(N)$ layout resolving logical `UiRect` bounds for all nodes.
pub def ui_layout(tree: UiTree, viewport_w: f64, viewport_h: f64) -> UiTree effect alloc {
    val _m = measure_pass(tree)
    if tree.root >= 0 && tree.root < list_len(tree.nodes) {
        val _r = update_node_layout(
            tree,
            tree.root,
            UiRect { x: 0.0, y: 0.0, w: viewport_w, h: viewport_h },
        )
        val work: list<i64> = list()
        list_push(work, tree.root)
        var head = 0
        while head < list_len(work) {
            val cur = list_get(work, head)
            head = head + 1
            val node = list_get(tree.nodes, cur)
            val _a = when node.kind {
                WidgetKind.Col => arrange_col_children(tree, node, work),
                WidgetKind.Card => arrange_col_children(tree, node, work),
                WidgetKind.Row => arrange_row_children(tree, node, work),
                WidgetKind.Stack => arrange_stack_children(tree, node, work),
                WidgetKind.Wrap => arrange_wrap_children(tree, node, work),
                WidgetKind.Grid => arrange_grid_children(tree, node, work),
                WidgetKind.SplitPane => arrange_split_pane_children(tree, node, work),
                WidgetKind.Accordion => arrange_accordion_children(tree, node, work),
                WidgetKind.Modal => arrange_overlay_children(
                    tree,
                    node,
                    viewport_w,
                    viewport_h,
                    true,
                    work,
                ),
                WidgetKind.Drawer => arrange_overlay_children(
                    tree,
                    node,
                    viewport_w,
                    viewport_h,
                    false,
                    work,
                ),
                _ => 0,
            }
        }
    }
    return clone_tree_with(tree, tree.root, viewport_w, viewport_h, tree.scroll_y)
}

/// Layout with an explicit vertical scroll offset for scrollable columns.
pub def ui_layout_scrolled(
    tree: UiTree,
    viewport_w: f64,
    viewport_h: f64,
    scroll_y: f64,
) -> UiTree effect alloc {
    val clamped = if scroll_y > 0.0 { scroll_y } else { 0.0 }
    return ui_layout(
        clone_tree_with(tree, tree.root, tree.width, tree.height, clamped),
        viewport_w,
        viewport_h,
    )
}

/// Layout `tree` synchronized with per-container scroll offsets and split ratios stored in `state`.
pub def ui_layout_with_state(
    tree: UiTree,
    state: UiState,
    viewport_w: f64,
    viewport_h: f64,
) -> UiTree effect alloc {
    val prepared = UiTree {
        theme: tree.theme,
        root: tree.root,
        nodes: tree.nodes,
        charts: tree.charts,
        radars: tree.radars,
        tensors: tree.tensors,
        width: tree.width,
        height: tree.height,
        scroll_y: if state.scroll_offset > 0.0 { state.scroll_offset } else { 0.0 },
        selects: tree.selects,
        tabs_specs: tree.tabs_specs,
        bar_charts: tree.bar_charts,
        images: tree.images,
        stats: tree.stats,
        menus: tree.menus,
        scroll_keys: state.extras.scroll_keys,
        scroll_offsets: state.extras.scroll_offsets,
        split_keys: state.extras.split_keys,
        split_ratios: state.extras.split_ratios,
    }
    return ui_layout(prepared, viewport_w, viewport_h)
}

def is_interactive_kind(kind: WidgetKind) -> bool {
    return when kind {
        WidgetKind.Button => true,
        WidgetKind.TextInput => true,
        WidgetKind.Checkbox => true,
        WidgetKind.Toggle => true,
        WidgetKind.Slider => true,
        WidgetKind.TableRow => true,
        WidgetKind.IconButton => true,
        WidgetKind.Radio => true,
        WidgetKind.Select => true,
        WidgetKind.Tabs => true,
        WidgetKind.Segmented => true,
        WidgetKind.Stepper => true,
        WidgetKind.NavItem => true,
        WidgetKind.Accordion => true,
        WidgetKind.Chip => true,
        WidgetKind.TextArea => true,
        WidgetKind.SplitPane => true,
        WidgetKind.Breadcrumb => true,
        WidgetKind.Menu => true,
        WidgetKind.Modal => true,
        WidgetKind.Drawer => true,
        _ => false,
    }
}

def is_interactive_node(node: UiNode) -> bool {
    if is_interactive_kind(node.kind) {
        return true
    }
    return when node.kind {
        WidgetKind.RadarScope => len(node.action) > 0,
        _ => false,
    }
}

/// Only list-like rows participate in built-in multi-select/drag. Buttons,
/// toggles, sliders and text inputs stay ordinary controls, so clicking a
/// toolbar button never replaces the user's list selection.
def is_selectable_node(node: UiNode) -> bool {
    return when node.kind {
        WidgetKind.TableRow => true,
        _ => false,
    }
}

def is_container_kind(kind: WidgetKind) -> bool {
    return when kind {
        WidgetKind.Col => true,
        WidgetKind.Row => true,
        WidgetKind.Stack => true,
        WidgetKind.Card => true,
        WidgetKind.Spacer => true,
        WidgetKind.Wrap => true,
        WidgetKind.Grid => true,
        WidgetKind.SplitPane => true,
        WidgetKind.Accordion => true,
        WidgetKind.Modal => true,
        WidgetKind.Drawer => true,
        _ => false,
    }
}

def node_hit_matches(tree: UiTree, node: UiNode, px: f64, py: f64) -> bool effect alloc {
    return when node.kind {
        WidgetKind.SplitPane => {
            val ix = node.layout.x + style_pad_x(node.style)
            val iy = node.layout.y + style_pad_y(node.style)
            val iw = fmax(0.0, node.layout.w - style_pad_x(node.style) * 2.0)
            val ih = fmax(0.0, node.layout.h - style_pad_y(node.style) * 2.0)
            val dr = split_divider_rect(
                UiRect { x: ix, y: iy, w: iw, h: ih },
                tree_split_ratio(tree, node),
            )
            rect_contains(UiRect { x: dr.x - 4.0, y: dr.y, w: dr.w + 8.0, h: dr.h }, px, py)
        },
        WidgetKind.Accordion => rect_contains(
            UiRect {
                x: node.layout.x,
                y: node.layout.y,
                w: node.layout.w,
                h: fmin(node.layout.h, 38.0),
            },
            px,
            py,
        ),
        WidgetKind.Modal => node.open,
        WidgetKind.Drawer => node.open,
        _ => rect_contains(node.layout, px, py),
    }
}

def collect_subtree_ids(tree: UiTree, root_idx: i64) -> list<i64> effect alloc {
    val out: list<i64> = list()
    val stack: list<i64> = list()
    list_push(stack, root_idx)
    while list_len(stack) > 0 {
        val id = list_pop(stack)
        list_push(out, id)
        val n = list_get(tree.nodes, id)
        for j in 0..list_len(n.children) {
            list_push(stack, list_get(n.children, j))
        }
    }
    return out
}

/// Find the topmost interactive (or visible leaf) widget under logical `(px, py)`.
pub def ui_hit_test(tree: UiTree, px: f64, py: f64) -> option<i64> effect alloc {
    val n = list_len(tree.nodes)
    // Open Modal / Drawer intercepts pointer hits across the viewport.
    var ov = n - 1
    while ov >= 0 {
        val candidate = list_get(tree.nodes, ov)
        if is_overlay_container(candidate.kind) && candidate.open {
            val sub = collect_subtree_ids(tree, ov)
            var s = list_len(sub) - 1
            while s >= 0 {
                val sid = list_get(sub, s)
                if sid != ov {
                    val sn = list_get(tree.nodes, sid)
                    if is_interactive_node(sn) && node_hit_matches(tree, sn, px, py) {
                        return some(sid)
                    }
                }
                s = s - 1
            }
            return some(ov)
        }
        ov = ov - 1
    }
    var i = n - 1
    while i >= 0 {
        val node = list_get(tree.nodes, i)
        if !is_overlay_container(node.kind)
            && is_interactive_node(node)
            && node_hit_matches(tree, node, px, py) {
            return some(i)
        }
        i = i - 1
    }
    var j = n - 1
    while j >= 0 {
        val leaf = list_get(tree.nodes, j)
        if !is_container_kind(leaf.kind) && rect_contains(leaf.layout, px, py) {
            return some(j)
        }
        j = j - 1
    }
    return none
}

/// Look up the laid-out rectangle of a widget by its stable key.
/// Returns an empty rect when the key is absent (before layout or after a
/// tree rebuild). Useful for overlay painters in `std.ui_widgets`.
pub def ui_node_rect(tree: UiTree, key: str) -> UiRect effect alloc {
    var i = 0
    while i < list_len(tree.nodes) {
        val node = list_get(tree.nodes, i)
        if node.key == key {
            return node.layout
        }
        i = i + 1
    }
    return UiRect {}
}

/// True when a key is present in the laid-out tree.
pub def ui_has_node(tree: UiTree, key: str) -> bool effect alloc {
    var i = 0
    while i < list_len(tree.nodes) {
        if list_get(tree.nodes, i).key == key {
            return true
        }
        i = i + 1
    }
    return false
}

def pop_last_utf8_char(s: str) -> str effect alloc {
    val chars = str_chars(s)
    val n = list_len(chars)
    if n <= 0 {
        return ""
    }
    var out = ""
    for i in 0..(n - 1) {
        out = concat(out, list_get(chars, i))
    }
    return out
}

/// Insert `chunk` at UTF-8 character index `idx` (-1 appends).
def text_insert_at(s: str, idx: i64, chunk: str) -> str effect alloc {
    val chars = str_chars(s)
    val n = list_len(chars)
    var out = ""
    var i = 0
    val at = if idx < 0 {
        n
    } else if idx > n {
        n
    } else {
        idx
    }
    while i < at {
        out = concat(out, list_get(chars, i))
        i = i + 1
    }
    out = concat(out, chunk)
    while i < n {
        out = concat(out, list_get(chars, i))
        i = i + 1
    }
    return out
}

/// Remove the character at UTF-8 character index `idx`.
def text_remove_at(s: str, idx: i64) -> str effect alloc {
    val chars = str_chars(s)
    val n = list_len(chars)
    if idx < 0 || idx >= n {
        return s
    }
    var out = ""
    var i = 0
    while i < n {
        if i != idx {
            out = concat(out, list_get(chars, i))
        }
        i = i + 1
    }
    return out
}

def text_len_chars(s: str) -> i64 effect alloc {
    return list_len(str_chars(s))
}

/// `(line, column)` of a caret positioned at UTF-8 character index `caret`
/// (`-1` means end of text).
pub def text_line_col_at(text: str, caret: i64) -> UiSize effect alloc {
    val chars = str_chars(text)
    val n = list_len(chars)
    val limit = if caret < 0 || caret > n { n } else { caret }
    var line = 0
    var col = 0
    var i = 0
    while i < limit {
        if list_get(chars, i) == "\n" {
            line = line + 1
            col = 0
        } else {
            col = col + 1
        }
        i = i + 1
    }
    return UiSize { w: to_f64(line), h: to_f64(col) }
}

/// Split `s` on LF, preserving interior empty lines.
def split_text_lines(s: str) -> list<str> effect alloc {
    val out: list<str> = list()
    val chars = str_chars(s)
    var cur = ""
    var i = 0
    while i < list_len(chars) {
        val ch = list_get(chars, i)
        if ch == "\n" {
            list_push(out, cur)
            cur = ""
        } else {
            cur = concat(cur, ch)
        }
        i = i + 1
    }
    list_push(out, cur)
    return out
}

/// Map a click inside a text input to a caret character index (`-1` at end).
def text_caret_for_point(
    text: str,
    layout: UiRect,
    px: f64,
    py: f64,
    multiline: bool,
) -> i64 effect alloc {
    val chars = str_chars(text)
    val n = list_len(chars)
    var line = 0
    if multiline {
        val rel_y = py - (layout.y + 8.0)
        val approx = (rel_y / 18.0) to i64
        line = if approx > 0 { approx } else { 0 }
    }
    var idx = 0
    var cur_line = 0
    while idx < n && cur_line < line {
        if list_get(chars, idx) == "\n" {
            cur_line = cur_line + 1
        }
        idx = idx + 1
    }
    val rel_x = px - (layout.x + 10.0)
    val approx_col = (rel_x / 7.6) to i64
    val col = if approx_col > 0 { approx_col } else { 0 }
    var c = 0
    while c < col && idx < n && list_get(chars, idx) != "\n" {
        idx = idx + 1
        c = c + 1
    }
    if idx >= n {
        return -1
    }
    return idx
}

def slider_value_at_x(node: UiNode, px: f64) -> f64 {
    val track_x = node.layout.x + 8.0
    val track_w = fmax(24.0, node.layout.w - 16.0)
    val t = clamp01((px - track_x) / track_w)
    return node.min_val + t * (node.max_val - node.min_val)
}

def collect_focusable_keys(tree: UiTree) -> list<str> effect alloc {
    val keys: list<str> = list()
    for i in 0..list_len(tree.nodes) {
        val n = list_get(tree.nodes, i)
        if is_interactive_node(n) && len(n.key) > 0 {
            list_push(keys, n.key)
        }
    }
    return keys
}

def cycle_focus_key(tree: UiTree, cur_key: str, reverse: bool) -> str effect alloc {
    val keys = collect_focusable_keys(tree)
    val n = list_len(keys)
    if n == 0 {
        return ""
    }
    var found = -1
    for i in 0..n {
        if list_get(keys, i) == cur_key {
            found = i
        }
    }
    if found < 0 {
        return if reverse { list_get(keys, n - 1) } else { list_get(keys, 0) }
    }
    val next_idx = if reverse { (found + n - 1) % n } else { (found + 1) % n }
    return list_get(keys, next_idx)
}

def with_state_copy(s: UiState, hovered: str, active: str, focused: str, dragging: str) -> UiState {
    return UiState {
        hovered_key: hovered,
        active_key: active,
        focused_key: focused,
        pointer_x: s.pointer_x,
        pointer_y: s.pointer_y,
        pointer_down: s.pointer_down,
        dragging_key: dragging,
        scroll_offset: s.scroll_offset,
        motion: s.motion,
        interaction: s.interaction,
        dispatched_action: s.dispatched_action,
        last_text_key: s.last_text_key,
        last_text_val: s.last_text_val,
        text_caret: s.text_caret,
        last_toggle_key: s.last_toggle_key,
        last_toggle_val: s.last_toggle_val,
        has_toggle_change: s.has_toggle_change,
        last_slider_key: s.last_slider_key,
        last_slider_val: s.last_slider_val,
        has_slider_change: s.has_slider_change,
        close_requested: s.close_requested,
        dirty: true,
        extras: s.extras,
    }
}

def clone_str_safe(s: str) -> str {
    if len(s) == 0 {
        return ""
    }
    return "" + s
}

def set_state_dirty(state: UiState, dirty: bool) -> UiState {
    return UiState {
        hovered_key: state.hovered_key,
        active_key: state.active_key,
        focused_key: state.focused_key,
        pointer_x: state.pointer_x,
        pointer_y: state.pointer_y,
        pointer_down: state.pointer_down,
        dragging_key: state.dragging_key,
        scroll_offset: state.scroll_offset,
        motion: state.motion,
        interaction: state.interaction,
        dispatched_action: state.dispatched_action,
        last_text_key: state.last_text_key,
        last_text_val: state.last_text_val,
        text_caret: state.text_caret,
        last_toggle_key: state.last_toggle_key,
        last_toggle_val: state.last_toggle_val,
        has_toggle_change: state.has_toggle_change,
        last_slider_key: state.last_slider_key,
        last_slider_val: state.last_slider_val,
        has_slider_change: state.has_slider_change,
        close_requested: state.close_requested,
        dirty: dirty,
        extras: state.extras,
    }
}

/// Return a copy of `state` with `dirty` cleared once a rendered frame is presented.
pub def ui_state_mark_clean(state: UiState) -> UiState {
    return set_state_dirty(state, false)
}

def clone_interaction(i: UiInteraction) -> UiInteraction effect alloc {
    val keys: list<str> = list()
    for k in i.selected_keys {
        list_push(keys, clone_str_safe(k))
    }
    return UiInteraction {
        selected_keys: keys,
        selection_anchor: clone_str_safe(i.selection_anchor),
        has_selection_change: i.has_selection_change,
        clipboard: clone_str_safe(i.clipboard),
        drag_key: clone_str_safe(i.drag_key),
        drag_payload: clone_str_safe(i.drag_payload),
        drag_x: i.drag_x,
        drag_y: i.drag_y,
        drop_key: clone_str_safe(i.drop_key),
        has_drop: i.has_drop,
        multiline: i.multiline,
        text_line: i.text_line,
        text_col: i.text_col,
    }
}

def clone_motion(m: UiMotion) -> UiMotion effect alloc {
    val tweens: list<UiTween> = list()
    for t in m.tweens {
        list_push(
            tweens,
            UiTween {
                key: clone_str_safe(t.key),
                from: t.from,
                to: t.to,
                started: t.started,
                duration: t.duration,
                ease: t.ease,
                delay: t.delay,
            },
        )
    }
    val keys: list<str> = list()
    for k in m.keys {
        list_push(keys, clone_str_safe(k))
    }
    // `settled` is a heap list too: copying the reference would leave the new
    // state pointing into the frame pool that is destroyed at end of frame.
    val settled: list<f64> = list()
    for v in m.settled {
        list_push(settled, v)
    }
    val springs: list<UiSpring> = list()
    for sp in m.springs {
        list_push(
            springs,
            UiSpring {
                key: clone_str_safe(sp.key),
                value: sp.value,
                velocity: sp.velocity,
                target: sp.target,
                stiffness: sp.stiffness,
                damping: sp.damping,
                mass: sp.mass,
                precision: sp.precision,
            },
        )
    }
    return UiMotion {
        // Records are boxed on this runtime: copying `m.clock` by field would
        // retain a pool-owned allocation. Rebuild it on the detached heap.
        clock: UiClock { now: m.clock.now, dt: m.clock.dt },
        tweens: tweens,
        settled: settled,
        keys: keys,
        springs: springs,
    }
}

def clone_extras(e: UiExtraState) -> UiExtraState effect alloc {
    val sc_k: list<str> = list()
    for k in e.scroll_keys {
        list_push(sc_k, clone_str_safe(k))
    }
    val sc_v: list<f64> = list()
    for v in e.scroll_offsets {
        list_push(sc_v, v)
    }
    val sp_k: list<str> = list()
    for k in e.split_keys {
        list_push(sp_k, clone_str_safe(k))
    }
    val sp_v: list<f64> = list()
    for v in e.split_ratios {
        list_push(sp_v, v)
    }
    val toasts: list<UiToast> = list()
    for t in e.toasts {
        list_push(
            toasts,
            UiToast {
                id: t.id,
                title: clone_str_safe(t.title),
                message: clone_str_safe(t.message),
                tone: t.tone,
                expires_at: t.expires_at,
            },
        )
    }
    return UiExtraState {
        scroll_keys: sc_k,
        scroll_offsets: sc_v,
        split_keys: sp_k,
        split_ratios: sp_v,
        open_popup_key: clone_str_safe(e.open_popup_key),
        popup_anchor: UiRect {
            x: e.popup_anchor.x,
            y: e.popup_anchor.y,
            w: e.popup_anchor.w,
            h: e.popup_anchor.h,
        },
        toasts: toasts,
        cursor: e.cursor,
        tooltip_text: clone_str_safe(e.tooltip_text),
        tooltip_x: e.tooltip_x,
        tooltip_y: e.tooltip_y,
        last_select_key: clone_str_safe(e.last_select_key),
        last_select_idx: e.last_select_idx,
        has_select_change: e.has_select_change,
        last_tab_key: clone_str_safe(e.last_tab_key),
        last_tab_idx: e.last_tab_idx,
        has_tab_change: e.has_tab_change,
        last_split_key: clone_str_safe(e.last_split_key),
        last_split_ratio: e.last_split_ratio,
        has_split_change: e.has_split_change,
        last_dropped_file: clone_str_safe(e.last_dropped_file),
        has_file_drop: e.has_file_drop,
    }
}

/// Clone `state`'s string, list, and boxed record fields onto the current active heap before destroying a frame pool.
pub def ui_state_detach(state: UiState) -> UiState effect alloc {
    return UiState {
        hovered_key: clone_str_safe(state.hovered_key),
        active_key: clone_str_safe(state.active_key),
        focused_key: clone_str_safe(state.focused_key),
        pointer_x: state.pointer_x,
        pointer_y: state.pointer_y,
        pointer_down: state.pointer_down,
        dragging_key: clone_str_safe(state.dragging_key),
        scroll_offset: state.scroll_offset,
        motion: clone_motion(state.motion),
        interaction: clone_interaction(state.interaction),
        dispatched_action: clone_str_safe(state.dispatched_action),
        last_text_key: clone_str_safe(state.last_text_key),
        last_text_val: clone_str_safe(state.last_text_val),
        text_caret: state.text_caret,
        last_toggle_key: clone_str_safe(state.last_toggle_key),
        last_toggle_val: state.last_toggle_val,
        has_toggle_change: state.has_toggle_change,
        last_slider_key: clone_str_safe(state.last_slider_key),
        last_slider_val: state.last_slider_val,
        has_slider_change: state.has_slider_change,
        close_requested: state.close_requested,
        dirty: state.dirty,
        extras: clone_extras(state.extras),
    }
}

/// Clear transient per-frame action/toggle/slider/select/tab/split/drop edge flags after processing.
pub def ui_clear_events(state: UiState) -> UiState {
    val ex = state.extras
    val next_ex = UiExtraState {
        scroll_keys: ex.scroll_keys,
        scroll_offsets: ex.scroll_offsets,
        split_keys: ex.split_keys,
        split_ratios: ex.split_ratios,
        open_popup_key: ex.open_popup_key,
        popup_anchor: ex.popup_anchor,
        toasts: ex.toasts,
        cursor: ex.cursor,
        tooltip_text: ex.tooltip_text,
        tooltip_x: ex.tooltip_x,
        tooltip_y: ex.tooltip_y,
        last_select_key: ex.last_select_key,
        last_select_idx: ex.last_select_idx,
        has_select_change: false,
        last_tab_key: ex.last_tab_key,
        last_tab_idx: ex.last_tab_idx,
        has_tab_change: false,
        last_split_key: ex.last_split_key,
        last_split_ratio: ex.last_split_ratio,
        has_split_change: false,
        last_dropped_file: ex.last_dropped_file,
        has_file_drop: false,
    }
    return UiState {
        hovered_key: state.hovered_key,
        active_key: state.active_key,
        focused_key: state.focused_key,
        pointer_x: state.pointer_x,
        pointer_y: state.pointer_y,
        pointer_down: state.pointer_down,
        dragging_key: state.dragging_key,
        scroll_offset: state.scroll_offset,
        motion: state.motion,
        interaction: state.interaction,
        dispatched_action: "",
        last_text_key: state.last_text_key,
        last_text_val: state.last_text_val,
        text_caret: state.text_caret,
        last_toggle_key: state.last_toggle_key,
        last_toggle_val: state.last_toggle_val,
        has_toggle_change: false,
        last_slider_key: state.last_slider_key,
        last_slider_val: state.last_slider_val,
        has_slider_change: false,
        close_requested: state.close_requested,
        dirty: state.dirty,
        extras: next_ex,
    }
}

/// Synchronize the tracked text value for widget `key` (for app-driven clear/reset).
pub def ui_state_set_text(state: UiState, key: str, val_str: str) -> UiState effect alloc {
    return with_text_value(state, key, val_str, -1)
}

def with_state_parts_ex(
    state: UiState,
    m: UiMotion,
    i: UiInteraction,
    ex: UiExtraState,
    dirty: bool,
) -> UiState {
    return UiState {
        hovered_key: state.hovered_key,
        active_key: state.active_key,
        focused_key: state.focused_key,
        pointer_x: state.pointer_x,
        pointer_y: state.pointer_y,
        pointer_down: state.pointer_down,
        dragging_key: state.dragging_key,
        scroll_offset: state.scroll_offset,
        dispatched_action: state.dispatched_action,
        last_text_key: state.last_text_key,
        last_text_val: state.last_text_val,
        text_caret: state.text_caret,
        last_toggle_key: state.last_toggle_key,
        last_toggle_val: state.last_toggle_val,
        has_toggle_change: state.has_toggle_change,
        last_slider_key: state.last_slider_key,
        last_slider_val: state.last_slider_val,
        has_slider_change: state.has_slider_change,
        close_requested: state.close_requested,
        dirty: dirty,
        motion: m,
        interaction: i,
        extras: ex,
    }
}

def with_state_parts(state: UiState, m: UiMotion, i: UiInteraction) -> UiState {
    return with_state_parts_ex(state, m, i, state.extras, true)
}

def with_extras(state: UiState, ex: UiExtraState) -> UiState {
    return with_state_parts_ex(state, state.motion, state.interaction, ex, true)
}

def with_motion(state: UiState, m: UiMotion) -> UiState {
    return with_state_parts(state, m, state.interaction)
}

def with_interaction(state: UiState, i: UiInteraction) -> UiState {
    return with_state_parts(state, state.motion, i)
}

// --- Widget transitions owned by UiState -----------------------------------

/// Advance the clock owned by `state`, step physics springs, and retire expired toasts/tweens.
pub def ui_state_tick(state: UiState, now: f64) -> UiState effect alloc {
    val next_motion = ui_motion_tick(state.motion, now)
    val old_toasts = state.extras.toasts
    if list_len(old_toasts) == 0 {
        return with_state_parts_ex(state, next_motion, state.interaction, state.extras, state.dirty)
    }
    val kept: list<UiToast> = list()
    var removed = false
    for i in 0..list_len(old_toasts) {
        val t = list_get(old_toasts, i)
        if t.expires_at <= 0.0 || t.expires_at > now {
            list_push(kept, t)
        } else {
            removed = true
        }
    }
    if !removed {
        return with_state_parts_ex(state, next_motion, state.interaction, state.extras, state.dirty)
    }
    val ex = state.extras
    val next_ex = UiExtraState {
        scroll_keys: ex.scroll_keys,
        scroll_offsets: ex.scroll_offsets,
        split_keys: ex.split_keys,
        split_ratios: ex.split_ratios,
        open_popup_key: ex.open_popup_key,
        popup_anchor: ex.popup_anchor,
        toasts: kept,
        cursor: ex.cursor,
        tooltip_text: ex.tooltip_text,
        tooltip_x: ex.tooltip_x,
        tooltip_y: ex.tooltip_y,
        last_select_key: ex.last_select_key,
        last_select_idx: ex.last_select_idx,
        has_select_change: ex.has_select_change,
        last_tab_key: ex.last_tab_key,
        last_tab_idx: ex.last_tab_idx,
        has_tab_change: ex.has_tab_change,
        last_split_key: ex.last_split_key,
        last_split_ratio: ex.last_split_ratio,
        has_split_change: ex.has_split_change,
        last_dropped_file: ex.last_dropped_file,
        has_file_drop: ex.has_file_drop,
    }
    return with_state_parts_ex(state, next_motion, state.interaction, next_ex, true)
}

/// Advance the state clock by its own `dt` (one frame) without an external timer.
pub def ui_state_tick_next(state: UiState) -> UiState effect alloc {
    return ui_state_tick(state, state.motion.clock.now + state.motion.clock.dt)
}

/// Start or retarget a named widget transition held by `state`.
pub def ui_state_animate(
    state: UiState,
    key: str,
    target: f64,
    duration: f64,
    curve: UiEase,
) -> UiState effect alloc {
    return with_motion(
        state,
        ui_motion_to(state.motion, key, target, duration, curve, state.motion.clock.now),
    )
}

/// Start or retarget a damped spring animation owned by `state`.
pub def ui_state_spring(
    state: UiState,
    key: str,
    target: f64,
    cfg: SpringConfig,
) -> UiState effect alloc {
    return with_motion(state, ui_motion_spring(state.motion, key, target, cfg))
}

/// Start a spring animation at explicit `initial` value toward `target`.
pub def ui_state_spring_from(
    state: UiState,
    key: str,
    initial: f64,
    target: f64,
    cfg: SpringConfig,
) -> UiState effect alloc {
    return with_motion(state, ui_motion_spring_from(state.motion, key, initial, target, cfg))
}

/// Read the current eased or spring-simulated value of `key` inside `state`.
pub def ui_state_animated_value(state: UiState, key: str, fallback: f64) -> f64 effect alloc {
    return ui_motion_value(state.motion, key, fallback)
}

/// Read the current value of spring `key` inside `state`.
pub def ui_state_spring_value(state: UiState, key: str, fallback: f64) -> f64 effect alloc {
    return ui_motion_value(state.motion, key, fallback)
}

/// The frame clock retained inside `state`, suitable for immediate-mode painters.
pub def ui_state_clock(state: UiState) -> UiClock {
    return state.motion.clock
}

/// True while any widget tween, spring, or timed toast is still active (drives redraw scheduling).
pub def ui_state_has_active_transitions(state: UiState) -> bool effect alloc {
    return ui_motion_has_active(state.motion) || list_len(state.extras.toasts) > 0
}

pub def ui_state_hover_progress(state: UiState, key: str) -> f64 effect alloc {
    return ui_motion_value(state.motion, "hover:" + key, 0.0)
}

pub def ui_state_press_progress(state: UiState, key: str) -> f64 effect alloc {
    return ui_motion_value(state.motion, "press:" + key, 0.0)
}

pub def ui_state_focus_progress(state: UiState, key: str) -> f64 effect alloc {
    return ui_motion_value(state.motion, "focus:" + key, 0.0)
}

/// Active native pointer cursor shape derived from hover/drag state.
pub def ui_state_cursor(state: UiState) -> UiCursor {
    return state.extras.cursor
}

/// Look up the vertical scroll offset stored for container `key` (or `state.scroll_offset`).
pub def ui_state_scroll_of(state: UiState, key: str) -> f64 effect alloc {
    if len(key) > 0 {
        for i in 0..list_len(state.extras.scroll_keys) {
            if list_get(state.extras.scroll_keys, i) == key {
                return list_get(state.extras.scroll_offsets, i)
            }
        }
    }
    return state.scroll_offset
}

/// Look up the interactive split ratio stored for `SplitPane` `key`, or `fallback`.
pub def ui_state_split_ratio(state: UiState, key: str, fallback: f64) -> f64 effect alloc {
    if len(key) > 0 {
        for i in 0..list_len(state.extras.split_keys) {
            if list_get(state.extras.split_keys, i) == key {
                return list_get(state.extras.split_ratios, i)
            }
        }
    }
    return fallback
}

/// Push a floating toast notification that auto-expires after `duration_secs`.
pub def ui_state_push_toast(
    state: UiState,
    title: str,
    message: str,
    tone: UiTone,
    duration_secs: f64,
) -> UiState effect alloc {
    val ex = state.extras
    val next_id = list_len(ex.toasts) + 1
    val exp = if duration_secs > 0.0 {
        state.motion.clock.now + duration_secs
    } else {
        0.0
    }
    val next_list: list<UiToast> = list()
    val start_i = if list_len(ex.toasts) >= 4 { list_len(ex.toasts) - 3 } else { 0 }
    for i in start_i..list_len(ex.toasts) {
        list_push(next_list, list_get(ex.toasts, i))
    }
    list_push(
        next_list,
        UiToast { id: next_id, title: title, message: message, tone: tone, expires_at: exp },
    )
    return with_extras(
        state,
        UiExtraState {
            scroll_keys: ex.scroll_keys,
            scroll_offsets: ex.scroll_offsets,
            split_keys: ex.split_keys,
            split_ratios: ex.split_ratios,
            open_popup_key: ex.open_popup_key,
            popup_anchor: ex.popup_anchor,
            toasts: next_list,
            cursor: ex.cursor,
            tooltip_text: ex.tooltip_text,
            tooltip_x: ex.tooltip_x,
            tooltip_y: ex.tooltip_y,
            last_select_key: ex.last_select_key,
            last_select_idx: ex.last_select_idx,
            has_select_change: ex.has_select_change,
            last_tab_key: ex.last_tab_key,
            last_tab_idx: ex.last_tab_idx,
            has_tab_change: ex.has_tab_change,
            last_split_key: ex.last_split_key,
            last_split_ratio: ex.last_split_ratio,
            has_split_change: ex.has_split_change,
            last_dropped_file: ex.last_dropped_file,
            has_file_drop: ex.has_file_drop,
        },
    )
}

/// Programmatically open a `Select` or `Menu` popup anchored at `anchor`.
pub def ui_state_open_popup(state: UiState, key: str, anchor: UiRect) -> UiState {
    val ex = state.extras
    return with_extras(
        state,
        UiExtraState {
            scroll_keys: ex.scroll_keys,
            scroll_offsets: ex.scroll_offsets,
            split_keys: ex.split_keys,
            split_ratios: ex.split_ratios,
            open_popup_key: key,
            popup_anchor: anchor,
            toasts: ex.toasts,
            cursor: ex.cursor,
            tooltip_text: ex.tooltip_text,
            tooltip_x: ex.tooltip_x,
            tooltip_y: ex.tooltip_y,
            last_select_key: ex.last_select_key,
            last_select_idx: ex.last_select_idx,
            has_select_change: ex.has_select_change,
            last_tab_key: ex.last_tab_key,
            last_tab_idx: ex.last_tab_idx,
            has_tab_change: ex.has_tab_change,
            last_split_key: ex.last_split_key,
            last_split_ratio: ex.last_split_ratio,
            has_split_change: ex.has_split_change,
            last_dropped_file: ex.last_dropped_file,
            has_file_drop: ex.has_file_drop,
        },
    )
}

/// Dismiss any open `Select` or `Menu` dropdown popup.
pub def ui_state_close_popup(state: UiState) -> UiState {
    return ui_state_open_popup(state, "", UiRect {})
}

/// True if a `Select` or `Menu` choice changed in this event batch.
pub def ui_state_select_changed(state: UiState, key: str) -> bool {
    return state.extras.has_select_change && state.extras.last_select_key == key
}

/// True if a `Tabs`, `Segmented`, or `Breadcrumb` item changed in this event batch.
pub def ui_state_tab_changed(state: UiState, key: str) -> bool {
    return state.extras.has_tab_change && state.extras.last_tab_key == key
}

/// True if the user dropped a file onto the window during this event batch.
pub def ui_state_dropped_file(state: UiState) -> option<str> effect alloc {
    if state.extras.has_file_drop && len(state.extras.last_dropped_file) > 0 {
        return some(state.extras.last_dropped_file)
    }
    return none
}

def animate_key(state: UiState, key: str, target: f64) -> UiState effect alloc {
    if len(key) == 0 {
        return state
    }
    return ui_state_spring(state, key, target, spring_snappy())
}

/// Retarget the built-in hover/press/focus transitions when interaction edges change.
pub def ui_state_sync_transitions(before: UiState, after: UiState) -> UiState effect alloc {
    var s = after
    if before.hovered_key != after.hovered_key {
        s = animate_key(s, "hover:" + before.hovered_key, 0.0)
        s = animate_key(s, "hover:" + after.hovered_key, 1.0)
    }
    if before.active_key != after.active_key {
        s = animate_key(s, "press:" + before.active_key, 0.0)
        s = animate_key(s, "press:" + after.active_key, 1.0)
    }
    if before.focused_key != after.focused_key {
        s = animate_key(s, "focus:" + before.focused_key, 0.0)
        s = animate_key(s, "focus:" + after.focused_key, 1.0)
    }
    return s
}

// --- Multi-select / drag & drop / clipboard / multi-line editing ------------

pub def ui_state_is_selected(state: UiState, key: str) -> bool effect alloc {
    for i in 0..list_len(state.interaction.selected_keys) {
        if list_get(state.interaction.selected_keys, i) == key {
            return true
        }
    }
    return false
}

pub def ui_state_selected_count(state: UiState) -> i64 effect alloc {
    return list_len(state.interaction.selected_keys)
}

def selection_with(state: UiState, keys: list<str>, anchor: str) -> UiState {
    val i = state.interaction
    return with_interaction(
        state,
        UiInteraction {
            selected_keys: keys,
            selection_anchor: anchor,
            has_selection_change: true,
            clipboard: i.clipboard,
            drag_key: i.drag_key,
            drag_payload: i.drag_payload,
            drag_x: i.drag_x,
            drag_y: i.drag_y,
            drop_key: i.drop_key,
            has_drop: i.has_drop,
            multiline: i.multiline,
            text_line: i.text_line,
            text_col: i.text_col,
        },
    )
}

/// Replace the selection with `keys`.
pub def ui_state_set_selection(state: UiState, keys: list<str>) -> UiState effect alloc {
    val anchor = if list_len(keys) > 0 { list_get(keys, 0) } else { "" }
    return selection_with(state, keys, anchor)
}

/// Ctrl-click style toggle: add `key` when absent, remove it when present.
pub def ui_state_toggle_selection(state: UiState, key: str) -> UiState effect alloc {
    val next: list<str> = list()
    for k in state.interaction.selected_keys {
        if k != key {
            list_push(next, k)
        }
    }
    if !ui_state_is_selected(state, key) {
        list_push(next, key)
    }
    return selection_with(state, next, key)
}

/// Select a contiguous range of selectable widgets in `tree` from anchor to `key`.
pub def ui_state_select_range(tree: UiTree, state: UiState, key: str) -> UiState effect alloc {
    val keys: list<str> = list()
    var start = -1
    var end = -1
    for i in 0..list_len(tree.nodes) {
        val node = list_get(tree.nodes, i)
        if is_interactive_node(node) && len(node.key) > 0 {
            list_push(keys, node.key)
            if node.key == state.interaction.selection_anchor {
                start = list_len(keys) - 1
            }
            if node.key == key {
                end = list_len(keys) - 1
            }
        }
    }
    if start < 0 || end < 0 {
        return selection_with(state, list(key), key)
    }
    val lo = if start < end { start } else { end }
    val hi = if start < end { end } else { start }
    val chosen: list<str> = list()
    for i in lo..hi + 1 {
        list_push(chosen, list_get(keys, i))
    }
    return selection_with(state, chosen, state.interaction.selection_anchor)
}

pub def ui_state_clear_selection(state: UiState) -> UiState effect alloc {
    return selection_with(state, list(), "")
}

pub def ui_state_begin_drag(
    state: UiState,
    key: str,
    payload: str,
    x: f64,
    y: f64,
) -> UiState {
    val i = state.interaction
    return with_interaction(
        state,
        UiInteraction {
            selected_keys: i.selected_keys,
            selection_anchor: i.selection_anchor,
            has_selection_change: i.has_selection_change,
            clipboard: i.clipboard,
            drag_key: key,
            drag_payload: payload,
            drag_x: x,
            drag_y: y,
            drop_key: "",
            has_drop: false,
            multiline: i.multiline,
            text_line: i.text_line,
            text_col: i.text_col,
        },
    )
}

pub def ui_state_is_dragging(state: UiState) -> bool {
    return len(state.interaction.drag_key) > 0
}

pub def ui_state_move_drag(state: UiState, x: f64, y: f64) -> UiState {
    val i = state.interaction
    return with_interaction(
        state,
        UiInteraction {
            selected_keys: i.selected_keys,
            selection_anchor: i.selection_anchor,
            has_selection_change: i.has_selection_change,
            clipboard: i.clipboard,
            drag_key: i.drag_key,
            drag_payload: i.drag_payload,
            drag_x: x,
            drag_y: y,
            drop_key: i.drop_key,
            has_drop: i.has_drop,
            multiline: i.multiline,
            text_line: i.text_line,
            text_col: i.text_col,
        },
    )
}

pub def ui_state_end_drag(state: UiState, drop_key: str) -> UiState {
    val i = state.interaction
    return with_interaction(
        state,
        UiInteraction {
            selected_keys: i.selected_keys,
            selection_anchor: i.selection_anchor,
            has_selection_change: i.has_selection_change,
            clipboard: i.clipboard,
            drag_key: "",
            drag_payload: "",
            drag_x: i.drag_x,
            drag_y: i.drag_y,
            drop_key: drop_key,
            has_drop: len(drop_key) > 0,
            multiline: i.multiline,
            text_line: i.text_line,
            text_col: i.text_col,
        },
    )
}

pub def ui_state_clipboard(state: UiState) -> str {
    return state.interaction.clipboard
}

pub def ui_state_set_clipboard(state: UiState, text: str) -> UiState {
    val i = state.interaction
    return with_interaction(
        state,
        UiInteraction {
            selected_keys: i.selected_keys,
            selection_anchor: i.selection_anchor,
            has_selection_change: i.has_selection_change,
            clipboard: clone_str_safe(text),
            drag_key: i.drag_key,
            drag_payload: i.drag_payload,
            drag_x: i.drag_x,
            drag_y: i.drag_y,
            drop_key: i.drop_key,
            has_drop: i.has_drop,
            multiline: i.multiline,
            text_line: i.text_line,
            text_col: i.text_col,
        },
    )
}

def selected_widget_text(tree: UiTree, state: UiState) -> str effect alloc {
    var out = ""
    for k in state.interaction.selected_keys {
        val _unused = when ui_find_node_key(tree, k) {
            some(idx) => {
                val txt = list_get(tree.nodes, idx).text
                out = if len(out) == 0 { txt } else { out + "\n" + txt }
                0
            },
            none => 0,
        }
    }
    return out
}

def focused_text_input(tree: UiTree, state: UiState) -> bool effect alloc {
    if len(state.focused_key) == 0 {
        return false
    }
    val idx = when ui_find_node_key(tree, state.focused_key) {
        some(i) => i,
        none => -1,
    }
    if idx < 0 {
        return false
    }
    return is_text_edit_kind(list_get(tree.nodes, idx).kind)
}

/// Copy the current selection (or focused text value) into the retained clipboard.
pub def ui_state_copy(tree: UiTree, state: UiState) -> UiState effect alloc {
    val text = if focused_text_input(tree, state) {
        state.last_text_val
    } else if ui_state_selected_count(state) > 0 {
        selected_widget_text(tree, state)
    } else {
        state.last_text_val
    }
    return ui_state_set_clipboard(state, text)
}

/// Copy then clear the focused text value.
pub def ui_state_cut(tree: UiTree, state: UiState) -> UiState effect alloc {
    val copied = ui_state_copy(tree, state)
    if len(copied.last_text_key) == 0 || !focused_text_input(tree, copied) {
        return copied
    }
    return with_text_value(copied, copied.last_text_key, "", 0)
}

/// Insert the retained clipboard at the current text caret.
pub def ui_state_paste(state: UiState) -> UiState effect alloc {
    val text = state.interaction.clipboard
    if len(text) == 0 || len(state.last_text_key) == 0 {
        return state
    }
    val next = text_insert_at(state.last_text_val, state.text_caret, text)
    val caret = if state.text_caret < 0 { -1 } else { state.text_caret + text_len_chars(text) }
    return with_text_value(state, state.last_text_key, next, caret)
}

pub def ui_state_set_multiline(state: UiState, enabled: bool) -> UiState {
    val i = state.interaction
    return with_interaction(
        state,
        UiInteraction {
            selected_keys: i.selected_keys,
            selection_anchor: i.selection_anchor,
            has_selection_change: i.has_selection_change,
            clipboard: i.clipboard,
            drag_key: i.drag_key,
            drag_payload: i.drag_payload,
            drag_x: i.drag_x,
            drag_y: i.drag_y,
            drop_key: i.drop_key,
            has_drop: i.has_drop,
            multiline: enabled,
            text_line: i.text_line,
            text_col: i.text_col,
        },
    )
}

/// Current `(line, column)` of the text caret, derived from `last_text_val`.
pub def ui_state_text_position(state: UiState) -> UiSize {
    return UiSize {
        w: to_f64(state.interaction.text_line),
        h: to_f64(state.interaction.text_col),
    }
}

def with_text_position(state: UiState, text: str, caret: i64) -> UiState effect alloc {
    return with_text_value(state, state.last_text_key, text, caret)
}

def multiline_caret(state: UiState, delta_line: i64) -> UiState effect alloc {
    val text = state.last_text_val
    val chars = str_chars(text)
    val caret = if state.text_caret < 0 { list_len(chars) } else { state.text_caret }
    val target_line = state.interaction.text_line + delta_line
    var line = 0
    var col = 0
    var i = 0
    while i < list_len(chars) && line < target_line {
        if list_get(chars, i) == "\n" {
            line = line + 1
        }
        i = i + 1
    }
    var next = i
    var c = 0
    while c < state.interaction.text_col
        && next < list_len(chars)
        && list_get(chars, next) != "\n" {
        next = next + 1
        c = c + 1
    }
    val clamped = if next > list_len(chars) { list_len(chars) } else { next }
    return with_text_position(state, text, clamped)
}

/// Fold the extra interactions (multi-select, drag/drop, clipboard, multi-line)
/// into the state produced by the core event machine.
def ui_apply_interaction_extras(
    tree: UiTree,
    before: UiState,
    after: UiState,
    ev: HostEvent,
) -> UiState effect alloc {
    var s = ui_state_sync_transitions(before, after)
    if ev.kind == UiEventKind.PointerDown {
        val hit = when ui_hit_test(tree, after.pointer_x, after.pointer_y) {
            some(idx) => idx,
            none => -1,
        }
        if hit >= 0 {
            val node = list_get(tree.nodes, hit)
            if is_selectable_node(node) && len(node.key) > 0 {
                val ctrl = (ev.modifiers % 8) >= 2
                val shift = (ev.modifiers % 2) == 1
                if ctrl {
                    s = ui_state_toggle_selection(s, node.key)
                } else if shift {
                    s = ui_state_select_range(tree, s, node.key)
                } else {
                    s = ui_state_set_selection(s, list(node.key))
                }
                s = ui_state_begin_drag(s, node.key, node.text, after.pointer_x, after.pointer_y)
            }
        }
    } else if ev.kind == UiEventKind.PointerMove {
        if ui_state_is_dragging(s) {
            s = ui_state_move_drag(s, after.pointer_x, after.pointer_y)
        }
    } else if ev.kind == UiEventKind.PointerUp {
        if ui_state_is_dragging(s) {
            val hit = when ui_hit_test(tree, after.pointer_x, after.pointer_y) {
                some(idx) => idx,
                none => -1,
            }
            var target = ""
            if hit >= 0 {
                val node = list_get(tree.nodes, hit)
                if is_selectable_node(node) && node.key != s.interaction.drag_key {
                    target = node.key
                }
            }
            s = ui_state_end_drag(s, target)
        }
    } else if ev.kind == UiEventKind.KeyDown {
        val ctrl = (ev.modifiers % 8) >= 2
        if ctrl {
            if ev.key_code == 99 {
                return ui_state_copy(tree, s)
            }
            if ev.key_code == 120 {
                return ui_state_cut(tree, s)
            }
            if ev.key_code == 118 {
                return ui_state_paste(s)
            }
            if ev.key_code == 97 {
                val keys: list<str> = list()
                for i in 0..list_len(tree.nodes) {
                    val node = list_get(tree.nodes, i)
                    if is_selectable_node(node) && len(node.key) > 0 {
                        list_push(keys, node.key)
                    }
                }
                return ui_state_set_selection(s, keys)
            }
        }
        if s.interaction.multiline && len(s.focused_key) > 0 {
            if ev.key_code == 7 {
                return multiline_caret(s, -1)
            }
            if ev.key_code == 8 {
                return multiline_caret(s, 1)
            }
            if ev.key_code == 1 {
                val next = text_insert_at(s.last_text_val, s.text_caret, "\n")
                val caret = if s.text_caret < 0 { -1 } else { s.text_caret + 1 }
                return with_text_position(s, next, caret)
            }
        }
    }
    return s
}

def resolve_event_pos(state: UiState, ev: HostEvent) -> UiSize {
    if ev.x > 0.0 || ev.y > 0.0 {
        return UiSize { w: ev.x, h: ev.y }
    }
    return UiSize { w: state.pointer_x, h: state.pointer_y }
}

def upsert_scroll_offset(ex: UiExtraState, key: str, val_y: f64) -> UiExtraState effect alloc {
    val next_k: list<str> = list()
    val next_v: list<f64> = list()
    var replaced = false
    for i in 0..list_len(ex.scroll_keys) {
        val k = list_get(ex.scroll_keys, i)
        if k == key {
            list_push(next_k, k)
            list_push(next_v, val_y)
            replaced = true
        } else {
            list_push(next_k, k)
            list_push(next_v, list_get(ex.scroll_offsets, i))
        }
    }
    if !replaced {
        list_push(next_k, key)
        list_push(next_v, val_y)
    }
    return UiExtraState {
        scroll_keys: next_k,
        scroll_offsets: next_v,
        split_keys: ex.split_keys,
        split_ratios: ex.split_ratios,
        open_popup_key: ex.open_popup_key,
        popup_anchor: ex.popup_anchor,
        toasts: ex.toasts,
        cursor: ex.cursor,
        tooltip_text: ex.tooltip_text,
        tooltip_x: ex.tooltip_x,
        tooltip_y: ex.tooltip_y,
        last_select_key: ex.last_select_key,
        last_select_idx: ex.last_select_idx,
        has_select_change: ex.has_select_change,
        last_tab_key: ex.last_tab_key,
        last_tab_idx: ex.last_tab_idx,
        has_tab_change: ex.has_tab_change,
        last_split_key: ex.last_split_key,
        last_split_ratio: ex.last_split_ratio,
        has_split_change: ex.has_split_change,
        last_dropped_file: ex.last_dropped_file,
        has_file_drop: ex.has_file_drop,
    }
}

def upsert_split_ratio(ex: UiExtraState, key: str, ratio: f64) -> UiExtraState effect alloc {
    val next_k: list<str> = list()
    val next_v: list<f64> = list()
    var replaced = false
    for i in 0..list_len(ex.split_keys) {
        val k = list_get(ex.split_keys, i)
        if k == key {
            list_push(next_k, k)
            list_push(next_v, ratio)
            replaced = true
        } else {
            list_push(next_k, k)
            list_push(next_v, list_get(ex.split_ratios, i))
        }
    }
    if !replaced {
        list_push(next_k, key)
        list_push(next_v, ratio)
    }
    return UiExtraState {
        scroll_keys: ex.scroll_keys,
        scroll_offsets: ex.scroll_offsets,
        split_keys: next_k,
        split_ratios: next_v,
        open_popup_key: ex.open_popup_key,
        popup_anchor: ex.popup_anchor,
        toasts: ex.toasts,
        cursor: ex.cursor,
        tooltip_text: ex.tooltip_text,
        tooltip_x: ex.tooltip_x,
        tooltip_y: ex.tooltip_y,
        last_select_key: ex.last_select_key,
        last_select_idx: ex.last_select_idx,
        has_select_change: ex.has_select_change,
        last_tab_key: ex.last_tab_key,
        last_tab_idx: ex.last_tab_idx,
        has_tab_change: ex.has_tab_change,
        last_split_key: key,
        last_split_ratio: ratio,
        has_split_change: true,
        last_dropped_file: ex.last_dropped_file,
        has_file_drop: ex.has_file_drop,
    }
}

def is_text_edit_kind(kind: WidgetKind) -> bool {
    return when kind {
        WidgetKind.TextInput => true,
        WidgetKind.TextArea => true,
        _ => false,
    }
}

def cursor_for_node(node: UiNode, is_dragging: bool) -> UiCursor {
    if node.disabled {
        return UiCursor.NotAllowed
    }
    val explicit = when node.style.cursor {
        UiCursor.Default => false,
        _ => true,
    }
    if explicit {
        return node.style.cursor
    }
    return when node.kind {
        WidgetKind.TextInput => UiCursor.Text,
        WidgetKind.TextArea => UiCursor.Text,
        WidgetKind.SplitPane => UiCursor.ResizeEw,
        WidgetKind.Slider => if is_dragging { UiCursor.Grabbing } else { UiCursor.Hand },
        _ => if is_interactive_node(node) { UiCursor.Hand } else { UiCursor.Default },
    }
}

/// Compute screen bounds of an open `Select` or `Menu` popup panel.
pub def popup_panel_rect(tree: UiTree, node: UiNode, anchor: UiRect) -> UiRect effect alloc {
    var count = 0
    if node.kind == WidgetKind.Select
        && node.data_idx >= 0
        && node.data_idx < list_len(tree.selects) {
        count = list_len(list_get(tree.selects, node.data_idx).options)
    } else if node.kind == WidgetKind.Menu
        && node.data_idx >= 0
        && node.data_idx < list_len(tree.menus) {
        count = list_len(list_get(tree.menus, node.data_idx).items)
    }
    val item_h = 32.0
    val pop_h = fmax(36.0, fmin(240.0, to_f64(count) * item_h + 8.0))
    val pop_w = fmax(160.0, anchor.w)
    val open_up = anchor.y + anchor.h + 4.0 + pop_h > tree.height - 8.0 && anchor.y > pop_h + 8.0
    val py = if open_up { anchor.y - pop_h - 4.0 } else { anchor.y + anchor.h + 4.0 }
    val px = fmax(6.0, fmin(anchor.x, fmax(6.0, tree.width - pop_w - 6.0)))
    return UiRect { x: px, y: py, w: pop_w, h: pop_h }
}

def popup_item_index(tree: UiTree, node: UiNode, anchor: UiRect, px: f64, py: f64) -> i64 effect alloc {
    val pr = popup_panel_rect(tree, node, anchor)
    if !rect_contains(pr, px, py) {
        return -1
    }
    val idx = ((py - (pr.y + 4.0)) / 32.0) to i64
    var count = 0
    if node.kind == WidgetKind.Select
        && node.data_idx >= 0
        && node.data_idx < list_len(tree.selects) {
        count = list_len(list_get(tree.selects, node.data_idx).options)
    } else if node.kind == WidgetKind.Menu
        && node.data_idx >= 0
        && node.data_idx < list_len(tree.menus) {
        count = list_len(list_get(tree.menus, node.data_idx).items)
    }
    if idx >= 0 && idx < count {
        return idx
    }
    return -1
}

def tabs_item_at(tree: UiTree, node: UiNode, px: f64) -> i64 effect alloc {
    if node.data_idx < 0 || node.data_idx >= list_len(tree.tabs_specs) {
        return 0
    }
    val spec = list_get(tree.tabs_specs, node.data_idx)
    val n = list_len(spec.labels)
    if n <= 1 {
        return 0
    }
    val w = fmax(1.0, node.layout.w)
    val seg_w = w / to_f64(n)
    val raw = ((px - node.layout.x) / seg_w) to i64
    if raw < 0 {
        return 0
    }
    if raw >= n {
        return n - 1
    }
    return raw
}

def apply_pointer_move(tree: UiTree, state: UiState, ev: HostEvent) -> UiState effect alloc {
    val hit = ui_hit_test(tree, ev.x, ev.y)
    var hov = ""
    var next_cursor = UiCursor.Default
    var tip_text = ""
    val _h = when hit {
        some(idx) => {
            val node = list_get(tree.nodes, idx)
            if is_interactive_node(node) && !is_overlay_container(node.kind) {
                hov = node.key
            }
            next_cursor = cursor_for_node(node, len(state.dragging_key) > 0)
            if len(node.tooltip) > 0 {
                tip_text = node.tooltip
            }
            0
        },
        none => 0,
    }
    var slider_key = state.last_slider_key
    var slider_val = state.last_slider_val
    var slider_chg = state.has_slider_change
    var slider_moved = false
    var next_ex = state.extras
    if state.pointer_down && len(state.dragging_key) > 0 {
        val _d = when ui_find_node_key(tree, state.dragging_key) {
            some(didx) => {
                val dnode = list_get(tree.nodes, didx)
                if dnode.kind == WidgetKind.SplitPane {
                    val ratio = fmin(
                        0.85,
                        fmax(0.15, (ev.x - dnode.layout.x) / fmax(1.0, dnode.layout.w)),
                    )
                    next_ex = upsert_split_ratio(next_ex, state.dragging_key, ratio)
                    next_cursor = UiCursor.ResizeEw
                    slider_moved = true
                } else {
                    slider_key = state.dragging_key
                    slider_val = slider_value_at_x(dnode, ev.x)
                    slider_chg = true
                    slider_moved = true
                }
                0
            },
            none => 0,
        }
    }
    next_ex = UiExtraState {
        scroll_keys: next_ex.scroll_keys,
        scroll_offsets: next_ex.scroll_offsets,
        split_keys: next_ex.split_keys,
        split_ratios: next_ex.split_ratios,
        open_popup_key: next_ex.open_popup_key,
        popup_anchor: next_ex.popup_anchor,
        toasts: next_ex.toasts,
        cursor: next_cursor,
        tooltip_text: tip_text,
        tooltip_x: ev.x,
        tooltip_y: ev.y,
        last_select_key: next_ex.last_select_key,
        last_select_idx: next_ex.last_select_idx,
        has_select_change: next_ex.has_select_change,
        last_tab_key: next_ex.last_tab_key,
        last_tab_idx: next_ex.last_tab_idx,
        has_tab_change: next_ex.has_tab_change,
        last_split_key: next_ex.last_split_key,
        last_split_ratio: next_ex.last_split_ratio,
        has_split_change: next_ex.has_split_change,
        last_dropped_file: next_ex.last_dropped_file,
        has_file_drop: next_ex.has_file_drop,
    }
    val next_dirty = state.dirty
        || hov != state.hovered_key
        || tip_text != state.extras.tooltip_text
        || slider_moved
    return UiState {
        hovered_key: hov,
        active_key: state.active_key,
        focused_key: state.focused_key,
        pointer_x: ev.x,
        pointer_y: ev.y,
        pointer_down: state.pointer_down,
        dragging_key: state.dragging_key,
        scroll_offset: state.scroll_offset,
        motion: state.motion,
        interaction: state.interaction,
        dispatched_action: state.dispatched_action,
        last_text_key: state.last_text_key,
        last_text_val: state.last_text_val,
        text_caret: state.text_caret,
        last_toggle_key: state.last_toggle_key,
        last_toggle_val: state.last_toggle_val,
        has_toggle_change: state.has_toggle_change,
        last_slider_key: slider_key,
        last_slider_val: slider_val,
        has_slider_change: slider_chg,
        close_requested: state.close_requested,
        dirty: next_dirty,
        extras: next_ex,
    }
}

def apply_pointer_leave(state: UiState) -> UiState {
    val ex = state.extras
    val next_ex = UiExtraState {
        scroll_keys: ex.scroll_keys,
        scroll_offsets: ex.scroll_offsets,
        split_keys: ex.split_keys,
        split_ratios: ex.split_ratios,
        open_popup_key: ex.open_popup_key,
        popup_anchor: ex.popup_anchor,
        toasts: ex.toasts,
        cursor: UiCursor.Default,
        tooltip_text: "",
        tooltip_x: ex.tooltip_x,
        tooltip_y: ex.tooltip_y,
        last_select_key: ex.last_select_key,
        last_select_idx: ex.last_select_idx,
        has_select_change: ex.has_select_change,
        last_tab_key: ex.last_tab_key,
        last_tab_idx: ex.last_tab_idx,
        has_tab_change: ex.has_tab_change,
        last_split_key: ex.last_split_key,
        last_split_ratio: ex.last_split_ratio,
        has_split_change: ex.has_split_change,
        last_dropped_file: ex.last_dropped_file,
        has_file_drop: ex.has_file_drop,
    }
    return with_state_parts_ex(
        with_state_copy(state, "", state.active_key, state.focused_key, state.dragging_key),
        state.motion,
        state.interaction,
        next_ex,
        true,
    )
}

def apply_file_dropped(state: UiState, ev: HostEvent) -> UiState {
    val ex = state.extras
    val next_ex = UiExtraState {
        scroll_keys: ex.scroll_keys,
        scroll_offsets: ex.scroll_offsets,
        split_keys: ex.split_keys,
        split_ratios: ex.split_ratios,
        open_popup_key: ex.open_popup_key,
        popup_anchor: ex.popup_anchor,
        toasts: ex.toasts,
        cursor: ex.cursor,
        tooltip_text: ex.tooltip_text,
        tooltip_x: ex.tooltip_x,
        tooltip_y: ex.tooltip_y,
        last_select_key: ex.last_select_key,
        last_select_idx: ex.last_select_idx,
        has_select_change: ex.has_select_change,
        last_tab_key: ex.last_tab_key,
        last_tab_idx: ex.last_tab_idx,
        has_tab_change: ex.has_tab_change,
        last_split_key: ex.last_split_key,
        last_split_ratio: ex.last_split_ratio,
        has_split_change: ex.has_split_change,
        last_dropped_file: ev.text,
        has_file_drop: len(ev.text) > 0,
    }
    return with_extras(state, next_ex)
}

def state_clear_focus_down(state: UiState, pos: UiSize) -> UiState {
    return UiState {
        hovered_key: state.hovered_key,
        active_key: "",
        focused_key: "",
        pointer_x: pos.w,
        pointer_y: pos.h,
        pointer_down: true,
        dragging_key: "",
        scroll_offset: state.scroll_offset,
        motion: state.motion,
        interaction: state.interaction,
        dispatched_action: state.dispatched_action,
        last_text_key: state.last_text_key,
        last_text_val: state.last_text_val,
        text_caret: state.text_caret,
        last_toggle_key: state.last_toggle_key,
        last_toggle_val: state.last_toggle_val,
        has_toggle_change: state.has_toggle_change,
        last_slider_key: state.last_slider_key,
        last_slider_val: state.last_slider_val,
        has_slider_change: state.has_slider_change,
        close_requested: state.close_requested,
        dirty: true,
        extras: state.extras,
    }
}

def try_handle_open_popup_click(
    tree: UiTree,
    state: UiState,
    pos: UiSize,
) -> option<UiState> effect alloc {
    if len(state.extras.open_popup_key) == 0 {
        return none
    }
    val found = ui_find_node_key(tree, state.extras.open_popup_key)
    val pop_node = when found {
        some(idx) => list_get(tree.nodes, idx),
        none => {
            return some(ui_state_close_popup(state))
        },
    }
    val item_idx = popup_item_index(tree, pop_node, state.extras.popup_anchor, pos.w, pos.h)
    val ex = state.extras
    if item_idx >= 0 {
        var act = if len(pop_node.action) > 0 { pop_node.action } else { pop_node.key }
        if pop_node.kind == WidgetKind.Menu
            && pop_node.data_idx >= 0
            && pop_node.data_idx < list_len(tree.menus) {
            val spec = list_get(tree.menus, pop_node.data_idx)
            if item_idx < list_len(spec.actions) && len(list_get(spec.actions, item_idx)) > 0 {
                act = list_get(spec.actions, item_idx)
            }
        }
        val next_ex = UiExtraState {
            scroll_keys: ex.scroll_keys,
            scroll_offsets: ex.scroll_offsets,
            split_keys: ex.split_keys,
            split_ratios: ex.split_ratios,
            open_popup_key: "",
            popup_anchor: UiRect {},
            toasts: ex.toasts,
            cursor: ex.cursor,
            tooltip_text: "",
            tooltip_x: ex.tooltip_x,
            tooltip_y: ex.tooltip_y,
            last_select_key: pop_node.key,
            last_select_idx: item_idx,
            has_select_change: true,
            last_tab_key: ex.last_tab_key,
            last_tab_idx: ex.last_tab_idx,
            has_tab_change: ex.has_tab_change,
            last_split_key: ex.last_split_key,
            last_split_ratio: ex.last_split_ratio,
            has_split_change: ex.has_split_change,
            last_dropped_file: ex.last_dropped_file,
            has_file_drop: ex.has_file_drop,
        }
        return some(dispatch_action_state(with_extras(state, next_ex), act))
    }
    // Clicking the anchor toggles it closed without immediate reopen.
    if rect_contains(pop_node.layout, pos.w, pos.h) {
        return some(ui_state_close_popup(state))
    }
    return none
}

def apply_pointer_down(tree: UiTree, state: UiState, ev: HostEvent) -> UiState effect alloc {
    val pos = resolve_event_pos(state, ev)
    val pop_handled = when try_handle_open_popup_click(tree, state, pos) {
        some(st) => {
            return st
        },
        none => 0,
    }
    val base_state = if len(state.extras.open_popup_key) > 0 {
        ui_state_close_popup(state)
    } else {
        state
    }
    val hit_idx = when ui_hit_test(tree, pos.w, pos.h) {
        some(idx) => idx,
        none => {
            return state_clear_focus_down(base_state, pos)
        },
    }
    val node = list_get(tree.nodes, hit_idx)
    if node.disabled {
        return state_clear_focus_down(base_state, pos)
    }
    if node.kind == WidgetKind.Modal || node.kind == WidgetKind.Drawer {
        val inner = if node.kind == WidgetKind.Modal {
            modal_card_rect(tree.width, tree.height, node)
        } else {
            drawer_panel_rect(tree.width, tree.height, node)
        }
        if !rect_contains(inner, pos.w, pos.h) {
            val close_act = if len(node.action) > 0 { node.action } else { "close:" + node.key }
            return dispatch_action_state(base_state, close_act)
        }
        return base_state
    }
    if !is_interactive_node(node) {
        return with_state_copy(base_state, base_state.hovered_key, "", "", "")
    }
    val is_slider = node.kind == WidgetKind.Slider
    val is_split = node.kind == WidgetKind.SplitPane
    val is_text = is_text_edit_kind(node.kind)
    val is_multiline = base_state.interaction.multiline || node.kind == WidgetKind.TextArea
    val text_now = if is_text {
        if base_state.last_text_key == node.key { base_state.last_text_val } else { node.text }
    } else {
        base_state.last_text_val
    }
    val caret = if is_text {
        text_caret_for_point(text_now, node.layout, pos.w, pos.h, is_multiline)
    } else {
        base_state.text_caret
    }
    val tpos = if is_text {
        text_line_col_at(text_now, caret)
    } else {
        UiSize {
            w: to_f64(base_state.interaction.text_line),
            h: to_f64(base_state.interaction.text_col),
        }
    }
    val int = base_state.interaction
    val next_int = if is_text {
        UiInteraction {
            selected_keys: int.selected_keys,
            selection_anchor: int.selection_anchor,
            has_selection_change: int.has_selection_change,
            clipboard: int.clipboard,
            drag_key: int.drag_key,
            drag_payload: int.drag_payload,
            drag_x: int.drag_x,
            drag_y: int.drag_y,
            drop_key: int.drop_key,
            has_drop: int.has_drop,
            multiline: int.multiline,
            text_line: tpos.w to i64,
            text_col: tpos.h to i64,
        }
    } else {
        int
    }
    return UiState {
        hovered_key: node.key,
        active_key: node.key,
        focused_key: node.key,
        pointer_x: pos.w,
        pointer_y: pos.h,
        pointer_down: true,
        dragging_key: if is_slider || is_split { node.key } else { "" },
        scroll_offset: base_state.scroll_offset,
        motion: base_state.motion,
        interaction: next_int,
        dispatched_action: base_state.dispatched_action,
        last_text_key: if is_text { node.key } else { base_state.last_text_key },
        last_text_val: text_now,
        text_caret: caret,
        last_toggle_key: base_state.last_toggle_key,
        last_toggle_val: base_state.last_toggle_val,
        has_toggle_change: base_state.has_toggle_change,
        last_slider_key: if is_slider { node.key } else { base_state.last_slider_key },
        last_slider_val: if is_slider {
            slider_value_at_x(node, pos.w)
        } else {
            base_state.last_slider_val
        },
        has_slider_change: if is_slider { true } else { base_state.has_slider_change },
        close_requested: base_state.close_requested,
        dirty: true,
        extras: base_state.extras,
    }
}

def dispatch_action_state(state: UiState, act: str) -> UiState {
    return UiState {
        hovered_key: state.hovered_key,
        active_key: "",
        focused_key: state.focused_key,
        pointer_x: state.pointer_x,
        pointer_y: state.pointer_y,
        pointer_down: false,
        dragging_key: "",
        scroll_offset: state.scroll_offset,
        motion: state.motion,
        interaction: state.interaction,
        dispatched_action: act,
        last_text_key: state.last_text_key,
        last_text_val: state.last_text_val,
        text_caret: state.text_caret,
        last_toggle_key: state.last_toggle_key,
        last_toggle_val: state.last_toggle_val,
        has_toggle_change: state.has_toggle_change,
        last_slider_key: state.last_slider_key,
        last_slider_val: state.last_slider_val,
        has_slider_change: state.has_slider_change,
        close_requested: state.close_requested,
        dirty: true,
        extras: state.extras,
    }
}

def dispatch_toggle_state(node: UiNode, state: UiState) -> UiState {
    val act = if len(node.action) > 0 { node.action } else { state.dispatched_action }
    return UiState {
        hovered_key: state.hovered_key,
        active_key: "",
        focused_key: state.focused_key,
        pointer_x: state.pointer_x,
        pointer_y: state.pointer_y,
        pointer_down: false,
        dragging_key: "",
        scroll_offset: state.scroll_offset,
        motion: state.motion,
        interaction: state.interaction,
        dispatched_action: act,
        last_text_key: state.last_text_key,
        last_text_val: state.last_text_val,
        text_caret: state.text_caret,
        last_toggle_key: node.key,
        last_toggle_val: !node.checked,
        has_toggle_change: true,
        last_slider_key: state.last_slider_key,
        last_slider_val: state.last_slider_val,
        has_slider_change: state.has_slider_change,
        close_requested: state.close_requested,
        dirty: true,
        extras: state.extras,
    }
}

def activate_tabs_widget(
    tree: UiTree,
    node: UiNode,
    state: UiState,
    px: f64,
) -> UiState effect alloc {
    val idx = tabs_item_at(tree, node, px)
    val ex = state.extras
    val act = if len(node.action) > 0 { node.action } else { node.key }
    val next_ex = UiExtraState {
        scroll_keys: ex.scroll_keys,
        scroll_offsets: ex.scroll_offsets,
        split_keys: ex.split_keys,
        split_ratios: ex.split_ratios,
        open_popup_key: ex.open_popup_key,
        popup_anchor: ex.popup_anchor,
        toasts: ex.toasts,
        cursor: ex.cursor,
        tooltip_text: ex.tooltip_text,
        tooltip_x: ex.tooltip_x,
        tooltip_y: ex.tooltip_y,
        last_select_key: ex.last_select_key,
        last_select_idx: ex.last_select_idx,
        has_select_change: ex.has_select_change,
        last_tab_key: node.key,
        last_tab_idx: idx,
        has_tab_change: true,
        last_split_key: ex.last_split_key,
        last_split_ratio: ex.last_split_ratio,
        has_split_change: ex.has_split_change,
        last_dropped_file: ex.last_dropped_file,
        has_file_drop: ex.has_file_drop,
    }
    var next_s = dispatch_action_state(with_extras(state, next_ex), act)
    if len(node.key) > 0 {
        next_s = ui_state_spring(next_s, "tab:" + node.key, to_f64(idx), spring_snappy())
    }
    return next_s
}

def activate_stepper_widget(node: UiNode, state: UiState, px: f64) -> UiState {
    val step = if node.step > 0.0 { node.step } else { 1.0 }
    val is_dec = px < node.layout.x + node.layout.w * 0.35
    val is_inc = px > node.layout.x + node.layout.w * 0.65
    val delta = if is_dec {
        -step
    } else if is_inc {
        step
    } else {
        step
    }
    val raw = node.value + delta
    val next_v = fmin(node.max_val, fmax(node.min_val, raw))
    val act = if len(node.action) > 0 { node.action } else { node.key }
    return UiState {
        hovered_key: state.hovered_key,
        active_key: "",
        focused_key: state.focused_key,
        pointer_x: state.pointer_x,
        pointer_y: state.pointer_y,
        pointer_down: false,
        dragging_key: "",
        scroll_offset: state.scroll_offset,
        motion: state.motion,
        interaction: state.interaction,
        dispatched_action: act,
        last_text_key: state.last_text_key,
        last_text_val: state.last_text_val,
        text_caret: state.text_caret,
        last_toggle_key: state.last_toggle_key,
        last_toggle_val: state.last_toggle_val,
        has_toggle_change: state.has_toggle_change,
        last_slider_key: node.key,
        last_slider_val: next_v,
        has_slider_change: true,
        close_requested: state.close_requested,
        dirty: true,
        extras: state.extras,
    }
}

def activate_radio_widget(node: UiNode, state: UiState) -> UiState {
    val ex = state.extras
    val act = if len(node.action) > 0 { node.action } else { node.key }
    val next_ex = UiExtraState {
        scroll_keys: ex.scroll_keys,
        scroll_offsets: ex.scroll_offsets,
        split_keys: ex.split_keys,
        split_ratios: ex.split_ratios,
        open_popup_key: ex.open_popup_key,
        popup_anchor: ex.popup_anchor,
        toasts: ex.toasts,
        cursor: ex.cursor,
        tooltip_text: ex.tooltip_text,
        tooltip_x: ex.tooltip_x,
        tooltip_y: ex.tooltip_y,
        last_select_key: node.key,
        last_select_idx: node.selected_idx,
        has_select_change: true,
        last_tab_key: ex.last_tab_key,
        last_tab_idx: ex.last_tab_idx,
        has_tab_change: ex.has_tab_change,
        last_split_key: ex.last_split_key,
        last_split_ratio: ex.last_split_ratio,
        has_split_change: ex.has_split_change,
        last_dropped_file: ex.last_dropped_file,
        has_file_drop: ex.has_file_drop,
    }
    return dispatch_toggle_state(node, dispatch_action_state(with_extras(state, next_ex), act))
}

def activate_widget_at(
    tree: UiTree,
    node: UiNode,
    state: UiState,
    px: f64,
) -> UiState effect alloc {
    if node.disabled {
        return with_state_copy(state, state.hovered_key, "", state.focused_key, "")
    }
    val act = if len(node.action) > 0 { node.action } else { node.key }
    return when node.kind {
        WidgetKind.Button => dispatch_action_state(state, act),
        WidgetKind.IconButton => dispatch_action_state(state, act),
        WidgetKind.NavItem => dispatch_action_state(state, act),
        WidgetKind.Chip => dispatch_action_state(state, act),
        WidgetKind.TableRow => dispatch_action_state(state, act),
        WidgetKind.RadarScope => if len(node.action) > 0 {
            dispatch_action_state(state, node.action)
        } else {
            with_state_copy(state, state.hovered_key, "", state.focused_key, "")
        },
        WidgetKind.Checkbox => dispatch_toggle_state(node, state),
        WidgetKind.Toggle => dispatch_toggle_state(node, state),
        WidgetKind.Accordion => dispatch_toggle_state(node, dispatch_action_state(state, act)),
        WidgetKind.Radio => activate_radio_widget(node, state),
        WidgetKind.Stepper => activate_stepper_widget(node, state, px),
        WidgetKind.Tabs => activate_tabs_widget(tree, node, state, px),
        WidgetKind.Segmented => activate_tabs_widget(tree, node, state, px),
        WidgetKind.Breadcrumb => activate_tabs_widget(tree, node, state, px),
        WidgetKind.Select => if state.extras.open_popup_key == node.key {
            ui_state_close_popup(state)
        } else {
            ui_state_open_popup(state, node.key, node.layout)
        },
        WidgetKind.Menu => if state.extras.open_popup_key == node.key {
            ui_state_close_popup(state)
        } else {
            ui_state_open_popup(state, node.key, node.layout)
        },
        _ => with_state_copy(state, state.hovered_key, "", state.focused_key, ""),
    }
}

def activate_widget(node: UiNode, state: UiState) -> UiState {
    if node.disabled {
        return with_state_copy(state, state.hovered_key, "", state.focused_key, "")
    }
    val act = if len(node.action) > 0 { node.action } else { node.key }
    return when node.kind {
        WidgetKind.Button => dispatch_action_state(state, act),
        WidgetKind.IconButton => dispatch_action_state(state, act),
        WidgetKind.NavItem => dispatch_action_state(state, act),
        WidgetKind.Chip => dispatch_action_state(state, act),
        WidgetKind.TableRow => dispatch_action_state(state, act),
        WidgetKind.RadarScope => if len(node.action) > 0 {
            dispatch_action_state(state, node.action)
        } else {
            with_state_copy(state, state.hovered_key, "", state.focused_key, "")
        },
        WidgetKind.Checkbox => dispatch_toggle_state(node, state),
        WidgetKind.Toggle => dispatch_toggle_state(node, state),
        WidgetKind.Accordion => dispatch_toggle_state(node, dispatch_action_state(state, act)),
        WidgetKind.Radio => activate_radio_widget(node, state),
        WidgetKind.Stepper => activate_stepper_widget(
            node,
            state,
            node.layout.x + node.layout.w * 0.8,
        ),
        _ => with_state_copy(state, state.hovered_key, "", state.focused_key, ""),
    }
}

def apply_pointer_up(tree: UiTree, state: UiState, ev: HostEvent) -> UiState effect alloc {
    val pos = resolve_event_pos(state, ev)
    val hit = ui_hit_test(tree, pos.w, pos.h)
    val cleared = UiState {
        hovered_key: state.hovered_key,
        active_key: "",
        focused_key: state.focused_key,
        pointer_x: pos.w,
        pointer_y: pos.h,
        pointer_down: false,
        dragging_key: "",
        scroll_offset: state.scroll_offset,
        motion: state.motion,
        interaction: state.interaction,
        dispatched_action: state.dispatched_action,
        last_text_key: state.last_text_key,
        last_text_val: state.last_text_val,
        text_caret: state.text_caret,
        last_toggle_key: state.last_toggle_key,
        last_toggle_val: state.last_toggle_val,
        has_toggle_change: state.has_toggle_change,
        last_slider_key: state.last_slider_key,
        last_slider_val: state.last_slider_val,
        has_slider_change: state.has_slider_change,
        close_requested: state.close_requested,
        dirty: true,
        extras: state.extras,
    }
    if len(state.active_key) > 0 {
        return when hit {
            some(hidx) => {
                val node = list_get(tree.nodes, hidx)
                if node.key == state.active_key {
                    activate_widget_at(tree, node, cleared, pos.w)
                } else {
                    cleared
                }
            },
            none => cleared,
        }
    }
    return cleared
}

def apply_text_input(tree: UiTree, state: UiState, ev: HostEvent) -> UiState effect alloc {
    if len(state.focused_key) == 0 || len(ev.text) == 0 {
        return state
    }
    val found_idx = when ui_find_node_key(tree, state.focused_key) {
        some(i) => i,
        none => {
            return state
        },
    }
    val node = list_get(tree.nodes, found_idx)
    if !is_text_edit_kind(node.kind) || node.disabled {
        return state
    }
    val base = if state.last_text_key == node.key { state.last_text_val } else { node.text }
    val next = text_insert_at(base, state.text_caret, ev.text)
    val next_caret = if state.text_caret < 0 {
        -1
    } else {
        state.text_caret + text_len_chars(ev.text)
    }
    return with_text_value(state, node.key, next, next_caret)
}

def apply_key_down(tree: UiTree, state: UiState, ev: HostEvent) -> UiState effect alloc {
    // Escape dismisses open popup -> open overlay -> clears focus.
    if ev.key_code == 4 {
        if len(state.extras.open_popup_key) > 0 {
            return ui_state_close_popup(state)
        }
        var ov = list_len(tree.nodes) - 1
        while ov >= 0 {
            val cand = list_get(tree.nodes, ov)
            if is_overlay_container(cand.kind) && cand.open {
                val close_act = if len(cand.action) > 0 { cand.action } else { "close:" + cand.key }
                return dispatch_action_state(state, close_act)
            }
            ov = ov - 1
        }
        return with_state_copy(state, "", state.active_key, "", state.dragging_key)
    }
    if ev.key_code == 3 {
        val next_focus = cycle_focus_key(tree, state.focused_key, (ev.modifiers % 2) == 1)
        return with_state_copy(
            state,
            state.hovered_key,
            state.active_key,
            next_focus,
            state.dragging_key,
        )
    }
    if len(state.focused_key) == 0 {
        return state
    }
    val found_idx = when ui_find_node_key(tree, state.focused_key) {
        some(i) => i,
        none => {
            return state
        },
    }
    val node = list_get(tree.nodes, found_idx)
    if node.disabled {
        return state
    }
    val is_text = is_text_edit_kind(node.kind)
    val base = if state.last_text_key == node.key { state.last_text_val } else { node.text }
    val nchars = if is_text { text_len_chars(base) } else { 0 }

    if is_text
        && (
            ev.key_code == 5
                || ev.key_code == 6
                || ev.key_code == 9
                || ev.key_code == 10
                || ev.key_code == 2
                || ev.key_code == 11
        ) {
        var caret = state.text_caret
        if caret < 0 {
            caret = nchars
        }
        if ev.key_code == 5 {
            if caret > 0 {
                caret = caret - 1
            }
        } else if ev.key_code == 6 {
            if caret < nchars {
                caret = caret + 1
            }
        } else if ev.key_code == 9 {
            caret = 0
        } else if ev.key_code == 10 {
            caret = nchars
        } else if ev.key_code == 2 {
            if caret > 0 {
                val next = text_remove_at(base, caret - 1)
                caret = caret - 1
                return with_text_value(state, node.key, next, caret)
            }
        } else if ev.key_code == 11 {
            if caret < nchars {
                val next = text_remove_at(base, caret)
                return with_text_value(state, node.key, next, caret)
            }
        }
        return with_text_value(state, node.key, base, if caret >= nchars { -1 } else { caret })
    }
    if node.kind == WidgetKind.Slider && (ev.key_code == 5 || ev.key_code == 6) {
        val span = fmax(0.001, node.max_val - node.min_val)
        val delta = span * (if ev.key_code == 6 { 0.05 } else { -0.05 })
        val cur_v = if state.last_slider_key == node.key {
            state.last_slider_val
        } else {
            node.value
        }
        val next_v = fmin(node.max_val, fmax(node.min_val, cur_v + delta))
        return UiState {
            hovered_key: state.hovered_key,
            active_key: state.active_key,
            focused_key: state.focused_key,
            pointer_x: state.pointer_x,
            pointer_y: state.pointer_y,
            pointer_down: state.pointer_down,
            dragging_key: state.dragging_key,
            scroll_offset: state.scroll_offset,
            motion: state.motion,
            interaction: state.interaction,
            dispatched_action: state.dispatched_action,
            last_text_key: state.last_text_key,
            last_text_val: state.last_text_val,
            text_caret: state.text_caret,
            last_toggle_key: state.last_toggle_key,
            last_toggle_val: state.last_toggle_val,
            has_toggle_change: state.has_toggle_change,
            last_slider_key: node.key,
            last_slider_val: next_v,
            has_slider_change: true,
            close_requested: state.close_requested,
            dirty: true,
            extras: state.extras,
        }
    }
    if node.kind == WidgetKind.TextArea && ev.key_code == 1 {
        val next = text_insert_at(base, state.text_caret, "\n")
        val next_caret = if state.text_caret < 0 { -1 } else { state.text_caret + 1 }
        return with_text_value(state, node.key, next, next_caret)
    }
    if ev.key_code == 1 || ev.key_code == 12 {
        return activate_widget(node, state)
    }
    return state
}

def with_text_value(state: UiState, key: str, value: str, caret: i64) -> UiState effect alloc {
    val copy = with_state_copy(
        state,
        state.hovered_key,
        state.active_key,
        state.focused_key,
        state.dragging_key,
    )
    val pos = text_line_col_at(value, caret)
    val int = copy.interaction
    return UiState {
        hovered_key: copy.hovered_key,
        active_key: copy.active_key,
        focused_key: copy.focused_key,
        pointer_x: copy.pointer_x,
        pointer_y: copy.pointer_y,
        pointer_down: copy.pointer_down,
        dragging_key: copy.dragging_key,
        scroll_offset: copy.scroll_offset,
        motion: copy.motion,
        interaction: UiInteraction {
            selected_keys: int.selected_keys,
            selection_anchor: int.selection_anchor,
            has_selection_change: int.has_selection_change,
            clipboard: int.clipboard,
            drag_key: int.drag_key,
            drag_payload: int.drag_payload,
            drag_x: int.drag_x,
            drag_y: int.drag_y,
            drop_key: int.drop_key,
            has_drop: int.has_drop,
            multiline: int.multiline,
            text_line: pos.w to i64,
            text_col: pos.h to i64,
        },
        dispatched_action: copy.dispatched_action,
        last_text_key: key,
        last_text_val: value,
        text_caret: caret,
        last_toggle_key: copy.last_toggle_key,
        last_toggle_val: copy.last_toggle_val,
        has_toggle_change: copy.has_toggle_change,
        last_slider_key: copy.last_slider_key,
        last_slider_val: copy.last_slider_val,
        has_slider_change: copy.has_slider_change,
        close_requested: copy.close_requested,
        dirty: true,
        extras: copy.extras,
    }
}

def set_close_requested(state: UiState) -> UiState {
    return UiState {
        hovered_key: state.hovered_key,
        active_key: state.active_key,
        focused_key: state.focused_key,
        pointer_x: state.pointer_x,
        pointer_y: state.pointer_y,
        pointer_down: state.pointer_down,
        dragging_key: state.dragging_key,
        scroll_offset: state.scroll_offset,
        motion: state.motion,
        interaction: state.interaction,
        dispatched_action: state.dispatched_action,
        last_text_key: state.last_text_key,
        last_text_val: state.last_text_val,
        text_caret: state.text_caret,
        last_toggle_key: state.last_toggle_key,
        last_toggle_val: state.last_toggle_val,
        has_toggle_change: state.has_toggle_change,
        last_slider_key: state.last_slider_key,
        last_slider_val: state.last_slider_val,
        has_slider_change: state.has_slider_change,
        close_requested: true,
        dirty: state.dirty,
        extras: state.extras,
    }
}

def find_scrollable_under(tree: UiTree, px: f64, py: f64) -> str effect alloc {
    var i = list_len(tree.nodes) - 1
    while i >= 0 {
        val node = list_get(tree.nodes, i)
        if node.style.scrollable && len(node.key) > 0 && rect_contains(node.layout, px, py) {
            return node.key
        }
        i = i - 1
    }
    return ""
}

def apply_wheel(tree: UiTree, state: UiState, ev: HostEvent) -> UiState effect alloc {
    val px = if ev.x > 0.0 || ev.y > 0.0 { ev.x } else { state.pointer_x }
    val py = state.pointer_y
    val target_key = find_scrollable_under(tree, px, py)
    val next_global = fmax(0.0, state.scroll_offset - ev.y)
    val next_ex = if len(target_key) > 0 {
        val old_k = ui_state_scroll_of(state, target_key)
        upsert_scroll_offset(state.extras, target_key, fmax(0.0, old_k - ev.y))
    } else {
        state.extras
    }
    return UiState {
        hovered_key: state.hovered_key,
        active_key: state.active_key,
        focused_key: state.focused_key,
        pointer_x: state.pointer_x,
        pointer_y: state.pointer_y,
        pointer_down: state.pointer_down,
        dragging_key: state.dragging_key,
        scroll_offset: next_global,
        motion: state.motion,
        interaction: state.interaction,
        dispatched_action: state.dispatched_action,
        last_text_key: state.last_text_key,
        last_text_val: state.last_text_val,
        text_caret: state.text_caret,
        last_toggle_key: state.last_toggle_key,
        last_toggle_val: state.last_toggle_val,
        has_toggle_change: state.has_toggle_change,
        last_slider_key: state.last_slider_key,
        last_slider_val: state.last_slider_val,
        has_slider_change: state.has_slider_change,
        close_requested: state.close_requested,
        dirty: true,
        extras: next_ex,
    }
}

/// Apply one `HostEvent` to `state` against the laid-out `tree`.
pub def ui_apply_event(tree: UiTree, state: UiState, ev: HostEvent) -> UiState effect alloc {
    val next = when ev.kind {
        UiEventKind.CloseRequested => set_close_requested(state),
        UiEventKind.PointerMove => apply_pointer_move(tree, state, ev),
        UiEventKind.PointerLeave => apply_pointer_leave(state),
        UiEventKind.PointerDown => apply_pointer_down(tree, state, ev),
        UiEventKind.PointerUp => apply_pointer_up(tree, state, ev),
        UiEventKind.Wheel => apply_wheel(tree, state, ev),
        UiEventKind.KeyDown => apply_key_down(tree, state, ev),
        UiEventKind.TextInput => apply_text_input(tree, state, ev),
        UiEventKind.FileDropped => apply_file_dropped(state, ev),
        UiEventKind.Resized => set_state_dirty(state, true),
        UiEventKind.KeyUp => state,
        UiEventKind.FocusChanged => state,
        UiEventKind.RedrawRequested => set_state_dirty(state, true),
        UiEventKind.ScaleChanged => set_state_dirty(state, true),
        UiEventKind.Unknown => state,
    }
    return ui_apply_interaction_extras(tree, state, next, ev)
}

/// Map a `WidgetKind` to its `AccessKit` integer role code understood by `iris_ui_host`.
pub def ui_a11y_role(kind: WidgetKind) -> i64 {
    return when kind {
        WidgetKind.Label => 2,
        WidgetKind.Badge => 2,
        WidgetKind.Chip => 2,
        WidgetKind.Avatar => 2,
        WidgetKind.StatCard => 2,
        WidgetKind.Button => 3,
        WidgetKind.IconButton => 3,
        WidgetKind.NavItem => 3,
        WidgetKind.Menu => 3,
        WidgetKind.Tabs => 3,
        WidgetKind.Segmented => 3,
        WidgetKind.Breadcrumb => 3,
        WidgetKind.Accordion => 3,
        WidgetKind.TextInput => 4,
        WidgetKind.TextArea => 4,
        WidgetKind.Checkbox => 5,
        WidgetKind.Radio => 5,
        WidgetKind.Toggle => 6,
        WidgetKind.Slider => 7,
        WidgetKind.Stepper => 7,
        WidgetKind.Select => 3,
        WidgetKind.TableHeader => 8,
        WidgetKind.TableRow => 9,
        WidgetKind.Sparkline => 10,
        WidgetKind.LineChart => 10,
        WidgetKind.BarChart => 10,
        WidgetKind.RadarScope => 10,
        WidgetKind.TensorView => 10,
        WidgetKind.Image => 10,
        WidgetKind.ProgressBar => 7,
        WidgetKind.ProgressRing => 7,
        _ => 0,
    }
}

/// Map normalized intensity `t` in `[0.0, 1.0]` onto `theme`'s semantic thermal ramp.
pub def ui_thermal_color_for(theme: UiTheme, t: f64) -> UiColor {
    val u = clamp01(t)
    val c0 = mix_color(theme.bg, theme.azure, 0.22)
    val c1 = theme.azure
    val c2 = theme.teal
    val c3 = theme.amber
    val c4 = theme.coral
    if u < 0.25 {
        return mix_color(c0, c1, u * 4.0)
    }
    if u < 0.50 {
        return mix_color(c1, c2, (u - 0.25) * 4.0)
    }
    if u < 0.75 {
        return mix_color(c2, c3, (u - 0.50) * 4.0)
    }
    return mix_color(c3, c4, (u - 0.75) * 4.0)
}

/// Map normalized intensity `t` in `[0.0, 1.0]` onto the IRIS Obsidian thermal ramp.
pub def ui_thermal_color(t: f64) -> UiColor {
    return ui_thermal_color_for(obsidian_theme(), t)
}

def emit_node_a11y_with_state(
    buf: DrawBuffer,
    state: UiState,
    node: UiNode,
) -> DrawBuffer effect ffi, alloc {
    val lbl = if len(node.text) > 0 {
        node.text
    } else {
        if len(node.placeholder) > 0 { node.placeholder } else { node.key }
    }
    if len(lbl) == 0 && !is_interactive_node(node) {
        return buf
    }
    var flags = 0
    if node.disabled {
        flags = flags + 1
    }
    if node.checked {
        flags = flags + 2
    }
    if len(node.key) > 0 && state.focused_key == node.key {
        flags = flags + 4
    }
    return draw_cmd_a11y_state(
        buf,
        node.id + 1,
        0,
        ui_a11y_role(node.kind),
        node.layout,
        flags,
        lbl,
    )
}

def emit_node_a11y(buf: DrawBuffer, node: UiNode) -> DrawBuffer effect ffi, alloc {
    val lbl = if len(node.text) > 0 {
        node.text
    } else {
        if len(node.placeholder) > 0 { node.placeholder } else { node.key }
    }
    if len(lbl) == 0 && !is_interactive_node(node) {
        return buf
    }
    val flags = (if node.disabled { 1 } else { 0 }) + (if node.checked { 2 } else { 0 })
    return draw_cmd_a11y_state(
        buf,
        node.id + 1,
        0,
        ui_a11y_role(node.kind),
        node.layout,
        flags,
        lbl,
    )
}

def paint_elevation_shadow(
    theme: UiTheme,
    node: UiNode,
    buf: DrawBuffer,
) -> DrawBuffer effect ffi, alloc {
    if theme.shadow.a <= 0 || node.layout.w < 2.0 || node.layout.h < 2.0 {
        return buf
    }
    val has_shadow = when node.style.elevation {
        UiElevation.Flat => false,
        _ => true,
    }
    if !has_shadow {
        return buf
    }
    val rad = if node.style.radius > 0.0 { node.style.radius } else { theme.radius }
    val radii = UiRadii { tl: rad, tr: rad, br: rad, bl: rad }
    val base_a = to_f64(theme.shadow.a)
    return when node.style.elevation {
        UiElevation.Flat => buf,
        UiElevation.Subtle => draw_cmd_box_shadow(
            buf,
            node.layout,
            radii,
            0.0,
            1.5,
            4.0,
            0.0,
            with_alpha(theme.shadow, (base_a * 0.45) to i64),
        ),
        UiElevation.Raised => draw_cmd_box_shadow(
            buf,
            node.layout,
            radii,
            0.0,
            4.0,
            10.0,
            0.0,
            with_alpha(theme.shadow, (base_a * 0.72) to i64),
        ),
        UiElevation.Floating => draw_cmd_box_shadow(
            buf,
            node.layout,
            radii,
            0.0,
            8.0,
            18.0,
            1.0,
            with_alpha(theme.shadow, (base_a * 0.90) to i64),
        ),
        UiElevation.Modal => draw_cmd_box_shadow(
            buf,
            node.layout,
            radii,
            0.0,
            14.0,
            30.0,
            2.0,
            theme.shadow,
        ),
    }
}

def paint_card_or_box(
    theme: UiTheme,
    node: UiNode,
    buf: DrawBuffer,
) -> DrawBuffer effect ffi, alloc {
    val is_card = when node.kind {
        WidgetKind.Card => true,
        _ => false,
    }
    if is_card {
        val bg = if node.style.bg.a > 0 { node.style.bg } else { theme.panel }
        val br = if node.style.border.a > 0 { node.style.border } else { theme.border }
        val bw = if node.style.border_width > 0.0 { node.style.border_width } else { 1.0 }
        val st = UiStyle { bg: bg, border: br, border_width: bw }
        return draw_cmd_round_rect(buf, node.layout, fmax(4.0, node.style.radius), st)
    }
    if node.style.bg.a > 0 || node.style.border_width > 0.0 {
        return draw_cmd_round_rect(buf, node.layout, node.style.radius, node.style)
    }
    return buf
}

def paint_badge(theme: UiTheme, node: UiNode, buf: DrawBuffer) -> DrawBuffer effect ffi, alloc {
    val accent = tone_color(theme, node.tone)
    val bg = mix_color(theme.surface, accent, 0.22)
    val box_st = UiStyle { bg: bg, border: accent, border_width: 1.0 }
    var b = draw_cmd_round_rect(buf, node.layout, node.layout.h * 0.5, box_st)
    val txt_r = UiRect {
        x: node.layout.x + 9.0,
        y: node.layout.y + 3.0,
        w: fmax(0.0, node.layout.w - 18.0),
        h: node.layout.h - 4.0,
    }
    val txt_st = UiStyle { fg: accent, font_size: 12.0, bold: true }
    b = draw_cmd_text(b, txt_r, node.text, txt_st)
    return emit_node_a11y(b, node)
}

def paint_button(
    theme: UiTheme,
    node: UiNode,
    state: UiState,
    buf: DrawBuffer,
) -> DrawBuffer effect ffi, alloc {
    val accent = tone_color(theme, node.tone)
    val clear = UiColor { r: 0, g: 0, b: 0, a: 0 }
    var fill = if node.style.bg.a > 0 {
        node.style.bg
    } else {
        when node.style.variant {
            UiButtonVariant.Solid => mix_color(theme.panel_alt, accent, 0.28),
            UiButtonVariant.Soft => mix_color(theme.surface, accent, 0.16),
            UiButtonVariant.Outline => clear,
            UiButtonVariant.Ghost => clear,
        }
    }
    var txt_fg = when node.style.variant {
        UiButtonVariant.Solid => theme.fg,
        UiButtonVariant.Soft => accent,
        UiButtonVariant.Outline => accent,
        UiButtonVariant.Ghost => if node.style.fg.a > 0 { node.style.fg } else { theme.fg },
    }
    val is_hov = !node.disabled && len(node.key) > 0 && state.hovered_key == node.key
    val is_act = !node.disabled && len(node.key) > 0 && state.active_key == node.key
    val is_foc = !node.disabled && len(node.key) > 0 && state.focused_key == node.key
    val hov = if node.disabled {
        0.0
    } else {
        fmax(ui_state_hover_progress(state, node.key), if is_hov { 1.0 } else { 0.0 })
    }
    val act = if node.disabled {
        0.0
    } else {
        fmax(ui_state_press_progress(state, node.key), if is_act { 1.0 } else { 0.0 })
    }
    if hov > 0.0 {
        val base_h = if fill.a > 0 { fill } else { theme.panel }
        fill = mix_color(base_h, theme.fg, 0.10 * hov)
    }
    if act > 0.0 {
        val base_a = if fill.a > 0 { fill } else { theme.panel }
        fill = mix_color(base_a, accent, 0.28 * act)
    }
    if ui_state_is_selected(state, node.key) {
        fill = mix_color(if fill.a > 0 { fill } else { theme.panel }, theme.cyan, 0.22)
    }
    if node.disabled {
        fill = mix_color(theme.surface, theme.panel, 0.5)
        txt_fg = theme.fg_muted
    }
    val default_br = when node.style.variant {
        UiButtonVariant.Ghost => if is_hov { theme.border } else { clear },
        UiButtonVariant.Soft => with_alpha(accent, 90),
        _ => accent,
    }
    val br = if node.disabled {
        theme.border
    } else if is_foc {
        theme.focus_ring
    } else if node.style.border.a > 0 {
        node.style.border
    } else {
        default_br
    }
    val bw = if is_foc {
        2.0
    } else if br.a > 0 {
        1.0
    } else {
        0.0
    }
    var b = draw_cmd_round_rect(
        buf,
        node.layout,
        node.style.radius,
        UiStyle { bg: fill, border: br, border_width: bw },
    )
    val fs = if node.style.font_size > 0.0 { node.style.font_size } else { 14.0 }
    val txt_r = UiRect {
        x: node.layout.x + 12.0,
        y: node.layout.y + fmax(4.0, (node.layout.h - fs * 1.35) * 0.5),
        w: fmax(0.0, node.layout.w - 24.0),
        h: node.layout.h,
    }
    b = draw_cmd_text(
        b,
        txt_r,
        node.text,
        UiStyle { fg: txt_fg, font_size: fs, bold: true, align: UiAlign.Center, ellipsis: true },
    )
    return emit_node_a11y_with_state(b, state, node)
}

def paint_text_input(
    theme: UiTheme,
    node: UiNode,
    state: UiState,
    buf: DrawBuffer,
) -> DrawBuffer effect ffi, alloc {
    val focused = !node.disabled && len(node.key) > 0 && state.focused_key == node.key
    val is_hov = !node.disabled && len(node.key) > 0 && state.hovered_key == node.key
    val br = if focused {
        theme.focus_ring
    } else if is_hov {
        lighten(theme.border, 0.25)
    } else {
        theme.border
    }
    var b = draw_cmd_round_rect(
        buf,
        node.layout,
        node.style.radius,
        UiStyle { bg: theme.surface, border: br, border_width: if focused { 1.5 } else { 1.0 } },
    )
    val clip_r = UiRect {
        x: node.layout.x + 10.0,
        y: node.layout.y + 4.0,
        w: fmax(4.0, node.layout.w - 20.0),
        h: fmax(4.0, node.layout.h - 8.0),
    }
    b = draw_cmd_push_clip(b, clip_r)
    val active_txt = if len(node.key) > 0 && state.last_text_key == node.key {
        state.last_text_val
    } else {
        node.text
    }
    val is_multi = state.interaction.multiline || node.kind == WidgetKind.TextArea
    val has_text = len(active_txt) > 0
    val fg = if node.disabled {
        theme.fg_muted
    } else if has_text {
        theme.fg
    } else {
        theme.fg_muted
    }
    if is_multi && has_text {
        val lines = split_text_lines(active_txt)
        var li = 0
        while li < list_len(lines) {
            b = draw_cmd_text(
                b,
                UiRect {
                    x: clip_r.x,
                    y: node.layout.y + 7.0 + to_f64(li) * 18.0,
                    w: clip_r.w,
                    h: 18.0,
                },
                list_get(lines, li),
                UiStyle { fg: fg, font_size: 13.0, monospace: true },
            )
            li = li + 1
        }
    } else {
        val shown = if has_text { active_txt } else { node.placeholder }
        val txt_r = UiRect { x: clip_r.x, y: node.layout.y + 8.0, w: clip_r.w, h: clip_r.h }
        b = draw_cmd_text(b, txt_r, shown, UiStyle { fg: fg, font_size: 13.0, monospace: true })
    }
    if focused {
        val caret = if state.text_caret < 0 { text_len_chars(active_txt) } else { state.text_caret }
        val lc = if is_multi {
            text_line_col_at(active_txt, caret)
        } else {
            UiSize { w: 0.0, h: to_f64(caret) }
        }
        val col = if is_multi { lc.h to i64 } else { caret }
        val line = if is_multi { lc.w to i64 } else { 0 }
        val cx = fmin(clip_r.x + clip_r.w - 3.0, clip_r.x + to_f64(col) * 7.6 + 2.0)
        val cy = node.layout.y + 7.0 + to_f64(line) * 18.0
        val cy2 = if is_multi { cy + 15.0 } else { node.layout.y + node.layout.h - 7.0 }
        b = draw_cmd_line(b, UiRect { x: cx, y: cy, w: cx, h: cy2 }, theme.cyan, 1.5, false)
    }
    b = draw_cmd_pop_clip(b)
    return emit_node_a11y_with_state(b, state, node)
}

def fmt_slider_f1(v: f64) -> str effect alloc {
    val sign = if v < 0.0 { "-" } else { "" }
    val av = if v < 0.0 { 0.0 - v } else { v }
    val scaled = (av * 10.0 + 0.5) to i64
    val whole = scaled / 10
    val frac = scaled % 10
    return f"{sign}{whole}.{frac}"
}

def paint_checkbox(
    theme: UiTheme,
    node: UiNode,
    state: UiState,
    buf: DrawBuffer,
) -> DrawBuffer effect ffi, alloc {
    val accent = tone_color(theme, node.tone)
    val is_foc = len(node.key) > 0 && state.focused_key == node.key
    val is_hov = len(node.key) > 0 && state.hovered_key == node.key
    val box_r = UiRect {
        x: node.layout.x + 2.0,
        y: node.layout.y + fmax(2.0, (node.layout.h - 18.0) * 0.5),
        w: 18.0,
        h: 18.0,
    }
    val box_bg = if node.checked { accent } else { theme.surface }
    val box_br = if is_foc {
        theme.cyan
    } else if node.checked || is_hov {
        accent
    } else {
        theme.border
    }
    var b = draw_cmd_round_rect(
        buf,
        box_r,
        4.0,
        UiStyle { bg: box_bg, border: box_br, border_width: 1.5 },
    )
    if node.checked {
        b = draw_cmd_line(
            b,
            UiRect { x: box_r.x + 4.0, y: box_r.y + 9.0, w: box_r.x + 8.0, h: box_r.y + 13.0 },
            theme.bg,
            2.0,
            false,
        )
        b = draw_cmd_line(
            b,
            UiRect { x: box_r.x + 8.0, y: box_r.y + 13.0, w: box_r.x + 14.0, h: box_r.y + 5.0 },
            theme.bg,
            2.0,
            false,
        )
    }
    val txt_r = UiRect {
        x: box_r.x + 26.0,
        y: node.layout.y + 4.0,
        w: fmax(0.0, node.layout.w - 30.0),
        h: node.layout.h,
    }
    b = draw_cmd_text(b, txt_r, node.text, UiStyle { fg: theme.fg, font_size: 13.0 })
    return emit_node_a11y(b, node)
}

def paint_toggle(
    theme: UiTheme,
    node: UiNode,
    state: UiState,
    buf: DrawBuffer,
) -> DrawBuffer effect ffi, alloc {
    val is_foc = len(node.key) > 0 && state.focused_key == node.key
    val is_hov = len(node.key) > 0 && state.hovered_key == node.key
    val accent = if node.checked { tone_color(theme, node.tone) } else { theme.panel_alt }
    val track_br = if is_foc {
        theme.cyan
    } else if node.checked || is_hov {
        mix_color(theme.border, tone_color(theme, node.tone), 0.7)
    } else {
        theme.border
    }
    val track_r = UiRect {
        x: node.layout.x + 2.0,
        y: node.layout.y + fmax(2.0, (node.layout.h - 22.0) * 0.5),
        w: 40.0,
        h: 22.0,
    }
    var b = draw_cmd_round_rect(
        buf,
        track_r,
        11.0,
        UiStyle { bg: accent, border: track_br, border_width: if is_foc { 1.5 } else { 1.0 } },
    )
    val knob_x = if node.checked { track_r.x + 29.0 } else { track_r.x + 11.0 }
    val knob_fill = if node.checked { theme.bg } else { theme.fg }
    b = draw_cmd_circle(
        b,
        knob_x,
        track_r.y + 11.0,
        8.0,
        UiStyle { bg: knob_fill, border: theme.surface, border_width: 0.75 },
    )
    val txt_r = UiRect {
        x: track_r.x + 48.0,
        y: node.layout.y + 4.0,
        w: fmax(0.0, node.layout.w - 52.0),
        h: node.layout.h,
    }
    b = draw_cmd_text(b, txt_r, node.text, UiStyle { fg: theme.fg, font_size: 13.0 })
    return emit_node_a11y(b, node)
}

def paint_slider(
    theme: UiTheme,
    node: UiNode,
    state: UiState,
    buf: DrawBuffer,
) -> DrawBuffer effect ffi, alloc {
    val accent = tone_color(theme, node.tone)
    val is_foc = len(node.key) > 0 && state.focused_key == node.key
    val is_hov = len(node.key) > 0
        && (state.hovered_key == node.key || state.dragging_key == node.key)
    val has_lbl = len(node.text) > 0
    var b = buf
    if has_lbl {
        val lbl = f"{node.text}: {fmt_slider_f1(node.value)}"
        b = draw_cmd_text(
            b,
            UiRect { x: node.layout.x + 4.0, y: node.layout.y + 2.0, w: node.layout.w, h: 18.0 },
            lbl,
            UiStyle { fg: theme.fg, font_size: 12.0 },
        )
    }
    val ty = node.layout.y + (if has_lbl { 27.0 } else { node.layout.h * 0.5 })
    val tx = node.layout.x + 8.0
    val tw = fmax(24.0, node.layout.w - 16.0)
    val span = fmax(0.0001, node.max_val - node.min_val)
    val t = clamp01((node.value - node.min_val) / span)
    b = draw_cmd_round_rect(
        b,
        UiRect { x: tx, y: ty - 3.0, w: tw, h: 6.0 },
        3.0,
        UiStyle { bg: theme.panel_alt },
    )
    b = draw_cmd_round_rect(
        b,
        UiRect { x: tx, y: ty - 3.0, w: tw * t, h: 6.0 },
        3.0,
        UiStyle { bg: accent },
    )
    val knob_br = if is_foc || is_hov { theme.cyan } else { accent }
    b = draw_cmd_circle(
        b,
        tx + tw * t,
        ty,
        if is_hov { 8.5 } else { 7.5 },
        UiStyle { bg: theme.fg, border: knob_br, border_width: 2.0 },
    )
    return emit_node_a11y(b, node)
}

def normalize_series_points(
    series: ChartSeries,
    plot_r: UiRect,
) -> (list<f64>, list<f64>) effect alloc {
    val pxs: list<f64> = list()
    val pys: list<f64> = list()
    val n = list_len(series.ys)
    if n == 0 {
        return (pxs, pys)
    }
    var ymin = list_get(series.ys, 0)
    var ymax = ymin
    for i in 1..n {
        val v = list_get(series.ys, i)
        ymin = fmin(ymin, v)
        ymax = fmax(ymax, v)
    }
    val yspan = if ymax - ymin < 0.0001 { 1.0 } else { ymax - ymin }
    val denom = if n > 1 { to_f64(n - 1) } else { 1.0 }
    for i in 0..n {
        val tx = to_f64(i) / denom
        val ty = (list_get(series.ys, i) - ymin) / yspan
        list_push(pxs, plot_r.x + tx * plot_r.w)
        list_push(pys, plot_r.y + plot_r.h - ty * plot_r.h)
    }
    return (pxs, pys)
}

def paint_chart(
    tree: UiTree,
    node: UiNode,
    is_spark: bool,
    buf: DrawBuffer,
) -> DrawBuffer effect ffi, alloc {
    val theme = tree.theme
    var b = draw_cmd_round_rect(
        buf,
        node.layout,
        if is_spark { 6.0 } else { 8.0 },
        UiStyle { bg: theme.surface, border: theme.border, border_width: 1.0 },
    )
    if node.data_idx < 0 || node.data_idx >= list_len(tree.charts) {
        return b
    }
    val series = list_get(tree.charts, node.data_idx)
    val accent = tone_color(theme, series.tone)
    val top_pad = if is_spark { 6.0 } else { 26.0 }
    val plot_r = UiRect {
        x: node.layout.x + 8.0,
        y: node.layout.y + top_pad,
        w: fmax(16.0, node.layout.w - 16.0),
        h: fmax(12.0, node.layout.h - top_pad - 8.0),
    }
    if !is_spark {
        b = draw_cmd_text(
            b,
            UiRect {
                x: node.layout.x + 10.0,
                y: node.layout.y + 6.0,
                w: node.layout.w - 20.0,
                h: 18.0,
            },
            series.label,
            UiStyle { fg: theme.fg_muted, font_size: 12.0, bold: true },
        )
        val mid_y = plot_r.y + plot_r.h * 0.5
        b = draw_cmd_line(
            b,
            UiRect { x: plot_r.x, y: mid_y, w: plot_r.x + plot_r.w, h: mid_y },
            theme.border,
            1.0,
            true,
        )
    }
    val pts = normalize_series_points(series, plot_r)
    val fill_c = if series.fill { with_alpha(accent, 42) } else { rgba(0, 0, 0, 0) }
    b = draw_cmd_push_clip(b, plot_r)
    b = draw_cmd_polyline(b, pts.0, pts.1, accent, fill_c)
    b = draw_cmd_pop_clip(b)
    return emit_node_a11y(b, node)
}

def paint_radar_rings(
    theme: UiTheme,
    cx: f64,
    cy: f64,
    rad: f64,
    spec: RadarSpec,
    buf: DrawBuffer,
) -> DrawBuffer effect ffi, alloc {
    var b = buf
    val ring_st = UiStyle {
        bg: rgba(0, 0, 0, 0),
        border: mix_color(theme.border, theme.teal, 0.32),
        border_width: 1.0,
    }
    val rings = if spec.ring_count > 0 { spec.ring_count } else { 3 }
    for r_i in 1..(rings + 1) {
        val rr = rad * (to_f64(r_i) / to_f64(rings))
        b = draw_cmd_circle(b, cx, cy, rr, ring_st)
    }
    b = draw_cmd_line(b, UiRect { x: cx - rad, y: cy, w: cx + rad, h: cy }, theme.border, 1.0, true)
    b = draw_cmd_line(b, UiRect { x: cx, y: cy - rad, w: cx, h: cy + rad }, theme.border, 1.0, true)
    val own_r = spec.own_heading_deg * 0.017453292519943295
    b = draw_cmd_line(
        b,
        UiRect { x: cx, y: cy, w: cx + sin(own_r) * rad * 0.85, h: cy - cos(own_r) * rad * 0.85 },
        with_alpha(theme.cyan, 140),
        1.5,
        true,
    )
    return draw_cmd_circle(
        b,
        cx,
        cy,
        4.0,
        UiStyle { bg: theme.cyan, border: theme.fg, border_width: 1.0 },
    )
}

def radar_blip_xy(layout: UiRect, max_r: f64, blip: RadarBlip) -> UiSize {
    val cx = layout.x + layout.w * 0.5
    val cy = layout.y + 22.0 + (layout.h - 28.0) * 0.5
    val rad = fmax(24.0, fmin(layout.w, layout.h - 28.0) * 0.41)
    val br = blip.bearing_deg * 0.017453292519943295
    val d = clamp01(blip.range_nm / max_r) * rad
    return UiSize { w: cx + sin(br) * d, h: cy - cos(br) * d }
}

/// Find the index of the closest radar blip within 18 logical pixels of `(px, py)`.
pub def ui_radar_pick_blip(tree: UiTree, key: str, px: f64, py: f64) -> option<i64> effect alloc {
    val idx = when ui_find_node_key(tree, key) {
        some(i) => i,
        none => {
            return none
        },
    }
    val node = list_get(tree.nodes, idx)
    if node.data_idx < 0 || node.data_idx >= list_len(tree.radars) {
        return none
    }
    val spec = list_get(tree.radars, node.data_idx)
    val max_r = if spec.range_nm > 0.1 { spec.range_nm } else { 12.0 }
    var best_idx = -1
    var best_d2 = 324.0
    for i in 0..list_len(spec.blips) {
        val pos = radar_blip_xy(node.layout, max_r, list_get(spec.blips, i))
        val dx = px - pos.w
        val dy = py - pos.h
        val d2 = dx * dx + dy * dy
        if d2 <= best_d2 {
            best_d2 = d2
            best_idx = i
        }
    }
    return if best_idx >= 0 { some(best_idx) } else { none }
}

def paint_radar_blip(
    theme: UiTheme,
    node: UiNode,
    rad_r: f64,
    blip: RadarBlip,
    buf: DrawBuffer,
) -> DrawBuffer effect ffi, alloc {
    val bpos = radar_blip_xy(node.layout, rad_r, blip)
    val bx = bpos.w
    val by = bpos.h
    val c = tone_color(theme, blip.tone)
    val cr = blip.course_deg * 0.017453292519943295
    val vlen = fmin(22.0, 6.0 + blip.speed_kn * 0.8)
    var b = draw_cmd_line(
        buf,
        UiRect { x: bx, y: by, w: bx + sin(cr) * vlen, h: by - cos(cr) * vlen },
        c,
        1.5,
        false,
    )
    if len(node.placeholder) > 0 && blip.label == node.placeholder {
        b = draw_cmd_circle(
            b,
            bx,
            by,
            9.5,
            UiStyle { bg: rgba(0, 0, 0, 0), border: theme.cyan, border_width: 1.5 },
        )
    }
    b = draw_cmd_circle(b, bx, by, 4.5, UiStyle { bg: c, border: theme.bg, border_width: 1.0 })
    if len(blip.label) == 0 {
        return b
    }
    val est_w = fmax(48.0, to_f64(len(blip.label)) * 7.2 + 8.0)
    val fits_right = bx + 6.0 + est_w <= node.layout.x + node.layout.w - 6.0
    val lbl_x = if fits_right { bx + 6.0 } else { fmax(node.layout.x + 8.0, bx - 6.0 - est_w) }
    val lbl_y = fmax(node.layout.y + 24.0, fmin(by - 8.0, node.layout.y + node.layout.h - 20.0))
    return draw_cmd_text(
        b,
        UiRect { x: lbl_x, y: lbl_y, w: est_w, h: 16.0 },
        blip.label,
        UiStyle { fg: c, font_size: 11.0, monospace: true },
    )
}

def paint_radar_scope(
    tree: UiTree,
    node: UiNode,
    state: UiState,
    buf: DrawBuffer,
) -> DrawBuffer effect ffi, alloc {
    val theme = tree.theme
    val scope_bg = mix_color(theme.bg, theme.surface, 0.35)
    val is_foc = len(node.action) > 0 && len(node.key) > 0 && state.focused_key == node.key
    val is_hov = len(node.action) > 0 && len(node.key) > 0 && state.hovered_key == node.key
    val scope_br = if is_foc {
        theme.cyan
    } else if is_hov {
        mix_color(theme.border, theme.cyan, 0.45)
    } else {
        theme.border
    }
    var b = draw_cmd_round_rect(
        buf,
        node.layout,
        10.0,
        UiStyle { bg: scope_bg, border: scope_br, border_width: if is_foc { 1.5 } else { 1.0 } },
    )
    if node.data_idx < 0 || node.data_idx >= list_len(tree.radars) {
        return b
    }
    val spec = list_get(tree.radars, node.data_idx)
    b = draw_cmd_text(
        b,
        UiRect {
            x: node.layout.x + 12.0,
            y: node.layout.y + 8.0,
            w: node.layout.w - 24.0,
            h: 18.0,
        },
        spec.title,
        UiStyle { fg: theme.teal, font_size: 12.0, bold: true },
    )
    val cx = node.layout.x + node.layout.w * 0.5
    val cy = node.layout.y + 22.0 + (node.layout.h - 28.0) * 0.5
    val rad = fmax(24.0, fmin(node.layout.w, node.layout.h - 28.0) * 0.41)
    b = draw_cmd_push_clip(b, node.layout)
    b = paint_radar_rings(theme, cx, cy, rad, spec, b)
    val max_r = if spec.range_nm > 0.1 { spec.range_nm } else { 12.0 }
    for i in 0..list_len(spec.blips) {
        b = paint_radar_blip(theme, node, max_r, list_get(spec.blips, i), b)
    }
    b = draw_cmd_pop_clip(b)
    return emit_node_a11y(b, node)
}

def paint_tensor_view(tree: UiTree, node: UiNode, buf: DrawBuffer) -> DrawBuffer effect ffi, alloc {
    val theme = tree.theme
    var b = draw_cmd_round_rect(
        buf,
        node.layout,
        8.0,
        UiStyle { bg: theme.surface, border: theme.border, border_width: 1.0 },
    )
    if node.data_idx < 0 || node.data_idx >= list_len(tree.tensors) {
        return b
    }
    val spec = list_get(tree.tensors, node.data_idx)
    if len(spec.title) > 0 {
        b = draw_cmd_text(
            b,
            UiRect {
                x: node.layout.x + 10.0,
                y: node.layout.y + 6.0,
                w: node.layout.w - 20.0,
                h: 18.0,
            },
            spec.title,
            UiStyle { fg: theme.fg_muted, font_size: 12.0, bold: true },
        )
    }
    val pixels: list<i64> = list()
    val span = if spec.vmax - spec.vmin < 0.0001 { 1.0 } else { spec.vmax - spec.vmin }
    val total = spec.width * spec.height
    val avail = list_len(spec.cells)
    for i in 0..total {
        val raw = if i < avail { list_get(spec.cells, i) } else { spec.vmin }
        list_push(pixels, pack_rgba(ui_thermal_color_for(theme, (raw - spec.vmin) / span)))
    }
    val top_y = if len(spec.title) > 0 { 26.0 } else { 8.0 }
    val dest = UiRect {
        x: node.layout.x + 8.0,
        y: node.layout.y + top_y,
        w: fmax(16.0, node.layout.w - 16.0),
        h: fmax(16.0, node.layout.h - top_y - 8.0),
    }
    if spec.width > 0 && spec.height > 0 {
        b = draw_cmd_image_rgba(b, dest, spec.width, spec.height, pixels)
    }
    return emit_node_a11y(b, node)
}

def paint_table_band(
    theme: UiTheme,
    node: UiNode,
    state: UiState,
    is_header: bool,
    buf: DrawBuffer,
) -> DrawBuffer effect ffi, alloc {
    val accent = if is_header { theme.cyan } else { tone_color(theme, node.tone) }
    val is_hov = !is_header && len(node.key) > 0 && state.hovered_key == node.key
    val is_sel = !is_header && (node.checked || ui_state_is_selected(state, node.key))
    var bg = if is_header {
        theme.panel_alt
    } else {
        mix_color(mix_color(theme.surface, theme.panel, 0.45), accent, 0.10)
    }
    if is_hov {
        bg = mix_color(bg, theme.fg, 0.08)
    }
    if is_sel {
        bg = mix_color(theme.panel_alt, accent, 0.22)
    }
    val br = if is_sel { accent } else { theme.border }
    val bw = if is_sel { 1.25 } else { 0.0 }
    var b = draw_cmd_round_rect(
        buf,
        node.layout,
        4.0,
        UiStyle { bg: bg, border: br, border_width: bw },
    )
    if is_sel {
        b = draw_cmd_round_rect(
            b,
            UiRect {
                x: node.layout.x + 1.0,
                y: node.layout.y + 3.0,
                w: 3.0,
                h: fmax(4.0, node.layout.h - 6.0),
            },
            1.5,
            UiStyle { bg: accent },
        )
    }
    val fg = if is_header { accent } else { mix_color(theme.fg, accent, 0.35) }
    b = draw_cmd_text(
        b,
        UiRect {
            x: node.layout.x + 10.0,
            y: node.layout.y + 5.0,
            w: fmax(0.0, node.layout.w - 20.0),
            h: node.layout.h,
        },
        node.text,
        UiStyle {
            fg: fg,
            font_size: 12.0,
            bold: is_header || is_sel,
            monospace: true,
        },
    )
    val by = node.layout.y + node.layout.h
    b = draw_cmd_line(
        b,
        UiRect { x: node.layout.x, y: by, w: node.layout.x + node.layout.w, h: by },
        theme.border,
        1.0,
        false,
    )
    return emit_node_a11y(b, node)
}

def paint_split_pane(
    tree: UiTree,
    node: UiNode,
    state: UiState,
    buf: DrawBuffer,
) -> DrawBuffer effect ffi, alloc {
    var b = paint_card_or_box(tree.theme, node, buf)
    val ix = node.layout.x + style_pad_x(node.style)
    val iy = node.layout.y + style_pad_y(node.style)
    val iw = fmax(0.0, node.layout.w - style_pad_x(node.style) * 2.0)
    val ih = fmax(0.0, node.layout.h - style_pad_y(node.style) * 2.0)
    val ratio = tree_split_ratio(tree, node)
    val div = split_divider_rect(UiRect { x: ix, y: iy, w: iw, h: ih }, ratio)
    val active = len(node.key) > 0
        && (state.hovered_key == node.key || state.dragging_key == node.key)
    val line_col = if active { tree.theme.cyan } else { tree.theme.border }
    val lx = div.x + div.w * 0.5
    b = draw_cmd_line(
        b,
        UiRect { x: lx, y: div.y + 4.0, w: lx, h: div.y + div.h - 4.0 },
        line_col,
        if active { 2.0 } else { 1.0 },
        false,
    )
    b = draw_cmd_round_rect(
        b,
        UiRect { x: lx - 2.0, y: div.y + div.h * 0.5 - 16.0, w: 4.0, h: 32.0 },
        2.0,
        UiStyle { bg: if active { tree.theme.cyan } else { tree.theme.panel_alt } },
    )
    return b
}

def paint_divider(theme: UiTheme, node: UiNode, buf: DrawBuffer) -> DrawBuffer effect ffi, alloc {
    val cy = node.layout.y + node.layout.h * 0.5
    val col = if node.style.border.a > 0 { node.style.border } else { theme.border }
    var b = draw_cmd_line(
        buf,
        UiRect { x: node.layout.x, y: cy, w: node.layout.x + node.layout.w, h: cy },
        col,
        1.0,
        false,
    )
    if len(node.text) > 0 {
        val tw = fmin(node.layout.w * 0.6, to_f64(len(node.text)) * 7.5 + 16.0)
        val pill = UiRect {
            x: node.layout.x + (node.layout.w - tw) * 0.5,
            y: cy - 9.0,
            w: tw,
            h: 18.0,
        }
        b = draw_cmd_round_rect(b, pill, 4.0, UiStyle { bg: theme.bg })
        b = draw_cmd_text(
            b,
            pill,
            node.text,
            UiStyle { fg: theme.fg_muted, font_size: 11.0, align: UiAlign.Center },
        )
    }
    return b
}

def paint_icon_widget(
    theme: UiTheme,
    node: UiNode,
    buf: DrawBuffer,
) -> DrawBuffer effect ffi, alloc {
    val sz = fmax(12.0, fmin(node.layout.w, node.layout.h) * 0.85)
    val ir = UiRect {
        x: node.layout.x + (node.layout.w - sz) * 0.5,
        y: node.layout.y + (node.layout.h - sz) * 0.5,
        w: sz,
        h: sz,
    }
    val fg = if node.style.fg.a > 0 && node.style.fg.r != 212 {
        node.style.fg
    } else {
        tone_color(theme, node.tone)
    }
    return draw_icon(buf, node.icon, ir, fg)
}

def paint_icon_button(
    theme: UiTheme,
    node: UiNode,
    state: UiState,
    buf: DrawBuffer,
) -> DrawBuffer effect ffi, alloc {
    val accent = tone_color(theme, node.tone)
    val clear = UiColor { r: 0, g: 0, b: 0, a: 0 }
    val is_hov = !node.disabled && len(node.key) > 0 && state.hovered_key == node.key
    val is_act = !node.disabled && len(node.key) > 0 && state.active_key == node.key
    val is_foc = !node.disabled && len(node.key) > 0 && state.focused_key == node.key
    val hov = if node.disabled {
        0.0
    } else {
        fmax(ui_state_hover_progress(state, node.key), if is_hov { 1.0 } else { 0.0 })
    }
    val act = if node.disabled {
        0.0
    } else {
        fmax(ui_state_press_progress(state, node.key), if is_act { 1.0 } else { 0.0 })
    }
    var bg = if node.style.bg.a > 0 { node.style.bg } else { theme.panel_alt }
    if hov > 0.0 {
        bg = mix_color(bg, accent, 0.18 * hov)
    }
    if act > 0.0 {
        bg = mix_color(bg, accent, 0.34 * act)
    }
    if node.disabled {
        bg = mix_color(theme.surface, theme.panel, 0.5)
    }
    val br = if is_foc {
        theme.focus_ring
    } else if node.style.border.a > 0 {
        node.style.border
    } else {
        if hov > 0.1 { accent } else { clear }
    }
    var b = draw_cmd_round_rect(
        buf,
        node.layout,
        node.style.radius,
        UiStyle {
            bg: bg,
            border: br,
            border_width: if is_foc {
                2.0
            } else if br.a > 0 {
                1.0
            } else {
                0.0
            },
        },
    )
    val icon_sz = 18.0
    val fg = if node.disabled { theme.fg_muted } else { if is_hov { theme.fg } else { accent } }
    if len(node.text) > 0 {
        val ir = UiRect {
            x: node.layout.x + 10.0,
            y: node.layout.y + (node.layout.h - icon_sz) * 0.5,
            w: icon_sz,
            h: icon_sz,
        }
        b = draw_icon(b, node.icon, ir, fg)
        b = draw_cmd_text(
            b,
            UiRect {
                x: node.layout.x + 34.0,
                y: node.layout.y + 8.0,
                w: fmax(0.0, node.layout.w - 42.0),
                h: node.layout.h - 12.0,
            },
            node.text,
            UiStyle {
                fg: if node.disabled { theme.fg_muted } else { theme.fg },
                font_size: 13.0,
                bold: true,
                ellipsis: true,
            },
        )
    } else {
        val ir = UiRect {
            x: node.layout.x + (node.layout.w - icon_sz) * 0.5,
            y: node.layout.y + (node.layout.h - icon_sz) * 0.5,
            w: icon_sz,
            h: icon_sz,
        }
        b = draw_icon(b, node.icon, ir, fg)
    }
    if len(node.badge_text) > 0 {
        b = draw_cmd_circle(
            b,
            node.layout.x + node.layout.w - 6.0,
            node.layout.y + 6.0,
            4.0,
            UiStyle { bg: theme.coral },
        )
    }
    return emit_node_a11y_with_state(b, state, node)
}

def paint_radio(
    theme: UiTheme,
    node: UiNode,
    state: UiState,
    buf: DrawBuffer,
) -> DrawBuffer effect ffi, alloc {
    val accent = tone_color(theme, node.tone)
    val is_foc = !node.disabled && len(node.key) > 0 && state.focused_key == node.key
    val is_hov = !node.disabled && len(node.key) > 0 && state.hovered_key == node.key
    val cx = node.layout.x + 11.0
    val cy = node.layout.y + node.layout.h * 0.5
    val br = if is_foc {
        theme.focus_ring
    } else if node.checked || is_hov {
        accent
    } else {
        theme.border
    }
    var b = draw_cmd_circle(
        buf,
        cx,
        cy,
        9.0,
        UiStyle { bg: theme.surface, border: br, border_width: if is_foc { 2.0 } else { 1.5 } },
    )
    if node.checked {
        b = draw_cmd_circle(b, cx, cy, 4.5, UiStyle { bg: accent })
    }
    b = draw_cmd_text(
        b,
        UiRect {
            x: node.layout.x + 28.0,
            y: node.layout.y + 4.0,
            w: fmax(0.0, node.layout.w - 30.0),
            h: node.layout.h - 4.0,
        },
        node.text,
        UiStyle { fg: if node.disabled { theme.fg_muted } else { theme.fg }, font_size: 13.5 },
    )
    return emit_node_a11y_with_state(b, state, node)
}

def paint_select(
    tree: UiTree,
    node: UiNode,
    state: UiState,
    buf: DrawBuffer,
) -> DrawBuffer effect ffi, alloc {
    val theme = tree.theme
    val is_open = state.extras.open_popup_key == node.key && len(node.key) > 0
    val is_foc = len(node.key) > 0 && state.focused_key == node.key
    val is_hov = len(node.key) > 0 && state.hovered_key == node.key
    val br = if is_open || is_foc {
        theme.focus_ring
    } else if is_hov {
        lighten(theme.border, 0.25)
    } else {
        theme.border
    }
    var b = draw_cmd_round_rect(
        buf,
        node.layout,
        node.style.radius,
        UiStyle {
            bg: theme.surface,
            border: br,
            border_width: if is_open || is_foc { 1.5 } else { 1.0 },
        },
    )
    var label = node.placeholder
    var has_val = false
    if node.data_idx >= 0 && node.data_idx < list_len(tree.selects) {
        val spec = list_get(tree.selects, node.data_idx)
        if node.selected_idx >= 0 && node.selected_idx < list_len(spec.options) {
            label = list_get(spec.options, node.selected_idx)
            has_val = true
        } else if len(label) == 0 {
            label = spec.placeholder
        }
    }
    b = draw_cmd_text(
        b,
        UiRect {
            x: node.layout.x + 12.0,
            y: node.layout.y + 8.0,
            w: fmax(0.0, node.layout.w - 40.0),
            h: node.layout.h - 10.0,
        },
        label,
        UiStyle {
            fg: if has_val && !node.disabled { theme.fg } else { theme.fg_muted },
            font_size: 13.5,
            ellipsis: true,
        },
    )
    val chev = if is_open { UiIcon.ChevronUp } else { UiIcon.ChevronDown }
    b = draw_icon(
        b,
        chev,
        UiRect {
            x: node.layout.x + node.layout.w - 24.0,
            y: node.layout.y + (node.layout.h - 16.0) * 0.5,
            w: 16.0,
            h: 16.0,
        },
        theme.fg_muted,
    )
    return emit_node_a11y_with_state(b, state, node)
}

def paint_tabs_or_segmented(
    tree: UiTree,
    node: UiNode,
    state: UiState,
    is_segmented: bool,
    buf: DrawBuffer,
) -> DrawBuffer effect ffi, alloc {
    val theme = tree.theme
    val accent = tone_color(theme, node.tone)
    if node.data_idx < 0 || node.data_idx >= list_len(tree.tabs_specs) {
        return buf
    }
    val spec = list_get(tree.tabs_specs, node.data_idx)
    val n = list_len(spec.labels)
    if n == 0 {
        return buf
    }
    var b = buf
    val seg_w = node.layout.w / to_f64(n)
    val anim_pos = ui_state_spring_value(state, "tab:" + node.key, to_f64(node.selected_idx))
    val clamped_pos = fmin(to_f64(n - 1), fmax(0.0, anim_pos))
    if is_segmented {
        b = draw_cmd_round_rect(
            b,
            node.layout,
            fmin(node.style.radius, node.layout.h * 0.45),
            UiStyle { bg: theme.panel, border: theme.border, border_width: 1.0 },
        )
        val pill_r = UiRect {
            x: node.layout.x + 3.0 + clamped_pos * seg_w,
            y: node.layout.y + 3.0,
            w: fmax(12.0, seg_w - 6.0),
            h: fmax(12.0, node.layout.h - 6.0),
        }
        b = draw_cmd_round_rect(
            b,
            pill_r,
            fmax(4.0, fmin(node.style.radius, pill_r.h * 0.4)),
            UiStyle {
                bg: mix_color(theme.panel_alt, accent, 0.25),
                border: with_alpha(accent, 140),
                border_width: 1.0,
            },
        )
    } else {
        val by = node.layout.y + node.layout.h - 1.0
        b = draw_cmd_line(
            b,
            UiRect { x: node.layout.x, y: by, w: node.layout.x + node.layout.w, h: by },
            theme.border,
            1.0,
            false,
        )
        val ind_r = UiRect {
            x: node.layout.x + clamped_pos * seg_w + 6.0,
            y: by - 2.0,
            w: fmax(12.0, seg_w - 12.0),
            h: 3.0,
        }
        b = draw_cmd_round_rect(b, ind_r, 1.5, UiStyle { bg: accent })
    }
    for i in 0..n {
        val is_sel = i == node.selected_idx
        val tr = UiRect {
            x: node.layout.x + to_f64(i) * seg_w + 4.0,
            y: node.layout.y + 7.0,
            w: fmax(0.0, seg_w - 8.0),
            h: fmax(0.0, node.layout.h - 10.0),
        }
        b = draw_cmd_text(
            b,
            tr,
            list_get(spec.labels, i),
            UiStyle {
                fg: if is_sel { theme.fg } else { theme.fg_muted },
                font_size: 13.0,
                bold: is_sel,
                align: UiAlign.Center,
                ellipsis: true,
            },
        )
    }
    return emit_node_a11y_with_state(b, state, node)
}

def paint_stepper(
    theme: UiTheme,
    node: UiNode,
    state: UiState,
    buf: DrawBuffer,
) -> DrawBuffer effect ffi, alloc {
    val accent = tone_color(theme, node.tone)
    val is_foc = len(node.key) > 0 && state.focused_key == node.key
    val is_hov = len(node.key) > 0 && state.hovered_key == node.key
    val br = if is_foc {
        theme.focus_ring
    } else if is_hov {
        accent
    } else {
        theme.border
    }
    var b = draw_cmd_round_rect(
        buf,
        node.layout,
        node.style.radius,
        UiStyle { bg: theme.surface, border: br, border_width: if is_foc { 1.5 } else { 1.0 } },
    )
    val btn_w = fmin(34.0, node.layout.w * 0.28)
    val div1 = node.layout.x + btn_w
    val div2 = node.layout.x + node.layout.w - btn_w
    b = draw_cmd_line(
        b,
        UiRect { x: div1, y: node.layout.y + 4.0, w: div1, h: node.layout.y + node.layout.h - 4.0 },
        theme.border,
        1.0,
        false,
    )
    b = draw_cmd_line(
        b,
        UiRect { x: div2, y: node.layout.y + 4.0, w: div2, h: node.layout.y + node.layout.h - 4.0 },
        theme.border,
        1.0,
        false,
    )
    val iy = node.layout.y + (node.layout.h - 14.0) * 0.5
    b = draw_icon(
        b,
        UiIcon.Minus,
        UiRect { x: node.layout.x + (btn_w - 14.0) * 0.5, y: iy, w: 14.0, h: 14.0 },
        theme.fg,
    )
    b = draw_icon(
        b,
        UiIcon.Plus,
        UiRect { x: div2 + (btn_w - 14.0) * 0.5, y: iy, w: 14.0, h: 14.0 },
        theme.fg,
    )
    val val_txt = if len(node.text) > 0 { node.text } else { fmt_slider_f1(node.value) }
    b = draw_cmd_text(
        b,
        UiRect {
            x: div1 + 4.0,
            y: node.layout.y + 7.0,
            w: fmax(0.0, div2 - div1 - 8.0),
            h: node.layout.h - 10.0,
        },
        val_txt,
        UiStyle {
            fg: theme.fg,
            font_size: 13.0,
            bold: true,
            monospace: true,
            align: UiAlign.Center,
        },
    )
    return emit_node_a11y_with_state(b, state, node)
}

def paint_nav_item(
    theme: UiTheme,
    node: UiNode,
    state: UiState,
    buf: DrawBuffer,
) -> DrawBuffer effect ffi, alloc {
    val accent = tone_color(theme, node.tone)
    val clear = UiColor { r: 0, g: 0, b: 0, a: 0 }
    val is_hov = !node.disabled && len(node.key) > 0 && state.hovered_key == node.key
    val is_foc = !node.disabled && len(node.key) > 0 && state.focused_key == node.key
    val bg = if node.checked {
        mix_color(theme.panel, accent, 0.20)
    } else if is_hov {
        mix_color(theme.panel, theme.fg, 0.06)
    } else {
        clear
    }
    var b = if bg.a > 0 || is_foc {
        draw_cmd_round_rect(
            buf,
            node.layout,
            6.0,
            UiStyle {
                bg: bg,
                border: if is_foc { theme.focus_ring } else { clear },
                border_width: if is_foc { 1.5 } else { 0.0 },
            },
        )
    } else {
        buf
    }
    if node.checked {
        b = draw_cmd_round_rect(
            b,
            UiRect {
                x: node.layout.x + 2.0,
                y: node.layout.y + 7.0,
                w: 3.0,
                h: fmax(4.0, node.layout.h - 14.0),
            },
            1.5,
            UiStyle { bg: accent },
        )
    }
    val fg = if node.checked { theme.fg } else { theme.fg_muted }
    val ic_col = if node.checked { accent } else { theme.fg_muted }
    b = draw_icon(
        b,
        node.icon,
        UiRect {
            x: node.layout.x + 12.0,
            y: node.layout.y + (node.layout.h - 16.0) * 0.5,
            w: 16.0,
            h: 16.0,
        },
        ic_col,
    )
    val right_pad = if len(node.badge_text) > 0 { 44.0 } else { 12.0 }
    b = draw_cmd_text(
        b,
        UiRect {
            x: node.layout.x + 36.0,
            y: node.layout.y + 8.0,
            w: fmax(0.0, node.layout.w - 36.0 - right_pad),
            h: node.layout.h - 10.0,
        },
        node.text,
        UiStyle { fg: fg, font_size: 13.0, bold: node.checked, ellipsis: true },
    )
    if len(node.badge_text) > 0 {
        val br = UiRect {
            x: node.layout.x + node.layout.w - 38.0,
            y: node.layout.y + 8.0,
            w: 30.0,
            h: 20.0,
        }
        b = draw_cmd_round_rect(b, br, 10.0, UiStyle { bg: mix_color(theme.surface, accent, 0.25) })
        b = draw_cmd_text(
            b,
            br,
            node.badge_text,
            UiStyle { fg: accent, font_size: 10.5, bold: true, align: UiAlign.Center },
        )
    }
    return emit_node_a11y_with_state(b, state, node)
}

def paint_accordion(
    theme: UiTheme,
    node: UiNode,
    state: UiState,
    buf: DrawBuffer,
) -> DrawBuffer effect ffi, alloc {
    val is_hov = len(node.key) > 0 && state.hovered_key == node.key
    val br = if is_hov { tone_color(theme, node.tone) } else { theme.border }
    var b = draw_cmd_round_rect(
        buf,
        node.layout,
        node.style.radius,
        UiStyle { bg: theme.panel, border: br, border_width: 1.0 },
    )
    val chev = if node.open { UiIcon.ChevronDown } else { UiIcon.ChevronRight }
    b = draw_icon(
        b,
        chev,
        UiRect { x: node.layout.x + 12.0, y: node.layout.y + 11.0, w: 16.0, h: 16.0 },
        theme.fg_muted,
    )
    b = draw_cmd_text(
        b,
        UiRect {
            x: node.layout.x + 34.0,
            y: node.layout.y + 10.0,
            w: fmax(0.0, node.layout.w - 46.0),
            h: 20.0,
        },
        node.text,
        UiStyle { fg: theme.fg, font_size: 13.5, bold: true, ellipsis: true },
    )
    if node.open && node.layout.h > 42.0 {
        val dy = node.layout.y + 38.0
        b = draw_cmd_line(
            b,
            UiRect { x: node.layout.x + 8.0, y: dy, w: node.layout.x + node.layout.w - 8.0, h: dy },
            theme.border,
            1.0,
            false,
        )
    }
    return emit_node_a11y_with_state(b, state, node)
}

def paint_chip(
    theme: UiTheme,
    node: UiNode,
    state: UiState,
    buf: DrawBuffer,
) -> DrawBuffer effect ffi, alloc {
    val accent = tone_color(theme, node.tone)
    val is_hov = len(node.key) > 0 && state.hovered_key == node.key
    val bg = if node.checked {
        mix_color(theme.surface, accent, 0.26)
    } else if is_hov {
        mix_color(theme.panel, theme.fg, 0.08)
    } else {
        theme.panel
    }
    val br = if node.checked || is_hov { accent } else { theme.border }
    var b = draw_cmd_round_rect(
        buf,
        node.layout,
        node.layout.h * 0.5,
        UiStyle { bg: bg, border: br, border_width: 1.0 },
    )
    b = draw_cmd_text(
        b,
        UiRect {
            x: node.layout.x + 10.0,
            y: node.layout.y + 5.0,
            w: fmax(0.0, node.layout.w - 20.0),
            h: node.layout.h - 6.0,
        },
        node.text,
        UiStyle {
            fg: if node.checked { accent } else { theme.fg },
            font_size: 12.0,
            bold: node.checked,
            align: UiAlign.Center,
            ellipsis: true,
        },
    )
    return emit_node_a11y_with_state(b, state, node)
}

def paint_progress_bar(
    theme: UiTheme,
    node: UiNode,
    buf: DrawBuffer,
) -> DrawBuffer effect ffi, alloc {
    val accent = tone_color(theme, node.tone)
    val span = if node.max_val > node.min_val { node.max_val - node.min_val } else { 1.0 }
    val frac = clamp01((node.value - node.min_val) / span)
    var b = buf
    var track_y = node.layout.y + (node.layout.h - 8.0) * 0.5
    if len(node.text) > 0 {
        val pct = (frac * 100.0 + 0.5) to i64
        b = draw_cmd_text(
            b,
            UiRect { x: node.layout.x, y: node.layout.y, w: node.layout.w - 44.0, h: 16.0 },
            node.text,
            UiStyle { fg: theme.fg_muted, font_size: 11.5, ellipsis: true },
        )
        b = draw_cmd_text(
            b,
            UiRect { x: node.layout.x + node.layout.w - 42.0, y: node.layout.y, w: 42.0, h: 16.0 },
            f"{pct}%",
            UiStyle {
                fg: accent,
                font_size: 11.5,
                bold: true,
                monospace: true,
                align: UiAlign.End,
            },
        )
        track_y = node.layout.y + 18.0
    }
    val track_r = UiRect { x: node.layout.x, y: track_y, w: node.layout.w, h: 8.0 }
    b = draw_cmd_round_rect(b, track_r, 4.0, UiStyle { bg: theme.panel_alt })
    val fw = node.layout.w * frac
    if fw >= 2.0 {
        b = draw_cmd_round_rect(
            b,
            UiRect { x: node.layout.x, y: track_y, w: fw, h: 8.0 },
            4.0,
            UiStyle { bg: accent },
        )
    }
    return emit_node_a11y(b, node)
}

def paint_progress_ring(
    theme: UiTheme,
    node: UiNode,
    buf: DrawBuffer,
) -> DrawBuffer effect ffi, alloc {
    val accent = tone_color(theme, node.tone)
    val span = if node.max_val > node.min_val { node.max_val - node.min_val } else { 1.0 }
    val frac = clamp01((node.value - node.min_val) / span)
    val cx = node.layout.x + node.layout.w * 0.5
    val cy = node.layout.y + node.layout.h * 0.5
    val rad = fmax(8.0, fmin(node.layout.w, node.layout.h) * 0.36)
    val clear = UiColor { r: 0, g: 0, b: 0, a: 0 }
    var b = draw_cmd_circle(
        buf,
        cx,
        cy,
        rad,
        UiStyle { bg: clear, border: theme.panel_alt, border_width: 5.5 },
    )
    if frac > 0.005 {
        b = draw_cmd_arc(b, cx, cy, rad, -1.57079632679, frac * 6.28318530718, accent, 5.5, true)
    }
    val pct = (frac * 100.0 + 0.5) to i64
    val lbl = if len(node.text) > 0 { node.text } else { f"{pct}%" }
    b = draw_cmd_text(
        b,
        UiRect { x: node.layout.x + 4.0, y: cy - 8.0, w: fmax(0.0, node.layout.w - 8.0), h: 18.0 },
        lbl,
        UiStyle {
            fg: theme.fg,
            font_size: 12.0,
            bold: true,
            monospace: true,
            align: UiAlign.Center,
        },
    )
    return emit_node_a11y(b, node)
}

def paint_spinner_widget(
    theme: UiTheme,
    node: UiNode,
    state: UiState,
    buf: DrawBuffer,
) -> DrawBuffer effect ffi, alloc {
    val accent = tone_color(theme, node.tone)
    val cx = node.layout.x + node.layout.w * 0.5
    val cy = node.layout.y + node.layout.h * 0.5
    val rad = fmax(6.0, fmin(node.layout.w, node.layout.h) * 0.36)
    val clear = UiColor { r: 0, g: 0, b: 0, a: 0 }
    var b = draw_cmd_circle(
        buf,
        cx,
        cy,
        rad,
        UiStyle { bg: clear, border: with_alpha(accent, 48), border_width: 3.0 },
    )
    val start_ang = ui_state_clock(state).now * 4.8
    b = draw_cmd_arc(b, cx, cy, rad, start_ang, 4.1, accent, 3.0, true)
    return b
}

def paint_avatar(theme: UiTheme, node: UiNode, buf: DrawBuffer) -> DrawBuffer effect ffi, alloc {
    val accent = tone_color(theme, node.tone)
    val cx = node.layout.x + node.layout.w * 0.5
    val cy = node.layout.y + node.layout.h * 0.5
    val rad = fmax(10.0, fmin(node.layout.w, node.layout.h) * 0.45)
    var b = draw_cmd_circle(
        buf,
        cx,
        cy,
        rad,
        UiStyle { bg: mix_color(theme.panel_alt, accent, 0.32), border: accent, border_width: 1.5 },
    )
    if len(node.text) > 0 {
        b = draw_cmd_text(
            b,
            UiRect { x: node.layout.x, y: cy - 8.0, w: node.layout.w, h: 18.0 },
            node.text,
            UiStyle { fg: theme.fg, font_size: 13.0, bold: true, align: UiAlign.Center },
        )
    } else {
        b = draw_icon(b, UiIcon.User, UiRect { x: cx - 8.0, y: cy - 8.0, w: 16.0, h: 16.0 }, accent)
    }
    if node.checked {
        b = draw_cmd_circle(
            b,
            cx + rad * 0.72,
            cy + rad * 0.72,
            4.5,
            UiStyle { bg: theme.emerald, border: theme.bg, border_width: 1.5 },
        )
    }
    return b
}

def paint_stat_card(tree: UiTree, node: UiNode, buf: DrawBuffer) -> DrawBuffer effect ffi, alloc {
    val theme = tree.theme
    var title = node.subtext
    var value_txt = node.text
    var delta = node.badge_text
    var positive = node.checked
    var ic = node.icon
    var tone = node.tone
    if node.data_idx >= 0 && node.data_idx < list_len(tree.stats) {
        val st = list_get(tree.stats, node.data_idx)
        title = st.title
        value_txt = st.value
        delta = st.delta
        positive = st.positive
        ic = st.icon
        tone = st.tone
    }
    val accent = tone_color(theme, tone)
    var b = draw_cmd_round_rect(
        buf,
        node.layout,
        node.style.radius,
        UiStyle { bg: theme.panel, border: theme.border, border_width: 1.0 },
    )
    val badge_r = UiRect {
        x: node.layout.x + node.layout.w - 40.0,
        y: node.layout.y + 12.0,
        w: 28.0,
        h: 28.0,
    }
    b = draw_cmd_round_rect(b, badge_r, 8.0, UiStyle { bg: mix_color(theme.surface, accent, 0.22) })
    b = draw_icon(
        b,
        ic,
        UiRect { x: badge_r.x + 6.0, y: badge_r.y + 6.0, w: 16.0, h: 16.0 },
        accent,
    )
    b = draw_cmd_text(
        b,
        UiRect {
            x: node.layout.x + 14.0,
            y: node.layout.y + 12.0,
            w: fmax(0.0, node.layout.w - 60.0),
            h: 18.0,
        },
        title,
        UiStyle { fg: theme.fg_muted, font_size: 12.0, ellipsis: true },
    )
    b = draw_cmd_text(
        b,
        UiRect {
            x: node.layout.x + 14.0,
            y: node.layout.y + 34.0,
            w: fmax(0.0, node.layout.w - 28.0),
            h: 28.0,
        },
        value_txt,
        UiStyle { fg: theme.fg, font_size: 22.0, bold: true, monospace: true, ellipsis: true },
    )
    if len(delta) > 0 {
        val dcol = if positive { theme.emerald } else { theme.coral }
        b = draw_cmd_text(
            b,
            UiRect {
                x: node.layout.x + 14.0,
                y: node.layout.y + node.layout.h - 24.0,
                w: fmax(0.0, node.layout.w - 28.0),
                h: 16.0,
            },
            delta,
            UiStyle { fg: dcol, font_size: 11.5, bold: true, ellipsis: true },
        )
    }
    return emit_node_a11y(b, node)
}

def paint_bar_chart(tree: UiTree, node: UiNode, buf: DrawBuffer) -> DrawBuffer effect ffi, alloc {
    val theme = tree.theme
    var b = draw_cmd_round_rect(
        buf,
        node.layout,
        node.style.radius,
        UiStyle { bg: theme.surface, border: theme.border, border_width: 1.0 },
    )
    if node.data_idx < 0 || node.data_idx >= list_len(tree.bar_charts) {
        return b
    }
    val spec = list_get(tree.bar_charts, node.data_idx)
    val accent = tone_color(theme, spec.tone)
    var top_pad = 12.0
    if len(spec.title) > 0 {
        b = draw_cmd_text(
            b,
            UiRect {
                x: node.layout.x + 12.0,
                y: node.layout.y + 10.0,
                w: fmax(0.0, node.layout.w - 24.0),
                h: 18.0,
            },
            spec.title,
            UiStyle { fg: theme.fg, font_size: 12.5, bold: true },
        )
        top_pad = 34.0
    }
    val n = list_len(spec.values)
    if n == 0 {
        return b
    }
    var vmax = 1.0
    for i in 0..n {
        vmax = fmax(vmax, list_get(spec.values, i))
    }
    val plot_x = node.layout.x + 14.0
    val plot_y = node.layout.y + top_pad
    val plot_w = fmax(20.0, node.layout.w - 28.0)
    val plot_h = fmax(20.0, node.layout.h - top_pad - 28.0)
    val base_y = plot_y + plot_h
    b = draw_cmd_line(
        b,
        UiRect { x: plot_x, y: base_y, w: plot_x + plot_w, h: base_y },
        theme.border,
        1.0,
        false,
    )
    val slot_w = plot_w / to_f64(n)
    val bar_w = fmax(8.0, fmin(42.0, slot_w * 0.62))
    for i in 0..n {
        val v = fmax(0.0, list_get(spec.values, i))
        val bh = fmax(3.0, (v / vmax) * (plot_h - 6.0))
        val bx = plot_x + to_f64(i) * slot_w + (slot_w - bar_w) * 0.5
        val by = base_y - bh
        b = draw_cmd_round_rect_corners(
            b,
            UiRect { x: bx, y: by, w: bar_w, h: bh },
            UiRadii { tl: 4.0, tr: 4.0, br: 0.0, bl: 0.0 },
            UiStyle { bg: mix_color(accent, theme.cyan, to_f64(i % 2) * 0.25) },
        )
        if i < list_len(spec.labels) {
            b = draw_cmd_text(
                b,
                UiRect { x: plot_x + to_f64(i) * slot_w, y: base_y + 4.0, w: slot_w, h: 16.0 },
                list_get(spec.labels, i),
                UiStyle {
                    fg: theme.fg_muted,
                    font_size: 10.5,
                    align: UiAlign.Center,
                    ellipsis: true,
                },
            )
        }
    }
    return emit_node_a11y(b, node)
}

def paint_breadcrumb(tree: UiTree, node: UiNode, buf: DrawBuffer) -> DrawBuffer effect ffi, alloc {
    val theme = tree.theme
    if node.data_idx < 0 || node.data_idx >= list_len(tree.tabs_specs) {
        return buf
    }
    val spec = list_get(tree.tabs_specs, node.data_idx)
    val n = list_len(spec.labels)
    var b = buf
    var cx = node.layout.x + 2.0
    for i in 0..n {
        val lbl = list_get(spec.labels, i)
        val lw = fmin(140.0, to_f64(len(lbl)) * 7.8 + 10.0)
        val is_last = i == n - 1
        b = draw_cmd_text(
            b,
            UiRect { x: cx, y: node.layout.y + 5.0, w: lw, h: 18.0 },
            lbl,
            UiStyle {
                fg: if is_last { theme.fg } else { theme.fg_muted },
                font_size: 13.0,
                bold: is_last,
                ellipsis: true,
            },
        )
        cx = cx + lw
        if !is_last && cx + 16.0 < node.layout.x + node.layout.w {
            b = draw_icon(
                b,
                UiIcon.ChevronRight,
                UiRect { x: cx, y: node.layout.y + 7.0, w: 12.0, h: 12.0 },
                theme.fg_muted,
            )
            cx = cx + 14.0
        }
    }
    return b
}

def paint_image_widget(
    tree: UiTree,
    node: UiNode,
    buf: DrawBuffer,
) -> DrawBuffer effect ffi, alloc {
    val theme = tree.theme
    var b = draw_cmd_round_rect(
        buf,
        node.layout,
        node.style.radius,
        UiStyle { bg: theme.panel, border: theme.border, border_width: 1.0 },
    )
    if node.data_idx >= 0 && node.data_idx < list_len(tree.images) {
        val spec = list_get(tree.images, node.data_idx)
        if spec.width > 0 && spec.height > 0 && list_len(spec.pixels) > 0 {
            val inner = UiRect {
                x: node.layout.x + 1.0,
                y: node.layout.y + 1.0,
                w: fmax(0.0, node.layout.w - 2.0),
                h: fmax(0.0, node.layout.h - 2.0),
            }
            b = draw_cmd_image_rgba(b, inner, spec.width, spec.height, spec.pixels)
        }
    }
    return b
}

def paint_menu_trigger(
    theme: UiTheme,
    node: UiNode,
    state: UiState,
    buf: DrawBuffer,
) -> DrawBuffer effect ffi, alloc {
    val is_open = state.extras.open_popup_key == node.key && len(node.key) > 0
    val is_hov = len(node.key) > 0 && state.hovered_key == node.key
    val accent = tone_color(theme, node.tone)
    var b = draw_cmd_round_rect(
        buf,
        node.layout,
        node.style.radius,
        UiStyle {
            bg: if is_open || is_hov {
                mix_color(theme.panel_alt, accent, 0.16)
            } else {
                theme.panel
            },
            border: if is_open { theme.focus_ring } else { theme.border },
            border_width: 1.0,
        },
    )
    b = draw_cmd_text(
        b,
        UiRect {
            x: node.layout.x + 10.0,
            y: node.layout.y + 8.0,
            w: fmax(0.0, node.layout.w - 34.0),
            h: 18.0,
        },
        node.text,
        UiStyle { fg: theme.fg, font_size: 13.0, bold: true, ellipsis: true },
    )
    b = draw_icon(
        b,
        UiIcon.ChevronDown,
        UiRect {
            x: node.layout.x + node.layout.w - 22.0,
            y: node.layout.y + (node.layout.h - 14.0) * 0.5,
            w: 14.0,
            h: 14.0,
        },
        theme.fg_muted,
    )
    return emit_node_a11y_with_state(b, state, node)
}

def paint_node(
    tree: UiTree,
    node: UiNode,
    state: UiState,
    buf: DrawBuffer,
) -> DrawBuffer effect ffi, alloc {
    val theme = tree.theme
    return when node.kind {
        WidgetKind.Col => paint_card_or_box(theme, node, buf),
        WidgetKind.Row => paint_card_or_box(theme, node, buf),
        WidgetKind.Stack => paint_card_or_box(theme, node, buf),
        WidgetKind.Card => paint_card_or_box(theme, node, buf),
        WidgetKind.Wrap => paint_card_or_box(theme, node, buf),
        WidgetKind.Grid => paint_card_or_box(theme, node, buf),
        WidgetKind.SplitPane => paint_split_pane(tree, node, state, buf),
        WidgetKind.Spacer => buf,
        WidgetKind.Label => emit_node_a11y(
            draw_cmd_text(buf, node.layout, node.text, node.style),
            node,
        ),
        WidgetKind.Badge => paint_badge(theme, node, buf),
        WidgetKind.Button => paint_button(theme, node, state, buf),
        WidgetKind.TextInput => paint_text_input(theme, node, state, buf),
        WidgetKind.TextArea => paint_text_input(theme, node, state, buf),
        WidgetKind.Checkbox => paint_checkbox(theme, node, state, buf),
        WidgetKind.Toggle => paint_toggle(theme, node, state, buf),
        WidgetKind.Slider => paint_slider(theme, node, state, buf),
        WidgetKind.Sparkline => paint_chart(tree, node, true, buf),
        WidgetKind.LineChart => paint_chart(tree, node, false, buf),
        WidgetKind.RadarScope => paint_radar_scope(tree, node, state, buf),
        WidgetKind.TensorView => paint_tensor_view(tree, node, buf),
        WidgetKind.TableHeader => paint_table_band(theme, node, state, true, buf),
        WidgetKind.TableRow => paint_table_band(theme, node, state, false, buf),
        WidgetKind.Divider => paint_divider(theme, node, buf),
        WidgetKind.Icon => paint_icon_widget(theme, node, buf),
        WidgetKind.IconButton => paint_icon_button(theme, node, state, buf),
        WidgetKind.Radio => paint_radio(theme, node, state, buf),
        WidgetKind.Select => paint_select(tree, node, state, buf),
        WidgetKind.Tabs => paint_tabs_or_segmented(tree, node, state, false, buf),
        WidgetKind.Segmented => paint_tabs_or_segmented(tree, node, state, true, buf),
        WidgetKind.Stepper => paint_stepper(theme, node, state, buf),
        WidgetKind.NavItem => paint_nav_item(theme, node, state, buf),
        WidgetKind.Accordion => paint_accordion(theme, node, state, buf),
        WidgetKind.Chip => paint_chip(theme, node, state, buf),
        WidgetKind.ProgressBar => paint_progress_bar(theme, node, buf),
        WidgetKind.ProgressRing => paint_progress_ring(theme, node, buf),
        WidgetKind.Spinner => paint_spinner_widget(theme, node, state, buf),
        WidgetKind.Avatar => paint_avatar(theme, node, buf),
        WidgetKind.StatCard => paint_stat_card(tree, node, buf),
        WidgetKind.BarChart => paint_bar_chart(tree, node, buf),
        WidgetKind.Breadcrumb => paint_breadcrumb(tree, node, buf),
        WidgetKind.Image => paint_image_widget(tree, node, buf),
        WidgetKind.Modal => buf,
        WidgetKind.Drawer => buf,
        WidgetKind.Menu => paint_menu_trigger(theme, node, state, buf),
    }
}

def paint_scrollbar_thumb(
    tree: UiTree,
    node: UiNode,
    buf: DrawBuffer,
) -> DrawBuffer effect ffi, alloc {
    val cc = list_len(node.children)
    if !node.style.scrollable || cc == 0 || node.layout.h < 24.0 {
        return buf
    }
    var content_h = 0.0
    for j in 0..cc {
        val c = list_get(tree.nodes, list_get(node.children, j))
        content_h = content_h + c.measured.h
    }
    if cc > 1 {
        content_h = content_h + node.style.gap * to_f64(cc - 1)
    }
    val ih = fmax(1.0, node.layout.h - style_pad_y(node.style) * 2.0)
    if content_h <= ih {
        return buf
    }
    val scroll_y = fmax(0.0, fmin(tree_scroll_for(tree, node.key), content_h - ih))
    val thumb_h = fmax(20.0, (ih / content_h) * (node.layout.h - 12.0))
    val track_travel = fmax(1.0, (node.layout.h - 12.0) - thumb_h)
    val thumb_y = node.layout.y + 6.0 + (scroll_y / fmax(1.0, content_h - ih)) * track_travel
    val thumb_r = UiRect { x: node.layout.x + node.layout.w - 6.0, y: thumb_y, w: 4.0, h: thumb_h }
    return draw_cmd_round_rect(
        buf,
        thumb_r,
        2.0,
        UiStyle { bg: with_alpha(tree.theme.fg_muted, 130) },
    )
}

def paint_subtree_dfs(
    tree: UiTree,
    start_id: i64,
    state: UiState,
    buf: DrawBuffer,
    overlays: list<i64>,
    skip_root_overlay_check: bool,
) -> DrawBuffer effect ffi, alloc {
    var b = buf
    val stack: list<i64> = list()
    list_push(stack, start_id)
    while list_len(stack) > 0 {
        val cur = list_pop(stack)
        if cur == -2000000 {
            b = draw_cmd_pop_opacity(b)
            continue
        }
        if cur < 0 {
            val orig_id = (-cur) - 1
            if orig_id >= 0 && orig_id < list_len(tree.nodes) {
                b = paint_scrollbar_thumb(tree, list_get(tree.nodes, orig_id), b)
            }
            b = draw_cmd_pop_clip(b)
            continue
        }
        val node = list_get(tree.nodes, cur)
        if is_overlay_container(node.kind) && (!skip_root_overlay_check || cur != start_id) {
            if node.open {
                list_push(overlays, cur)
            }
            continue
        }
        b = paint_elevation_shadow(tree.theme, node, b)
        if node.style.opacity < 0.999 {
            b = draw_cmd_push_opacity(b, clamp01(node.style.opacity))
            list_push(stack, -2000000)
        }
        val clipped = node.layout.w > 1.0 && node.layout.h > 1.0
        if clipped {
            if node.style.overflow_clip && node.style.radius > 0.0 {
                val r = node.style.radius
                b = draw_cmd_push_round_clip(b, node.layout, UiRadii { tl: r, tr: r, br: r, bl: r })
            } else {
                b = draw_cmd_push_clip(b, node.layout)
            }
            list_push(stack, -(cur + 1))
        }
        b = paint_node(tree, node, state, b)
        val allow_children = if node.kind == WidgetKind.Accordion { node.open } else { true }
        if allow_children {
            val cc = list_len(node.children)
            var k = cc - 1
            while k >= 0 {
                list_push(stack, list_get(node.children, k))
                k = k - 1
            }
        }
    }
    return b
}

def paint_overlay_containers(
    tree: UiTree,
    overlays: list<i64>,
    state: UiState,
    buf: DrawBuffer,
) -> DrawBuffer effect ffi, alloc {
    var b = buf
    val theme = tree.theme
    for i in 0..list_len(overlays) {
        val ov_id = list_get(overlays, i)
        val node = list_get(tree.nodes, ov_id)
        if node.open {
            val vp = UiRect { x: 0.0, y: 0.0, w: tree.width, h: tree.height }
            b = draw_cmd_round_rect(b, vp, 0.0, UiStyle { bg: rgba(4, 8, 16, 150) })
            val is_modal = node.kind == WidgetKind.Modal
            val card = if is_modal {
                modal_card_rect(tree.width, tree.height, node)
            } else {
                drawer_panel_rect(tree.width, tree.height, node)
            }
            val rad = if is_modal { theme.radius_lg } else { 0.0 }
            val r4 = UiRadii { tl: rad, tr: rad, br: rad, bl: rad }
            if theme.shadow.a > 0 {
                b = draw_cmd_box_shadow(b, card, r4, 0.0, 14.0, 28.0, 2.0, theme.shadow)
            }
            b = draw_cmd_round_rect(
                b,
                card,
                rad,
                UiStyle { bg: theme.surface, border: theme.border, border_width: 1.0 },
            )
            if len(node.text) > 0 {
                b = draw_cmd_text(
                    b,
                    UiRect { x: card.x + 20.0, y: card.y + 14.0, w: card.w - 40.0, h: 24.0 },
                    node.text,
                    UiStyle { fg: theme.fg, font_size: 16.0, bold: true },
                )
            }
            b = draw_cmd_push_clip(b, card)
            val nested: list<i64> = list()
            val cc = list_len(node.children)
            for j in 0..cc {
                b = paint_subtree_dfs(tree, list_get(node.children, j), state, b, nested, false)
            }
            b = draw_cmd_pop_clip(b)
        }
    }
    return b
}

def paint_popup_overlay(
    tree: UiTree,
    state: UiState,
    buf: DrawBuffer,
) -> DrawBuffer effect ffi, alloc {
    if len(state.extras.open_popup_key) == 0 {
        return buf
    }
    val found = ui_find_node_key(tree, state.extras.open_popup_key)
    val pop_node = when found {
        some(idx) => list_get(tree.nodes, idx),
        none => {
            return buf
        },
    }
    val anchor = if state.extras.popup_anchor.w > 1.0 {
        state.extras.popup_anchor
    } else {
        pop_node.layout
    }
    val pr = popup_panel_rect(tree, pop_node, anchor)
    val theme = tree.theme
    val r4 = UiRadii { tl: 8.0, tr: 8.0, br: 8.0, bl: 8.0 }
    var b = buf
    if theme.shadow.a > 0 {
        b = draw_cmd_box_shadow(b, pr, r4, 0.0, 8.0, 18.0, 1.0, theme.shadow)
    }
    b = draw_cmd_round_rect(
        b,
        pr,
        8.0,
        UiStyle { bg: theme.panel, border: theme.border, border_width: 1.0 },
    )
    b = draw_cmd_push_clip(b, pr)
    if pop_node.kind == WidgetKind.Select
        && pop_node.data_idx >= 0
        && pop_node.data_idx < list_len(tree.selects) {
        val spec = list_get(tree.selects, pop_node.data_idx)
        for i in 0..list_len(spec.options) {
            val row_r = UiRect {
                x: pr.x + 4.0,
                y: pr.y + 4.0 + to_f64(i) * 32.0,
                w: pr.w - 8.0,
                h: 30.0,
            }
            val sel = i == pop_node.selected_idx
            val hov = rect_contains(row_r, state.pointer_x, state.pointer_y)
            if sel || hov {
                val bg = if sel {
                    mix_color(theme.panel_alt, theme.primary, 0.28)
                } else {
                    theme.panel_alt
                }
                b = draw_cmd_round_rect(b, row_r, 5.0, UiStyle { bg: bg })
            }
            b = draw_cmd_text(
                b,
                UiRect { x: row_r.x + 10.0, y: row_r.y + 6.0, w: row_r.w - 20.0, h: 18.0 },
                list_get(spec.options, i),
                UiStyle {
                    fg: if sel { theme.primary } else { theme.fg },
                    font_size: 13.0,
                    bold: sel,
                    ellipsis: true,
                },
            )
        }
    } else if pop_node.kind == WidgetKind.Menu
        && pop_node.data_idx >= 0
        && pop_node.data_idx < list_len(tree.menus) {
        val spec = list_get(tree.menus, pop_node.data_idx)
        for i in 0..list_len(spec.items) {
            val row_r = UiRect {
                x: pr.x + 4.0,
                y: pr.y + 4.0 + to_f64(i) * 32.0,
                w: pr.w - 8.0,
                h: 30.0,
            }
            if rect_contains(row_r, state.pointer_x, state.pointer_y) {
                b = draw_cmd_round_rect(
                    b,
                    row_r,
                    5.0,
                    UiStyle { bg: mix_color(theme.panel_alt, theme.azure, 0.25) },
                )
            }
            b = draw_cmd_text(
                b,
                UiRect { x: row_r.x + 10.0, y: row_r.y + 6.0, w: row_r.w - 20.0, h: 18.0 },
                list_get(spec.items, i),
                UiStyle { fg: theme.fg, font_size: 13.0, ellipsis: true },
            )
        }
    }
    return draw_cmd_pop_clip(b)
}

def paint_tooltip_and_toasts(
    tree: UiTree,
    state: UiState,
    buf: DrawBuffer,
) -> DrawBuffer effect ffi, alloc {
    var b = buf
    val theme = tree.theme
    if len(state.extras.tooltip_text) > 0 && !state.pointer_down {
        val tw = fmin(280.0, fmax(64.0, to_f64(len(state.extras.tooltip_text)) * 7.4 + 18.0))
        val tx = fmax(8.0, fmin(state.extras.tooltip_x + 12.0, tree.width - tw - 8.0))
        val ty = fmax(8.0, fmin(state.extras.tooltip_y + 18.0, tree.height - 34.0))
        val tr = UiRect { x: tx, y: ty, w: tw, h: 26.0 }
        if theme.shadow.a > 0 {
            b = draw_cmd_box_shadow(
                b,
                tr,
                UiRadii { tl: 6.0, tr: 6.0, br: 6.0, bl: 6.0 },
                0.0,
                4.0,
                10.0,
                0.0,
                theme.shadow,
            )
        }
        b = draw_cmd_round_rect(
            b,
            tr,
            6.0,
            UiStyle { bg: theme.panel_alt, border: theme.border, border_width: 1.0 },
        )
        b = draw_cmd_text(
            b,
            UiRect { x: tr.x + 9.0, y: tr.y + 5.0, w: tr.w - 18.0, h: 16.0 },
            state.extras.tooltip_text,
            UiStyle { fg: theme.fg, font_size: 11.5, ellipsis: true },
        )
    }
    val toasts = state.extras.toasts
    for i in 0..list_len(toasts) {
        val t = list_get(toasts, i)
        val col = tone_color(theme, t.tone)
        val tw = fmin(320.0, fmax(180.0, tree.width - 32.0))
        val th = if len(t.message) > 0 { 52.0 } else { 36.0 }
        val tx = fmax(12.0, tree.width - tw - 16.0)
        val ty = 16.0 + to_f64(i) * 60.0
        val tr = UiRect { x: tx, y: ty, w: tw, h: th }
        if theme.shadow.a > 0 {
            b = draw_cmd_box_shadow(
                b,
                tr,
                UiRadii { tl: 8.0, tr: 8.0, br: 8.0, bl: 8.0 },
                0.0,
                6.0,
                16.0,
                0.0,
                theme.shadow,
            )
        }
        b = draw_cmd_round_rect(
            b,
            tr,
            8.0,
            UiStyle { bg: theme.panel, border: col, border_width: 1.0 },
        )
        b = draw_cmd_round_rect(
            b,
            UiRect { x: tr.x + 1.0, y: tr.y + 6.0, w: 3.0, h: th - 12.0 },
            1.5,
            UiStyle { bg: col },
        )
        b = draw_cmd_text(
            b,
            UiRect { x: tr.x + 12.0, y: tr.y + 7.0, w: tw - 22.0, h: 18.0 },
            t.title,
            UiStyle { fg: theme.fg, font_size: 12.5, bold: true, ellipsis: true },
        )
        if len(t.message) > 0 {
            b = draw_cmd_text(
                b,
                UiRect { x: tr.x + 12.0, y: tr.y + 26.0, w: tw - 22.0, h: 18.0 },
                t.message,
                UiStyle { fg: theme.fg_muted, font_size: 11.5, ellipsis: true },
            )
        }
    }
    return b
}

/// Encode the entire laid-out `tree` into `buf` using iterative traversal, shadows, opacity layers, scrollbars, and overlays.
pub def ui_paint(tree: UiTree, state: UiState, buf: DrawBuffer) -> DrawBuffer effect ffi, alloc {
    var b = draw_buf_begin(buf, tree.theme.bg)
    val overlays: list<i64> = list()
    if tree.root >= 0 && tree.root < list_len(tree.nodes) {
        b = paint_subtree_dfs(tree, tree.root, state, b, overlays, false)
    }
    b = paint_overlay_containers(tree, overlays, state, b)
    b = paint_popup_overlay(tree, state, b)
    b = paint_tooltip_and_toasts(tree, state, b)
    return draw_buf_finish(b)
}
