// src/stdlib/collections.iris -- Extended collection algorithms and data structures

// Remove the first occurrence of `val` from `lst` by value.
// Returns 1 if removed, 0 if not found.
pub def list_remove_val(lst: list<i64>, elem: i64) -> i64 effect alloc {
    val idx = list_index_of(lst, elem);
    if idx == -1 {
        0
    } else {
        list_remove(lst, idx);
        1
    }
}

// Create a list of `n` copies of `val`.
pub def list_fill(n: i64, elem: i64) -> list<i64> effect alloc {
    val result: list<i64> = list();
    var i = 0;
    while i < n {
        push(result, elem);
        i = i + 1;
    }
    result
}

pub def list_repeat(elem: i64, count: i64) -> list<i64> effect alloc {
    list_fill(count, elem)
}

// Reverses the elements of a list, returning a new list.
pub def list_reverse(lst: list<i64>) -> list<i64> effect alloc {
    val result: list<i64> = list();
    val n = list_len(lst);
    var i = n - 1;
    while i >= 0 {
        push(result, list_get(lst, i));
        i = i - 1;
    }
    result
}

// Returns a deduplicated copy of the list preserving original order.
pub def list_unique(lst: list<i64>) -> list<i64> effect alloc {
    val result: list<i64> = list();
    val n = list_len(lst);
    for i in 0 .. n {
        val elem = list_get(lst, i);
        if !list_contains(result, elem) {
            push(result, elem);
        };
    };
    result
}

// Counts occurrences of `elem` in `lst`.
pub def list_count(lst: list<i64>, elem: i64) -> i64 effect alloc {
    var c = 0;
    val n = list_len(lst);
    for i in 0 .. n {
        if list_get(lst, i) == elem {
            c = c + 1;
        };
    };
    c
}

// Checks if two lists have equal contents and lengths.
pub def list_all_equal(a: list<i64>, b: list<i64>) -> bool effect alloc {
    val len_a = list_len(a);
    val len_b = list_len(b);
    if len_a != len_b { return false };
    for i in 0 .. len_a {
        if list_get(a, i) != list_get(b, i) {
            return false;
        };
    };
    true
}

// Computes the integer sum of elements in a list.
pub def list_sum(lst: list<i64>) -> i64 effect alloc {
    var total = 0;
    val n = list_len(lst);
    for i in 0 .. n {
        total = total + list_get(lst, i);
    };
    total
}

// Returns minimum element in list, or none if empty.
pub def list_min(lst: list<i64>) -> option<i64> effect alloc {
    val n = list_len(lst);
    if n == 0 { return none };
    var m = list_get(lst, 0);
    for i in 1 .. n {
        val v = list_get(lst, i);
        if v < m { m = v };
    };
    some(m)
}

// Returns maximum element in list, or none if empty.
pub def list_max(lst: list<i64>) -> option<i64> effect alloc {
    val n = list_len(lst);
    if n == 0 { return none };
    var m = list_get(lst, 0);
    for i in 1 .. n {
        val v = list_get(lst, i);
        if v > m { m = v };
    };
    some(m)
}

// Returns the first `count` elements of the list.
pub def list_take(lst: list<i64>, count: i64) -> list<i64> effect alloc {
    val result: list<i64> = list();
    val n = list_len(lst);
    val limit = if count < n { count } else { n };
    if limit <= 0 { return result };
    for i in 0 .. limit {
        push(result, list_get(lst, i));
    };
    result
}

// Returns the list without the first `count` elements.
pub def list_drop(lst: list<i64>, count: i64) -> list<i64> effect alloc {
    val result: list<i64> = list();
    val n = list_len(lst);
    if count >= n { return result };
    val start = if count < 0 { 0 } else { count };
    for i in start .. n {
        push(result, list_get(lst, i));
    };
    result
}

// Swaps two elements in place.
pub def list_swap(lst: list<i64>, i: i64, j: i64) -> unit effect alloc {
    val tmp = list_get(lst, i);
    list_set(lst, i, list_get(lst, j));
    list_set(lst, j, tmp);
}

// Flattens a list of lists into a single 1D list.
pub def list_flatten(nested: list<list<i64>>) -> list<i64> effect alloc {
    val result: list<i64> = list();
    val outer_len = list_len(nested);
    for i in 0 .. outer_len {
        val inner = list_get(nested, i);
        val inner_len = list_len(inner);
        for j in 0 .. inner_len {
            push(result, list_get(inner, j));
        };
    };
    result
}

// --- Map Operations ---

// Get a value from a map, returning `default` if the key is missing.
pub def map_get_or(m: map<str, i64>, k: str, default: i64) -> i64 effect alloc, throw {
    val opt = map_get(m, k);
    opt.unwrap_or(default)
}

// Checks if map contains key.
pub def map_has_key(m: map<str, i64>, k: str) -> bool effect alloc {
    map_contains(m, k)
}

// Merge two maps into a new map. If both have the same key, the value from `b` wins.
pub def map_merge(a: map<str, i64>, b: map<str, i64>) -> map<str, i64> effect alloc, throw {
    val result = map();
    for k in map_keys(a) {
        map_set(result, k, map_get(a, k).unwrap_or(0));
    }
    for k in map_keys(b) {
        map_set(result, k, map_get(b, k).unwrap_or(0));
    }
    result
}

// Extracts all values into a list.
pub def map_values_list(m: map<str, i64>) -> list<i64> effect alloc, throw {
    val result: list<i64> = list();
    for k in map_keys(m) {
        push(result, map_get(m, k).unwrap_or(0));
    };
    result
}

// Clones a map.
pub def map_clone(m: map<str, i64>) -> map<str, i64> effect alloc, throw {
    val result = map();
    for k in map_keys(m) {
        map_set(result, k, map_get(m, k).unwrap_or(0));
    };
    result
}
