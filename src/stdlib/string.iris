// src/stdlib/string.iris -- IRIS standard string library

// Text whitespace is ASCII space, tab, LF, VT, FF, or CR.
def string_is_space(b: i64) -> bool {
    b == 32 || (b >= 9 && b <= 13)
}

// Trim only leading ASCII whitespace, preserving UTF-8 content.
pub def trim_start(s: str) -> str effect alloc {
    var i = 0
    val n = len(s)
    while i < n {
        if !string_is_space(str_index(s, i)) { return slice(s, i, n) }
        i = i + 1
    }
    ""
}

// Trim only trailing ASCII whitespace.
pub def trim_end(s: str) -> str effect alloc {
    var end = len(s)
    while end > 0 {
        if !string_is_space(str_index(s, end - 1)) { return slice(s, 0, end) }
        end = end - 1
    }
    ""
}

// Pad to at least width UTF-8 bytes using whole copies of pad_char.
// Empty padding leaves the input unchanged; content is never truncated.
pub def pad_left(s: str, width: i64, pad_char: str) -> str effect alloc {
    val step = len(pad_char)
    if step == 0 || width <= len(s) { return s }
    val missing = width - len(s)
    val copies = missing / step + if missing % step == 0 { 0 } else { 1 }
    concat(repeat(pad_char, copies), s)
}

pub def pad_right(s: str, width: i64, pad_char: str) -> str effect alloc {
    val step = len(pad_char)
    if step == 0 || width <= len(s) { return s }
    val missing = width - len(s)
    val copies = missing / step + if missing % step == 0 { 0 } else { 1 }
    concat(s, repeat(pad_char, copies))
}

// Split on runs of ASCII whitespace, omitting empty words.
pub def words(s: str) -> list<str> effect alloc {
    val out: list<str> = list()
    val n = len(s)
    var start = 0
    var i = 0
    while i < n {
        if string_is_space(str_index(s, i)) {
            if start < i { list_push(out, slice(s, start, i)); }
            start = i + 1
        }
        i = i + 1
    }
    if start < n { list_push(out, slice(s, start, n)); }
    out
}

// Split LF and CRLF lines. Preserve interior empty lines, omit a final
// empty segment after a terminator, and keep lone CR characters as content.
pub def lines(s: str) -> list<str> effect alloc {
    val out: list<str> = list()
    val n = len(s)
    var start = 0
    var i = 0
    while i < n {
        if str_index(s, i) == 10 {
            var end = i
            if end > start {
                if str_index(s, end - 1) == 13 { end = end - 1 }
            }
            list_push(out, slice(s, start, end));
            start = i + 1
        }
        i = i + 1
    }
    if start < n { list_push(out, slice(s, start, n)); }
    out
}

// Join a list of strings into one, separated by a delimiter.
pub def str_join(parts: list<str>, delim: str) -> str effect alloc {
    join(parts, delim)
}

// Check if a string is empty.
pub def is_empty(s: str) -> bool {
    len(s) == 0
}

// Repeat a string n times.
pub def str_repeat(s: str, n: i64) -> str effect alloc {
    repeat(s, n)
}

// Count non-overlapping occurrences of substring in a string.
pub def count(s: str, sub: str) -> i64 {
    str_count(s, sub)
}

// Remove one matching prefix/suffix. Empty patterns always match.
pub def strip_prefix(s: str, prefix: str) -> option<str> effect alloc {
    if starts_with(s, prefix) { some(slice(s, len(prefix), len(s))) } else { none }
}

pub def strip_suffix(s: str, suffix: str) -> option<str> effect alloc {
    if ends_with(s, suffix) { some(slice(s, 0, len(s) - len(suffix))) } else { none }
}

// Split at the first delimiter, excluding it. An empty delimiter splits at 0.
pub def split_once(s: str, delim: str) -> option<(str, str)> effect alloc, throw {
    val pos = find(s, delim)
    if is_some(pos) {
        val i = unwrap(pos)
        some((slice(s, 0, i), slice(s, i + len(delim), len(s))))
    } else { none }
}

// At most max_parts segments, retaining the unsplit remainder in the last.
// Nonpositive limits return an empty list. Empty delimiters leave s unsplit.
pub def split_n(s: str, delim: str, max_parts: i64) -> list<str> effect alloc, throw {
    val out: list<str> = list()
    if max_parts <= 0 { return out }
    if len(delim) == 0 {
        list_push(out, s);
        return out
    }
    var start = 0
    var parts = 1
    val n = len(s)
    while parts < max_parts {
        val pos = find(slice(s, start, n), delim)
        if !is_some(pos) {
            list_push(out, slice(s, start, n));
            return out
        }
        val end = start + unwrap(pos)
        list_push(out, slice(s, start, end));
        start = end + len(delim)
        parts = parts + 1
    }
    list_push(out, slice(s, start, n));
    out
}

// Replace up to limit non-overlapping matches, scanning the original string.
// An empty pattern or nonpositive limit leaves s unchanged.
pub def replace_n(s: str, pattern: str, replacement: str, limit: i64) -> str effect alloc, throw {
    if len(pattern) == 0 || limit <= 0 { return s }
    val parts: list<str> = list()
    var start = 0
    var replaced = 0
    val n = len(s)
    while replaced < limit {
        val pos = find(slice(s, start, n), pattern)
        if !is_some(pos) {
            list_push(parts, slice(s, start, n));
            return join(parts, "")
        }
        val end = start + unwrap(pos)
        list_push(parts, slice(s, start, end));
        list_push(parts, replacement);
        start = end + len(pattern)
        replaced = replaced + 1
    }
    list_push(parts, slice(s, start, n));
    join(parts, "")
}

// Collapse ASCII whitespace runs to one space and remove outer whitespace.
pub def normalize_whitespace(s: str) -> str effect alloc {
    join(words(s), " ")
}

pub def is_blank(s: str) -> bool effect alloc {
    len(trim_start(s)) == 0
}

// Capitalizes the first character of a string.
pub def capitalize(s: str) -> str effect alloc {
    val n = len(s);
    if n == 0 { return s };
    val first = to_upper(slice(s, 0, 1));
    if n == 1 { first } else { concat(first, slice(s, 1, n)) }
}

// Truncates string to max_chars with a custom suffix/ellipsis.
pub def truncate_with(s: str, max_chars: i64, ellipsis: str) -> str effect alloc {
    val n = len(s);
    if n <= max_chars { return s };
    val el_len = len(ellipsis);
    val keep_len = if max_chars > el_len { max_chars - el_len } else { 0 };
    concat(slice(s, 0, keep_len), ellipsis)
}

// Truncates string to max_chars, appending "..." if truncated.
pub def truncate(s: str, max_chars: i64) -> str effect alloc {
    truncate_with(s, max_chars, "...")
}

// Reverses a string.
pub def reverse_str(s: str) -> str effect alloc {
    val n = len(s);
    if n <= 1 { return s };
    val parts: list<str> = list();
    var i = n - 1;
    while i >= 0 {
        push(parts, slice(s, i, i + 1));
        i = i - 1;
    };
    join(parts, "")
}

// Returns true if byte is an ASCII decimal digit (0-9).
pub def is_ascii_digit(b: i64) -> bool {
    b >= 48 && b <= 57
}

// Returns true if byte is an ASCII uppercase letter (A-Z).
pub def is_ascii_uppercase(b: i64) -> bool {
    b >= 65 && b <= 90
}

// Returns true if byte is an ASCII lowercase letter (a-z).
pub def is_ascii_lowercase(b: i64) -> bool {
    b >= 97 && b <= 122
}

// Returns true if byte is an ASCII alphabetic character.
pub def is_ascii_alphabetic(b: i64) -> bool {
    is_ascii_uppercase(b) || is_ascii_lowercase(b)
}

// Returns true if byte is alphanumeric.
pub def is_ascii_alphanumeric(b: i64) -> bool {
    is_ascii_alphabetic(b) || is_ascii_digit(b)
}

// Computes the Levenshtein edit distance between two strings using dynamic programming.
pub def levenshtein_distance(s1: str, s2: str) -> i64 effect alloc {
    val m = len(s1);
    val n = len(s2);
    if m == 0 { return n };
    if n == 0 { return m };

    var prev: list<i64> = list();
    for j in 0 .. (n + 1) {
        push(prev, j);
    };

    for i in 1 .. (m + 1) {
        var curr: list<i64> = list();
        push(curr, i);
        val c1 = str_index(s1, i - 1);
        for j in 1 .. (n + 1) {
            val c2 = str_index(s2, j - 1);
            val cost = if c1 == c2 { 0 } else { 1 };
            val del_cost = list_get(prev, j) + 1;
            val ins_cost = list_get(curr, j - 1) + 1;
            val sub_cost = list_get(prev, j - 1) + cost;

            var min_v = del_cost;
            if ins_cost < min_v { min_v = ins_cost };
            if sub_cost < min_v { min_v = sub_cost };
            push(curr, min_v);
        };
        prev = curr;
    };

    list_get(prev, n)
}

// Computes Hamming distance between two equal-length strings (returns -1 if lengths differ).
pub def hamming_distance(s1: str, s2: str) -> i64 {
    val n1 = len(s1);
    val n2 = len(s2);
    if n1 != n2 { return 0 - 1 };
    var dist = 0;
    for i in 0 .. n1 {
        if str_index(s1, i) != str_index(s2, i) {
            dist = dist + 1;
        };
    };
    dist
}

