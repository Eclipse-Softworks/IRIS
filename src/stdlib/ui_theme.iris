/// Create a WCAG-AAA high-contrast accessibility theme.
pub def high_contrast_theme() -> UiTheme {
    return UiTheme {
        bg: rgb(0, 0, 0),
        surface: rgb(12, 12, 16),
        panel: rgb(22, 22, 28),
        panel_alt: rgb(38, 38, 48),
        fg: rgb(255, 255, 255),
        fg_muted: rgb(212, 220, 235),
        border: rgb(255, 255, 255),
        primary: rgb(255, 214, 0),
        azure: rgb(92, 196, 255),
        teal: rgb(64, 240, 192),
        cyan: rgb(120, 235, 255),
        amber: rgb(255, 214, 0),
        coral: rgb(255, 110, 110),
        emerald: rgb(90, 245, 130),
        is_dark: true,
        shadow: UiColor { r: 0, g: 0, b: 0, a: 0 },
        focus_ring: UiColor { r: 255, g: 214, b: 0, a: 255 },
    }
}

/// Lighten `c` toward white by `amount` (`0.0..1.0`), preserving alpha.
pub def lighten(c: UiColor, amount: f64) -> UiColor {
    val mixed = mix_color(c, rgb(255, 255, 255), clamp_unit(amount))
    return with_alpha(mixed, c.a)
}

/// Darken `c` toward black by `amount` (`0.0..1.0`), preserving alpha.
pub def darken(c: UiColor, amount: f64) -> UiColor {
    val mixed = mix_color(c, rgb(0, 0, 0), clamp_unit(amount))
    return with_alpha(mixed, c.a)
}

/// Choose a high-contrast foreground color (dark ink or light ink) against `bg`.
pub def contrast_fg(bg: UiColor) -> UiColor {
    val lum = 0.299 * to_f64(bg.r) + 0.587 * to_f64(bg.g) + 0.114 * to_f64(bg.b)
    if lum >= 152.0 {
        return rgb(18, 22, 30)
    }
    return rgb(250, 252, 255)
}

/// Decode a 24-bit `0xRRGGBB` integer literal into an opaque `UiColor`.
pub def hex_rgb(code: i64) -> UiColor {
    val safe = if code < 0 { 0 } else { code }
    val r = (safe / 65536) % 256
    val g = (safe / 256) % 256
    val b = safe % 256
    return rgb(r, g, b)
}

/// Clone `theme` with an updated `primary` accent and synchronized `focus_ring`.
pub def theme_with_accent(theme: UiTheme, accent: UiColor) -> UiTheme {
    return UiTheme {
        bg: theme.bg,
        surface: theme.surface,
        panel: theme.panel,
        panel_alt: theme.panel_alt,
        fg: theme.fg,
        fg_muted: theme.fg_muted,
        border: theme.border,
        primary: accent,
        azure: theme.azure,
        teal: theme.teal,
        cyan: theme.cyan,
        amber: theme.amber,
        coral: theme.coral,
        emerald: theme.emerald,
        font_ui_size: theme.font_ui_size,
        font_mono_size: theme.font_mono_size,
        radius: theme.radius,
        is_dark: theme.is_dark,
        shadow: theme.shadow,
        focus_ring: with_alpha(accent, 215),
        radius_sm: theme.radius_sm,
        radius_lg: theme.radius_lg,
        radius_pill: theme.radius_pill,
    }
}

/// Classify horizontal viewport `width` into a responsive `UiBreakpoint`.
pub def ui_breakpoint(width: f64) -> UiBreakpoint {
    if width < 640.0 {
        return UiBreakpoint.Compact
    }
    if width < 1024.0 {
        return UiBreakpoint.Medium
    }
    if width < 1440.0 {
        return UiBreakpoint.Expanded
    }
    return UiBreakpoint.Wide
}

/// Select column count based on responsive viewport `width`.
pub def ui_responsive_cols(width: f64, compact: i64, medium: i64, expanded: i64) -> i64 {
    val bp = ui_breakpoint(width)
    val cols = when bp {
        UiBreakpoint.Compact => compact,
        UiBreakpoint.Medium => medium,
        UiBreakpoint.Expanded => expanded,
        UiBreakpoint.Wide => expanded,
    }
    return if cols < 1 { 1 } else { cols }
}

/// Resolve a semantic `UiTone` into the theme's accent color.
pub def tone_color(theme: UiTheme, tone: UiTone) -> UiColor {
    return when tone {
        UiTone.Primary => theme.primary,
        UiTone.Secondary => theme.azure,
        UiTone.Accent => theme.cyan,
        UiTone.Success => theme.teal,
        UiTone.Warning => theme.amber,
        UiTone.Danger => theme.coral,
        UiTone.Neutral => theme.fg,
        UiTone.Muted => theme.fg_muted,
    }
}
