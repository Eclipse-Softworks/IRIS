// src/stdlib/path.iris -- IRIS standard path manipulation (pure IRIS, no OS calls)

// Joins two path components with "/" separator.
pub def join_path(a: str, b: str) -> str effect alloc {
    concat(concat(a, "/"), b)
}

// Returns the final component of a path (after the last "/").
pub def basename(p: str) -> str effect alloc {
    val n = len(p)
    var last_slash = -1
    var i = 0
    while i < n {
        val ch = slice(p, i, i + 1)
        last_slash = if ch == "/" { i } else { last_slash }
        i = i + 1
    }
    if last_slash < 0 {
        p
    } else {
        slice(p, last_slash + 1, n)
    }
}

// Returns the directory part of a path (everything before the last "/").
pub def dirname(p: str) -> str effect alloc {
    val n = len(p)
    var last_slash = -1
    var i = 0
    while i < n {
        val ch = slice(p, i, i + 1)
        last_slash = if ch == "/" { i } else { last_slash }
        i = i + 1
    }
    if last_slash < 0 {
        "."
    } else {
        if last_slash == 0 { "/" } else { slice(p, 0, last_slash) }
    }
}

// Returns the file extension (part after the last "."), or "" if none.
pub def extension(p: str) -> str effect alloc {
    val b = basename(p)
    val n = len(b)
    var last_dot = -1
    var i = 0
    while i < n {
        val ch = slice(b, i, i + 1)
        last_dot = if ch == "." { i } else { last_dot }
        i = i + 1
    }
    if last_dot < 0 { "" } else { slice(b, last_dot + 1, n) }
}

// Returns the basename without its extension.
pub def stem(p: str) -> str effect alloc {
    val b = basename(p)
    val n = len(b)
    var last_dot = -1
    var i = 0
    while i < n {
        val ch = slice(b, i, i + 1)
        last_dot = if ch == "." { i } else { last_dot }
        i = i + 1
    }
    if last_dot < 0 { b } else { slice(b, 0, last_dot) }
}

// POSIX-style lexical helpers: slash is the only separator. No filesystem I/O.
pub def path_is_absolute(p: str) -> bool {
    starts_with(p, "/")
}

// Nonempty components, retaining '.' and '..' for callers to interpret.
pub def path_components(p: str) -> list<str> effect alloc {
    val out: list<str> = list()
    val parts = split(p, "/")
    var i = 0
    while i < list_len(parts) {
        val part = list_get(parts, i)
        if len(part) > 0 { push(out, part); }
        i = i + 1
    }
    out
}

// Collapse repeated slashes, '.' and cancellable '..' components.
// Relative leading '..' are retained; absolute paths cannot climb above '/'.
// Empty relative results become '.'. Does not resolve symlinks.
pub def normalize_path(p: str) -> str effect alloc {
    val rooted = path_is_absolute(p)
    val parts = path_components(p)
    val stack: list<str> = list()
    var i = 0
    while i < list_len(parts) {
        val part = list_get(parts, i)
        if part == ".." {
            val n = list_len(stack)
            var cancelled = false
            if n > 0 {
                if list_get(stack, n - 1) != ".." {
                    list_remove(stack, n - 1);
                    cancelled = true
                }
            }
            if !cancelled && !rooted { push(stack, ".."); }
        } else {
            if part != "." { push(stack, part); }
        }
        i = i + 1
    }
    val joined = join(stack, "/")
    if rooted { concat("/", joined) } else {
        if len(joined) == 0 { "." } else { joined }
    }
}

// Replace the final filename extension; empty ext removes it.
// ext is supplied without a leading dot. A leading filename dot is preserved.
// Empty paths, directory paths, '.' and '..' are returned unchanged.
pub def with_extension(p: str, ext: str) -> str effect alloc {
    val b = basename(p)
    if len(b) == 0 || b == "." || b == ".." { return p }
    var dot = -1
    var i = 1
    while i < len(b) {
        if str_index(b, i) == 46 { dot = i }
        i = i + 1
    }
    val end = if dot < 0 { len(p) } else { len(p) - len(b) + dot }
    val base = slice(p, 0, end)
    if len(ext) == 0 { base } else { concat(concat(base, "."), ext) }
}

// Convert backslashes to forward slashes for cross-platform POSIX path consistency.
pub def path_to_posix(p: str) -> str effect alloc {
    val n = len(p)
    var out = ""
    var i = 0
    while i < n {
        val ch = slice(p, i, i + 1)
        out = if ch == "\\" { concat(out, "/") } else { concat(out, ch) }
        i = i + 1
    }
    out
}

// Join a list of path segments together sequentially.
pub def path_join_all(parts: list<str>) -> str effect alloc {
    val n = list_len(parts)
    if n == 0 { return "" }
    var res = list_get(parts, 0)
    var i = 1
    while i < n {
        val part = list_get(parts, i)
        res = if len(part) == 0 { res } else {
            if ends_with(res, "/") {
                concat(res, part)
            } else {
                concat(concat(res, "/"), part)
            }
        }
        i = i + 1
    }
    res
}

// Test whether a path has the specified file extension (with or without leading dot).
pub def path_has_extension(p: str, ext: str) -> bool effect alloc {
    val clean_ext = if starts_with(ext, ".") { slice(ext, 1, len(ext)) } else { ext }
    extension(p) == clean_ext
}

// Return the parent directory of a path (alias for dirname).
pub def path_parent(p: str) -> str effect alloc {
    dirname(p)
}

// Find first offset of a character in string or -1 if not found.
pub def path_find_char(s: str, target: str) -> i64 effect alloc {
    val n = len(s)
    var i = 0
    while i < n {
        if slice(s, i, i + 1) == target {
            return i
        }
        i = i + 1
    }
    -1
}

// Match a filename or path against a wildcard glob pattern containing '*'.
pub def path_matches_glob(p: str, pattern: str) -> bool effect alloc {
    if pattern == "*" { return true }
    val star_idx = path_find_char(pattern, "*")
    if star_idx < 0 { return p == pattern }
    val prefix = slice(pattern, 0, star_idx)
    val suffix = slice(pattern, star_idx + 1, len(pattern))
    if !starts_with(p, prefix) { return false }
    if !ends_with(p, suffix) { return false }
    len(p) >= (len(prefix) + len(suffix))
}
