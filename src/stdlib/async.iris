// src/stdlib/async.iris -- IRIS standard async/concurrency library
//
// Provides task helpers (timeouts, joining, cancelling), non-blocking channel
// operations, thread utilities, and timing functions.
//
// `async def` tasks run cooperatively on the thread that awaits them; the
// language builtins for them are `async_sleep(ms)`, `async_yield()`,
// `async_recv(ch)`, `async_any(...)`, `task_done(t)`, `task_cancel(t)` and
// `task_cancelled(t)`.

extern def iris_async_worker_count() -> i64 effect thread
extern def iris_async_queued_tasks() -> i64 effect thread
extern def iris_current_task_cancelled_i64() -> i64 effect thread
extern def iris_task_group_is_cancelled_i64(group: task_group) -> i64 effect thread

/// Number of fixed worker threads that run `spawn` jobs. `async def` tasks do
/// not use them: a task runs on the thread that created it.
pub def async_worker_count() -> i64 effect thread {
    return iris_async_worker_count()
}

/// `spawn` jobs currently waiting for a worker thread.
pub def async_queued_tasks() -> i64 effect thread {
    return iris_async_queued_tasks()
}

/// Wait for `t` for at most `ms` milliseconds: `some(result)` if it finished
/// in time, `none` otherwise. The task keeps running; await it again later,
/// or stop it with `task_cancel`.
pub async def timeout_after[T](t: task<T>, ms: i64) -> option<T> effect time, thread, alloc {
    val which = await async_any(t, async_sleep(ms))
    if which == 0 { some(await t) } else { none }
}

/// Await every task, in order, and collect the results. The tasks already
/// run concurrently from the moment they were created; this only gathers them.
pub async def join_all[T](tasks: list<task<T>>) -> list<T> effect alloc {
    val results: list<T> = list()
    for i in 0..list_len(tasks) {
        list_push(results, await list_get(tasks, i))
    }
    results
}

/// Cancel every unfinished task in `tasks`; returns how many were cancelled.
pub def cancel_all[T](tasks: list<task<T>>) -> i64 effect thread, alloc {
    var cancelled = 0
    for i in 0..list_len(tasks) {
        val t = list_get(tasks, i)
        if !task_done(t) {
            task_cancel(t);
            cancelled = cancelled + 1
        }
    }
    cancelled
}

/// True when cancellation has been requested for the current structured task.
/// Long-running CPU tasks should check this at bounded intervals and return.
pub def cancellation_requested() -> bool effect thread {
    return iris_current_task_cancelled_i64() != 0
}

/// Observe cancellation for a specific task group.
pub def task_group_cancelled(group: task_group) -> bool effect thread {
    return iris_task_group_is_cancelled_i64(group) != 0
}

/// Try to receive from a channel without blocking.
/// Returns `some(value)` if available, `none` otherwise.
pub def try_recv(ch: chan<i64>) -> option<i64> effect alloc, thread {
    chan_try_recv(ch)
}

/// Create a new bounded channel with the specified capacity.
pub def channel_bounded(capacity: i64) -> chan<i64> effect alloc {
    channel(capacity)
}

/// Create a new unbounded channel.
pub def channel_unbounded() -> chan<i64> effect alloc {
    channel(-1)
}

/// Get the number of pending messages in a channel.
pub def channel_len(ch: chan<i64>) -> i64 effect alloc, thread {
    chan_len(ch)
}

/// Sleep for a given number of milliseconds.
/// Returns `true` when the timeout completes.
pub def sleep(ms: i64) -> bool effect time {
    timeout(ms)
}

/// Get the number of available hardware threads.
pub def num_threads() -> i64 effect env {
    thread_count()
}

/// Get current Unix timestamp in seconds.
pub def now() -> i64 effect time {
    datetime_timestamp() to i64
}

/// Sleep for `ms` milliseconds.
/// Returns `true` after the delay completes.
pub def delay(ms: i64) -> bool effect time {
    timeout(ms)
}

/// Select the first ready channel from a list (returns index 0..n-1, or -1 if none ready).
pub def select_first(channels: list<chan<i64>>) -> i64 effect alloc, thread {
    val n = list_len(channels)
    var i = 0
    while i < n {
        val ch = list_get(channels, i)
        if chan_len(ch) > 0 { return i }
        i = i + 1
    }
    -1
}

/// Receive from channel with a timeout in milliseconds.
/// Returns `some(val)` if received before timeout, `none` otherwise.
pub def recv_timeout_ms(ch: chan<i64>, timeout_ms: i64) -> option<i64> effect thread, alloc {
    recv_timeout(ch, timeout_ms)
}

/// Create a new structured TaskGroup.
pub def new_task_group() -> task_group effect alloc {
    task_group()
}

/// Force a cycle collection sweep on the GC side-table.
pub def gc_collect_sweep() -> bool effect alloc {
    gc_collect()
}

/// Retrieve current GC allocation and collection statistics.
pub def gc_get_stats() -> map<str, i64> effect alloc {
    gc_stats()
}
