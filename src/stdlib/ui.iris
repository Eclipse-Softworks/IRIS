        align: UiAlign.Stretch,
        flex: style.flex,
        min_w: style.min_w,
        min_h: style.min_h,
        max_w: style.max_w,
        max_h: style.max_h,
    }
    return ui_add_node(
        tree,
        UiNode {
            key: key,
            kind: WidgetKind.TextInput,
            text: text,
            placeholder: placeholder,
            style: merged,
            children: empty,
        },
    )
}

