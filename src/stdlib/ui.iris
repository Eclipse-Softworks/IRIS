    tree: UiTree,
    key: str,
    options: list<str>,
    selected_idx: i64,
    placeholder: str,
    action: str,
) -> i64 effect alloc {
    val idx = ui_push_select(tree, SelectSpec { options: options, placeholder: placeholder })
    val empty: list<i64> = list()
    return ui_add_node(
        tree,
        UiNode {
            key: key,
            kind: WidgetKind.Select,
            placeholder: placeholder,
            selected_idx: selected_idx,
            data_idx: idx,
            action: action,
            children: empty,
        },
    )
}

