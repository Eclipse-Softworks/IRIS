/// Append a CPU-rasterized heatmap surface widget from a `TensorSpec`.
pub def ui_tensor_from_grid(
    tree: UiTree,
    key: str,
    spec: TensorSpec,
    style: UiStyle,
) -> i64 effect alloc {
    val empty: list<i64> = list()
    val tidx = ui_push_tensor(tree, spec)
    val merged = UiStyle {
        align: UiAlign.Stretch,
        flex: style.flex,
        min_w: style.min_w,
        min_h: style.min_h,
        max_w: style.max_w,
        max_h: style.max_h,
    }
    return ui_add_node(
        tree,
        UiNode {
            key: key,
            kind: WidgetKind.TensorView,
            text: spec.title,
            style: merged,
            data_idx: tidx,
            children: empty,
        },
    )
}

/// Append a CPU-rasterized heatmap directly from a `std.tensor.Tensor` (`1D` or `2D`).
pub def ui_tensor_surface(
    tree: UiTree,
    key: str,
    t: Tensor,
    title: str,
    style: UiStyle,
) -> i64 effect alloc {
    val data = tensor_data(t)
    val shape = tensor_shape(t)
    val ndims = list_len(shape)
    val h = if ndims >= 2 { list_get(shape, 0) } else { 1 }
    val w = if ndims >= 2 {
        list_get(shape, 1)
    } else {
        if ndims == 1 { list_get(shape, 0) } else { list_len(data) }
    }
    val n = list_len(data)
    var vmin = 0.0
    var vmax = 1.0
    if n > 0 {
        vmin = list_get(data, 0)
        vmax = vmin
        for i in 1..n {
            val v = list_get(data, i)
            if v < vmin {
                vmin = v
            }
            if v > vmax {
                vmax = v
            }
        }
        if vmax - vmin < 0.0001 {
            vmax = vmin + 1.0
        }
    }
    val spec = TensorSpec { width: w, height: h, cells: data, vmin: vmin, vmax: vmax, title: title }
    return ui_tensor_from_grid(tree, key, spec, style)
}

