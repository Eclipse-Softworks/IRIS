}

/// Append an elevated bordered surface container (`Card`) owning `children`.
pub def ui_card(tree: UiTree, key: str, style: UiStyle, children: list<i64>) -> i64 effect alloc {
    val card_style = UiStyle {
        bg: if style.bg.a > 0 { style.bg } else { tree.theme.panel },
        fg: style.fg,
        border: if style.border.a > 0 { style.border } else { tree.theme.border },
        border_width: if style.border_width > 0.0 { style.border_width } else { 1.0 },
        radius: if style.radius > 0.0 { style.radius } else { tree.theme.radius },
        padding: if style.padding > 0.0 { style.padding } else { 12.0 },
        gap: style.gap,
        align: UiAlign.Stretch,
        flex: style.flex,
        min_w: style.min_w,
        min_h: style.min_h,
        max_w: style.max_w,
        max_h: style.max_h,
    }
    return ui_add_node(
        tree,
        UiNode {
            key: key,
            kind: WidgetKind.Card,
            style: card_style,
            children: children,
        },
    )
}

/// Append a flexible spacer leaf.
pub def ui_spacer(tree: UiTree, flex: f64, min_w: f64, min_h: f64) -> i64 effect alloc {
    val empty: list<i64> = list()
