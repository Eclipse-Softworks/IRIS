/// Append a responsive equal-column grid container (`Grid`) with `cols` columns.
pub def ui_grid(
    tree: UiTree,
    key: str,
    cols: i64,
    gap: f64,
    children: list<i64>,
) -> i64 effect alloc {
    return ui_add_node(
        tree,
        UiNode {
            key: key,
            kind: WidgetKind.Grid,
            style: UiStyle {
                columns: if cols > 0 { cols } else { 2 },
                gap: gap,
                align: UiAlign.Stretch,
            },
            children: children,
        },
    )
}

/// Append a two-pane resizable split view (`SplitPane`) with initial `ratio` (`0.15..0.85`).
pub def ui_split_pane(
    tree: UiTree,
    key: str,
    ratio: f64,
    left_child: i64,
    right_child: i64,
) -> i64 effect alloc {
    val kids: list<i64> = list(left_child, right_child)
    return ui_add_node(
        tree,
        UiNode {
            key: key,
            kind: WidgetKind.SplitPane,
            ratio: ratio,
            style: UiStyle { align: UiAlign.Stretch, flex: 1.0 },
            children: kids,
        },
    )
}

