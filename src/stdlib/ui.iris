// std.ui -- High-level declarative + immediate-mode native GUI toolkit for IRIS.

bring std.ffi
bring std.tensor
pub bring std.ui_theme
pub bring std.ui_protocol
pub bring std.ui_motion
pub bring std.ui_icons
pub bring std.ui_layout
pub bring std.ui_widgets

/// Result of one frame pump against `iris_ui_host`.
pub record UiFrameStep {
    state: UiState,
    buf: DrawBuffer,
    metrics: WindowMetrics,
    events: list<HostEvent>,
}

/// Create a new `UiTree` styled with the canonical IRIS Obsidian & Signal theme.
pub def ui_new() -> UiTree effect alloc {
    return ui_tree_new(obsidian_theme())
}

/// Create a new `UiTree` styled with an explicit `UiTheme`.
pub def ui_with_theme(theme: UiTheme) -> UiTree effect alloc {
    return ui_tree_new(theme)
}

/// Construct a default interaction `UiState`.
pub def ui_state_new() -> UiState {
    return UiState {}
}

/// Append a vertical flex/stack container (`Col`) owning `children`.
pub def ui_col(tree: UiTree, key: str, style: UiStyle, children: list<i64>) -> i64 effect alloc {
    return ui_add_node(
        tree,
        UiNode {
            key: key,
            kind: WidgetKind.Col,
            style: style,
            children: children,
        },
    )
}

/// Append a horizontal flex container (`Row`) owning `children`.
pub def ui_row(tree: UiTree, key: str, style: UiStyle, children: list<i64>) -> i64 effect alloc {
    return ui_add_node(
        tree,
        UiNode {
            key: key,
            kind: WidgetKind.Row,
            style: style,
            children: children,
        },
    )
}

/// Append an overlay container (`Stack`) positioning `children` inside shared bounds.
pub def ui_stack(tree: UiTree, key: str, style: UiStyle, children: list<i64>) -> i64 effect alloc {
    return ui_add_node(
        tree,
        UiNode {
            key: key,
            kind: WidgetKind.Stack,
            style: style,
