/// Append a `[0.0, max_val]` horizontal slider widget.
pub def ui_slider(
    tree: UiTree,
    key: str,
    label: str,
    value: f64,
    max_val: f64,
) -> i64 effect alloc {
    return ui_slider_range(tree, key, label, value, UiSize { w: 0.0, h: max_val })
}

/// Append a bounded horizontal slider using `bounds.w` (`min`) and `bounds.h` (`max`).
pub def ui_slider_range(
    tree: UiTree,
    key: str,
    label: str,
    value: f64,
    bounds: UiSize,
) -> i64 effect alloc {
    val empty: list<i64> = list()
    return ui_add_node(
        tree,
        UiNode {
            key: key,
            kind: WidgetKind.Slider,
            text: label,
            tone: UiTone.Accent,
            style: UiStyle { align: UiAlign.Stretch },
            value: value,
            min_val: bounds.w,
            max_val: bounds.h,
            children: empty,
        },
    )
}

