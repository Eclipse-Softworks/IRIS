/// Append a horizontal determinate progress bar (`ProgressBar`).
pub def ui_progress_bar(
    tree: UiTree,
    key: str,
    label: str,
    value: f64,
    max_val: f64,
    tone: UiTone,
) -> i64 effect alloc {
    val empty: list<i64> = list()
    return ui_add_node(
        tree,
        UiNode {
            key: key,
            kind: WidgetKind.ProgressBar,
            text: label,
            value: value,
            min_val: 0.0,
            max_val: if max_val > 0.0 { max_val } else { 1.0 },
            tone: tone,
            children: empty,
        },
    )
}

