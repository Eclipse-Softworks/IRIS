// src/stdlib/iter.iris -- IRIS standard iteration / functional list utilities
//
// Provides higher-order functions and utilities for working with lists of i64.

/// Sum all elements of a list.
/// Returns 0 for empty lists.
pub def sum(xs: list<i64>) -> i64 {
    var acc = 0
    var i = 0
    val n = list_len(xs)
    while i < n {
        acc = acc + list_get(xs, i)
        i = i + 1
    }
    acc
}

/// Product of all elements.
/// Returns 1 for empty lists.
pub def product(xs: list<i64>) -> i64 {
    var acc = 1
    var i = 0
    val n = list_len(xs)
    while i < n {
        acc = acc * list_get(xs, i)
        i = i + 1
    }
    acc
}

/// Minimum element.
/// Panics if the list is empty.
pub def min(xs: list<i64>) -> i64 {
    var m = list_get(xs, 0)
    var i = 1
    val n = list_len(xs)
    while i < n {
        val v = list_get(xs, i)
        m = if v < m { v } else { m }
        i = i + 1
    }
    m
}

/// Maximum element.
/// Panics if the list is empty.
pub def max(xs: list<i64>) -> i64 {
    var m = list_get(xs, 0)
    var i = 1
    val n = list_len(xs)
    while i < n {
        val v = list_get(xs, i)
        m = if v > m { v } else { m }
        i = i + 1
    }
    m
}

/// Reverse a list (returns new list).
pub def reverse(xs: list<i64>) -> list<i64> {
    var result: list<i64> = list()
    var i = list_len(xs) - 1
    while i >= 0 {
        push(result, list_get(xs, i));
        i = i - 1
    }
    result
}

/// Take first `n` elements.
/// Returns all elements if `n` exceeds list length.
pub def take(xs: list<i64>, n: i64) -> list<i64> {
    var result: list<i64> = list()
    var i = 0
    val len = list_len(xs)
    val limit = if n < len { n } else { len }
    while i < limit {
        push(result, list_get(xs, i));
        i = i + 1
    }
    result
}

/// Drop first `n` elements.
/// Returns empty list if `n` exceeds list length.
pub def drop(xs: list<i64>, n: i64) -> list<i64> {
    var result: list<i64> = list()
    val len = list_len(xs)
    var i = if n < 0 { 0 } else { n }
    while i < len {
        push(result, list_get(xs, i));
        i = i + 1
    }
    result
}

/// Range: generate list from `lo` to `hi-1`.
/// Returns empty list if `lo >= hi`.
pub def range(lo: i64, hi: i64) -> list<i64> {
    var result: list<i64> = list()
    var i = lo
    while i < hi {
        push(result, i);
        i = i + 1
    }
    result
}

/// Check if any element equals `target`.
pub def contains(xs: list<i64>, target: i64) -> bool {
    var found = false
    var i = 0
    val n = list_len(xs)
    while i < n {
        found = if list_get(xs, i) == target { true } else { found }
        i = i + 1
    }
    found
}

/// Count occurrences of `target`.
pub def count(xs: list<i64>, target: i64) -> i64 {
    var c = 0
    var i = 0
    val n = list_len(xs)
    while i < n {
        c = if list_get(xs, i) == target { c + 1 } else { c }
        i = i + 1
    }
    c
}

/// Index of first occurrence of `target`, or -1 if not found.
pub def index_of(xs: list<i64>, target: i64) -> i64 {
    var i = 0
    val n = list_len(xs)
    while i < n {
        if list_get(xs, i) == target {
            return i
        };
        i = i + 1
    }
    0 - 1
}

/// Flatten a list of lists into a single list.
pub def flatten_i64(xss: list<list<i64>>) -> list<i64> {
    var result: list<i64> = list()
    var i = 0
    val n = list_len(xss)
    while i < n {
        val inner = list_get(xss, i)
        var j = 0
        val m = list_len(inner)
        while j < m {
            push(result, list_get(inner, j));
            j = j + 1
        }
        i = i + 1
    }
    result
}

/// Transform each value in order into a fresh list.
pub def map_i64(xs: list<i64>, transform: |i64| -> i64) -> list<i64> {
    val out: list<i64> = list()
    var i = 0
    val n = list_len(xs)
    while i < n {
        push(out, transform(list_get(xs, i)));
        i = i + 1
    }
    out
}

/// Retain matching values in order, without changing the input.
pub def filter_i64(xs: list<i64>, predicate: |i64| -> bool) -> list<i64> {
    val out: list<i64> = list()
    var i = 0
    val n = list_len(xs)
    while i < n {
        val value = list_get(xs, i)
        if predicate(value) { push(out, value); }
        i = i + 1
    }
    out
}

/// Left fold. Empty lists return initial without calling combine.
pub def fold_i64(xs: list<i64>, initial: i64, combine: |i64, i64| -> i64) -> i64 {
    var acc = initial
    var i = 0
    val n = list_len(xs)
    while i < n {
        acc = combine(acc, list_get(xs, i))
        i = i + 1
    }
    acc
}

/// Short-circuit queries. any(empty) is false; all(empty) is true.
pub def any_i64(xs: list<i64>, predicate: |i64| -> bool) -> bool {
    var i = 0
    val n = list_len(xs)
    while i < n {
        if predicate(list_get(xs, i)) { return true }
        i = i + 1
    }
    false
}

pub def all_i64(xs: list<i64>, predicate: |i64| -> bool) -> bool {
    var i = 0
    val n = list_len(xs)
    while i < n {
        if !predicate(list_get(xs, i)) { return false }
        i = i + 1
    }
    true
}

/// First matching value, or none. Stops at the first match.
pub def find_i64(xs: list<i64>, predicate: |i64| -> bool) -> option<i64> {
    var i = 0
    val n = list_len(xs)
    while i < n {
        val value = list_get(xs, i)
        if predicate(value) { return some(value) }
        i = i + 1
    }
    none
}

/// Stable partition into (matching, nonmatching), testing each value once.
pub def partition_i64(xs: list<i64>, predicate: |i64| -> bool) -> (list<i64>, list<i64>) {
    val yes: list<i64> = list()
    val no: list<i64> = list()
    var i = 0
    val n = list_len(xs)
    while i < n {
        val value = list_get(xs, i)
        if predicate(value) { push(yes, value); } else { push(no, value); }
        i = i + 1
    }
    (yes, no)
}

/// First occurrence of each value, preserving order. O(n^2) worst case.
pub def unique_i64(xs: list<i64>) -> list<i64> {
    val out: list<i64> = list()
    var i = 0
    val n = list_len(xs)
    while i < n {
        val value = list_get(xs, i)
        if list_index_of(out, value) < 0 { push(out, value); }
        i = i + 1
    }
    out
}

/// Independent chunks, including a final short chunk. size <= 0 returns empty.
pub def chunks_i64(xs: list<i64>, size: i64) -> list<list<i64>> {
    val out: list<list<i64>> = list()
    if size <= 0 { return out }
    var i = 0
    val n = list_len(xs)
    while i < n {
        val chunk: list<i64> = list()
        val remaining = n - i
        val chunk_len = if size < remaining { size } else { remaining }
        var j = 0
        while j < chunk_len {
            push(chunk, list_get(xs, i));
            i = i + 1
            j = j + 1
        }
        push(out, chunk);
    }
    out
}

/// All full, overlapping windows, copied into independent lists.
/// Nonpositive sizes or sizes larger than the input return empty.
pub def windows_i64(xs: list<i64>, size: i64) -> list<list<i64>> {
    val out: list<list<i64>> = list()
    val n = list_len(xs)
    if size <= 0 || size > n { return out }
    var i = 0
    while i <= n - size {
        val window: list<i64> = list()
        var j = 0
        while j < size {
            push(window, list_get(xs, i + j));
            j = j + 1
        }
        push(out, window);
        i = i + 1
    }
    out
}

/// Sum of elements in a borrowed slice.
pub def slice_sum(s: &[i64], len: i64) -> i64 {
    var acc = 0;
    var i = 0;
    while i < len {
        acc = acc + s[i];
        i = i + 1;
    }
    acc
}

/// Find index of target in a borrowed slice (-1 if absent).
pub def slice_find(s: &[i64], len: i64, target: i64) -> i64 {
    var i = 0;
    while i < len {
        if s[i] == target { return i }
        i = i + 1;
    }
    -1
}

/// In-place slice fill operation on a mutable slice view.
pub def slice_fill(s: &mut [i64], len: i64, value: i64) -> i64 {
    var i = 0;
    while i < len {
        s[i] = value;
        i = i + 1;
    }
    0
}

/// In-place slice reverse on a mutable slice view.
pub def slice_reverse(s: &mut [i64], len: i64) -> i64 {
    var left = 0;
    var right = len - 1;
    while left < right {
        val temp = s[left];
        s[left] = s[right];
        s[right] = temp;
        left = left + 1;
        right = right - 1;
    }
    0
}
