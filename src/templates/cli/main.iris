// {{name}}: a command-line tool.
//
//   iris run main.iris -- --name Ada --times 2
//   iris test
//
// Arguments are parsed into a record by `parse`, which the tests call
// directly; `main` only reads the real arguments and prints.

record Options { name: str, times: i64, error: str }

// `argv` as the program receives it: argv[0] is the program itself.
def parse(argv: list<str>) -> Options {
    var name = "world"
    var times = 1
    var error = ""
    var i = 1
    while i < list_len(argv) {
        val a = list_get(argv, i)
        if a == "--name" && i + 1 < list_len(argv) {
            name = list_get(argv, i + 1)
            i = i + 1
        } else if a == "--times" && i + 1 < list_len(argv) {
            val n = parse_i64(list_get(argv, i + 1))
            if is_some(n) { times = unwrap(n) } else { error = "--times needs a number" }
            i = i + 1
        } else {
            error = "unknown argument " + a
        }
        i = i + 1
    }
    return Options { name: name, times: times, error: error }
}

def greeting(o: Options) -> str {
    var out = ""
    for i in 0..o.times {
        if i > 0 { out = out + "\n" }
        out = out + "hello, " + o.name
    }
    return out
}

def main() -> i64 {
    val o = parse(args())
    if len(o.error) > 0 {
        println("{{name}}: " + o.error)
        println("usage: {{name}} [--name NAME] [--times N]")
        return 2
    }
    println(greeting(o))
    return 0
}

def argv_of(a: str, b: str, c: str, d: str) -> list<str> {
    val v: list<str> = list()
    push(v, "{{name}}")
    if len(a) > 0 { push(v, a) }
    if len(b) > 0 { push(v, b) }
    if len(c) > 0 { push(v, c) }
    if len(d) > 0 { push(v, d) }
    return v
}

def test_defaults() -> i64 {
    val o = parse(argv_of("", "", "", ""))
    assert(o.name == "world" && o.times == 1 && len(o.error) == 0)
    assert(greeting(o) == "hello, world")
    return 0
}

def test_options() -> i64 {
    val o = parse(argv_of("--name", "Ada", "--times", "2"))
    assert(o.name == "Ada" && o.times == 2)
    assert(greeting(o) == "hello, Ada\nhello, Ada")
    return 0
}

def test_bad_arguments() -> i64 {
    assert(parse(argv_of("--times", "many", "", "")).error == "--times needs a number")
    assert(parse(argv_of("--loud", "", "", "")).error == "unknown argument --loud")
    return 0
}
