record Point { x: f64, y: f64 }
record Pair { a: i64, b: i64 }

def simple_value() -> i64 {
    val p = Point { x: 1.0, y: 2.0 }
    when p {
        Point { x: 1.0, y } => { print("x is 1.0, y = " + to_str(y)); 1 }
        Point { x, y } => { print("x = " + to_str(x) + ", y = " + to_str(y)); 2 }
        _ => { print("other"); 0 }
    }
}

def second_arm_value() -> i64 {
    val q = Point { x: 5.0, y: 7.0 }
    when q {
        Point { x: 1.0, y } => { print("x is 1.0, y = " + to_str(y)); 1 }
        Point { x, y } => { print("x = " + to_str(x) + ", y = " + to_str(y)); 2 }
        _ => { print("other"); 0 }
    }
}

def field_lit_value() -> i64 {
    val pr = Pair { a: 3, b: 4 }
    when pr {
        Pair { a: 0, b } => { print("a is zero, b = " + to_str(b)); 1 }
        Pair { a, b: 4 } => { print("a = " + to_str(a) + ", and b is 4"); 2 }
        _ => { print("no match"); 0 }
    }
}

def wildcard_value() -> i64 {
    val pr = Pair { a: 9, b: 9 }
    when pr {
        Pair { a: 0, b } => { print("a is zero, b = " + to_str(b)); 1 }
        Pair { a, b: 4 } => { print("a = " + to_str(a) + ", and b is 4"); 2 }
        _ => { print("no match"); 0 }
    }
}

def test_simple() -> i64 { assert(simple_value() == 1); return 0 }
def test_second_arm() -> i64 { assert(second_arm_value() == 2); return 0 }
def test_field_lit() -> i64 { assert(field_lit_value() == 2); return 0 }
def test_wildcard() -> i64 { assert(wildcard_value() == 0); return 0 }

def main() -> i64 {
    // Each helper must select a *different* arm. The file called all four and
    // discarded every result.
    assert(test_simple() == 0);       // Point { x: 1.0, y } -- literal field, bound field
    assert(test_second_arm() == 0);   // falls through to the catch-all binding arm
    assert(test_field_lit() == 0);
    assert(test_wildcard() == 0);     // reaches `_`
    println("struct patterns in when ok");
    return 0
}
