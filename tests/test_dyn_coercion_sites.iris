// A concrete record becomes a `dyn Trait` at every site that expects one:
// a parameter, an annotated binding, a list element, a function's tail value,
// an early return, each `if` branch of a returned value, and a record field.

trait Shape { def area(self) -> f64 }
record Sq { s: f64 }
record Rect { w: f64, h: f64 }
impl Shape for Sq { def area(self) -> f64 { self.s * self.s } }
impl Shape for Rect { def area(self) -> f64 { self.w * self.h } }

record Holder { shape: dyn Shape }
record Scene { items: list<dyn Shape> }

def area_of(s: dyn Shape) -> f64 { s.area() }

def make_square() -> dyn Shape { Sq { s: 3.0 } }

def pick(big: bool) -> dyn Shape {
    if big { Rect { w: 2.0, h: 5.0 } } else { Sq { s: 3.0 } }
}

def pick_early(big: bool) -> dyn Shape {
    if big { return Rect { w: 2.0, h: 5.0 } };
    Sq { s: 1.0 }
}

def main() -> i64 {
    assert(area_of(Sq { s: 2.0 }) == 4.0);

    val annotated: dyn Shape = Rect { w: 1.0, h: 3.0 };
    assert(annotated.area() == 3.0);

    assert(make_square().area() == 9.0);
    assert(pick(true).area() == 10.0);
    assert(pick(false).area() == 9.0);
    assert(pick_early(true).area() == 10.0);
    assert(pick_early(false).area() == 1.0);

    val h: Holder = Holder { shape: Rect { w: 2.0, h: 3.0 } };
    assert(h.shape.area() == 6.0);

    val xs: list<dyn Shape> = list();
    push(xs, Sq { s: 1.0 });
    push(xs, Rect { w: 2.0, h: 2.0 });
    val scene: Scene = Scene { items: xs };
    var total = 0.0;
    for s in scene.items { total = total + s.area(); };
    assert(total == 5.0);

    println("dyn coercion sites ok");
    0
}
