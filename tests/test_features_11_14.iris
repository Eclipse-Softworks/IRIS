/// Documentation, type-alias, and higher-kinded-type coverage.
///
/// Refinement `where` clauses are not part of the RC1 grammar, so this public
/// test exercises the supported type surface instead of preserving stale
/// syntax that could never compile.

type Positive = i64

record Box[T] {
    item: T
}

record Wrapper[F[_], A] {
    value: F<A>
}

/// A documented function whose comment is available to docs and LSP hover.
def documented_value() -> i64 {
    return 42
}

def test_documented_function() -> i64 {
    assert(documented_value() == 42);
    return 0
}

def test_type_alias() -> i64 {
    val value: Positive = 10;
    assert(value == 10);
    return 0
}

def test_higher_kinded_wrapper() -> i64 {
    val wrapped: Wrapper<Box, i64> = Wrapper {
        value: Box { item: 100 }
    };
    assert(wrapped.value.item == 100);
    return 0
}

def main() -> i64 {
    assert(test_documented_function() == 0);
    assert(test_type_alias() == 0);
    assert(test_higher_kinded_wrapper() == 0);
    println("docs, aliases, and HKT: ok");
    return 0
}
