// `select!` with a `default` arm must take the default when no channel is
// ready, and take the message arm when one is.
def select_default_value() -> i64 {
    val ch: chan<i64> = channel();
    var received = 0;
    select! {
        msg = ch => {
            received = msg
        },
        default => {
            received = -1
        }
    };
    received
}

def select_ready_value() -> i64 {
    val ch: chan<i64> = channel();
    send(ch, 99);
    var received = 0;
    select! {
        msg = ch => {
            received = msg
        },
        default => {
            received = -1
        }
    };
    received
}

def test_select_default() -> i64 {
    assert(select_default_value() == -1);
    return 0
}

def test_select_ready() -> i64 {
    assert(select_ready_value() == 99);
    return 0
}

def main() -> i64 {
    // Nothing sent, so the default arm runs.
    assert(test_select_default() == 0);
    // A value is waiting, so the message arm runs and carries the payload --
    // a select that always took `default` would fail here.
    assert(test_select_ready() == 0);
    println("select ok");
    return 0
}
