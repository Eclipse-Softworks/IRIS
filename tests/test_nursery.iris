// Structured concurrency through nursery scopes and timed channel receives.

bring std.async

def test_nursery_join() -> i64 {
    val ch: chan<i64> = channel_unbounded();
    nursery {
        spawn { chan_send(ch, 10) };
        spawn { chan_send(ch, 20) };
    };
    val first = recv(ch);
    val second = recv(ch);
    assert(first + second == 30);
    return 0
}

def test_timed_receive() -> i64 {
    val ch: chan<i64> = channel_unbounded();
    val empty = recv_timeout_ms(ch, 25);
    assert(is_none(empty));

    chan_send(ch, 99);
    val ready = recv_timeout_ms(ch, 100);
    assert(is_some(ready));
    assert(unwrap(ready) == 99);
    return 0
}

def main() -> i64 {
    assert(test_nursery_join() == 0);
    assert(test_timed_receive() == 0);
    println("nursery and timeout: ok");
    return 0
}
