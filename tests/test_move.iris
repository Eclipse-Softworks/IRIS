// Test linear/affine types: move keyword
// All tests should compile and run successfully.

def basic_move_value() -> i64 {
    val a: list<i64> = list(1, 2, 3);
    val b = move a;
    val sum: i64 = list_len(b);
    return sum
}

def move_and_use_value() -> str {
    val msg: str = "hello";
    val greeting = move msg;
    return greeting
}

def move_in_block_value() -> i64 {
    val x: i64 = 42;
    val y = move x;
    val z = move y;
    return z
}

def move_chain_value() -> str {
    val s: str = "world";
    val a = move s;
    val b = move a;
    val c = move b;
    return c
}

def test_basic_move() -> i64 { assert(basic_move_value() == 3); return 0 }
def test_move_and_use() -> i64 { assert(move_and_use_value() == "hello"); return 0 }
def test_move_in_block() -> i64 { assert(move_in_block_value() == 42); return 0 }
def test_move_chain() -> i64 { assert(move_chain_value() == "world"); return 0 }

def main() -> i64 {
    // `move` transfers ownership; the moved-to binding must hold the value.
    // This file previously printed the four results and checked them only via
    // a `process.exit(1)` that `--emit eval` discards anyway (#53).
    assert(test_basic_move() == 0);
    assert(test_move_and_use() == 0);
    assert(test_move_in_block() == 0);
    assert(test_move_chain() == 0);
    println("move ok");
    return 0
}
