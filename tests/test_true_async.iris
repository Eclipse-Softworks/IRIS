bring std.async

async def square(value: i64) -> i64 {
    // Give way once, so every task is suspended at the same time.
    await async_yield();
    return value * value
}

def main() -> i64 effect alloc, thread, throw {
    val pending: list<task<i64>> = list()
    for value in 0..128 {
        list_push(pending, square(value));
    }

    var total = 0
    for index in 0..list_len(pending) {
        total = total + await list_get(pending, index)
    }
    assert(total == 690880);
    // Tasks run on this thread's executor: nothing goes to the spawn workers.
    assert(async_queued_tasks() == 0);
    return 0
}
