{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "IRIS",
  "scopeName": "source.iris",
  "fileTypes": [
    "iris"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#preprocessor"
    },
    {
      "include": "#fstrings"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#chars"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#model_dsl"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#macros"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.iris",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.iris",
          "match": "//.*$"
        },
        {
          "name": "comment.block.iris",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "preprocessor": {
      "comment": "Conditional compilation & predefined target symbols from src/preprocessor.rs",
      "patterns": [
        {
          "name": "meta.preprocessor.iris",
          "begin": "^\\s*(#\\s*(?:define|undef|ifdef|ifndef|if|elif|else|endif|error|warning))\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.iris"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "name": "keyword.operator.logical.iris",
              "match": "\\b(defined)\\b|(&&|\\|\\||!)"
            },
            {
              "name": "constant.language.preprocessor.iris",
              "match": "\\b(WINDOWS|LINUX|MACOS|WASM|EMBEDDED|TARGET_WINDOWS|TARGET_LINUX|TARGET_MACOS|X86_64|AARCH64|ARM|RISCV32|RISCV64|AVR|XTENSA|WASM32|TARGET_OS|TARGET_ARCH|DEBUG|RELEASE|IRIS_VERSION_MAJOR|IRIS_VERSION_MINOR|IRIS_VERSION_PATCH)\\b"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#identifiers"
            }
          ]
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.iris",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.iris",
          "match": "\\\\(n|t|r|\\\\|\")"
        }
      ]
    },
    "fstrings": {
      "name": "string.interpolated.iris",
      "begin": "f\"",
      "end": "\"",
      "patterns": [
        {
          "name": "meta.embedded.iris",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "$self"
            }
          ]
        },
        {
          "name": "constant.character.escape.iris",
          "match": "\\\\(n|t|r|\\\\|\")"
        }
      ]
    },
    "chars": {
      "comment": "Single-quoted character literal ('A', '\\n')",
      "patterns": [
        {
          "name": "string.quoted.single.iris",
          "match": "'(?:[^'\\\\]|(\\\\[ntr\\\\'\"]))'",
          "captures": {
            "1": {
              "name": "constant.character.escape.iris"
            }
          }
        }
      ]
    },
    "labels": {
      "comment": "Loop labels: `for outer i in 0..n { break outer; }`",
      "patterns": [
        {
          "match": "\\b(break|continue)\\s+([a-z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.flow.iris"
            },
            "2": {
              "name": "entity.name.label.iris"
            }
          }
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.annotation.iris",
          "match": "@([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "entity.name.function.decorator.iris"
            }
          }
        }
      ]
    },
    "model_dsl": {
      "comment": "Highlight contextual `input`, `layer`, `output` strictly inside `model Name { ... }` blocks.",
      "begin": "\\b(model)\\s+([A-Z][a-zA-Z0-9_]*)\\s*\\{",
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.iris"
        },
        "2": {
          "name": "entity.name.type.iris"
        }
      },
      "end": "\\}",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "name": "keyword.control.model.iris",
          "match": "\\b(input|layer|output)\\b"
        },
        {
          "include": "#types"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#functions"
        },
        {
          "include": "#identifiers"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.function.definition.iris",
          "match": "\\b(def)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.iris"
            },
            "2": {
              "name": "entity.name.function.iris"
            }
          }
        },
        {
          "name": "meta.macro.definition.iris",
          "match": "\\b(defmacro)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.iris"
            },
            "2": {
              "name": "entity.name.function.macro.iris"
            }
          }
        },
        {
          "name": "meta.type.definition.iris",
          "match": "\\b(record|choice|model|trait)\\s+([A-Z][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.iris"
            },
            "2": {
              "name": "entity.name.type.iris"
            }
          }
        },
        {
          "name": "meta.type.alias.iris",
          "match": "\\b(type)\\s+([A-Z][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.iris"
            },
            "2": {
              "name": "entity.name.type.iris"
            }
          }
        },
        {
          "name": "meta.module.definition.iris",
          "match": "\\b(mod)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.other.iris"
            },
            "2": {
              "name": "entity.name.namespace.iris"
            }
          }
        },
        {
          "name": "meta.const.definition.iris",
          "match": "\\b(const)\\s+([A-Z_][A-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.iris"
            },
            "2": {
              "name": "entity.name.constant.iris"
            }
          }
        }
      ]
    },
    "keywords": {
      "comment": "Mirrors src/parser/lexer.rs plus contextual operator words.",
      "patterns": [
        {
          "name": "keyword.control.flow.iris",
          "match": "\\b(if|else|when|match|for|while|loop|break|continue|return|in|by)\\b"
        },
        {
          "name": "keyword.control.exception.iris",
          "match": "\\b(try|catch|raise|defer)\\b"
        },
        {
          "name": "keyword.control.effect.iris",
          "match": "\\b(effect|handle|resume|with|yield|mask|pure|transaction)\\b"
        },
        {
          "name": "keyword.control.concurrent.iris",
          "match": "\\b(spawn|par|async|await|select)\\b"
        },
        {
          "name": "storage.modifier.iris",
          "match": "\\b(pub|extern|unsafe|move|dyn|mut)\\b"
        },
        {
          "name": "keyword.declaration.iris",
          "match": "\\b(def|record|choice|model|trait|impl|type|const|defmacro)\\b"
        },
        {
          "name": "keyword.other.iris",
          "match": "\\b(val|var|let|bring|mod|where)\\b"
        },
        {
          "name": "keyword.operator.logical.iris",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.operator.cast.iris",
          "match": "\\b(to)\\b"
        },
        {
          "name": "variable.language.iris",
          "match": "\\b(self|Self)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.iris",
          "match": "\\b(i64|i32|i8|u8|u32|u64|usize|f64|f32|bool|str|unit)\\b"
        },
        {
          "comment": "Built-in composite and runtime types",
          "name": "support.type.iris",
          "match": "\\b(task_group|weak_ref|channel|atomic|bitset|option|result|sparse|tensor|deque|mutex|tuple|Cell|Dual|cell|chan|grad|list|task|map|set)\\b"
        },
        {
          "comment": "Native Desktop UI stdlib types (std.ui*)",
          "name": "support.type.iris",
          "match": "\\b(UiButtonVariant|BoxConstraints|UiGradientStop|UiInteraction|UiNeuralGraph|WindowMetrics|BarChartSpec|SpringConfig|UiBreakpoint|UiCameraInfo|UiExtraState|ChartSeries|NativeUiLib|TextMetrics|UiAppConfig|UiElevation|UiEventKind|UiFrameStep|UiGraphLink|UiGraphNode|UiOptionBox|UiTransform|DrawBuffer|SelectSpec|TensorSpec|UiHostMode|UiPathVerb|UiReactive|WidgetKind|HostEvent|ImageSpec|RadarBlip|RadarSpec|SignalBox|UiJustify|UiListBox|MenuSpec|StatSpec|TabsSpec|UiCursor|UiInsets|UiMotion|UiSpring|UiAlign|UiClock|UiColor|UiRadii|UiState|UiStyle|UiTheme|UiToast|UiTween|UiEase|UiIcon|UiNode|UiRect|UiSize|UiTone|UiTree)\\b"
        },
        {
          "comment": "AI, ML, AD, LLM & Autonomy stdlib types",
          "name": "support.type.iris",
          "match": "\\b(ActiveInferenceDecision|HomeostaticVariable|ViabilityAssessment|AutonomyV2Decision|ExpectedFreeEnergy|EmbeddingResponse|SoftwareGovernor|GenerativeModel|ViabilityChoice|NormalInvGamma|ViabilityBound|AutonomicRule|AutopilotStep|KnowledgeBase|MetaCognition|ModelRegistry|SafetyVerdict|SensorReading|AgentRuntime|Constitution|GovernorStep|ModelSession|ReplayBuffer|RunningStats|SafetyPolicy|AifDecision|BeliefState|FewShotTask|LinearModel|LlmResponse|LlmToolCall|MetaProgram|ModelHealth|PolicyValue|RiskMetrics|Uncertainty|Constraint|DiffTensor|Experience|LlmMessage|LocalModel|MAPEKAgent|Population|SafetyRule|WorldModel|AgentStep|Autopilot|Homeostat|LlmClient|AifAgent|EWCState|MASState|MLTensor|MetaEdit|LlmTool|Genome|Tensor|Pomdp)\\b"
        },
        {
          "comment": "Systems, Networking, Protocol & Robotics stdlib types",
          "name": "support.type.iris",
          "match": "\\b(SpeculationOutcome|PcapGlobalHeader|ROS2ActionClient|ROS2ActionServer|StampedTransform|TransformBuffer|TlsClientHello|WebSocketFrame|EthernetFrame|ROS2Publisher|TfBroadcaster|HttpResponse|ROS2Executor|HttpRequest|ROS2Context|ROS2Service|TcpListener|UdpDatagram|ByteBuffer|Ipv4Packet|PcapPacket|QoSProfile|Quaternion|ROS2Client|SVGContext|TcpSegment|Countable|Ja3Result|Ja4Result|ROS2Event|ROS2Timer|TcpStream|TlsRecord|Transform|DateTime|Duration|PinWrite|ROS2Goal|ROS2Node|TfBuffer|ROS2Msg|ROS2Sub|Reading|Vector3|Serial|Point|Queue|Sized|Twist|File|Pose)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.iris",
          "match": "\\b(true|false|none|unit)\\b"
        }
      ]
    },
    "macros": {
      "patterns": [
        {
          "name": "meta.macro.call.iris",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)!",
          "captures": {
            "1": {
              "name": "entity.name.function.macro.iris"
            }
          }
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "comment": "Core I/O, Strings, Options/Results, Regex builtins",
          "name": "support.function.builtin.iris",
          "match": "\\b(regex_replace_all|json_stringify|regex_find_all|regex_replace|str_pad_right|str_pad_left|regex_match|starts_with|str_replace|str_reverse|unwrap_err|ends_with|exit_code|parse_f64|parse_i64|read_line|str_bytes|str_chars|str_count|str_index|unwrap_or|contains|eprintln|read_f64|read_i64|to_lower|to_upper|char_at|is_none|is_some|println|replace|type_of|assert|concat|format|is_err|repeat|to_f64|to_i64|to_str|unwrap|is_ok|panic|print|slice|split|args|exit|find|join|none|some|trim|err|len|ok)\\b"
        },
        {
          "comment": "Math, Bitwise & Checked/Wrapping arithmetic builtins",
          "name": "support.function.builtin.iris",
          "match": "\\b(wrapping_add|wrapping_mul|wrapping_sub|math_inf|math_pi|bitnot|is_inf|is_nan|math_e|clamp|floor|round|band|bxor|ceil|log2|sign|sqrt|abs|bor|cos|exp|log|max|min|pow|shl|shr|sin|tan)\\b"
        },
        {
          "comment": "Collections, Reference Cells, WeakRefs & GC builtins (1/2)",
          "name": "support.function.builtin.iris",
          "match": "\\b(deque_push_front|deque_pop_front|deque_push_back|list_scale_blas|deque_pop_back|list_axpy_blas|list_enumerate|array_to_list|list_contains|list_dot_blas|list_index_of|list_mul_elem|bitset_clear|bitset_count|list_flatten|list_max_val|list_min_val|list_reverse|list_sigmoid|list_softmax|map_contains|weak_upgrade|deque_front|list_concat|list_filter|list_insert|list_reduce|list_remove|list_sorted|list_unique|map_entries|sorted_keys|bitset_get|bitset_new|bitset_set|deque_back|gc_collect|list_count|list_scale|list_slice|map_remove|map_values|weak_alive|deque_len|deque_new|list_axpy|list_drop|list_mean|list_norm|list_push|list_relu|list_sort|list_take|cell_get|cell_set|gc_stats|is_empty|list_add|list_all|list_any|list_dir|list_dot|list_get|list_len|list_map|list_max|list_min|list_new|list_pop|list_set|list_std|list_sub|list_sum|list_zip|map_keys|weak_ref|map_get|map_len|map_new|map_set|filter|index|cell|fold|list)\\b"
        },
        {
          "comment": "Collections, Reference Cells, WeakRefs & GC builtins (2/2)",
          "name": "support.function.builtin.iris",
          "match": "\\b(push|all|any|get|map|pop|set)\\b"
        },
        {
          "comment": "Autodiff, Tensors & ML compiler builtins",
          "name": "support.function.builtin.iris",
          "match": "\\b(dtensor_backward|dtensor_sigmoid|dtensor_to_list|dtensor_matmul|cross_entropy|dtensor_grad|dtensor_item|dtensor_relu|dtensor_tanh|dtensor_tape|dtensor_add|dtensor_div|dtensor_mul|dtensor_sub|dtensor_sum|backward|linspace|mse_loss|sgd_step|sparsify|densify|dtensor|grad_of|tangent|arange|einsum|matmul|zeros|fill|grad|ones|tape|nnz)\\b"
        },
        {
          "comment": "Concurrency, Async, Atomics & Transactional Speculation builtins",
          "name": "support.function.builtin.iris",
          "match": "\\b(transaction_rollback|transaction_commit|task_group_cancel|transaction_begin|transaction_depth|task_group_join|async_readable|async_writable|task_cancelled|chan_try_recv|atomic_store|mutex_unlock|recv_timeout|thread_count|async_sleep|async_yield|atomic_load|task_cancel|async_recv|atomic_add|atomic_new|mutex_lock|task_group|async_any|chan_send|mutex_new|task_done|chan_len|barrier|channel|par_map|timeout|atomic|select|recv|send)\\b"
        },
        {
          "comment": "System, Filesystem, SQLite, FFI, Networking & Reflection builtins (1/2)",
          "name": "support.function.builtin.iris",
          "match": "\\b(iris_reflection_available|ffi_out_get_str_range|ffi_out_write_bytes|datetime_timestamp|reflect_available|tcp_connect_async|reflect_eval_i64|reflect_validate|tcp_accept_async|term_show_cursor|datetime_format|db_query_params|ffi_out_get_f32|ffi_out_get_f64|ffi_out_get_i32|ffi_out_get_i64|ffi_out_get_str|ffi_out_set_f32|ffi_out_set_f64|ffi_out_set_i32|ffi_out_set_i64|file_read_bytes|tcp_write_async|db_exec_params|ffi_out_get_u8|ffi_out_set_u8|file_write_all|http_get_async|http_post_json|python_version|rust_call_void|tcp_read_async|term_set_color|base64_decode|base64_encode|ffi_call_args|ffi_call_void|file_read_all|iris_eval_i64|iris_validate|read_password|rust_call_f64|rust_call_i64|rust_lib_open|datetime_now|ffi_call_f64|ffi_call_i64|ffi_call_str|ffi_out_free|http_request|random_range|reflect_eval|ffi_out_len|ffi_out_new|file_exists|python_call|python_eval|python_exec|random_seed|remove_file|tcp_connect|term_cursor|time_now_ms|file_close|file_lines|file_write|hex_decode|hex_encode|tcp_accept|tcp_listen|term_clear|term_reset|ffi_close|file_open|file_read|http_post|iris_eval|path_join|tcp_close|tcp_write|term_cols|term_rows|udp_close|db_close|db_query)\\b"
        },
        {
          "comment": "System, Filesystem, SQLite, FFI, Networking & Reflection builtins (2/2)",
          "name": "support.function.builtin.iris",
          "match": "\\b(exec_cmd|ffi_call|ffi_open|http_get|list_dir|read_key|sleep_ms|tcp_read|udp_open|udp_recv|udp_send|db_exec|db_open|env_get|env_set|env_var|random|sha256|mkdir|hash|seed|uuid|cwd|pid)\\b"
        },
        {
          "comment": "Native Desktop UI & Camera stdlib (std.ui*) (1/4)",
          "name": "support.function.stdlib.iris",
          "match": "\\b(ui_native_camera_set_sim_target|ui_state_has_active_transitions|ui_native_set_size_constraints|ui_native_camera_sample_grid|draw_cmd_round_rect_corners|ui_native_set_cursor_window|ui_native_take_dropped_file|ui_radar_scope_interactive|ui_state_sync_transitions|ui_state_toggle_selection|ui_transform_rotate_about|draw_cmd_linear_gradient|draw_cmd_push_round_clip|draw_cmd_radial_gradient|ui_native_set_fullscreen|ui_native_window_is_open|ui_native_window_metrics|ui_state_clear_selection|ui_transform_scale_about|draw_cmd_push_transform|ui_http_mirror_response|ui_native_clipboard_get|ui_native_clipboard_set|ui_native_set_icon_rgba|ui_native_set_maximized|ui_native_set_resizable|ui_native_submit_window|ui_native_window_create|ui_state_animated_value|ui_state_focus_progress|ui_state_hover_progress|ui_state_press_progress|ui_state_select_changed|ui_state_selected_count|ui_table_row_selectable|draw_cmd_pop_transform|ui_native_camera_close|ui_native_inject_event|ui_native_measure_text|ui_native_sample_pixel|ui_native_window_close|ui_state_set_clipboard|ui_state_set_multiline|ui_state_set_selection|ui_state_text_position|ui_transform_translate|draw_cmd_camera_frame|draw_cmd_push_opacity|ui_frame_pool_destroy|ui_motion_spring_from|ui_native_camera_info|ui_native_camera_open|ui_native_poll_window|ui_radar_scope_action|ui_render_mirror_html|ui_state_dropped_file|ui_state_select_range|ui_state_spring_value|draw_cmd_pop_opacity|emerald_studio_theme|ui_close_native_host|ui_frame_pool_resume|ui_layout_with_state|ui_motion_has_active|ui_motion_to_delayed|ui_native_clock_secs|ui_native_set_cursor|ui_state_close_popup|ui_state_is_dragging|ui_state_is_selected|ui_state_split_ratio|ui_state_spring_from|ui_state_tab_changed|ui_thermal_color_for|draw_cmd_a11y_state)\\b"
        },
        {
          "comment": "Native Desktop UI & Camera stdlib (std.ui*) (2/4)",
          "name": "support.function.stdlib.iris",
          "match": "\\b(draw_cmd_box_shadow|draw_cmd_image_rgba|draw_cmd_round_rect|high_contrast_theme|motion_cubic_bezier|ui_frame_pool_begin|ui_frame_pool_pause|ui_motion_is_active|ui_native_pump_once|ui_native_set_title|ui_neural_graph_new|ui_open_native_host|ui_state_begin_drag|ui_state_mark_clean|ui_state_open_popup|ui_state_push_toast|ui_tensor_from_grid|draw_buf_cmd_count|draw_cmd_push_clip|draw_progress_ring|split_divider_rect|ui_layout_scrolled|ui_native_save_png|ui_radar_pick_blip|ui_render_headless|ui_responsive_cols|ui_state_clipboard|ui_state_move_drag|ui_state_scroll_of|ui_state_tick_next|draw_cmd_polyline|draw_cmd_pop_clip|draw_cmd_svg_path|draw_neural_graph|drawer_panel_rect|motion_lerp_color|theme_with_accent|ui_icon_from_name|ui_list_box_first|ui_native_metrics|ui_process_events|ui_push_bar_chart|ui_signal_summary|ui_state_end_drag|ui_state_set_text|ui_tensor_surface|cursor_kind_code|draw_icon_styled|draw_metric_tile|motion_lerp_rect|popup_panel_rect|text_line_col_at|text_style_flags|ui_find_node_key|ui_motion_spring|ui_native_submit|ui_option_box_or|ui_progress_ring|ui_state_animate|ui_thermal_color|draw_buf_finish|draw_cmd_circle|draw_search_box|hkt_bind_signal|modal_card_rect|ui_clear_events|ui_motion_value|ui_progress_bar|ui_slider_range|ui_state_cursor|ui_state_detach|ui_state_spring|ui_table_header|constrain_size|daylight_theme)\\b"
        },
        {
