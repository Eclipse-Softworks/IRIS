{
  "name": "iris-lang",
  "displayName": "IRIS Language",
  "description": "Complete IRIS RC2 developer experience: language server, formatter, Test Explorer, debugger, safety diagnostics, and REPL",
  "version": "1.0.10",
  "publisher": "iris-lang",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "iris",
    "iris-lang",
    "compiler",
    "llvm",
    "machine learning",
    "dsl",
    "language server",
    "debugger",
    "repl"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "icon": "icon.png",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Eclipse-Softworks/IRIS.git"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "iris",
        "aliases": [
          "IRIS",
          "Iris",
          "iris"
        ],
        "extensions": [
          ".iris"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "iris",
        "scopeName": "source.iris",
        "path": "./syntaxes/iris.tmLanguage.json"
      }
    ],
    "debuggers": [
      {
        "type": "iris",
        "label": "IRIS Debugger",
        "languages": [
          "iris"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to the .iris file to debug.",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at the first line on launch.",
                "default": false
              },
              "entryFunction": {
                "type": "string",
                "description": "Optional zero-argument function to debug instead of main (used by Test Explorer)."
              },
              "native": {
                "type": "boolean",
                "description": "Debug the compiled native binary instead of replaying the interpreter: builds with debug info (iris build -g) and runs it under GDB 14+ (or the adapter named by IRIS_NATIVE_DAP). Supports line breakpoints, stepping, call stacks, scalar and composite DWARF locals (str, record, enum, arrays, option, result, tuple, list, map), native attach, and reverse stepping when the adapter reports supportsStepBack.",
                "default": false
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Command-line arguments for a native session."
              },
              "cwd": {
                "type": "string",
                "description": "Working directory for a native session (defaults to the program's directory)."
              }
            }
          },
          "attach": {
            "properties": {
              "native": {
                "type": "boolean",
                "description": "Attach through the native DAP bridge (`gdb -i dap` / `IRIS_NATIVE_DAP`). Required for attach requests.",
                "default": true
              },
              "processId": {
                "type": [
                  "integer",
                  "string"
                ],
                "description": "Process ID of the running native IRIS binary to attach to."
              },
              "pid": {
                "type": [
                  "integer",
                  "string"
                ],
                "description": "Alias for processId."
              },
              "target": {
                "type": "string",
                "description": "Remote native debug target (for example \"localhost:3333\")."
              },
              "program": {
                "type": "string",
                "description": "Optional path to the native executable for symbol lookup."
              },
              "cwd": {
                "type": "string",
                "description": "Optional working directory for the native adapter."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "iris",
            "request": "launch",
            "name": "Debug IRIS File",
            "program": "${file}",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "IRIS: Debug File",
            "description": "Debug the currently open .iris file",
            "body": {
              "type": "iris",
              "request": "launch",
              "name": "Debug ${1:File}",
              "program": "${file}",
              "stopOnEntry": false
            }
          },
          {
            "label": "IRIS: Debug Native Binary",
            "description": "Build with debug info and debug the native executable under GDB",
            "body": {
              "type": "iris",
              "request": "launch",
              "name": "Debug ${1:File} (native)",
              "program": "${file}",
              "native": true
            }
          },
          {
            "label": "IRIS: Attach Native Process",
            "description": "Attach GDB/LLDB DAP to a running native IRIS executable or remote target",
            "body": {
              "type": "iris",
              "request": "attach",
              "name": "Attach ${1:IRIS Process}",
              "native": true,
              "processId": "${2:0}"
            }
          }
        ]
      }
    ],
    "problemMatchers": [
      {
        "name": "iris",
        "owner": "iris",
        "source": "iris",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": [
          {
            "regexp": "^(error|warning)(?:\\[([A-Z]\\d+)\\])?:\\s+(.*)$",
            "severity": 1,
            "code": 2,
            "message": 3
          },
          {
            "regexp": "^\\s*-->\\s+(.+):(\\d+):(\\d+)\\s*$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "iris",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "enum": [
              "run",
              "build",
              "build-debug",
              "build-gui",
              "bundle",
              "check",
              "test",
              "bench",
              "profile",
              "doctor"
            ],
            "description": "The IRIS command to run: run, build, build-debug, build-gui, bundle, check, test, bench, profile, or doctor."
          }
        }
      }
    ],
    "commands": [
      {
        "command": "iris.runTest",
        "title": "IRIS: Run Test Function"
      },
      {
        "command": "iris.debugTest",
        "title": "IRIS: Debug Test Function"
      },
      {
        "command": "iris.runFile",
        "title": "IRIS: Run File",
        "icon": "$(play)"
      },
      {
        "command": "iris.buildFile",
        "title": "IRIS: Build Binary",
        "icon": "$(package)"
      },
      {
        "command": "iris.debugFile",
        "title": "IRIS: Debug File",
        "icon": "$(debug-alt)"
      },
      {
        "command": "iris.debugFileNative",
        "title": "IRIS: Debug Native Binary",
        "icon": "$(debug-alt-small)"
      },
      {
        "command": "iris.openRepl",
        "title": "IRIS: Open REPL",
        "icon": "$(terminal)"
      },
      {
        "command": "iris.restartLsp",
        "title": "IRIS: Restart Language Server",
        "icon": "$(debug-restart)"
      },
      {
        "command": "iris.stopLsp",
        "title": "IRIS: Stop Language Server",
        "icon": "$(debug-stop)"
      },
      {
        "command": "iris.showIR",
        "title": "IRIS: Show IR Output",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "iris.showLLVM",
        "title": "IRIS: Show LLVM IR Output",
        "icon": "$(symbol-class)"
      },
      {
        "command": "iris.showVersion",
        "title": "IRIS: Show Version Info",
        "icon": "$(info)"
      },
      {
        "command": "iris.showEmit",
        "title": "IRIS: Show Compiler Output...",
        "icon": "$(file-binary)"
      },
      {
        "command": "iris.showGraph",
        "title": "IRIS: Show Graph Output",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "iris.showCuda",
        "title": "IRIS: Show CUDA Output",
        "icon": "$(chip)"
      },
      {
        "command": "iris.showSimd",
        "title": "IRIS: Show SIMD Output",
        "icon": "$(symbol-array)"
      },
      {
        "command": "iris.explainError",
        "title": "IRIS: Explain Error Code",
        "icon": "$(question)"
      },
      {
        "command": "iris.checkFormat",
        "title": "IRIS: Check Formatting",
        "icon": "$(check)"
      },
      {
        "command": "iris.runTests",
        "title": "IRIS: Run Tests in File",
        "icon": "$(beaker)"
      },
      {
        "command": "iris.runWorkspaceTests",
        "title": "IRIS: Run All Workspace Tests",
        "icon": "$(beaker)"
      },
      {
        "command": "iris.fmtWorkspace",
        "title": "IRIS: Format All Workspace Files",
        "icon": "$(wand)"
      },
      {
        "command": "iris.runBench",
        "title": "IRIS: Run Benchmarks",
        "icon": "$(dashboard)"
      },
      {
        "command": "iris.generateDocs",
        "title": "IRIS: Generate Documentation",
        "icon": "$(book)"
      },
      {
        "command": "iris.pkg",
        "title": "IRIS: Package Manager...",
        "icon": "$(package)"
      },
      {
        "command": "iris.diagnostics",
        "title": "IRIS: Diagnose Toolchain",
        "icon": "$(tools)"
      },
      {
        "command": "iris.buildGui",
        "title": "IRIS: Build GUI Binary",
        "icon": "$(window)"
      },
      {
        "command": "iris.bundleApp",
        "title": "IRIS: Bundle Standalone Application...",
        "icon": "$(archive)"
      },
      {
        "command": "iris.newProject",
        "title": "IRIS: New Project from Template...",
        "icon": "$(new-folder)"
      },
      {
        "command": "iris.checkWorkspace",
        "title": "IRIS: Check Project",
        "icon": "$(check-all)"
      },
      {
        "command": "iris.watchFile",
        "title": "IRIS: Watch File...",
        "icon": "$(eye)"
      },
      {
        "command": "iris.doctor",
        "title": "IRIS: Run Toolchain Doctor",
        "icon": "$(heart)"
      },
      {
        "command": "iris.profileFile",
        "title": "IRIS: Profile File",
        "icon": "$(flame)"
      },
      {
        "command": "iris.buildEmbedded",
        "title": "IRIS: Build Embedded Bundle...",
        "icon": "$(circuit-board)"
      },
      {
        "command": "iris.bindgen",
        "title": "IRIS: Generate FFI Bindings...",
        "icon": "$(plug)"
      },
      {
        "command": "iris.bugReport",
        "title": "IRIS: Collect Bug Report",
        "icon": "$(bug)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "iris.runFile",
          "when": "resourceExtname == .iris",
          "group": "navigation"
        },
        {
          "command": "iris.debugFile",
          "when": "resourceExtname == .iris",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "iris.runFile",
          "when": "resourceExtname == .iris"
        },
        {
          "command": "iris.buildFile",
          "when": "resourceExtname == .iris"
        },
        {
          "command": "iris.debugFile",
          "when": "resourceExtname == .iris"
        },
        {
          "command": "iris.debugFileNative",
          "when": "resourceExtname == .iris"
        },
        {
          "command": "iris.openRepl"
        },
        {
          "command": "iris.restartLsp"
        },
        {
          "command": "iris.stopLsp"
        },
        {
          "command": "iris.showIR",
          "when": "resourceExtname == .iris"
        },
        {
          "command": "iris.showLLVM",
          "when": "resourceExtname == .iris"
        },
        {
          "command": "iris.showVersion"
        },
        {
          "command": "iris.showEmit",
          "when": "resourceExtname == .iris"
        },
        {
          "command": "iris.showGraph",
          "when": "resourceExtname == .iris"
        },
        {
          "command": "iris.showCuda",
          "when": "resourceExtname == .iris"
        },
        {
          "command": "iris.showSimd",
          "when": "resourceExtname == .iris"
        },
        {
          "command": "iris.explainError"
        },
        {
          "command": "iris.checkFormat",
          "when": "resourceExtname == .iris"
        },
        {
          "command": "iris.runTests",
          "when": "resourceExtname == .iris"
        },
        {
          "command": "iris.runWorkspaceTests"
        },
        {
          "command": "iris.fmtWorkspace"
        },
        {
          "command": "iris.runBench",
          "when": "resourceExtname == .iris"
        },
        {
          "command": "iris.generateDocs",
          "when": "resourceExtname == .iris"
        },
        {
          "command": "iris.pkg"
        },
        {
          "command": "iris.diagnostics"
        },
        {
          "command": "iris.buildGui",
          "when": "resourceExtname == .iris"
        },
        {
          "command": "iris.bundleApp"
        },
        {
          "command": "iris.newProject"
        },
        {
          "command": "iris.checkWorkspace"
        },
        {
          "command": "iris.watchFile",
          "when": "resourceExtname == .iris"
        },
        {
          "command": "iris.doctor"
        },
        {
          "command": "iris.profileFile",
          "when": "resourceExtname == .iris"
        },
        {
          "command": "iris.buildEmbedded",
          "when": "resourceExtname == .iris"
        },
        {
          "command": "iris.bindgen"
        },
        {
          "command": "iris.bugReport",
          "when": "resourceExtname == .iris"
        }
      ]
    },
    "keybindings": [
      {
        "command": "iris.runFile",
        "key": "ctrl+f5",
        "when": "resourceExtname == .iris && !inDebugMode"
      }
    ],
    "configuration": {
      "title": "IRIS",
      "properties": {
        "iris.executablePath": {
          "type": "string",
          "default": "iris",
          "description": "Path to the iris executable. Defaults to 'iris' (must be in PATH).",
          "scope": "machine-overridable"
        },
        "iris.maxNumberOfProblems": {
          "type": "number",
          "default": 100,
          "description": "Maximum number of problems (errors/warnings) shown in the Problems panel."
        },
        "iris.formatOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically format .iris files on save."
        },
        "iris.format.indentSize": {
          "type": "integer",
          "default": 4,
          "minimum": 1,
          "maximum": 16,
          "description": "Spaces per indentation level used by the deterministic IRIS formatter."
        },
        "iris.format.maxLineWidth": {
          "type": "integer",
          "default": 100,
          "minimum": 40,
          "maximum": 240,
          "description": "Preferred formatter line width; lists and parameter groups wrap at safe comma boundaries."
        },
        "iris.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace communication between VS Code and the IRIS language server.",
          "enumDescriptions": [
            "No tracing",
            "Log messages only",
            "Log messages and their contents"
          ]
        },
        "iris.inlayHints.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable inlay hints (type annotations on bindings)."
        },
        "iris.inlayHints.typeHints": {
          "type": "boolean",
          "default": true,
          "description": "Show inferred binding hints on val/var bindings."
        },
        "iris.debug.stopOnEntry": {
          "type": "boolean",
          "default": false,
          "description": "Stop at the first executable trace point when debugging an IRIS file."
        },
        "iris.debug.native": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Make **IRIS: Debug File** debug the compiled native binary (built with `iris build -g`, run under GDB 14+) instead of replaying the interpreter. Native sessions support line breakpoints, stepping, call stacks, local `val`/`var` inspection (scalars, `str`, `record`, `enum`, arrays, `option`, `result`, `tuple`, `list`, `map`), native `attach`, and reverse stepping when the underlying adapter reports `supportsStepBack`."
        },
        "iris.debug.nativeAdapter": {
          "type": "string",
          "default": "",
          "markdownDescription": "Command line of the native DAP adapter for native debug sessions (sets `IRIS_NATIVE_DAP`), e.g. `C:/msys64/ucrt64/bin/gdb.exe -i dap` or `lldb-dap`. Empty: use GDB 14+ from PATH or MSYS2, then `lldb-dap`.",
          "scope": "machine-overridable"
        },
        "iris.build.debugInfo": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Make **IRIS: Build Binary** emit DWARF debug information (`-g`, compiled at `-O0`) so the binary can be debugged or attached with gdb/lldb. Ignored when `iris.target` is set."
        },
        "iris.strictEffects": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Pass `--strict-effects` when running or building: every effectful function must declare an `effect` clause that covers what it does."
        },
        "iris.showTimingOnRun": {
          "type": "boolean",
          "default": true,
          "description": "Show elapsed compile+run time in the output channel."
        },
        "iris.sandbox": {
          "type": "boolean",
          "default": false,
          "description": "Pass --sandbox when running or building, denying filesystem, network, FFI and process access."
        },
        "iris.noCache": {
          "type": "boolean",
          "default": false,
          "description": "Pass --no-cache to disable incremental compilation."
        },
        "iris.target": {
          "type": "string",
          "default": "",
          "description": "Target preset or triple used by IRIS: Build Binary (e.g. linux-arm64). Empty means the host target.",
          "scope": "machine-overridable"
        },
        "iris.simd": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Pass `--simd` to compile element-wise `par for` loops as explicit AVX2/NEON vector kernels and enable LLVM loop vectorization."
        },
        "iris.gpu": {
          "type": "string",
          "enum": [
            "",
            "cuda"
          ],
          "default": "",
          "markdownDescription": "Pass `--gpu <api>` to offload numeric/tensor `par for` loops (currently `cuda` or empty to disable)."
        },
        "iris.build.gui": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Pass `--gui` on **IRIS: Build Binary** so desktop applications link with the Windows GUI subsystem (no console window)."
        },
        "iris.bundle.release": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Prefer release-built `iris_ui_host` when running **IRIS: Bundle Standalone Application...**."
        }
      }
    },
    "snippets": [
      {
        "language": "iris",
        "path": "./snippets/iris.json"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "npx @vscode/vsce package --no-dependencies",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.3.0"
  },
  "overrides": {
    "form-data": "^4.0.6",
    "tmp": "^0.2.6",
    "brace-expansion": "^2.1.4",
    "linkify-it": "^5.0.2",
    "undici": "^7.29.0",
    "qs": "^6.15.2",
    "markdown-it": "^14.2.0",
    "uuid": "^11.1.1"
  }
}