    ],
    "description": "Create an AIS runtime and record a production outcome"
  },
  "Transactional effect block": {
    "prefix": "tx",
    "body": [
      "transaction_begin();",
      "try {",
      "  ${1:// transactional state mutations and staged file operations}",
      "  transaction_commit();",
      "} catch {",
      "  transaction_rollback();",
      "}"
    ],
    "description": "Execute state mutations inside an atomic transactional rollback frame"
  },
  "Autonomy v2 step": {
    "prefix": "autonomyv2",
    "body": [
      "bring std.ais",
      "val ${1:bounds}: list<ViabilityBound> = list()",
      "push(${1:bounds}, viability_bound_new(\"${2:metric}\", ${3:0.4}, ${4:0.8}, ${5:0.2}, ${6:0.9}, ${7:1.0}, ${8:0}));",
      "val ${9:decision} = autonomy_v2_step(",
      "  ${1:bounds}, ${10:values}, ${11:drift}, ${12:1.0},",
      "  ${13:policy_outcomes}, ${14:preferences}, ${15:ambiguities}, ${16:epistemic}, ${17:99}",
