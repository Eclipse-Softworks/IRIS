      "if is_err(${1:connection}) { return ${6:1} }",
      "val ${7:stream} = unwrap(${1:connection})",
      "val _ = tcp_write_all_checked(${7:stream}, ${8:\"hello\"})",
      "val ${9:response} = tcp_read_bounded(${7:stream}, ${10:65536})",
      "tcp_close_checked(${7:stream});"
    ],
    "description": "Use typed, bounded TCP networking with explicit Result handling"
  },
  "AIS production step": {
    "prefix": "aisstep",
    "body": [
      "bring std.ais",
