    "body": ["val ${1:r}: &mut ${2:T} = &mut ${3:val};"],
    "description": "Borrow a mutable reference"
  },
  "Reverse-mode Autodiff": {
    "prefix": "autodiff",
    "body": [
      "val ${1:w} = tape(${2:1.0});",
      "val ${3:loss} = ${4:w * w};",
      "val _ = backward(${3:loss});",
      "val ${5:dw} = grad(${1:w});"
    ],
    "description": "Compute reverse-mode automatic differentiation gradients using a tape"
  },
  "Forward-mode Dual Number": {
    "prefix": "dual",
    "body": [
      "val ${1:x} = Dual { primal: ${2:2.0}, tangent: 1.0 };",
      "val ${3:y} = ${4:x * x};"
    ],
    "description": "Forward-mode automatic differentiation with Dual numbers"
  },
  "Model declaration": {
    "prefix": "model",
    "body": [
      "model ${1:Classifier} {",
