  },
  "Tuple destructure": {
    "prefix": "tuple",
    "body": [
      "val ${1:t} = (${2:a}, ${3:b})",
      "val ${4:x} = ${1:t}.0",
      "val ${5:y} = ${1:t}.1"
    ],
    "description": "Create and destructure a tuple"
  },
  "Trait Object (dyn Trait)": {
    "prefix": "dyn",
    "body": [
      "val ${1:obj}: dyn ${2:Trait} = ${3:concrete_val};",
