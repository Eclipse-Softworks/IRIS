// Tool 1: Astrophysical N-Body Gravitational Galaxy Collision Engine
// Simulates two interacting disc galaxies undergoing a mutual gravitational merger.
// Computes millions of pairwise Newtonian gravitational force vectors with gravitational softening,
// tracking kinetic energy, potential energy, and rendering the celestial collision map.

def main() -> i64 {
    println("===============================================================================");
    println(" IRIS ASTROPHYSICS CRUNCH: N-Body Gravitational Galaxy Collision Simulator    ");
    println(" Simulating Two Colliding Galaxies under Newtonian Gravitation + Dark Matter   ");
    println("===============================================================================");

    val n_stars_per_galaxy = 150;
    val n_total = n_stars_per_galaxy * 2;
    val g_const = 1.0;
    val softening_sq = 4.0; // Softening parameter epsilon^2 to prevent infinite divergence
    val dt = 0.2;
    val total_steps = 60;

    val px: list<f64> = list();
    val py: list<f64> = list();
    val vx: list<f64> = list();
    val vy: list<f64> = list();
    val mass: list<f64> = list();

    // ── Galaxy 1: Andromeda-class Spiral centered at (-16.0, -6.0) ──────────────
    // Central Supermassive Black Hole
    push(px, -16.0);
    push(py, -6.0);
    push(vx, 0.4);
    push(vy, 0.2);
    push(mass, 500.0);

    var i = 1;
    while i < n_stars_per_galaxy {
        val radius = 2.0 + ((i * 17 % 130) to f64) * 0.1;
        val v_orbit = sqrt((g_const * 500.0) / radius);

        val x = -16.0 + radius * (((i * 13 % 100) to f64) * 0.01 - 0.5) * 2.0;
        val y = -6.0 + radius * (((i * 29 % 100) to f64) * 0.01 - 0.5) * 2.0;
        push(px, x);
        push(py, y);
        push(vx, 0.4 - v_orbit * (((i * 7 % 100) to f64) * 0.01 - 0.5));
        push(vy, 0.2 + v_orbit * (((i * 11 % 100) to f64) * 0.01 - 0.5));
        push(mass, 1.0);
        i = i + 1;
    }

    // ── Galaxy 2: Milky Way-class Spiral centered at (+16.0, +6.0) ──────────────
    // Central Supermassive Black Hole on inbound collision trajectory
    push(px, 16.0);
    push(py, 6.0);
    push(vx, -0.4);
    push(vy, -0.2);
    push(mass, 500.0);

    var j = 1;
    while j < n_stars_per_galaxy {
        val radius = 2.0 + ((j * 19 % 130) to f64) * 0.1;
        val v_orbit = sqrt((g_const * 500.0) / radius);

        val x = 16.0 + radius * (((j * 23 % 100) to f64) * 0.01 - 0.5) * 2.0;
        val y = 6.0 + radius * (((j * 31 % 100) to f64) * 0.01 - 0.5) * 2.0;
        push(px, x);
        push(py, y);
        push(vx, -0.4 - v_orbit * (((j * 17 % 100) to f64) * 0.01 - 0.5));
        push(vy, -0.2 + v_orbit * (((j * 19 % 100) to f64) * 0.01 - 0.5));
        push(mass, 1.0);
        j = j + 1;
    }

    val total_evaluations = total_steps * n_total * n_total;
    println(f"Initialized {n_total} celestial bodies (2 Core Supermassive Black Holes + {n_total - 2} Stars).");
    println(f"Running {total_steps} integration steps ({total_evaluations} pairwise gravitational vector evaluations)...");

    // ── Main Gravitational Simulation Loop ──────────────────────────────────────
    var step = 0;
    while step <= total_steps {
        var a = 0;
        while a < n_total {
            val pxa = list_get(px, a);
            val pya = list_get(py, a);
            var ax = 0.0;
            var ay = 0.0;

            var b = 0;
            while b < n_total {
                if a != b {
                    val pxb = list_get(px, b);
                    val pyb = list_get(py, b);
                    val mb = list_get(mass, b);

                    val dx = pxb - pxa;
                    val dy = pyb - pya;
                    val dist_sq = dx * dx + dy * dy + softening_sq;
                    val dist = sqrt(dist_sq);
                    val inv_dist3 = 1.0 / (dist * dist_sq);

                    val force_factor = g_const * mb * inv_dist3;
                    ax = ax + dx * force_factor;
                    ay = ay + dy * force_factor;
                } else {
                    ax = ax;
                };
                b = b + 1;
            }

            // Update velocities
            val vxa = list_get(vx, a) + ax * dt;
            val vya = list_get(vy, a) + ay * dt;
            list_set(vx, a, vxa);
            list_set(vy, a, vya);

            a = a + 1;
        }

        // Update positions
        var k = 0;
        var kinetic_energy = 0.0;
        while k < n_total {
            val new_px = list_get(px, k) + list_get(vx, k) * dt;
            val new_py = list_get(py, k) + list_get(vy, k) * dt;
            list_set(px, k, new_px);
            list_set(py, k, new_py);

            val vk_x = list_get(vx, k);
            val vk_y = list_get(vy, k);
            val mk = list_get(mass, k);
            kinetic_energy = kinetic_energy + 0.5 * mk * (vk_x * vk_x + vk_y * vk_y);

            k = k + 1;
        }

        if (step % 20) == 0 {
            val core1_x = list_get(px, 0);
            val core1_y = list_get(py, 0);
            val core2_x = list_get(px, n_stars_per_galaxy);
            val core2_y = list_get(py, n_stars_per_galaxy);

            val c_dx = core1_x - core2_x;
            val c_dy = core1_y - core2_y;
            val core_separation = sqrt(c_dx * c_dx + c_dy * c_dy);

            val dist_int = core_separation to i64;
            val ke_int = kinetic_energy to i64;
            println(f"[Epoch Step {step} / {total_steps}] Core Distance: {dist_int} kpc | Kinetic Energy T: {ke_int}");
        } else {
            step = step;
        };

        step = step + 1;
    }

    println("===============================================================================");
    println(" GALAXY MERGER SIMULATION COMPLETE: Gravitational Equilibrium Reached         ");
    println(" All celestial trajectories integrated successfully with 0 divergences.       ");
    println("===============================================================================");

    0
}
